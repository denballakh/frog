record Point
    x int
    y int
end

proc squared-distance Point -- int do
    let point do
        point @Point.x dup *
        point @Point.y dup *
        +
    end
end

proc main -- do
    Point:alloc
    let point do
        3 point !Point.x
        4 point !Point.y
        point squared-distance print
        Point:sizeof print
    end
end
