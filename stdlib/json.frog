                end
            end
        end
    end
end

proc json-number-int JsonValue -- int bool do
    json-number-bytes
    let bytes length is-number do
        if is-number ! length 0 == || do
            0 false
        else
            0 false
            let index negative do
                if bytes @u8 45 == do
                    1 true
                else
                    index negative
                end
                let index negative do
                    if index length >= do
                        0 false
                    elif bytes index + @u8 48 == index 1 + length < && do
                        0 false
                    else
                        index 0 true
                        while peek current result valid do
                            current length < valid &&
                        end
                        do
                            let current result valid do
                                bytes current + @u8
                                let byte do
                                    if byte json-digit? ! do
                                        length result false
                                    else
                                        byte 48 -
                                        let digit do
                                            if negative do
                                                if result 0 json-int-magnitude-limit - <
                                                    result 0 json-int-magnitude-limit - ==
                                                    digit json-int-min-last-digit > && ||
                                                do
                                                    length result false
                                                else
                                                    current 1 + result 10 * digit - true
                                                end
                                            else
                                                if result json-int-magnitude-limit >
                                                    result json-int-magnitude-limit ==
                                                    digit json-int-max-last-digit > && ||
                                                do
                                                    length result false
                                                else
                                                    current 1 + result 10 * digit + true
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        let current result valid do result valid end
                    end
                end
            end
        end
    end
end

proc json-array-length JsonValue -- int bool do
    let value do
        if value ptr cast json-null-pointer? do
            0 false
        else
            value JsonValue.array?
            let candidate matches do
                if matches do
                    candidate JsonValue.array @JsonArray.values @PtrArray.count true
                else
                    0 false
                end
            end
        end
    end
end

proc json-array-get JsonValue int -- JsonValue bool do
    let value index do
        if value ptr cast json-null-pointer? do
            json-parse-failure
        else
            value JsonValue.array?
            let candidate matches do
                if matches do
                    candidate JsonValue.array @JsonArray.values index ptr-array-get
                    let item found do
                        if found do item JsonValue cast true else json-parse-failure end
                    end
                else
                    json-parse-failure
                end
            end
        end
    end
end

proc json-object-get-bytes JsonValue ptr int -- JsonValue bool do
    let value key key-length do
        if key-length 0 < do
            json-parse-failure
        elif key-length 0 > key json-null-pointer? && do
            json-parse-failure
        elif value ptr cast json-null-pointer? do
            json-parse-failure
        else
            value JsonValue.object?
            let candidate matches do
                if matches ! do
                    json-parse-failure
                else
                    candidate JsonValue.object @JsonObject.head json-null-value false
                    while peek current result found do
                        current json-null-pointer? ! found ! &&
                    end
                    do
                        let current result found do
                            current JsonObjectEntry cast
                            let entry do
                                if entry @JsonObjectEntry.key
                                    let entry-key do
                                        entry-key @JsonText.bytes entry-key @JsonText.len
                                        key key-length bytes-equal
                                    end
                                do
                                    0 ptr cast entry @JsonObjectEntry.value true
                                else
                                    entry @JsonObjectEntry.next result false
                                end
                            end
                        end
                    end
                    let current result found do
                        if found do result true else json-parse-failure end
                    end
                end
            end
        end
    end
end

proc json-object-get JsonValue String -- JsonValue bool do
    let value key do
        value key String.bytes key String.len json-object-get-bytes
    end
end
