end

func string-equal String String -- bool do
    let first second do
        first String.bytes first String.len
            second String.bytes second String.len
        bytes-equal
    end
end

func string-starts-with String String -- bool do
    let value prefix do
        value String.bytes value String.len
            prefix String.bytes prefix String.len
        bytes-starts-with
    end
end

struct ByteBuffer
    bytes ptr
    len int
    capacity int
end

func byte-buffer-new int -- ByteBuffer* do
    let capacity do
        capacity alloc
        let bytes do
            ByteBuffer:alloc
            let buffer do
                bytes buffer !ByteBuffer.bytes
                0 buffer !ByteBuffer.len
                capacity buffer !ByteBuffer.capacity
                buffer
            end
        end
    end
end

func byte-buffer-push int ByteBuffer* -- do
    let byte buffer do
        if buffer @ByteBuffer.len buffer @ByteBuffer.capacity == do
            if buffer @ByteBuffer.capacity 0 == do
                1
            else
                buffer @ByteBuffer.capacity 2 *
            end
            let capacity do
                capacity alloc
                let bytes do
                    buffer @ByteBuffer.bytes bytes buffer @ByteBuffer.len bytes-copy
                    buffer @ByteBuffer.bytes free
                    bytes buffer !ByteBuffer.bytes
                    capacity buffer !ByteBuffer.capacity
                end
            end
        end
        byte u8 cast buffer @ByteBuffer.bytes buffer @ByteBuffer.len + u8* cast !
        buffer @ByteBuffer.len 1 + buffer !ByteBuffer.len
    end
end

func byte-buffer-append-bytes ptr int ByteBuffer* -- do
    let bytes length buffer do
        0
        while dup length < do
            let index do
                bytes index + u8* cast @ int cast buffer byte-buffer-push
                index 1 +
            end
        end
