    end
end

func bytes-contain ptr int ptr int -- bool do
    bytes-index-of 0 >=
end

func bytes-starts-with ptr int ptr int -- bool do
    let bytes bytes-length prefix prefix-length do
        if bytes-length 0 < prefix-length 0 < || do
            false
        elif prefix-length bytes-length > do
            false
