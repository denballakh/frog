end

func byte-buffer-append-string String ByteBuffer* -- do
    let value buffer do
        value String.bytes value String.len buffer byte-buffer-append-bytes
    end
end

func byte-buffer-equal-string ByteBuffer* String -- bool do
    let buffer value do
        buffer @ByteBuffer.bytes buffer @ByteBuffer.len
            value String.bytes value String.len
        bytes-equal
    end
end

func byte-buffer-free ByteBuffer* -- do
    let buffer do
        buffer @ByteBuffer.bytes free
        buffer ptr cast free
    end
end
