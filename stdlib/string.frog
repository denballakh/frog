from "libc.frog" import ( alloc free )

func bytes-copy ptr ptr int -- do
    let source destination count do
        0
        while dup count < do
            let index do
                source index + u8* cast @ destination index + u8* cast !
                index 1 +
            end
        end
        drop
    end
end

func bytes-equal ptr int ptr int -- bool do
    let first first-length second second-length do
        if first-length second-length != do
            false
        else
            0 true
            while
                peek index equal do
                    index first-length < equal &&
                end
            do
                let index equal do
                    index 1 +
                      equal
                      first index + u8* cast @ second index + u8* cast @ == &&
                end
            end
            let index equal do equal end
        end
    end
end

func bytes-index-of ptr int ptr int -- int do
    let bytes bytes-length needle needle-length do
        if needle-length 0 == do
            0
        elif bytes-length 0 < do
            0 1 -
        elif needle-length 0 < do
            0 1 -
        elif bytes-length needle-length < do
            0 1 -
        else
            0 false
            while peek index found do
                    index bytes-length needle-length - <= found ! &&
                end
            do
                let index found do
                    if bytes index + needle-length needle needle-length bytes-equal do
                        index true
                    else
                        index 1 + false
                    end
                end
            end
            let index found do
                if found do index else 0 1 - end
            end
