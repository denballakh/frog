end

func bytes-count ptr int ptr int -- int do
    let bytes bytes-length needle needle-length do
        if needle-length 0 == do
            0
        else
            0 0
            while peek index count do
                    index bytes-length <
                end
            do
                let index count do
                    bytes index + bytes-length index - needle needle-length bytes-index-of
                    let found do
                        if found 0 < do
                            bytes-length count
                        else
                            index found + needle-length + count 1 +
                        end
                    end
