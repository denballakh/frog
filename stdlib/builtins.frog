macro dup peek a do a end end
macro dup2 peek a b do a b end end
macro drop let a do end end
macro swap let a b do b a end end
macro swap2 let a b c d do c d a b end end
macro rot let a b c do b c a end end

// in the future we might implement boolean negation as macro instead of intrinsic:
// macro not let x do if x do false else true end end end

func assert bool String -- do
    let condition message do
        if condition do
        else
            message __intrinsic_assert_fail
        end
    end
end



func + int int -- int do __intrinsic_add_int end
func - int int -- int do __intrinsic_sub_int end
func * int int -- int do __intrinsic_mul_int end
func / int int -- int do __intrinsic_div_int end
func % int int -- int do __intrinsic_mod_int end
func /% int int -- int int do __intrinsic_divmod_int end
func | int int -- int do __intrinsic_or_int end
func & int int -- int do __intrinsic_and_int end
func ^ int int -- int do __intrinsic_xor_int end
func ~ int -- int do __intrinsic_not_int end
func << int u32 -- int do __intrinsic_shl_int end
func >> int u32 -- int do __intrinsic_shr_int end
func == int int -- bool do __intrinsic_eq_int end
func != int int -- bool do __intrinsic_ne_int end
func < int int -- bool do __intrinsic_lt_int end
func > int int -- bool do __intrinsic_gt_int end
func <= int int -- bool do __intrinsic_le_int end
func >= int int -- bool do __intrinsic_ge_int end

