{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.frog",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#punctiation" },
    { "include": "#operators" },
    { "include": "#special" },
    { "include": "#literals" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.frog"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(proc|extern|macro|from|import|as|if|elif|else|while|do|end|let)\\b",
          "name": "keyword.control.frog"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(int|bool|ptr|c-int|c-bool|c-ptr)\\b",
          "name": "storage.type.frog"
        }
      ]
    },
    "operators": {
      "patterns": [
        { 
          "match": "@ptr|@i(8|16|32|64)|@u(8|16|32|64)|!i(8|16|32|64)|!u(8|16|32|64)|\\+|-|\\*|/|%|/%|<<|>>|\\||&|\\^|~|&&|\\|\\||!|==|!=|<=|>=|<|>",
          "name": "keyword.operator.frog"
        }
      ]
    },
    "punctiation": {
      "patterns": [
        {
          "match": "--",
          "name": "punctuation.frog"
        }
      ]
    },
    "special": {
      "patterns": [
        {
          "match": "\\?|\\b(dup|dup2|drop|swap|swap2|rot|cast|alloc|args|print|putc|getc|read-file|eputc|exit)\\b",
          "name": "support.function"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.frog" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.frog" }
          },
          "name": "string.quoted.double.frog",
          "patterns": [
            {
              "match": "\\\\(?:[\\\\\"nrt0]|x[0-9A-Fa-f]{2})",
              "name": "constant.character.escape.frog"
            },
            {
              "match": "\\\\(?:x[^\"\\\\\\r\\n]{0,2}|[^\"\\r\\n])?",
              "name": "invalid.illegal.escape.frog"
            }
          ]
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.frog"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.frog"
        }
      ]
    }
  }
}
