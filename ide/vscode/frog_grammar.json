{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.frog",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#special" },
    { "include": "#types" },
    { "include": "#punctiation" },
    { "include": "#literals" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.frog"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(func|c-include|c-type|c-call|c-value|struct|enum|case|fn|macro|const|from|import|as|if|elif|else|while|do|end|let|peek)\\b",
          "name": "keyword.control.frog"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(String|int|i8|i16|i32|i64|u8|u16|u32|u64|bool|ptr)\\b\\**",
          "name": "storage.type.frog"
        }
      ]
    },
    "operators": {
      "patterns": [
        { 
          "match": "/%|<<|>>|&&|\\|\\||==|!=|<=|>=|@|!|\\+|-|\\*|/|%|\\||&|\\^|~|<|>",
          "name": "keyword.operator.frog"
        }
      ]
    },
    "punctiation": {
      "patterns": [
        {
          "match": "--",
          "name": "punctuation.frog"
        }
      ]
    },
    "special": {
      "patterns": [
        {
          "match": "(?<!\\S)[A-Za-z_][A-Za-z0-9_]*:ref:[^\\s]+(?!\\S)|(?<!\\S)[@!]\\.[A-Za-z_][A-Za-z0-9_]*(?!\\S)|(?<!\\S)[@!][A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*(?!\\S)|\\bString\\.(bytes|len)\\b|\\b[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*\\b|\\b[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\?|\\?|\\b__intrinsic_[A-Za-z0-9_]+\\b|\\b(dup|dup2|drop|swap|swap2|rot|cast|args|print)\\b",
          "name": "support.function"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "match": "'(?:\\\\(?:[\\\\'\"nrt0]|x[0-9A-Fa-f]{2})|[^\\\\'\\r\\n])'",
          "name": "constant.character.frog"
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.frog" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.frog" }
          },
          "name": "string.quoted.double.frog",
          "patterns": [
            {
              "match": "\\\\(?:[\\\\\"nrt0]|x[0-9A-Fa-f]{2})",
              "name": "constant.character.escape.frog"
            },
            {
              "match": "\\\\(?:x[^\"\\\\\\r\\n]{0,2}|[^\"\\r\\n])?",
              "name": "invalid.illegal.escape.frog"
            }
          ]
        },
        {
          "match": "(?:(?<=[\"'])|(?<!\\S))[+-]?(?:0b[01]+|0o[0-7]+|0x[0-9A-Fa-f]+|[0-9]+)(?!\\S)",
          "name": "constant.numeric.frog"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.frog"
        }
      ]
    }
  }
}
