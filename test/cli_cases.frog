from "framework.frog" import (
    FrogTestContext frog-check frog-process-equals
    frog-line-length frog-bytes-contain-line frog-count-lines-starting-with
)
from "stdlib/string.frog" import ( bytes-contain bytes-equal bytes-starts-with )
from "stdlib/subprocess.frog" import (
    CompletedProcess
