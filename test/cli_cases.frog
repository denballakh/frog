proc frog-cli-inspect-cfg FrogTestContext* -- do
    let context do
        2 context frog-cli-argv
        let arguments do
            "inspect" arguments 1 subprocess-arg
            "test/cases/cli/inspect_cfg.frog" arguments 2 subprocess-arg
            arguments "" subprocess-run
            let result do
                result @CompletedProcess.stdout result @CompletedProcess.stdout_len
                let bytes length do
                    result @CompletedProcess.returncode 0 ==
                    result @CompletedProcess.stderr_len 0 == &&
                    bytes length "frogc-inspect\t4\n" String.bytes "frogc-inspect\t4\n" String.len bytes-starts-with &&
                    bytes length
                    "fields\tprocedure\tmodule\tindex\tname\toperation_count\tbinding_local_count\tinstruction_count\texpansion_count\tblock_count"
                    frog-bytes-contain-line &&
                    bytes length
                    "fields\tblock\tprocedure_module\tprocedure_index\tindex\tsource_module\tstart_token\tinstruction_start\tinstruction_count\tterminator\tterminator_module\tterminator_token\tfirst_target\tsecond_target\tentry_types\texit_types"
                    frog-bytes-contain-line &&
                    bytes length frog-cli-inspect-straight &&
                    bytes length frog-cli-inspect-if-else &&
                    bytes length frog-cli-inspect-no-else &&
                    bytes length frog-cli-inspect-empty-arms &&
                    bytes length frog-cli-inspect-elif &&
                    bytes length frog-cli-inspect-loop &&
                    bytes length frog-cli-inspect-nested &&
                    bytes length frog-cli-inspect-macro-flow &&
