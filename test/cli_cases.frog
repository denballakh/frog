proc frog-cli-check-stdin String String String int String FrogTestContext* -- do
    let source expected-stdout expected-stderr expected-status name context do
        2 subprocess-argv
        let arguments do
            context @FrogTestContext.compiler arguments 0 subprocess-arg-pointer
            "check" arguments 1 subprocess-arg
            arguments source String.bytes source String.len "" subprocess-run-bytes-in
            let result do
                result expected-stdout expected-stderr expected-status frog-process-equals
                name context frog-check
                result completed-process-free
                arguments subprocess-argv-free
            end
        end
    end
end

