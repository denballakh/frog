end

proc frog-cli-tsv-field ptr int int -- ptr int bool do
    let line length requested do
        if requested 0 < do
            line 0 false
        else
            0 0
            while
                peek index field do
                    index length < field requested < &&
                end
            do
                let index field do
                    if line index + u8* cast @ int cast 9 == do
                        index 1 + field 1 +
                    else
                        index 1 + field
                    end
                end
            end
            let start field do
                if field requested != do
                    line 0 false
                else
                    start
                    while
                        peek finish do
                            if finish length < do
                                line finish + u8* cast @ int cast 9 !=
                            else
                                false
                            end
                        end
                    do
                        1 +
                    end
                    let finish do
                        line start + finish start - true
                    end
                end
            end
        end
    end
end

proc frog-cli-tsv-field-equals ptr int int String -- bool do
    let line length index expected do
        line length index frog-cli-tsv-field
        let field field-length found do
            if found do
                field field-length expected String.bytes expected String.len bytes-equal
            else
                false
            end
        end
    end
end

proc frog-cli-parse-inspect-int ptr int -- int bool do
    let bytes length do
        if length 0 == do
            0 false
        else
            bytes u8* cast @ int cast 45 ==
            let negative do
                if negative do 1 else 0 end
                let start do
                    if start length >= do
                        0 false
                    else
                        start 0 true
                        while
                            peek index value valid do
                                index length < valid &&
                            end
                        do
                            let index value valid do
                                bytes index + u8* cast @ int cast
                                let byte do
                                    if byte 48 < byte 57 > || do
                                        length value false
                                    else
                                        index 1 + value 10 * byte 48 - + true
                                    end
                                end
                            end
                        end
                        let index value valid do
                            if valid index length == && do
                                if negative do 0 value - else value end true
                            else
                                0 false
                            end
                        end
                    end
                end
            end
        end
    end
end

proc frog-cli-tsv-int ptr int int -- int bool do
    let line length index do
        line length index frog-cli-tsv-field
        let field field-length found do
            if found do field field-length frog-cli-parse-inspect-int else 0 false end
        end
    end
end

proc frog-cli-find-inspect-procedure-line ptr int String -- ptr int bool do
    let bytes length name do
        0 0 ptr cast 0 false
        while
            peek offset result result-length found do
                offset length < found ! &&
            end
        do
            let offset result result-length found do
                bytes offset + length offset - frog-line-length
                let line-length do
                    offset line-length 1 + +
                    if
                        bytes offset + line-length 0 "procedure" frog-cli-tsv-field-equals
                        bytes offset + line-length 3 name frog-cli-tsv-field-equals &&
                    do
                        bytes offset + line-length true
                    else
                        result result-length found
                    end
                end
            end
        end
        let offset result result-length found do result result-length found end
    end
end

proc frog-cli-inspect-procedure-info ptr int String -- int int int int int bool do
    let bytes length name do
        bytes length name frog-cli-find-inspect-procedure-line
        let line line-length found do
            if found ! do
                0 0 0 0 0 false
            else
                line line-length 1 frog-cli-tsv-int
                line line-length 2 frog-cli-tsv-int
                line line-length 4 frog-cli-tsv-int
                line line-length 6 frog-cli-tsv-int
                line line-length 8 frog-cli-tsv-int
                let module module-valid procedure procedure-valid operation-count operation-count-valid instruction-count instruction-count-valid block-count block-count-valid do
                    module procedure operation-count instruction-count block-count
                    module-valid procedure-valid && operation-count-valid && instruction-count-valid && block-count-valid &&
                end
            end
        end
    end
end

proc frog-cli-inspect-row-ids-match ptr int String int int int -- bool do
    let line length kind module procedure index do
        if line length 0 kind frog-cli-tsv-field-equals ! do
            false
        else
            line length 1 frog-cli-tsv-int
            line length 2 frog-cli-tsv-int
            line length 3 frog-cli-tsv-int
            let actual-module module-valid actual-procedure procedure-valid actual-index index-valid do
                module-valid procedure-valid && index-valid &&
                actual-module module == &&
                actual-procedure procedure == &&
                actual-index index == &&
            end
        end
    end
end

proc frog-cli-find-inspect-indexed-line ptr int String int int int -- ptr int bool do
    let bytes length kind module procedure index do
        0 0 ptr cast 0 false
        while
            peek offset result result-length found do
                offset length < found ! &&
            end
        do
            let offset result result-length found do
                bytes offset + length offset - frog-line-length
                let line-length do
                    offset line-length 1 + +
                    if
                        bytes offset + line-length kind module procedure index
                        frog-cli-inspect-row-ids-match
                    do
                        bytes offset + line-length true
                    else
                        result result-length found
                    end
                end
            end
        end
        let offset result result-length found do result result-length found end
    end
end

proc frog-cli-inspect-block-int ptr int int int int int -- int bool do
    let bytes length module procedure block-index field-index do
        bytes length "block" module procedure block-index frog-cli-find-inspect-indexed-line
        let line line-length found do
            if found do line line-length field-index frog-cli-tsv-int else 0 false end
        end
    end
end

proc frog-cli-inspect-block-field-equals ptr int int int int int String -- bool do
    let bytes length module procedure block-index field-index expected do
        bytes length "block" module procedure block-index frog-cli-find-inspect-indexed-line
        let line line-length found do
            if found do
                line line-length field-index expected frog-cli-tsv-field-equals
            else
                false
            end
        end
    end
end

proc frog-cli-inspect-target-valid int int -- bool do
    let target block-count do target 0 >= target block-count < && end
end

proc frog-cli-inspect-block-valid ptr int int int int -- int bool do
    let line length next-instruction procedure-instruction-count block-count do
        line length 6 frog-cli-tsv-int
        line length 7 frog-cli-tsv-int
        line length 11 frog-cli-tsv-int
        line length 12 frog-cli-tsv-int
        let instruction-start instruction-start-valid block-instruction-count block-instruction-count-valid first-target first-target-valid second-target second-target-valid do
            instruction-start-valid block-instruction-count-valid &&
            first-target-valid && second-target-valid &&
            instruction-start next-instruction == &&
            instruction-start 0 >= &&
            instruction-start procedure-instruction-count <= &&
            block-instruction-count 0 >= &&
            block-instruction-count procedure-instruction-count instruction-start - <= &&
            let range-valid do
                line length 8 "jump" frog-cli-tsv-field-equals
                line length 8 "branch" frog-cli-tsv-field-equals
                line length 8 "return" frog-cli-tsv-field-equals
                let jump branch return do
                    if jump do
                        first-target block-count frog-cli-inspect-target-valid
                        second-target 0 1 - == &&
                    elif branch do
                        first-target block-count frog-cli-inspect-target-valid
                        second-target block-count frog-cli-inspect-target-valid &&
                        first-target second-target != &&
                    elif return do
                        first-target 0 1 - == second-target 0 1 - == &&
                    else
                        false
                    end
                    let terminator-valid do
                        next-instruction block-instruction-count +
                        range-valid terminator-valid &&
                    end
                end
            end
        end
    end
end

proc frog-cli-inspect-procedure-generic ptr int int int int int -- bool do
    let bytes length module procedure instruction-count block-count do
        0 0 true
        while
            peek block-index next-instruction valid do
                block-index block-count < valid &&
            end
        do
            let block-index next-instruction valid do
                bytes length "block" module procedure block-index frog-cli-find-inspect-indexed-line
                let line line-length found do
                    if found do
                        line line-length next-instruction instruction-count block-count frog-cli-inspect-block-valid
                    else
                        next-instruction false
                    end
                    let next valid-block do
                        block-index 1 + next valid valid-block &&
                    end
                end
            end
        end
        let block-index next-instruction valid do
            valid next-instruction instruction-count == &&
        end
    end
end

proc frog-cli-inspect-procedure-base ptr int String int -- int int int bool do
    let bytes length name expected-block-count do
        bytes length name frog-cli-inspect-procedure-info
        let module procedure operation-count instruction-count block-count found do
            if found block-count expected-block-count == && do
                module procedure operation-count
                bytes length module procedure instruction-count block-count
                frog-cli-inspect-procedure-generic
            else
                module procedure operation-count false
            end
        end
    end
end

proc frog-cli-inspect-block-is ptr int int int int String -- bool do
    let bytes length module procedure block-index terminator do
        bytes length module procedure block-index 8 terminator frog-cli-inspect-block-field-equals
    end
end

proc frog-cli-inspect-block-types-are ptr int int int int String String -- bool do
