from "framework.frog" import ( FrogTestContext frog-check )
from "stdlib/string.frog" import bytes-equal
from "stdlib/subprocess.frog" import (
    CompletedProcess
    subprocess-argv subprocess-arg subprocess-arg-pointer subprocess-argv-free
    subprocess-run subprocess-run-bytes-in completed-process-free
)

proc frog-cli-argv-1 String FrogTestContext* -- ptr do
    let first context do
        2 subprocess-argv
        let arguments do
            context @FrogTestContext.compiler arguments 0 subprocess-arg-pointer
            first arguments 1 subprocess-arg
            arguments
        end
    end
end

proc frog-cli-argv-2 String String FrogTestContext* -- ptr do
    let first second context do
        3 subprocess-argv
        let arguments do
            context @FrogTestContext.compiler arguments 0 subprocess-arg-pointer
            first arguments 1 subprocess-arg
            second arguments 2 subprocess-arg
            arguments
        end
    end
end

proc frog-cli-argv-3 String String String FrogTestContext* -- ptr do
    let first second third context do
        4 subprocess-argv
        let arguments do
            context @FrogTestContext.compiler arguments 0 subprocess-arg-pointer
            first arguments 1 subprocess-arg
            second arguments 2 subprocess-arg
            third arguments 3 subprocess-arg
            arguments
        end
    end
end

proc frog-cli-argv-4 String String String String FrogTestContext* -- ptr do
    let first second third fourth context do
        5 subprocess-argv
        let arguments do
            context @FrogTestContext.compiler arguments 0 subprocess-arg-pointer
            first arguments 1 subprocess-arg
            second arguments 2 subprocess-arg
            third arguments 3 subprocess-arg
            fourth arguments 4 subprocess-arg
            arguments
        end
    end
end

proc frog-cli-argv-5 String String String String String FrogTestContext* -- ptr do
    let first second third fourth fifth context do
        6 subprocess-argv
        let arguments do
            context @FrogTestContext.compiler arguments 0 subprocess-arg-pointer
            first arguments 1 subprocess-arg
            second arguments 2 subprocess-arg
            third arguments 3 subprocess-arg
            fourth arguments 4 subprocess-arg
            fifth arguments 5 subprocess-arg
            arguments
        end
    end
end

proc frog-check-cli-process CompletedProcess* String String int String FrogTestContext* -- do
    let result expected-stdout expected-stderr expected-status name context do
        result @CompletedProcess.returncode expected-status ==
        result @CompletedProcess.stdout result @CompletedProcess.stdout_len
        expected-stdout String.bytes expected-stdout String.len bytes-equal &&
        result @CompletedProcess.stderr result @CompletedProcess.stderr_len
        expected-stderr String.bytes expected-stderr String.len bytes-equal &&
        name context frog-check
    end
end

proc frog-run-cli ptr String String int String FrogTestContext* -- do
    let arguments expected-stdout expected-stderr expected-status name context do
        arguments "" subprocess-run
        let result do
            result expected-stdout expected-stderr expected-status name context frog-check-cli-process
            result completed-process-free
            arguments subprocess-argv-free
        end
    end
end

proc frog-cli-case-1 String String String int String FrogTestContext* -- do
    let first expected-stdout expected-stderr expected-status name context do
        first context frog-cli-argv-1
        expected-stdout expected-stderr expected-status name context frog-run-cli
    end
end

proc frog-cli-case-2 String String String String int String FrogTestContext* -- do
    let first second expected-stdout expected-stderr expected-status name context do
        first second context frog-cli-argv-2
        expected-stdout expected-stderr expected-status name context frog-run-cli
    end
end

proc frog-cli-case-3 String String String String String int String FrogTestContext* -- do
    let first second third expected-stdout expected-stderr expected-status name context do
        first second third context frog-cli-argv-3
        expected-stdout expected-stderr expected-status name context frog-run-cli
    end
end

proc frog-cli-case-4 String String String String String String int String FrogTestContext* -- do
    let first second third fourth expected-stdout expected-stderr expected-status name context do
        first second third fourth context frog-cli-argv-4
        expected-stdout expected-stderr expected-status name context frog-run-cli
    end
end

proc frog-cli-case-5 String String String String String String String int String FrogTestContext* -- do
    let first second third fourth fifth expected-stdout expected-stderr expected-status name context do
        first second third fourth fifth context frog-cli-argv-5
        expected-stdout expected-stderr expected-status name context frog-run-cli
    end
end

proc frog-cli-filter-debug-invariant FrogTestContext* -- do
    let context do
        "proc main -- do 1 2 + print end
"
        "frogc: debug: +: before [int int]
frogc: debug: +: after [int]
frogc: debug: print: before [int]
frogc: debug: print: after []
"
        let source expected-debug do
            1 subprocess-argv
            let normal-arguments do
                context @FrogTestContext.compiler normal-arguments 0 subprocess-arg-pointer
                2 subprocess-argv
                let debug-arguments do
                    context @FrogTestContext.compiler debug-arguments 0 subprocess-arg-pointer
                    "--debug" debug-arguments 1 subprocess-arg
                    normal-arguments source String.bytes source String.len "" subprocess-run-bytes-in
                    debug-arguments source String.bytes source String.len "" subprocess-run-bytes-in
                    let normal-result debug-result do
                        normal-result @CompletedProcess.returncode 0 ==
                        normal-result @CompletedProcess.stderr_len 0 == &&
                        debug-result @CompletedProcess.returncode 0 == &&
                        normal-result @CompletedProcess.stdout normal-result @CompletedProcess.stdout_len
                        debug-result @CompletedProcess.stdout debug-result @CompletedProcess.stdout_len bytes-equal &&
                        debug-result @CompletedProcess.stderr debug-result @CompletedProcess.stderr_len
                        expected-debug String.bytes expected-debug String.len bytes-equal &&
                        "cli/debug-filter-invariant" context frog-check
                        normal-result completed-process-free
                        debug-result completed-process-free
                    end
                    debug-arguments subprocess-argv-free
                end
                normal-arguments subprocess-argv-free
            end
        end
    end
end

proc run-cli-cases FrogTestContext* -- do
    let context do
        "-h" "Usage:
  frogc [--debug] [--release] < source.frog > source.c
  frogc [--debug] [--release] <command> [options]

Commands:
  run [-c CODE | FILE]       compile and run Frog source
  build [-o FILE] [-r] FILE  compile Frog source to a binary

Options:
  --debug    trace compile-time type stacks to standard error
  --release  omit implicit builtin assertion calls
" "" 0 "cli/help-short" context frog-cli-case-1

        "--help" "Usage:
  frogc [--debug] [--release] < source.frog > source.c
  frogc [--debug] [--release] <command> [options]

Commands:
  run [-c CODE | FILE]       compile and run Frog source
  build [-o FILE] [-r] FILE  compile Frog source to a binary

Options:
  --debug    trace compile-time type stacks to standard error
  --release  omit implicit builtin assertion calls
" "" 0 "cli/help-long" context frog-cli-case-1

        "run" "-h" "Usage: frogc [--debug] [--release] run [-c CODE | FILE]
" "" 0 "cli/run-help" context frog-cli-case-2

        "build" "-h" "Usage: frogc [--debug] [--release] build [-o FILE] [-r] FILE
" "" 0 "cli/build-help" context frog-cli-case-2

        "run" "test/cases/cli/missing.frog" ""
        "frogc: unable to read source: test/cases/cli/missing.frog
" 1 "cli/run-missing" context frog-cli-case-2

        "--unknown" "" "frogc: unknown command: --unknown
Try `frogc --help`.
" 2 "cli/unknown-option" context frog-cli-case-1

        "unknown" "" "frogc: unknown command: unknown
Try `frogc --help`.
" 2 "cli/unknown-command" context frog-cli-case-1

        "run" "-c" "proc main -- do 42 print end" "42
" "" 0 "cli/run-code" context frog-cli-case-3

        "run" "-c" "proc main -- do false \"normal failure\" assert end" "" "normal failure
" 1 "cli/assert-normal" context frog-cli-case-3

        "--release" "run" "-c" "proc main -- do false \"ignored\" assert 42 print end" "42
" "" 0 "cli/release-implicit-assert" context frog-cli-case-4

        "--release" "run" "-c" "proc condition -- bool do 1 print false end proc message -- String do 2 print \"ignored\" end proc main -- do condition message assert 3 print end" "1
2
3
" "" 0 "cli/release-assert-operands" context frog-cli-case-4

        "--release" "run" "-c" "proc assert bool String -- do drop drop 7 print end proc main -- do false \"user\" assert end" "7
" "" 0 "cli/release-shadowed-assert" context frog-cli-case-4

        "--release" "run" "-c" "from \"stdlib/builtins.frog\" import assert as builtin-assert proc main -- do false \"explicit failure\" builtin-assert end" "" "explicit failure
" 1 "cli/release-explicit-assert" context frog-cli-case-4

        "--release" "run" "-c" "fn Check bool String -- end from \"stdlib/builtins.frog\" import assert as builtin-assert proc main -- do false \"reference failure\" Check:ref:builtin-assert Check:call end" "" "reference failure
" 1 "cli/release-assert-reference" context frog-cli-case-4

        "--release" "run" "-c" "proc assert int -- do drop end proc main -- do false \"ignored\" assert 8 print end" "8
" "" 0 "cli/release-unmatched-assert-overload" context frog-cli-case-4

        "--release" "run" "-c" "proc main -- do false 1 assert end" "" "<command>:1:25:
  proc main -- do false 1 assert end
                          ^^^^^^
error: assert: stack contract mismatch: expected [bool String], actual [bool int]
" 1 "cli/release-assert-contract" context frog-cli-case-4

        "--release" "--debug" "run" "-c" "proc main -- do false \"ignored\" assert end" "" "frogc: debug: assert: before [bool String]
frogc: debug: assert: after []
" 0 "cli/release-debug-order" context frog-cli-case-5

        "--debug" "--release" "run" "-c" "proc main -- do false \"ignored\" assert end" "" "frogc: debug: assert: before [bool String]
frogc: debug: assert: after []
" 0 "cli/debug-release-order" context frog-cli-case-5

        "run" "-c" "proc main -- do nope end" "" "<command>:1:17:
  proc main -- do nope end
                  ^^^^
error: unknown word: nope
" 1 "cli/run-code-diagnostic-path" context frog-cli-case-3

        "build" "-r" "test/cases/cli/build_run.frog" "42
" "" 0 "cli/build-run" context frog-cli-case-3

        "--debug" "run" "-c" "proc main -- do 1 2 + print end" "3
" "frogc: debug: +: before [int int]
frogc: debug: +: after [int]
frogc: debug: print: before [int]
frogc: debug: print: after []
" 0 "cli/debug-run-optimized" context frog-cli-case-4

        "--debug" "run" "-c" "proc main -- do 1 dup ? + print end" "2
" "frogc: debug: dup: before [int]
frogc: debug: dup: after [int int]
frogc: debug: ?: before [int int]
frogc: debug: ?: after [int int]
frogc: debug: +: before [int int]
frogc: debug: +: after [int]
frogc: debug: print: before [int]
frogc: debug: print: after []
" 0 "cli/debug-run-macro" context frog-cli-case-4

        "--debug" "run" "-c" "proc main -- do true 1 + end" "" "frogc: debug: +: before [bool int]
<command>:1:24:
  proc main -- do true 1 + end
                         ^
error: +: stack contract mismatch: expected [int int], actual [bool int]
" 1 "cli/debug-run-error" context frog-cli-case-4

        "--debug" "build" "-r" "test/cases/cli/build_run.frog" "42
" "frogc: debug: +: before [int int]
frogc: debug: +: after [int]
frogc: debug: print: before [int]
frogc: debug: print: after []
" 0 "cli/debug-build-run" context frog-cli-case-4

        context frog-cli-filter-debug-invariant
    end
end
