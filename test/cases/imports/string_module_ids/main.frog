from "function.frog" import text
from "direct_macros.frog" import direct_text
from "facade.frog" import reexport_text
from "stdlib/libc.frog" import putc

func emit_one String -- do
    String.bytes u8* cast @ int cast putc
end

func main -- do
    text emit_one
    direct_text emit_one
    reexport_text emit_one
    10 putc
end
