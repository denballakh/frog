from "stdlib/libc.frog" import alloc

proc main -- do
    7 i8 cast 3 i8 cast + int cast print
    1 u32 cast 3 u32 cast << int cast print
    2 u16 cast 3 u16 cast < print
    true false || print

    0 ptr cast 0 ptr cast == print
    0 ptr cast 0 + 0 ptr cast == print

    8 alloc ptr cast i32* cast
    let value do
        42 i32 cast value !
        value @ int cast print
    end

    8 alloc
    let value do
        value value ptr* cast !
        value ptr* cast @ value == print
    end

    0 u64 cast ~ 0 u64 cast ~ == print
end
