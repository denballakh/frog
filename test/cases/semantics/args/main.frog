from "stdlib/libc.frog" import putc

func pointer-bytes -- int do 8 end

func argument-at ptr int -- ptr do
    pointer-bytes * + ptr* cast @
end

func print-c-string ptr -- do
    while dup u8* cast @ int cast 0 != do
        dup u8* cast @ int cast putc
        1 +
    end
    drop
    10 putc
end

func main -- do
    args
    let argv argc do
        argc print
        argv 0 argument-at u8* cast @ int cast putc
        10 putc
        argv 1 argument-at print-c-string
        argv 2 argument-at print-c-string
    end
end
