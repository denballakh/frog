proc signed i8 i16 i32 i64 -- int do
    let a b c d do
        a int cast b int cast + c int cast + d int cast +
    end
end

proc unsigned u8 u16 u32 u64 -- int do
    let a b c d do
        a int cast b int cast + c int cast + d int cast +
    end
end

record Local
    value i16
    link Local*
end

proc typed-pointers i8* i8** Local* Local** -- do
    drop drop drop drop
end

proc main -- do
    -1 i8 cast 2 i16 cast 3 i32 cast 4 i64 cast signed print
    1 u8 cast 2 u16 cast 3 u32 cast 4 u64 cast unsigned print
    0 ptr cast i8* cast
      0 ptr cast i8** cast
        Local:alloc
          0 ptr cast Local** cast
    typed-pointers
end
