from "stdlib/libc.frog" import alloc

c-include system "stdlib.h" end
c-include local "test/cases/semantics/c_ffi/helper.h" end

c-call ffi-answer ffi_test_answer -- CInt end
c-call ffi-mix ffi_test_mix CInt CBool CPtr -- CInt end
c-call ffi-truth ffi_test_truth CInt -- CBool end
c-call ffi-identity ffi_test_identity CPtr -- CPtr end
c-call ffi-free free CPtr -- end
c-call ffi-answer-again ffi_test_answer -- CInt end
c-call legacy-p0 p0 -- CInt end

c-type CInt int "int" end
c-type CBool bool "int" end
c-type CPtr ptr "void *" end

proc main -- do
    ffi-answer print
    ffi-answer-again print
    legacy-p0 print
    8 alloc
    let memory do
        7 true memory ffi-mix print
        17 ffi-truth print
        0 ffi-truth print
        memory ffi-identity ffi-free
    end
end
