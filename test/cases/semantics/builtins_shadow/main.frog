from "fallbacks.frog" import exercise-builtins

func drop int -- int do 1 + end
macro swap let first second do first second end end
func assert bool String -- int do let condition message do 99 end end

func main -- do
    41 drop print

    7
    let dup do
        dup print
    end

    1 2 swap print print
    3 dup + print
    false "ignored" assert print
    exercise-builtins
end
