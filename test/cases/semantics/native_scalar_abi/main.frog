fn RefPair i8 bool -- i8 bool end
fn RefBool bool -- bool end

union NativeValue
    case flag bool
    case byte i8
    case address ptr
end

proc pair-int-bool int bool -- int bool do end
proc pair-bool-int bool int -- bool int do end
proc ref-pair i8 bool -- i8 bool do end
proc ref-bool bool -- bool do end

proc native-roundtrip int bool i8 i16 i32 i64 u8 u16 u32 u64 ptr i8* -- int bool i8 i16 i32 i64 u8 u16 u32 u64 ptr i8* do end

proc local-reuse bool -- do
    drop
    if true do
        1 i8 cast drop
    else
        true drop
    end
end

proc control i8 bool -- i8 bool do
    let value condition do
        if condition do value else value end
        true
    end
end

proc main -- do
    7 true pair-int-bool print print
    false 8 pair-bool-int print print
    9 i8 cast true RefPair:ref:ref-pair RefPair:call print int cast print

    10 i8 cast false control print int cast print
    true local-reuse
    false local-reuse

    true NativeValue:flag NativeValue.flag? print drop
    true NativeValue:flag NativeValue.flag print
    11 i8 cast NativeValue:byte NativeValue.byte int cast print
    0 ptr cast NativeValue:address NativeValue.address int cast 0 == print
    false RefBool:ref:ref-bool RefBool:call print
    true "assert must preserve native bool" assert

    1 true
    2 i8 cast 3 i16 cast 4 i32 cast 5 i64 cast
    6 u8 cast 7 u16 cast 8 u32 cast 9 u64 cast
    0 ptr cast 0 ptr cast i8* cast
    native-roundtrip
    drop drop drop drop drop drop drop drop drop drop drop drop
end
