macro opaque-flow
    if dup 0 > do 1 + else 1 - end
end

func straight -- int do
    1 2 +
end

func if-else -- int do
    if true do 10 else 20 end
end

func no-else -- int do
    30 if false do end
end

func empty-arms -- int do
    40 if true do else end
end

func elif-chain -- int do
    if false do 1 elif true do 2 else 3 end
end

func loop -- int do
    0 while dup 2 < do 1 + end
end

func nested -- int do
    0 while dup 2 < do
        if dup 0 == do 1 + else 2 + end
    end
end

func macro-flow int -- int do
    opaque-flow
end

func main -- do end
