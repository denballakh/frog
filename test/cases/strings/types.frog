record Holder
    value String
end

union MaybeString
    case none
    case some String
end

fn StringIdentity String -- String end

proc identity String -- String do end

proc main -- do
    "typed" identity String.len print

    Holder:alloc
    let holder do
        "field" holder !Holder.value
        holder @Holder.value String.len print
    end

    "union" MaybeString:some MaybeString.some String.len print
    "call" StringIdentity:ref:identity StringIdentity:call String.len print
end
