struct Holder
    value String
end

enum MaybeString
    case none
    case some String
end

fn StringIdentity String -- String end

func identity String -- String do end

func main -- do
    "typed" identity String.len print

    Holder:alloc
    let holder do
        "field" holder !Holder.value
        holder @Holder.value String.len print
    end

    "enum" MaybeString:some MaybeString.some String.len print
    "call" StringIdentity:ref:identity StringIdentity:call String.len print
end
