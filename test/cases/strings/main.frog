from "lib.frog" import ( shared shared-macro )

func main -- do
    "same" dup String.len
    let root root-length do
        shared dup String.len
        let imported imported-length do
            shared-macro dup String.len
            let macro-value macro-length do
                root-length imported-length == print
                root String.bytes int cast imported String.bytes int cast == print
                root-length macro-length == print
                root String.bytes int cast macro-value String.bytes int cast == print
            end
        end
    end

    "a" dup String.len
    let plain plain-length do
        "\x61" dup String.len
        let escaped escaped-length do
            plain-length escaped-length == print
            plain String.bytes int cast escaped String.bytes int cast == print
            98 u8 cast plain String.bytes u8* cast !
            escaped String.bytes u8* cast @ int cast print
        end
    end

    "\xB2\x39\x51\x9B\xF2\x9C\x09\x91" dup String.len
    let first-collision first-length do
        "\xEF\xEF\x6D\x6A\x8C\xFD\xCE\x4F" dup String.len
        let second-collision second-length do
            first-length second-length == print
            first-collision String.bytes int cast second-collision String.bytes int cast != print
            first-collision String.bytes u8* cast @ int cast print
            second-collision String.bytes u8* cast @ int cast print
        end
    end

    "A\"\\\n\0\xFF??/" dup String.len
    let value length do
        length print
        value String.bytes
        let bytes do
            bytes u8* cast @ int cast print
            bytes 1 + u8* cast @ int cast print
            bytes 2 + u8* cast @ int cast print
            bytes 3 + u8* cast @ int cast print
            bytes 4 + u8* cast @ int cast print
            bytes 5 + u8* cast @ int cast print
            bytes 6 + u8* cast @ int cast print
            bytes 7 + u8* cast @ int cast print
            bytes 8 + u8* cast @ int cast print
        end
    end

    "line one
// still string \"quoted\"" dup String.len
    let multiline multiline-length do
        multiline-length print
        multiline String.bytes
        let bytes do
            bytes 8 + u8* cast @ int cast print
            bytes 9 + u8* cast @ int cast print
            bytes 25 + u8* cast @ int cast print
            bytes 32 + u8* cast @ int cast print
        end
    end
end
