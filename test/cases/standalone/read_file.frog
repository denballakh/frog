from "../../../stdlib/libc.frog" import ( putc exit )

proc main -- do
    "README.md"
    let path do
        path String.bytes path String.len read-file
        let data length success do
            if success do
                data @u8 putc
                10 putc
                length 0 > print
            else
                1 exit
            end
        end
    end

    "frog-read-file-missing"
    let path do
        path String.bytes path String.len read-file
        let data length success do
            data drop
            length print
            success print
        end
    end

    0 ptr cast 0 read-file
    let data length success do
        data drop
        if length 0 == success ! && do
        else
            1 exit
        end
    end
end
