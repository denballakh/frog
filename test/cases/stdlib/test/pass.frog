from "stdlib/test.frog" import (
    TestSuite
    test-suite
    check
    check-int-equal
    check-bytes-equal
    check-string-equal
    test-finish
)

func main -- do
    test-suite
    let suite do
        true "boolean" suite check
        42 42 "integer" suite check-int-equal
        "frog" String.bytes 4 "frog" String.bytes 4 "bytes" suite check-bytes-equal
        "frog" "frog" "string" suite check-string-equal
        suite @TestSuite.checks 4 == "check count" assert
        suite @TestSuite.failures 0 == "failure count" assert
        suite test-finish
    end
end
