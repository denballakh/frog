from "stdlib/subprocess.frog" import ( CompletedProcess subprocess-argv subprocess-arg subprocess-arg-pointer subprocess-argv-free subprocess-run subprocess-run-in subprocess-run-bytes completed-process-free )
from "stdlib/libc.frog" import exit

func require bool -- do
    let condition do
        if condition do else 1 exit end
    end
end

func main -- do
    3 subprocess-argv
    let argv do
        "sh" argv 0 subprocess-arg
        "-c" argv 1 subprocess-arg
        "cat; printf err >&2; exit 7" argv 2 subprocess-arg
        argv "x" subprocess-run
        let result do
            result @CompletedProcess.returncode 7 == require
            result @CompletedProcess.stdout_len 1 == require
            result @CompletedProcess.stdout u8* cast @ int cast 120 == require
            result @CompletedProcess.stderr_len 3 == require
            result @CompletedProcess.stderr u8* cast @ int cast 101 == require
            result completed-process-free
        end
        argv subprocess-argv-free
    end

    3 subprocess-argv
    let argv do
        "sh" argv 0 subprocess-arg
        "-c" argv 1 subprocess-arg
        "cat" argv 2 subprocess-arg
        "\0\xFFx" let input do
            argv input String.bytes input String.len subprocess-run-bytes
            let result do
                result @CompletedProcess.returncode 0 == require
                result @CompletedProcess.stdout_len 3 == require
                result @CompletedProcess.stdout u8* cast @ int cast 0 == require
                result @CompletedProcess.stdout 1 + u8* cast @ int cast 255 == require
                result @CompletedProcess.stdout 2 + u8* cast @ int cast 120 == require
                result completed-process-free
            end
        end
        argv subprocess-argv-free
    end

    4 subprocess-argv
    let argv do
        "sh" argv 0 subprocess-arg
        "-c" argv 1 subprocess-arg
        "test -n \"$0\"" argv 2 subprocess-arg
        args drop ptr* cast @ argv 3 subprocess-arg-pointer
        argv "" subprocess-run
        let result do
            result @CompletedProcess.returncode 0 == require
            result completed-process-free
        end
        argv subprocess-argv-free
    end

    3 subprocess-argv
    let argv do
        "sh" argv 0 subprocess-arg
        "-c" argv 1 subprocess-arg
        "yes x | head -c 300" argv 2 subprocess-arg
        argv "" subprocess-run
        let result do
            result @CompletedProcess.stdout_len 300 == require
            result @CompletedProcess.stdout u8* cast @ int cast 120 == require
            result @CompletedProcess.stdout 299 + u8* cast @ int cast 10 == require
            result completed-process-free
        end
        argv subprocess-argv-free
    end

    3 subprocess-argv
    let argv do
        "sh" argv 0 subprocess-arg
        "-c" argv 1 subprocess-arg
        "test -f 01_simple.frog" argv 2 subprocess-arg
        argv "" "examples" subprocess-run-in
        let result do
            result @CompletedProcess.returncode 0 == require
            result completed-process-free
        end
        argv subprocess-argv-free
    end
end
