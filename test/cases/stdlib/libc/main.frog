from "stdlib/libc.frog" import (
    alloc free putc getc eputc exit ensure-directory
)

func require bool -- do
    let condition do
        if condition do else 1 exit end
    end
end

func main -- do
    8 alloc
    let bytes do
        65 u8 cast bytes u8* cast !
        bytes u8* cast @ int cast 65 == require
        bytes free
    end

    getc 0 1 - == require
    "." String.bytes ensure-directory 0 == require
    "README.md" String.bytes ensure-directory 0 < require
    65 putc
    69 eputc
    0 exit
end
