from "stdlib/string.frog" import (
    bytes-copy
    bytes-equal
    bytes-index-of
    bytes-contain
    bytes-starts-with
    bytes-count
    string-equal
    string-starts-with
    ByteBuffer
    byte-buffer-new
    byte-buffer-push
    byte-buffer-append-bytes
    byte-buffer-append-string
    byte-buffer-equal-string
    byte-buffer-free
)
from "stdlib/libc.frog" import ( alloc free exit )

func assert bool -- do
    let condition do
        if condition do else 1 exit end
    end
end

func main -- do
    "same" "same" string-equal assert
    "same" "different" string-equal ! assert
    "abcabc" String.bytes 6 "abc" String.bytes 3 bytes-index-of 0 == assert
    "abcabc" String.bytes 6 "cab" String.bytes 3 bytes-index-of 2 == assert
    "abcabc" String.bytes 6 "x" String.bytes 1 bytes-index-of 0 1 - == assert
    "abc" String.bytes 3 "" String.bytes 0 bytes-index-of 0 == assert
    "abc" String.bytes 3 "bc" String.bytes 2 bytes-contain assert
    "abc" String.bytes 3 "x" String.bytes 1 bytes-contain ! assert
    "abc" String.bytes 3 "ab" String.bytes 2 bytes-starts-with assert
    "abc" String.bytes 3 "bc" String.bytes 2 bytes-starts-with ! assert
    "abc" String.bytes 3 "" String.bytes 0 bytes-starts-with assert
    "short" "sho" string-starts-with assert
    "short" "longer" string-starts-with ! assert
    "aaaaa" String.bytes 5 "aa" String.bytes 2 bytes-count 2 == assert
    "abc" String.bytes 3 "" String.bytes 0 bytes-count 0 == assert

    3 alloc
    let copied do
        "abc" String.bytes copied 3 bytes-copy
        copied 3 "abc" String.bytes 3 bytes-equal assert
        copied free
    end

    0 byte-buffer-new
    let buffer do
        buffer @ByteBuffer.len 0 == assert
        buffer @ByteBuffer.capacity 0 == assert

        65 buffer byte-buffer-push
        66 buffer byte-buffer-push
        67 buffer byte-buffer-push
        "DE" String.bytes 2 buffer byte-buffer-append-bytes
        "FG" buffer byte-buffer-append-string

        buffer @ByteBuffer.len 7 == assert
        buffer @ByteBuffer.capacity 7 >= assert
        buffer "ABCDEFG" byte-buffer-equal-string assert
        buffer "ABD" byte-buffer-equal-string ! assert
        buffer @ByteBuffer.bytes 1 + u8* cast @ int cast 66 == assert
        buffer byte-buffer-free
    end
end
