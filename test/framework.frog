        end
    end
end

proc frog-inline-error-body String String int String FrogTestContext -- do
    let body expected-stderr expected-status name context do
        context frog-count-case
        "" body "" frog-inline-materialize
        let source do
            source @ByteBuffer.bytes source @ByteBuffer.len
            expected-stderr expected-status name context frog-inline-error-bytes
            source byte-buffer-free
        end
    end
end

proc frog-inline-run-source String String String String String int String FrogTestContext -- do
    let before body after expected-stdout expected-stderr expected-status name context do
        context frog-count-case
        before body after frog-inline-materialize
        let source do
            source @ByteBuffer.bytes source @ByteBuffer.len
            expected-stdout expected-stderr expected-status "" name context frog-inline-run-bytes
            source byte-buffer-free
        end
    end
end

proc frog-inline-run-source-program String String String String String int String String FrogTestContext -- do
    let before body after expected-stdout expected-stderr expected-status program name context do
        context frog-count-case
        before body after frog-inline-materialize
        let source do
