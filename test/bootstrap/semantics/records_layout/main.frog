proc node-value Node -- int do Node.value end

record Node
    next Node
    value int
    ready bool
    bytes int
end

proc main -- do
    Node:alloc
    let node do
        0 ptr cast Node cast node Node.next!
        41 node Node.value!
        true node Node.ready!
        7 node Node.bytes!
        node node-value print
        node Node.ready print
        node Node.next ptr cast int cast 0 == print
        Node:sizeof print
        node Node.bytes print
    end
end
