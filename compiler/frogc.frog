proc bytes-are-digits-from ptr int int -- bool do
    let bytes length start do
        start true
        while
            let index valid do
                index valid
                index length < valid &&
            end
        do
            let index valid do
                index 1 +
                valid bytes index byte-read is-digit &&
            end
        end
        let index valid do valid end
    end
end

proc generated-proc-symbol ptr int -- bool do
