proc constant-evaluator-top-type ConstantEvaluator* -- int do
    let evaluator do
        if evaluator @ConstantEvaluator.count 0 <= do evaluator "constant expression stack underflow" constant-fail end
        evaluator @ConstantEvaluator.values evaluator @ConstantEvaluator.count 1 - constant-value-at @ConstantValue.value_type
    end
