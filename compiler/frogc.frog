        elif cc @CompileContext.defining_module token-index "i8" token-equals do cc type-i8 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "i16" token-equals do cc type-i16 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "i32" token-equals do cc type-i32 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "i64" token-equals do cc type-i64 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "u8" token-equals do cc type-u8 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "u16" token-equals do cc type-u16 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "u32" token-equals do cc type-u32 compile-primitive-type-literal
