proc begin-analyzed-block CompileContext* ModuleContext* int -- int do
    let cc source-module token-start do
        if cc cfg-recording ! do 0 1 - else
            if cc @CompileContext.cfg_current_block 0 >= do "internal analyzed block already active" fail end
            cc compile-context-analysis
            let analysis do
                if analysis @ProcedureAnalysis.cfg_block_count analysis @ProcedureAnalysis.cfg_block_capacity == do
                    analysis grow-analyzed-blocks
                end
                analysis @ProcedureAnalysis.cfg_block_count
                let index do
                    analysis index analyzed-block-at
                    let block do
                        analysis @ProcedureAnalysis.instruction_count block !AnalyzedBlock.instruction_start
                        0 block !AnalyzedBlock.instruction_count
                        analysis cc @CompileContext.type_stack cc @CompileContext.type_count append-operation-types
                        block !AnalyzedBlock.entry_type_start
                        cc @CompileContext.type_count block !AnalyzedBlock.entry_type_count
                        0 1 - block !AnalyzedBlock.exit_type_start
                        0 block !AnalyzedBlock.exit_type_count
                        source-module block !AnalyzedBlock.source_module
                        token-start block !AnalyzedBlock.token_start
                        cc @CompileContext.current_expansion_id block !AnalyzedBlock.source_expansion_id
                        CFGTerminatorKind:unresolved block !AnalyzedBlock.terminator_kind
                        0 ptr cast ModuleContext* cast block !AnalyzedBlock.terminator_module
                        0 1 - block !AnalyzedBlock.terminator_token
                        0 1 - block !AnalyzedBlock.terminator_expansion_id
                        0 1 - block !AnalyzedBlock.first_target
                        0 1 - block !AnalyzedBlock.second_target
                        analysis @ProcedureAnalysis.cfg_block_count 1 + analysis !ProcedureAnalysis.cfg_block_count
                        index cc !CompileContext.cfg_current_block
                        index
                    end
                end
            end
        end
    end
