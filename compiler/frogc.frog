proc add-pooled-string Program* ptr int int int -- int do
    let program bytes length hash collision do
        program @Program.string_count
        let string-index do
            bytes program string-index string-at !StringPoolEntry.data
            length program string-index string-at !StringPoolEntry.length
            hash program string-index string-at !StringPoolEntry.hash
            collision program string-index string-at !StringPoolEntry.collision
            string-index 1 + program !Program.string_count
            string-index
        end
    end
end

proc intern-string-token Program* ModuleContext* int -- do
    let program ctx token do
        ctx token decoded-string-length
        peek length do alloc
            let bytes do
                ctx token 0 bytes 0 decode-string-copy-from
                bytes length hash-string-bytes
                let hash do
                    program bytes length hash find-pooled-string
                    let existing do
                        if existing 0 >= do
                            existing
                        else
                            program bytes length hash program hash count-string-hash add-pooled-string
                        end
                        ctx token token-at !TokenEntry.value
                    end
                end
            end
        end
    end
end

proc intern-module-strings Program* ModuleContext* -- do
    let program ctx do
        0
        while dup ctx @ModuleContext.token_count < do
            dup
            let token do
                if ctx token token-at @TokenEntry.kind token-string == do
                    program ctx token intern-string-token
                end
            end
            1 +
        end
        drop
    end
end

proc initialize-string-pool Program* -- do
    peek program do @Program.token_count 1 + StringPoolEntry:sizeof * alloc program !Program.strings
        0 program !Program.string_count
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            dup program swap intern-module-strings
            @ModuleContext.next_module
        end
        drop
    end
end

proc bytes-are-dot ptr int int -- bool do
    let bytes start length do
        if length 1 == do
            bytes start byte-read 46 ==
