proc compile-record-field ptr ptr int int bool -- bool do
    let cc bytes length separator setter do
        if separator 1 <= separator 1 + length >= || do
            false
        else
            cc @cc-scope-module bytes 1 + separator 1 - visible-record-definition
            let module record-index found do
                if found ! do
