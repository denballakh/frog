        ctx token-index "record" token-equals ||
        ctx token-index "union" token-equals ||
        ctx token-index "case" token-equals ||
        ctx token-index "fn" token-equals ||
        ctx token-index "--" token-equals ||
    end
end

proc c-identifier-suffix-valid ptr int int -- bool do
    let bytes length index do
        if index length >= do
            true
        elif bytes index byte-read is-c-identifier-byte do
            bytes length index 1 + c-identifier-suffix-valid
        else
            false
        end
    end
end

proc identifier-token ModuleContext* int -- bool do
    let ctx token-index do ctx token-index token-slice
        let bytes length do
