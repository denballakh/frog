proc compile-constant-values-from CompileContext* ModuleContext* int int -- do
    let cc module constant-index value-index do
        if value-index module constant-index constant-at @ConstantEntry.value_count < do
            module constant-index constant-at @ConstantEntry.values
            peek values do value-index constant-value-at @ConstantValue.value_type
                values value-index constant-value-at @ConstantValue.payload
                let value-type payload do
                    cc value-type type-push
                    if value-type type-is-integer value-type type-bool == || do
                        if value-type type-int == value-type type-bool == || do
                            cc payload emit-push-integer
                        else
                            if cc @CompileContext.emitting do
                                cc emit-indent cc emit-top-slot " = (" emit
                                cc @CompileContext.program value-type emit-c-value-type ")" emit
                                payload emit-integer ";" emit 10 putc
                            end
                        end
                    elif value-type type-string == do
                        cc payload emit-push-pooled-string
                    else
                        "internal unsupported constant value type" fail
                    end
                    cc module constant-index value-index 1 + compile-constant-values-from
                end
            end
        end
    end
end

proc compile-constant CompileContext* ModuleContext* int -- do
    peek cc module constant-index do
            cc OperationKind:constant module constant-index set-operation-target
        if cc @CompileContext.instruction_active do
            module constant-index constant-at @ConstantEntry.value_count cc active-typed-instruction !TypedInstruction.payload
        end
        0 compile-constant-values-from
    end
end

proc compile-macro CompileContext* int ModuleContext* int -- do
    let cc invocation-token module macro-index do
        if module macro-index macro-at @MacroEntry.expanding do
            cc "recursive macro expansion" fail-compile-word
        end
        true module macro-index macro-at !MacroEntry.expanding
        if cc @CompileContext.instruction_active do false cc !CompileContext.instruction_active end
        cc cc @CompileContext.defining_module invocation-token module macro-index begin-macro-expansion
        let expansion-id do
            if cc @CompileContext.operation_active do
                if cc active-analyzed-operation @AnalyzedOperation.root_expansion_id 0 < do
                    expansion-id cc active-analyzed-operation !AnalyzedOperation.root_expansion_id
                end
            end
            cc @CompileContext.defining_module
              cc @CompileContext.scope_module
            let previous-defining-module previous-scope-module do
                module cc !CompileContext.defining_module
                module cc !CompileContext.scope_module
                cc
                  module macro-index macro-at @MacroEntry.body_start
                    module macro-index macro-at @MacroEntry.body_end
                compile-body-range
                previous-defining-module cc !CompileContext.defining_module
                previous-scope-module cc !CompileContext.scope_module
            end
            cc expansion-id finish-macro-expansion
        end
        false module macro-index macro-at !MacroEntry.expanding
    end
end

proc compile-ordinary-word CompileContext* int -- do
    let cc token-index do
        if cc token-index cc-diagnostic-is-token do true cc !CompileContext.diagnostic_word end
        cc cc-debug-tracing
        cc token-index cc-diagnostic-is-token &&
        let trace do
            if trace do cc "before" emit-debug-word-stack end
            cc @CompileContext.scope_module cc @CompileContext.defining_module token-index find-scope-symbol
            let symbol-index do
                cc token-index token-resolves-to-macro
                let is-macro do
                    if is-macro do
                        cc @CompileContext.scope_module cc @CompileContext.defining_module token-index token-slice
                            visible-macro-definition
                        let macro-module macro-index found do
                            if found ! do "internal macro resolution failed" fail end
                            cc macro-module macro-index set-operation-macro
                            cc token-index macro-module macro-index compile-macro
                        end
                    elif cc token-index compile-type-word do
                    elif cc @CompileContext.program program-failed do
                    elif cc token-index compile-string-word do
                    elif cc @CompileContext.program program-failed do
                    elif cc token-index compile-record-word do
                    elif cc @CompileContext.program program-failed do
                    elif cc token-index compile-union-word do
                    elif cc @CompileContext.program program-failed do
                    elif cc token-index compile-function-word do
                    elif cc @CompileContext.program program-failed do
                    elif cc token-index compile-private-intrinsic do
                    elif cc @CompileContext.program program-failed do
                    else
                        cc token-index find-local
                        let local-index do
                            if local-index 0 >= do
                                cc token-index local-index compile-local-reference
                            else
                                if symbol-index 0 >= do
                                    if cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.kind ScopeKind:constant == do
                                        cc
                                          cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_module
                                            cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_index
                                        compile-constant
                                    elif cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.kind ScopeKind:procedure != do
                                        cc token-index fail-unknown-word
                                    else
                                        cc @CompileContext.defining_module token-index token-slice
                                        let bytes length do
                                            cc cc @CompileContext.scope_module bytes length visible-procedure-matches
                                            let proc-module proc-index count found do
                                                if
                                                    cc @CompileContext.scope_module ptr cast int cast
                                                      cc @CompileContext.program @Program.builtins_module ptr cast int cast
                                                    ==
                                                do
                                                    0 ptr cast ModuleContext* cast 0 1 - 0 false
                                                else
                                                    cc
                                                      cc @CompileContext.scope_module
                                                        cc @CompileContext.program @Program.builtins_module
                                                          bytes length
                                                          visible-builtin-procedure-matches
                                                end
                                                let builtin-module builtin-index builtin-count builtin-found do
                                                    count builtin-count +
                                                    let total-count do
                                                        if total-count 1 == do
                                                            if count 1 == do
                                                                cc token-index proc-module proc-index compile-procedure-call
                                                            else
                                                                cc token-index builtin-module builtin-index compile-implicit-builtin-call
                                                            end
                                                        elif total-count 1 > do
                                                            cc fail-ambiguous-procedure-call
                                                        else
                                                            if cc token-index compile-generic-pointer-memory ! do
                                                                cc
                                                                  token-index
                                                                    cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_module
                                                                      cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_index
                                                                compile-procedure-call
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                else
                                    if cc token-index compile-builtins-word ! do
                                        if cc @CompileContext.program program-failed do
                                        else
                                            if cc token-index compile-generic-pointer-memory ! do
                                                if cc @CompileContext.program program-failed do
                                                else
                                                    if cc token-index compile-memory-io-intrinsic ! do
                                                        cc token-index fail-unknown-word
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            if trace cc @CompileContext.program program-failed ! && do cc "after" emit-debug-word-stack end
        end
    end
end

proc compile-word-token CompileContext* int -- int do
    let cc token-index do
        if cc @CompileContext.defining_module token-index "if" token-equals do
            cc token-index compile-if token-index 1 +
        elif cc @CompileContext.defining_module token-index "while" token-equals do
            cc token-index compile-while token-index 1 +
        elif cc @CompileContext.defining_module token-index "do" token-equals do
            cc token-index compile-do token-index 1 +
        elif cc @CompileContext.defining_module token-index "else" token-equals do
            cc token-index compile-else token-index 1 +
        elif cc @CompileContext.defining_module token-index "elif" token-equals do
            cc token-index compile-elif token-index 1 +
        elif cc @CompileContext.defining_module token-index "end" token-equals do
            cc token-index compile-end token-index 1 +
        elif cc @CompileContext.defining_module token-index "let" token-equals do
            cc token-index compile-let
        elif cc @CompileContext.defining_module token-index "peek" token-equals do
            cc token-index compile-peek
        else
            cc token-index compile-ordinary-word
            token-index 1 +
        end
    end
end

proc compile-token-inner CompileContext* int -- int do
    let cc token-index do
        cc @CompileContext.defining_module token-index token-at @TokenEntry.kind
        let kind do
            if kind TokenKind:int == do
                cc OperationKind:literal type-int set-operation-type
                cc cc @CompileContext.defining_module token-index token-at @TokenEntry.value set-operation-payload
                cc type-int type-push
                cc @CompileContext.defining_module token-index token-at @TokenEntry.value cc swap emit-push-integer
                token-index 1 +
            elif kind TokenKind:bool == do
                cc OperationKind:literal type-bool set-operation-type
                cc cc @CompileContext.defining_module token-index token-at @TokenEntry.value set-operation-payload
                cc type-bool type-push
                cc @CompileContext.defining_module token-index token-at @TokenEntry.value cc swap emit-push-integer
                token-index 1 +
            elif kind TokenKind:char == do
                cc OperationKind:literal type-int set-operation-type
                cc cc @CompileContext.defining_module token-index token-at @TokenEntry.value set-operation-payload
                cc type-int type-push
                cc @CompileContext.defining_module token-index token-at @TokenEntry.value cc swap emit-push-integer
                token-index 1 +
            elif kind TokenKind:string == do
                cc OperationKind:literal type-string set-operation-type
                cc cc @CompileContext.defining_module token-index token-at @TokenEntry.value set-operation-payload
                cc type-string type-push
                cc token-index emit-push-string
                token-index 1 +
            elif kind TokenKind:word == do
                cc token-index compile-word-token
            else
                cc "unknown token kind" fail-compile-word
                token-index 1 +
            end
        end
    end
end

proc token-is-structured-word CompileContext* int -- bool do
    let cc token-index do
        if cc @CompileContext.defining_module token-index token-at @TokenEntry.kind TokenKind:word != do
            false
        else
            cc @CompileContext.defining_module token-index "if" token-equals
            cc @CompileContext.defining_module token-index "elif" token-equals ||
            cc @CompileContext.defining_module token-index "else" token-equals ||
            cc @CompileContext.defining_module token-index "while" token-equals ||
            cc @CompileContext.defining_module token-index "do" token-equals ||
            cc @CompileContext.defining_module token-index "end" token-equals ||
        end
    end
end

proc token-starts-typed-instruction CompileContext* int -- bool do
    let cc token-index do
        if cc token-index token-is-structured-word do false
        elif cc @CompileContext.defining_module token-index token-at @TokenEntry.kind TokenKind:word != do true
        elif
            cc @CompileContext.defining_module token-index "let" token-equals
            cc @CompileContext.defining_module token-index "peek" token-equals ||
        do false
        else cc token-index token-resolves-to-macro !
        end
    end
end

proc compile-token CompileContext* int -- int do
    let cc token-index do
        cc token-index record-compile-cursor-state drop
        if cc token-index token-is-structured-word do false else cc token-index begin-format-operation end
        let begin-format do
            cc @CompileContext.diagnostic_active
              cc @CompileContext.record_operations
              cc @CompileContext.operation_active ! &&
              cc @CompileContext.current_expansion_id 0 < &&
              cc token-index token-is-structured-word ! &&
            let was-active begin-operation do
                if begin-operation do cc token-index begin-analyzed-operation end
                if cc @CompileContext.instruction_active do
                    "internal leaked typed instruction before token: " emit-error
                    cc @CompileContext.defining_module token-index token-slice emit-error-bytes 10 eputc 1 exit
                end
                if was-active ! do
                    cc @CompileContext.defining_module cc !CompileContext.diagnostic_module
                    token-index cc !CompileContext.diagnostic_token
                    true cc !CompileContext.diagnostic_active
                    false cc !CompileContext.diagnostic_word
                end
                cc token-index token-starts-typed-instruction
                let begin-instruction do
                    if begin-instruction do cc token-index begin-typed-instruction end
                    cc token-index compile-token-inner
                    let next-token do
                        if was-active ! do false cc !CompileContext.diagnostic_active end
                        if cc @CompileContext.program program-failed do
                            false cc !CompileContext.instruction_active
                            false cc !CompileContext.operation_active
                        else
                            if cc @CompileContext.instruction_active do cc next-token finish-typed-instruction end
                            if begin-operation do cc next-token finish-analyzed-operation end
                            if begin-format do cc next-token finish-format-operation end
                        end
                        next-token
                    end
                end
            end
        end
    end
end

proc token-resolves-to-macro CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.scope_module cc @CompileContext.defining_module token-index token-slice
            visible-macro-definition
        let module index found do found end
    end
end

proc try-compile-constant-add CompileContext* int int -- bool do
    let cc token-index body-end do
        if token-index 2 + body-end >= do
            false
        elif
            cc @CompileContext.program @Program.record_format_operations
        do
            false
        elif
            cc @CompileContext.defining_module token-index token-at @TokenEntry.kind TokenKind:int ==
            cc @CompileContext.defining_module token-index 1 + token-at @TokenEntry.kind TokenKind:int == &&
            cc @CompileContext.defining_module token-index 2 + token-at @TokenEntry.kind TokenKind:word == &&
            cc @CompileContext.defining_module token-index 2 + "+" token-equals &&
            cc token-index 2 + token-resolves-to-macro ! &&
            cc @CompileContext.scope_module cc @CompileContext.defining_module token-index 2 + type-int type-int word-resolves-to-builtin-2 &&
        do
            cc @CompileContext.defining_module token-index token-at @TokenEntry.value
              cc @CompileContext.defining_module token-index 1 + token-at @TokenEntry.value
            let left right do
                if right 0 > do
                    left max-int right - <=
                elif right 0 < do
                    left min-int right - >=
                else
                    true
                end
                let fits do
                    if fits do
                        if cc cc-debug-tracing do false else
                            cc token-index record-constant-add-cursor-states
                            cc token-index 2 + record-constant-add-occurrence
                            cc @CompileContext.operation_active !
                            let begin-operation do
                                if begin-operation do cc token-index begin-analyzed-operation end
                                cc token-index begin-typed-instruction
                                cc OperationKind:literal type-int set-operation-type
                                cc left right + set-operation-payload
                                cc type-int type-push
                                cc token-index 3 + finish-typed-instruction
                                if begin-operation do cc token-index 3 + finish-analyzed-operation end
                            end
                            true
                        end
                    else
                        false
                    end
                end
            end
        else
            false
        end
    end
end

proc initialize-proc-inputs CompileContext* int -- do
    let cc input-index do
        if input-index cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.input_count < do
            cc @CompileContext.procedure_module
              cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.input_start
              input-index +
            type-at
            cc swap type-push
            cc input-index 1 + initialize-proc-inputs
        end
    end
end

proc outputs-match-from CompileContext* int -- bool do
    let cc output-index do
        if output-index cc @CompileContext.type_count >= do
            true
        else
            cc output-index type-at-depth
              cc @CompileContext.procedure_module
                cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.output_start
                output-index +
              type-at
            ==
            let matches do
                if matches do
                    cc output-index 1 + outputs-match-from
                else
                    false
                end
            end
        end
    end
end

proc fail-proc-output-contract CompileContext* -- do
    let cc do
        64 byte-buffer-new
        let message do
            cc @CompileContext.procedure_module @ModuleContext.source
            cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.name_start +
              cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.name_length
            message byte-buffer-append-bytes
            ": procedure output contract mismatch: expected " message byte-buffer-append-string
            cc @CompileContext.program cc @CompileContext.procedure_module cc @CompileContext.procedure_index message append-proc-outputs
            ", actual " message byte-buffer-append-string
            cc @CompileContext.program cc @CompileContext.type_stack 0 cc @CompileContext.type_count message append-type-array
            cc DiagnosticCode:type_error message finish-compile-diagnostic
        end
    end
end

proc require-proc-outputs CompileContext* -- do
    let cc do
        if cc @CompileContext.type_count cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.output_count != do
            cc fail-proc-output-contract
        end
        if cc @CompileContext.program program-failed ! cc 0 outputs-match-from ! && do
            cc fail-proc-output-contract
        end
    end
end

proc compile-body-range CompileContext* int int -- do
    let cc token-index body-end do
        token-index
        while peek current do current body-end < cc @CompileContext.program program-failed ! && end do
            let current-token do
                if cc current-token body-end try-compile-constant-add do
                    current-token 3 +
                else
                    cc current-token compile-token
                end
            end
        end
        drop
        if cc @CompileContext.program program-failed ! do
            cc body-end record-compile-cursor-state drop
        end
    end
end

proc create-compile-context Program* ModuleContext* int -- CompileContext* do
    let program ctx proc-index do
        CompileContext:alloc
        let cc do
            program cc !CompileContext.program
            ctx cc !CompileContext.procedure_module
            ctx cc !CompileContext.defining_module
            ctx cc !CompileContext.scope_module
            proc-index cc !CompileContext.procedure_index
            16 cell-bytes * alloc cc !CompileContext.type_stack
            16 cc !CompileContext.type_capacity
            0 cc !CompileContext.type_count
            16 BlockFrame:sizeof * alloc cc !CompileContext.blocks
            0 cc !CompileContext.block_count
            16 cc !CompileContext.block_capacity
            16 LocalEntry:sizeof * alloc cc !CompileContext.locals
            0 cc !CompileContext.local_count
            16 cc !CompileContext.local_capacity
            0 cc !CompileContext.next_local
            0 cc !CompileContext.indent
            false cc !CompileContext.emitting
            0 cc !CompileContext.max_type_count
            16 StackSlotEntry:sizeof * alloc cc !CompileContext.stack_slots
            0 cc !CompileContext.stack_slot_count
            16 cc !CompileContext.stack_slot_capacity
            false cc !CompileContext.diagnostic_active
            false cc !CompileContext.diagnostic_word
            false cc !CompileContext.record_operations
            false cc !CompileContext.operation_active
            0 cc !CompileContext.operation_minimum_type_count
            false cc !CompileContext.operation_identity_set
            false cc !CompileContext.operation_identity_locked
            false cc !CompileContext.operation_binding_active
            0 1 - cc !CompileContext.current_expansion_id
            false cc !CompileContext.instruction_active
            0 cc !CompileContext.instruction_minimum_type_count
            0 1 - cc !CompileContext.cfg_current_block
            0 1 - cc !CompileContext.current_cursor_state
            16 FormatOperationFrame:sizeof * alloc cc !CompileContext.format_operation_frames
            0 cc !CompileContext.format_operation_frame_count
            16 cc !CompileContext.format_operation_frame_capacity
            cc
        end
    end
end

proc emit-ffi-argument-name int -- do
    emit-proc-argument-name
end

proc emit-c-signature-type-name ModuleContext* int -- do
    let ctx type-index do
        ctx type-index c-signature-type-at let signature do
            signature @CSignatureType.definition_module signature @CSignatureType.definition_index emit-c-type-spelling
        end
    end
end

proc emit-c-binding-arguments ModuleContext* int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index procedure-at @ProcedureEntry.input_count < do
            if input-index 0 != do ", " emit end
            ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + type-at
            let value-type do
                "(" emit ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + emit-c-signature-type-name
                if value-type type-is-integer do ")" emit input-index emit-ffi-argument-name
                elif value-type type-bool == do ")(" emit input-index emit-ffi-argument-name " != 0)" emit
                elif value-type type-ptr == value-type type-is-typed-pointer || do ")(uintptr_t)" emit input-index emit-ffi-argument-name
                else ")(intptr_t)" emit input-index emit-ffi-argument-name end
            end
            ctx proc-index input-index 1 + emit-c-binding-arguments
        end
    end
end

proc emit-c-binding-expression ModuleContext* int -- do
    peek ctx proc-index do emit-c-symbol
        if ctx proc-index procedure-at @ProcedureEntry.c_binding CBinding:call == do
            "(" emit ctx proc-index 0 emit-c-binding-arguments ")" emit
        end
    end
end

proc compile-c-binding-procedure ModuleContext* int -- do
    peek ctx proc-index do emit-proc-signature " {\n" emit
        if ctx proc-index procedure-at @ProcedureEntry.output_count 0 == do
            "  " emit ctx proc-index emit-c-binding-expression ";\n" emit
        else
            ctx ctx proc-index procedure-at @ProcedureEntry.output_start type-at let value-type do
                "  return " emit
                if value-type type-is-integer do
                    "(" emit ctx @ModuleContext.program value-type emit-c-value-type ")(" emit
                    ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit
                    ctx proc-index emit-c-binding-expression ");\n" emit
                elif value-type type-bool == do "(bool)((" emit ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit ctx proc-index emit-c-binding-expression ") != 0);\n" emit
                elif value-type type-ptr == value-type type-is-typed-pointer || do
                    "(" emit ctx @ModuleContext.program value-type emit-c-value-type ")(uintptr_t)(" emit
                    ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit
                    ctx proc-index emit-c-binding-expression ");\n" emit
                else "(Cell)(intptr_t)(" emit ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit ctx proc-index emit-c-binding-expression ");\n" emit end
            end
        end
        "}\n" emit
    end
end

proc validate-compiled-procedure CompileContext* -- do
    let cc do
        if cc @CompileContext.program program-failed do
        elif cc @CompileContext.block_count 0 != do
            cc "unclosed control-flow block" fail-compile-word
        end
        if cc @CompileContext.local_count 0 != do
            cc "unclosed local scope" fail-compile-word
        end
        cc require-proc-outputs
    end
end

proc compile-procedure-body CompileContext* ModuleContext* int -- do
    let cc ctx proc-index do
        cc 0 initialize-proc-inputs
        cc ctx ctx proc-index procedure-at @ProcedureEntry.body_start begin-analyzed-block drop
        cc
          ctx proc-index procedure-at @ProcedureEntry.body_start
            ctx proc-index procedure-at @ProcedureEntry.body_end
        compile-body-range
        if cc @CompileContext.program program-failed ! do
            ctx cc !CompileContext.diagnostic_module
            ctx proc-index procedure-at @ProcedureEntry.body_end cc !CompileContext.diagnostic_token
            true cc !CompileContext.diagnostic_active
            false cc !CompileContext.diagnostic_word
            cc validate-compiled-procedure
            if cc @CompileContext.program program-failed ! do
                cc ctx ctx proc-index procedure-at @ProcedureEntry.body_end CFGTerminatorKind:return 0 1 - 0 1 - finish-analyzed-block drop
            end
            false cc !CompileContext.diagnostic_active
        end
    end
end

proc emit-proc-input-slots CompileContext* ModuleContext* int int -- do
    let cc ctx proc-index input-index do
        if input-index ctx proc-index procedure-at @ProcedureEntry.input_count < do
            cc emit-indent cc input-index
                ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + type-at
            emit-slot-as " = frog_arg_" emit input-index emit-unsigned ";" emit 10 putc
            cc ctx proc-index input-index 1 + emit-proc-input-slots
        end
    end
end

proc emit-proc-slot-frame CompileContext* -- do
    let cc do 0
        while dup cc @CompileContext.stack_slot_count < do
            dup let index do cc index stack-slot-at let slot do
                    cc emit-indent cc @CompileContext.program slot @StackSlotEntry.value_type emit-c-value-type
                    " " emit cc slot @StackSlotEntry.depth slot @StackSlotEntry.value_type emit-slot-as ";" emit 10 putc
                    cc emit-indent "(void)&" emit cc slot @StackSlotEntry.depth slot @StackSlotEntry.value_type emit-slot-as ";" emit 10 putc
                end end
            1 +
        end
        drop
    end
end

proc emit-proc-return-values CompileContext* int -- do
    let cc remaining do
        if remaining 0 > do
            remaining 1 -
            let output-index do
                cc emit-indent "frog_result.value_" emit output-index emit-unsigned " = " emit
                cc output-index cc output-index type-at-depth emit-slot-as ";" emit 10 putc
                cc output-index emit-proc-return-values
            end
        end
    end
end

proc emit-proc-return CompileContext* ModuleContext* int -- do
    let cc ctx proc-index do
        ctx proc-index procedure-at @ProcedureEntry.output_count
        let output-count do
            if output-count 1 == do
                cc emit-indent "return " emit cc 0
                    ctx ctx proc-index procedure-at @ProcedureEntry.output_start type-at
                emit-slot-as ";" emit 10 putc
            elif output-count 1 > do
                cc emit-indent
                ctx @ModuleContext.types ctx proc-index procedure-at @ProcedureEntry.output_start cell-bytes * +
                output-count emit-result-type-name " frog_result;" emit 10 putc
                cc output-count emit-proc-return-values
                cc emit-indent "return frog_result;" emit 10 putc
            end
        end
    end
end

proc emit-ir-instruction CompileContext* ProcedureAnalysis* TypedInstruction* -- do
    let cc analysis instruction do
        instruction @TypedInstruction.source_module cc !CompileContext.diagnostic_module
        instruction @TypedInstruction.token_start cc !CompileContext.diagnostic_token
        true cc !CompileContext.diagnostic_active
        cc analysis instruction load-ir-before-types
        instruction @TypedInstruction.operation
        let operation do
            if operation RuntimeOperation.literal? operation RuntimeOperation.type_literal? || operation RuntimeOperation.function_reference? || do
                instruction @TypedInstruction.after_type_count 1 - let index do
                    cc emit-indent cc index
                        analysis @ProcedureAnalysis.operation_types instruction @TypedInstruction.after_type_start index + cell-bytes * field-read
                    emit-slot-as " = " emit
                    if instruction @TypedInstruction.value_type type-string == do
                        cc @CompileContext.program instruction @TypedInstruction.payload emit-string-symbol
                    else instruction @TypedInstruction.payload emit-integer end
                    ";" emit 10 putc
                end
            elif operation RuntimeOperation.local_load? do
                instruction @TypedInstruction.after_type_count 1 - let index do
                    cc emit-indent cc index instruction @TypedInstruction.value_type emit-slot-as " = " emit
                    instruction @TypedInstruction.local_id emit-local-name ";" emit 10 putc
                end
            elif operation RuntimeOperation.constant? do
                cc instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index 0 compile-constant-values-from
            elif operation RuntimeOperation.procedure_call? do
                if cc @CompileContext.program @Program.release instruction @TypedInstruction.payload 0 != && do
                else
                    cc analysis instruction load-ir-after-types
                    cc instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index emit-call
                end
            elif operation RuntimeOperation.bind_locals? do cc analysis instruction emit-ir-bind-locals
            elif operation RuntimeOperation.restore_peek_locals? do cc analysis instruction emit-ir-restore-peek-locals
            elif operation RuntimeOperation.record_new? do
                instruction @TypedInstruction.after_type_count cc !CompileContext.type_count
                cc instruction @TypedInstruction.payload emit-record-zero-value
            elif operation RuntimeOperation.record_alloc? do
                instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index record-type-at @RecordTypeEntry.record_type
                let record-type do
                    instruction @TypedInstruction.after_type_count cc !CompileContext.type_count
                    cc record-type instruction @TypedInstruction.payload emit-record-allocation
                end
            elif operation RuntimeOperation.record_sizeof? do
                instruction @TypedInstruction.after_type_count cc !CompileContext.type_count
                cc instruction @TypedInstruction.payload emit-record-sizeof
            elif operation RuntimeOperation.record_field_read? operation RuntimeOperation.record_field_write? || do cc instruction emit-ir-record-field
            elif operation RuntimeOperation.union_construct? operation RuntimeOperation.union_test? || operation RuntimeOperation.union_project? || do
                cc analysis instruction load-ir-after-types
                cc instruction emit-ir-union
            elif operation RuntimeOperation.function_call? do
                cc analysis instruction load-ir-after-types
                cc instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index emit-function-call
            elif operation RuntimeOperation.private_intrinsic? do cc instruction emit-ir-private-instruction
            elif operation RuntimeOperation.cast? do cc instruction emit-ir-cast
            elif
                operation RuntimeOperation.args?
                operation RuntimeOperation.print? ||
                operation RuntimeOperation.noop? ||
                operation RuntimeOperation.string_bytes? ||
                operation RuntimeOperation.string_len? ||
                operation RuntimeOperation.pointer_load? ||
                operation RuntimeOperation.pointer_store? ||
                operation RuntimeOperation.assert_fail? ||
            do cc instruction emit-ir-simple-intrinsic
            else "internal unsupported typed instruction emission" fail end
        end
    end
end

proc emit-ir-block CompileContext* ProcedureAnalysis* int -- do
    let cc analysis block-index do
        analysis block-index analyzed-block-at
        let block do
            if block-index 0 > do "frog_block_" emit block-index emit-unsigned ": ;" emit 10 putc end
            0
            while dup block @AnalyzedBlock.instruction_count < do
                dup let offset do cc analysis analysis block @AnalyzedBlock.instruction_start offset + typed-instruction-at emit-ir-instruction end
                1 +
            end
            drop
            cc analysis block load-ir-block-exit-types
            block @AnalyzedBlock.terminator_kind
            let terminator do
                if terminator CFGTerminatorKind.jump? do
                    cc emit-indent "goto frog_block_" emit block @AnalyzedBlock.first_target emit-unsigned ";" emit 10 putc
                elif terminator CFGTerminatorKind.branch? do
                    block @AnalyzedBlock.exit_type_count 1 - let condition-index do
                        cc emit-indent "if (" emit cc condition-index type-bool emit-slot-as ") goto frog_block_" emit
                        block @AnalyzedBlock.first_target emit-unsigned "; else goto frog_block_" emit
                        block @AnalyzedBlock.second_target emit-unsigned ";" emit 10 putc
                    end
                else
                    cc cc @CompileContext.procedure_module cc @CompileContext.procedure_index emit-proc-return
                    if cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.output_count 0 == do
                        cc emit-indent "return;" emit 10 putc
                    end
                end
            end
        end
    end
end

proc emit-ir-procedure-body CompileContext* ProcedureAnalysis* -- do
    let cc analysis do
        0 while dup analysis @ProcedureAnalysis.cfg_block_count < do
            dup let block-index do cc analysis block-index emit-ir-block end
            1 +
        end drop
    end
end

proc finish-procedure-analysis Program* ModuleContext* int CompileContext* -- do
    let program ctx proc-index measurement do
        if measurement @CompileContext.operation_active do
            "internal unclosed analyzed operation" fail
        end
        if measurement @CompileContext.format_operation_frame_count 0 != do
            "internal unclosed formatter operation" fail
        end
        ctx proc-index procedure-at @ProcedureEntry.analysis
        let analysis do
            measurement @CompileContext.max_type_count analysis !ProcedureAnalysis.max_type_count
            measurement @CompileContext.stack_slots analysis !ProcedureAnalysis.stack_slots
            measurement @CompileContext.stack_slot_count analysis !ProcedureAnalysis.stack_slot_count
            measurement @CompileContext.stack_slot_capacity analysis !ProcedureAnalysis.stack_slot_capacity
            analysis verify-typed-instructions
            analysis verify-macro-expansions
            ctx proc-index analysis verify-procedure-cfg
        end
    end
end

proc analyze-procedure Program* ModuleContext* int -- do
    let program ctx proc-index do
        if ctx proc-index procedure-at @ProcedureEntry.c_binding CBinding:none == do
            ctx proc-index procedure-at @ProcedureEntry.analysis
            let analysis do
                analysis reset-procedure-operations
            end
            program ctx proc-index create-compile-context
            let measurement do
                true measurement !CompileContext.record_operations
                measurement ctx proc-index compile-procedure-body
                if program program-failed ! do program ctx proc-index measurement finish-procedure-analysis end
            end
        end
    end
end

proc emit-procedure Program* ModuleContext* int -- do
    let program ctx proc-index do
        if ctx proc-index procedure-at @ProcedureEntry.c_binding CBinding:none == do
            ctx proc-index procedure-at @ProcedureEntry.analysis
            let analysis do
                program ctx proc-index create-compile-context
                let cc do
                    true cc !CompileContext.emitting
                    analysis @ProcedureAnalysis.max_type_count cc !CompileContext.max_type_count
                    analysis @ProcedureAnalysis.stack_slots cc !CompileContext.stack_slots
                    analysis @ProcedureAnalysis.stack_slot_count cc !CompileContext.stack_slot_count
                    analysis @ProcedureAnalysis.stack_slot_capacity cc !CompileContext.stack_slot_capacity
                    ctx proc-index emit-proc-signature " {" emit 10 putc
                    1 cc !CompileContext.indent
                    cc emit-proc-slot-frame
                    cc ctx proc-index 0 emit-proc-input-slots
                    cc analysis emit-ir-procedure-body
                    "}" emit 10 putc
                end
            end
        end
    end
end

proc emit-module-c-bindings ModuleContext* -- do
    let ctx do
        0
        while dup ctx @ModuleContext.proc_count < do
            dup let proc-index do
                if ctx proc-index procedure-at @ProcedureEntry.c_binding CBinding:none != do
                    ctx proc-index compile-c-binding-procedure
                end
            end
            1 +
        end
        drop
    end
end

proc emit-all-c-bindings Program* -- do
    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup emit-module-c-bindings
            @ModuleContext.next_module
        end
        drop
    end
end

proc analyze-module-procedures Program* ModuleContext* -- do
    let program ctx do
        0
        while peek index do index ctx @ModuleContext.proc_count < program program-failed ! && end do
            dup program ctx rot analyze-procedure
            1 +
        end
        drop
    end
end

proc program-owns-module Program* ModuleContext* -- bool do
    let program module do
        if module ptr cast int cast 0 == do
            false
        else
            module @ModuleContext.program ptr cast int cast program ptr cast int cast ==
        end
    end
end

proc verify-cursor-owner Program* CursorOwnerKind ModuleContext* int int -- do
    let program kind module index expansion-id do
        if kind CursorOwnerKind.none? do
            if
                module ptr cast int cast 0 !=
                index 0 1 - != ||
                expansion-id 0 1 - != ||
            do
                "internal invalid module cursor owner" fail
            end
        elif kind CursorOwnerKind.procedure? do
            if program module program-owns-module ! do "internal invalid procedure cursor module" fail end
            if index 0 < index module @ModuleContext.proc_count >= || do "internal invalid procedure cursor owner" fail end
            module index procedure-at @ProcedureEntry.analysis
            let analysis do
                if analysis ptr cast int cast 0 == do "internal missing procedure cursor analysis" fail end
                if expansion-id 0 1 - < expansion-id analysis @ProcedureAnalysis.macro_expansion_count >= || do
                    "internal invalid procedure cursor expansion" fail
                end
            end
        elif kind CursorOwnerKind.constant? do
            if program module program-owns-module ! do "internal invalid constant cursor module" fail end
            if index 0 < index module @ModuleContext.constant_count >= || expansion-id 0 1 - != || do
                "internal invalid constant cursor owner" fail
            end
        else
            "internal unknown cursor owner kind" fail
        end
    end
end

proc verify-semantic-identity Program* SemanticOccurrence* -- do
    let program occurrence do
        occurrence @SemanticOccurrence.semantic_class
        let semantic-class do
            occurrence @SemanticOccurrence.identity_module
            let module do
                occurrence @SemanticOccurrence.identity_index
                  occurrence @SemanticOccurrence.identity_subindex
                let index subindex do
                    if semantic-class SemanticClass.procedure? do
                        if program module program-owns-module ! do "internal invalid procedure occurrence module" fail end
                        if index 0 < index module @ModuleContext.proc_count >= || subindex 0 1 - != || do
                            "internal invalid procedure occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.macro_symbol? do
                        if program module program-owns-module ! do "internal invalid macro occurrence module" fail end
                        if index 0 < index module @ModuleContext.macro_count >= || subindex 0 1 - != || do
                            "internal invalid macro occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.constant? do
                        if program module program-owns-module ! do "internal invalid constant occurrence module" fail end
                        if index 0 < index module @ModuleContext.constant_count >= || subindex 0 1 - != || do
                            "internal invalid constant occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.local? do
                        if program module program-owns-module ! do "internal invalid local occurrence module" fail end
                        if index 0 < index module @ModuleContext.proc_count >= || subindex 0 < || do
                            "internal invalid local occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.record_type? do
                        if program module program-owns-module ! do "internal invalid record occurrence module" fail end
                        if index 0 < index module @ModuleContext.record_count >= || subindex 0 1 - != || do
                            "internal invalid record occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.record_field? do
                        if program module program-owns-module ! do "internal invalid record field occurrence module" fail end
                        if index 0 < index module @ModuleContext.record_count >= || do
                            "internal invalid record field owner identity" fail
                        end
                        if
                            subindex module index record-type-at @RecordTypeEntry.field_start <
                            subindex module index record-type-at @RecordTypeEntry.field_start module index record-type-at @RecordTypeEntry.field_count + >= ||
                        do
                            "internal invalid record field occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.union_type? do
                        if program module program-owns-module ! do "internal invalid union occurrence module" fail end
                        if index 0 < index module @ModuleContext.union_count >= || subindex 0 1 - != || do
                            "internal invalid union occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.union_case? do
                        if program module program-owns-module ! do "internal invalid union case occurrence module" fail end
                        if index 0 < index module @ModuleContext.union_count >= || do
                            "internal invalid union case owner identity" fail
                        end
                        if
                            subindex module index union-type-at @UnionTypeEntry.case_start <
                            subindex module index union-type-at @UnionTypeEntry.case_start module index union-type-at @UnionTypeEntry.case_count + >= ||
                        do
                            "internal invalid union case occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.function_type? do
                        if program module program-owns-module ! do "internal invalid function occurrence module" fail end
                        if index 0 < index module @ModuleContext.function_count >= || subindex 0 1 - != || do
                            "internal invalid function occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.c_type? do
                        if program module program-owns-module ! do "internal invalid C type occurrence module" fail end
                        if index 0 < index module @ModuleContext.c_type_count >= || subindex 0 1 - != || do
                            "internal invalid C type occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.primitive_type? do
                        if module ptr cast int cast 0 != index 0 <= || subindex 0 1 - != || do
                            "internal invalid primitive occurrence identity" fail
                        end
                    elif semantic-class SemanticClass.intrinsic? do
                        if module ptr cast int cast 0 != index 0 1 - != || subindex 0 1 - != || do
                            "internal invalid intrinsic occurrence identity" fail
                        end
                    else
                        "internal unknown semantic occurrence class" fail
                    end
                end
            end
        end
    end
end

proc semantic-class-matches-scope-kind SemanticClass ScopeKind -- bool do
    let semantic-class kind do
        semantic-class SemanticClass.procedure? kind ScopeKind:procedure == &&
        semantic-class SemanticClass.macro_symbol? kind ScopeKind:macro_symbol == && ||
        semantic-class SemanticClass.constant? kind ScopeKind:constant == && ||
        semantic-class SemanticClass.record_type? kind ScopeKind:record_type == && ||
        semantic-class SemanticClass.union_type? kind ScopeKind:union_type == && ||
        semantic-class SemanticClass.function_type? kind ScopeKind:function_type == && ||
        semantic-class SemanticClass.c_type? kind ScopeKind:c_type == && ||
    end
end

proc verify-occurrence-binding Program* SemanticOccurrence* -- do
    let program occurrence do
        occurrence @SemanticOccurrence.binding_module
          occurrence @SemanticOccurrence.binding_scope_index
        let module scope-index do
            if module ptr cast int cast 0 == do
                if scope-index 0 1 - != do "internal occurrence has a binding index without a module" fail end
            else
                if program module program-owns-module ! do "internal invalid occurrence binding module" fail end
                if scope-index 0 < scope-index module @ModuleContext.scope_count >= || do
                    "internal invalid occurrence binding" fail
                end
                module scope-index scope-at
                let symbol do
                    if occurrence @SemanticOccurrence.semantic_class symbol @ScopeEntry.kind semantic-class-matches-scope-kind ! do
                        "internal occurrence binding kind mismatch" fail
                    end
                    if
                        symbol @ScopeEntry.definition_module ptr cast int cast
                        occurrence @SemanticOccurrence.identity_module ptr cast int cast !=
                        symbol @ScopeEntry.definition_index occurrence @SemanticOccurrence.identity_index != ||
                    do
                        "internal occurrence binding identity mismatch" fail
                    end
                end
            end
        end
    end
end

proc verify-semantic-occurrence Program* int -- do
    let program occurrence-index do
        program occurrence-index semantic-occurrence-at
        let occurrence do
            if program occurrence @SemanticOccurrence.source_module program-owns-module ! do
                "internal semantic occurrence source is invalid" fail
            end
            if
                occurrence @SemanticOccurrence.start_byte 0 <
                occurrence @SemanticOccurrence.end_byte occurrence @SemanticOccurrence.start_byte <= ||
                occurrence @SemanticOccurrence.end_byte occurrence @SemanticOccurrence.source_module @ModuleContext.source_length > ||
            do
                "internal semantic occurrence span is invalid" fail
            end
            program occurrence @SemanticOccurrence.owner_kind occurrence @SemanticOccurrence.owner_module
            occurrence @SemanticOccurrence.owner_index occurrence @SemanticOccurrence.expansion_id verify-cursor-owner
            occurrence @SemanticOccurrence.state_index
            let state-index do
                if state-index 0 1 - < state-index program @Program.cursor_state_count >= || do
                    "internal semantic occurrence state is invalid" fail
                end
                if state-index 0 >= do
                    program state-index cursor-state-at
                    let state do
                        if
                            state @CursorState.owner_module ptr cast int cast occurrence @SemanticOccurrence.owner_module ptr cast int cast !=
                            state @CursorState.owner_index occurrence @SemanticOccurrence.owner_index != ||
                            state @CursorState.expansion_id occurrence @SemanticOccurrence.expansion_id != ||
                            state @CursorState.source_module ptr cast int cast occurrence @SemanticOccurrence.source_module ptr cast int cast != ||
                        do
                            "internal semantic occurrence state owner mismatch" fail
                        end
                    end
                end
            end
            program occurrence verify-semantic-identity
            program occurrence verify-occurrence-binding
        end
    end
end

proc verify-cursor-state Program* int -- do
    let program state-index do
        program state-index cursor-state-at
        let state do
            if state @CursorState.owner_kind CursorOwnerKind.none? do
                "internal cursor state has no owner" fail
            end
            program state @CursorState.owner_kind state @CursorState.owner_module state @CursorState.owner_index
            state @CursorState.expansion_id verify-cursor-owner
            if program state @CursorState.source_module program-owns-module ! do
                "internal cursor state source is invalid" fail
            end
            if program state @CursorState.scope_module program-owns-module ! do
                "internal cursor state scope is invalid" fail
            end
            if
                state @CursorState.token 0 <
                state @CursorState.token state @CursorState.source_module @ModuleContext.token_count > ||
                state @CursorState.type_start 0 < ||
                state @CursorState.type_count 0 < ||
                state @CursorState.type_start program @Program.cursor_type_count > ||
                state @CursorState.type_count program @Program.cursor_type_count state @CursorState.type_start - > ||
            do
                "internal cursor state storage is invalid" fail
            end
        end
    end
end

proc verify-local-visibility Program* int -- do
    let program visibility-index do
        program visibility-index local-visibility-at
        let visibility do
            if program visibility @LocalVisibility.procedure_module program-owns-module ! do
                "internal local visibility procedure module is invalid" fail
            end
            if
                visibility @LocalVisibility.procedure_index 0 <
                visibility @LocalVisibility.procedure_index visibility @LocalVisibility.procedure_module @ModuleContext.proc_count >= ||
                visibility @LocalVisibility.local_id 0 < ||
                visibility @LocalVisibility.binding_occurrence 0 < ||
                visibility @LocalVisibility.binding_occurrence program @Program.semantic_occurrence_count >= ||
                visibility @LocalVisibility.start_state 0 < ||
                visibility @LocalVisibility.end_state visibility @LocalVisibility.start_state < ||
                visibility @LocalVisibility.end_state program @Program.cursor_state_count > ||
            do
                "internal local visibility storage is invalid" fail
            end
            program visibility @LocalVisibility.binding_occurrence semantic-occurrence-at
            let occurrence do
                if
                    occurrence @SemanticOccurrence.semantic_class SemanticClass.local? !
                    occurrence @SemanticOccurrence.identity_module ptr cast int cast visibility @LocalVisibility.procedure_module ptr cast int cast != ||
                    occurrence @SemanticOccurrence.identity_index visibility @LocalVisibility.procedure_index != ||
                    occurrence @SemanticOccurrence.identity_subindex visibility @LocalVisibility.local_id != ||
                do
                    "internal local visibility binding mismatch" fail
                end
            end
            if visibility @LocalVisibility.start_state visibility @LocalVisibility.end_state < do
                program visibility @LocalVisibility.start_state cursor-state-at
                  program visibility @LocalVisibility.end_state 1 - cursor-state-at
                let first-state last-state do
                    if
                        first-state @CursorState.owner_module ptr cast int cast visibility @LocalVisibility.procedure_module ptr cast int cast !=
                        first-state @CursorState.owner_index visibility @LocalVisibility.procedure_index != ||
                        last-state @CursorState.owner_module ptr cast int cast visibility @LocalVisibility.procedure_module ptr cast int cast != ||
                        last-state @CursorState.owner_index visibility @LocalVisibility.procedure_index != ||
                    do
                        "internal local visibility owner range mismatch" fail
                    end
                end
            end
        end
    end
end

proc verify-semantic-cursor-data Program* -- do
    let program do
        if
            program @Program.semantic_occurrence_count 0 <
            program @Program.semantic_occurrence_count program @Program.semantic_occurrence_capacity > ||
            program @Program.cursor_state_count 0 < ||
            program @Program.cursor_state_count program @Program.cursor_state_capacity > ||
            program @Program.cursor_type_count 0 < ||
            program @Program.cursor_type_count program @Program.cursor_type_capacity > ||
            program @Program.local_visibility_count 0 < ||
            program @Program.local_visibility_count program @Program.local_visibility_capacity > ||
        do
            "internal semantic cursor table count is invalid" fail
        end
        0 while dup program @Program.cursor_state_count < do
            dup program swap verify-cursor-state
            1 +
        end drop
        0 while dup program @Program.semantic_occurrence_count < do
            dup program swap verify-semantic-occurrence
            1 +
        end drop
        0 while dup program @Program.local_visibility_count < do
            dup program swap verify-local-visibility
            1 +
        end drop
    end
end

proc analyze-all-procedures Program* -- do
    let program do
        if program @Program.phase ProgramPhase.resolved? ! do
            "internal program must be resolved before analysis" fail
        end
        program @Program.module_head
        while peek module do module ptr cast int cast 0 != program program-failed ! && end do
            dup program swap analyze-module-procedures
            @ModuleContext.next_module
        end
        drop
        if program program-failed ! do
            program verify-semantic-cursor-data
            ProgramPhase:analyzed program !Program.phase
        end
    end
end

proc emit-module-procedures Program* ModuleContext* -- do
    let program ctx do
        0
        while dup ctx @ModuleContext.proc_count < do
            dup program ctx rot emit-procedure
            1 +
        end
        drop
    end
end

proc emit-all-procedures Program* -- do
    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup program swap emit-module-procedures
            @ModuleContext.next_module
        end
        drop
    end
end

proc emit-main-wrapper Program* -- do
    peek program do @Program.root_module
        let ctx do
            "int main(int argc, char **argv) {\n  frog_argc = argc;\n  frog_argv = argv;\n" emit
            program emit-string-references
            "  " emit ctx ctx @ModuleContext.main_proc emit-proc-name
            "();\n  return 0;\n}\n" emit
        end
    end
end
// END BODY COMPILER


proc allocate-program bool bool ptr int -- Program* do
    let debug release standard-library-root standard-library-root-length do
        Program:alloc
        peek program do
            0 ptr cast ModuleContext* cast program !Program.root_module
            0 ptr cast ModuleContext* cast program !Program.module_head
            0 ptr cast ModuleContext* cast program !Program.module_tail
            0 program !Program.module_count
            0 program !Program.next_proc_id
            type-nominal-base program !Program.next_nominal_type
            type-function-base program !Program.next_function_type
            16 PointerTypeEntry:sizeof * alloc program !Program.pointer_types
            0 program !Program.pointer_type_count
            16 program !Program.pointer_type_capacity
            16 UnresolvedPointerTypeEntry:sizeof * alloc program !Program.unresolved_pointer_types
            0 program !Program.unresolved_pointer_type_count
            16 program !Program.unresolved_pointer_type_capacity
            16 ResultTypeEntry:sizeof * alloc program !Program.result_types
            0 program !Program.result_type_count
            16 program !Program.result_type_capacity
            0 program !Program.token_count
            0 ptr cast program !Program.strings
            0 program !Program.string_count
            debug program !Program.debug
            release program !Program.release
            0 1 - program !Program.builtins_assert_proc
            if standard-library-root int cast 0 == do
                0 ptr cast
            else
                standard-library-root standard-library-root-length copy-bytes
            end
            program !Program.standard_library_root
            standard-library-root-length program !Program.standard_library_root_length
            0 ptr cast ModuleContext* cast program !Program.builtins_module
            ProgramPhase:allocated program !Program.phase
            8 Diagnostic:sizeof * alloc program !Program.diagnostics
            0 program !Program.diagnostic_count
            8 program !Program.diagnostic_capacity
            8 SourceEntry:sizeof * alloc program !Program.sources
            0 program !Program.source_count
            8 program !Program.source_capacity
            true program !Program.allow_filesystem_sources
            true program !Program.require_main
            false program !Program.record_format_operations
            32 SemanticOccurrence:sizeof * alloc program !Program.semantic_occurrences
            0 program !Program.semantic_occurrence_count
            32 program !Program.semantic_occurrence_capacity
            32 CursorState:sizeof * alloc program !Program.cursor_states
            0 program !Program.cursor_state_count
            32 program !Program.cursor_state_capacity
            64 cell-bytes * alloc program !Program.cursor_types
            0 program !Program.cursor_type_count
            64 program !Program.cursor_type_capacity
            32 LocalVisibility:sizeof * alloc program !Program.local_visibilities
            0 program !Program.local_visibility_count
            32 program !Program.local_visibility_capacity
        end
    end
end

proc disable-filesystem-sources Program* -- do false swap !Program.allow_filesystem_sources end

proc load-program-source Program* ptr int ptr int -- do
    let program source source-length diagnostic-path diagnostic-path-length do
        if program @Program.phase ProgramPhase.allocated? ! do
            "internal program must be allocated before loading" fail
        end
        ModuleContext:alloc
        let ctx do
            0 ptr cast ctx !ModuleContext.canonical_path
            0 ctx !ModuleContext.canonical_path_length
            diagnostic-path diagnostic-path-length copy-bytes ctx !ModuleContext.diagnostic_path
            diagnostic-path-length ctx !ModuleContext.diagnostic_path_length
            0 ptr cast ctx !ModuleContext.imports
            0 ctx !ModuleContext.import_count
            0 ptr cast ctx !ModuleContext.scope
            0 ctx !ModuleContext.scope_count
            LoadState:loading ctx !ModuleContext.load_state
            ResolveState:new ctx !ModuleContext.resolve_state
            true ctx !ModuleContext.is_root
            program ctx program-add-module
            ctx program !Program.root_module
            source source-length copy-bytes ctx swap source-length initialize-module-source
            if program program-failed ! do
                program ctx load-module-imports
                if program program-failed ! do
                    LoadState:loaded ctx !ModuleContext.load_state
                    program initialize-builtins
                    if program program-failed ! do
                        program initialize-string-pool
                        ProgramPhase:loaded program !Program.phase
                    end
                end
            end
        end
    end
end

proc analyze-program Program* ptr int ptr int -- Program* do
    let program source source-length diagnostic-path diagnostic-path-length do
        program source source-length diagnostic-path diagnostic-path-length load-program-source
        if program program-failed ! do program resolve-program end
        if program program-failed ! do program analyze-all-procedures end
        program
    end
end

proc resolve-program Program* -- do
    let program do
        if program @Program.phase ProgramPhase.loaded? ! do
            "internal program must be loaded before resolution" fail
        end
        program resolve-all-module-scopes
        if program program-failed ! do program record-all-declaration-occurrences end
        if program program-failed ! do
            program find-builtins-assert-procedure program !Program.builtins_assert_proc
            program evaluate-all-constants
        end
        if program program-failed ! do
            program resolve-all-types
            if program program-failed ! do program record-all-type-occurrences end
        end
        if program program-failed ! do ProgramPhase:resolved program !Program.phase end
    end
end

proc emit-program Program* -- do
    let program do
        if program @Program.phase ProgramPhase.analyzed? ! do
            "internal program must be analyzed before emission" fail
        end
        program emit-c-emitter-support
        program emit-all-procedures
        program emit-main-wrapper
    end
end

proc analyze-source ptr int ptr int bool bool ptr int -- Program* do
    let source source-length diagnostic-path diagnostic-path-length debug release standard-library-root standard-library-root-length do
        debug release standard-library-root standard-library-root-length allocate-program
        source source-length diagnostic-path diagnostic-path-length analyze-program
    end
end

proc analyze-format-source ptr int ptr int bool bool ptr int -- Program* do
    let source source-length diagnostic-path diagnostic-path-length debug release standard-library-root standard-library-root-length do
        debug release standard-library-root standard-library-root-length allocate-program
        let program do
            false program !Program.require_main
            true program !Program.record_format_operations
            program source source-length diagnostic-path diagnostic-path-length analyze-program
        end
    end
end

proc formatter-line-at Formatter* int -- FormatLine* do
    let formatter line do
        if line 1 < line formatter @Formatter.line_count > || do
            "internal formatter line is out of range" fail
        end
        formatter @Formatter.lines line 1 - FormatLine:sizeof * + FormatLine* cast
    end
end

proc formatter-region-at Formatter* int -- FormatRegion* do
    let formatter index do formatter @Formatter.regions index FormatRegion:sizeof * + FormatRegion* cast end
end

proc formatter-block-end Formatter* int -- int do
    let formatter token do formatter @Formatter.block_ends token cell-bytes * field-read end
end

proc formatter-declaration-end Formatter* int -- int do
    let formatter token do formatter @Formatter.declaration_ends token cell-bytes * field-read end
end

proc formatter-add-region Formatter* int int -- int do
    let formatter entry-depth syntax-depth do
        if formatter @Formatter.region_count formatter @Formatter.module @ModuleContext.token_count > do
            "internal too many formatter regions" fail
        end
        formatter @Formatter.region_count
        let index do
            formatter index formatter-region-at
            let region do
                entry-depth region !FormatRegion.floor
                syntax-depth region !FormatRegion.syntax_depth
                index 1 + formatter !Formatter.region_count
                index
            end
        end
    end
end

proc formatter-touch-region Formatter* int int -- do
    let formatter index floor do
        formatter index formatter-region-at
        let region do
            if floor region @FormatRegion.floor < do floor region !FormatRegion.floor end
        end
    end
end

proc formatter-register-syntax-token Formatter* int int -- do
    let formatter token syntax-depth do
        formatter @Formatter.module token token-at @TokenEntry.line
        formatter swap formatter-line-at
        let line do
            if line @FormatLine.state format-line-unassigned == do
                format-line-syntax line !FormatLine.state
                syntax-depth line !FormatLine.syntax_depth
                0 1 - line !FormatLine.region
                0 line !FormatLine.before_depth
                0 line !FormatLine.after_depth
            end
        end
    end
end

proc formatter-register-operation-line Formatter* int int int int -- do
    let formatter token region-index before-depth after-depth do
        formatter @Formatter.module token token-at @TokenEntry.line
        formatter swap formatter-line-at
        let line do
            if line @FormatLine.state format-line-unassigned == do
                format-line-flow line !FormatLine.state
                formatter region-index formatter-region-at @FormatRegion.syntax_depth line !FormatLine.syntax_depth
                region-index line !FormatLine.region
                before-depth line !FormatLine.before_depth
                after-depth line !FormatLine.after_depth
            elif line @FormatLine.state format-line-flow == do
                after-depth line !FormatLine.after_depth
            end
        end
    end
end

proc formatter-measure-region-floors Formatter* -- do
    let formatter do
        1
        while dup formatter @Formatter.line_count <= do
            dup formatter swap formatter-line-at
            let line-number line do
                if line @FormatLine.state format-line-flow == do
                    formatter line @FormatLine.region line @FormatLine.before_depth formatter-touch-region
                    formatter line @FormatLine.region line @FormatLine.after_depth formatter-touch-region
                end
                line-number 1 +
            end
        end
        drop
    end
end

proc formatter-protect-token-lines Formatter* int -- do
    let formatter token do
        formatter @Formatter.module token token-at
        let entry do
            if entry @TokenEntry.kind TokenKind:string == do
                entry @TokenEntry.start entry @TokenEntry.length + 1 +
                let finish do
                    entry @TokenEntry.line
                      entry @TokenEntry.start 1 -
                    while peek line offset do offset finish < end do
                        let line offset do
                            if formatter @Formatter.module offset source-byte-is-newline do
                                line 1 +
                                peek next-line do
                                    if offset 1 + finish < do
                                        true formatter next-line formatter-line-at !FormatLine.protected
                                    end
                                end
                            else
                                line
                            end
                              offset 1 +
                        end
                    end
                    let line offset do end
                end
            end
        end
    end
end

proc formatter-protect-declaration-lines Formatter* int int -- do
    let formatter start end-token do
        start
        while dup end-token < do
            dup let token do
                formatter @Formatter.module token token-at @TokenEntry.line
                let line-number do
                    if token 0 == do
                        true formatter line-number formatter-line-at !FormatLine.protected
                    elif formatter @Formatter.module token 1 - token-at @TokenEntry.line line-number != do
                        true formatter line-number formatter-line-at !FormatLine.protected
                    end
                end
            end
            1 +
        end
        drop
    end
end

proc create-formatter ModuleContext* -- Formatter* do
    let module do
        Formatter:alloc
        let formatter do
            module formatter !Formatter.module
            module @ModuleContext.lex_line formatter !Formatter.line_count
            module @ModuleContext.lex_line FormatLine:sizeof * alloc formatter !Formatter.lines
            module @ModuleContext.token_count 1 + FormatRegion:sizeof * alloc formatter !Formatter.regions
            0 formatter !Formatter.region_count
            module @ModuleContext.token_count 1 + cell-bytes * alloc formatter !Formatter.block_ends
            module @ModuleContext.token_count 1 + cell-bytes * alloc formatter !Formatter.declaration_ends
            1
            while dup formatter @Formatter.line_count <= do
                dup formatter swap formatter-line-at
                let line-number line do
                    format-line-unassigned line !FormatLine.state
                    0 line !FormatLine.syntax_depth
                    0 1 - line !FormatLine.region
                    0 line !FormatLine.before_depth
                    0 line !FormatLine.after_depth
                    false line !FormatLine.protected
                    line-number 1 +
                end
            end
            drop
            0
            while dup module @ModuleContext.token_count <= do
                dup let token do
                    0 formatter @Formatter.block_ends token cell-bytes * field-write
                    0 formatter @Formatter.declaration_ends token cell-bytes * field-write
                end
                1 +
            end
            drop
            0
            while dup module @ModuleContext.syntax_region_count < do
                dup let index do
                    module index syntax-region-at
                    let region do
                        if region @SyntaxRegion.kind SyntaxRegionKind.block? do
                            region @SyntaxRegion.end_token formatter @Formatter.block_ends
                            region @SyntaxRegion.start_token cell-bytes * field-write
                        elif region @SyntaxRegion.kind SyntaxRegionKind.declaration? do
                            region @SyntaxRegion.end_token formatter @Formatter.declaration_ends
                            region @SyntaxRegion.start_token cell-bytes * field-write
                        end
                    end
                end
                1 +
            end
            drop
            0
            while dup module @ModuleContext.token_count < do
                dup let token do formatter token formatter-protect-token-lines end
                1 +
            end
            drop
            formatter
        end
    end
end

proc formatter-operation-error Formatter* int String -- do
    let formatter token message do formatter @Formatter.module token message fail-at end
end

proc formatter-apply-operation Formatter* int int int -- int int do
    let formatter token region-index depth do
        formatter @Formatter.module token format-operation-state-at
        let state do
            if state format-operation-unresolved == do
                formatter token "formatter requires a resolved stack effect" formatter-operation-error
                token 1 + depth
            elif state format-operation-resolved != do
                "internal invalid formatter operation state" fail
                token 1 + depth
            else
                formatter @Formatter.module token format-operation-inputs-at
                  formatter @Formatter.module token format-operation-outputs-at
                    formatter @Formatter.module token format-operation-end-at
                let inputs outputs token-end do
                    if token-end token <= token-end formatter @Formatter.module @ModuleContext.token_count > || do
                        "internal invalid formatter operation range" fail
                    end
                    depth inputs -
                    let floor do
                        floor outputs +
                        let after-depth do
                            formatter token region-index depth after-depth formatter-register-operation-line
                            token-end after-depth
                        end
                    end
                end
            end
        end
    end
end

proc formatter-register-syntax-range Formatter* int int int -- do
    let formatter start end-token syntax-depth do
        start
        while dup end-token < do
            dup let token do formatter token syntax-depth formatter-register-syntax-token end
            1 +
        end
        drop
    end
end

proc formatter-find-token Formatter* int int String -- int do
    let formatter token end-token expected do
        if token end-token >= do
            0 1 -
        else
            formatter token formatter-block-end
            let block-end do
                if block-end 0 > do
                    formatter block-end end-token expected formatter-find-token
                elif
                    formatter @Formatter.module token token-at @TokenEntry.kind TokenKind:word ==
                    formatter @Formatter.module token expected token-equals &&
                do
                    token
                else
                    formatter token 1 + end-token expected formatter-find-token
                end
            end
        end
    end
end

proc formatter-find-if-separator Formatter* int int -- int do
    let formatter token end-token do
        if token end-token >= do
            end-token
        else
            formatter token formatter-block-end
            let block-end do
                if block-end 0 > do
                    formatter block-end end-token formatter-find-if-separator
                elif
                    formatter @Formatter.module token token-at @TokenEntry.kind TokenKind:word ==
                      formatter @Formatter.module token "elif" token-equals
                      formatter @Formatter.module token "else" token-equals ||
                    formatter @Formatter.module token "end" token-equals || &&
                do
                    token
                else
                    formatter token 1 + end-token formatter-find-if-separator
                end
            end
        end
    end
end

proc formatter-format-flow-region Formatter* int int int int -- int do
    let formatter start end-token syntax-depth entry-depth do
        formatter entry-depth syntax-depth formatter-add-region
        let region-index do
            formatter start end-token region-index entry-depth formatter-format-flow-range
        end
    end
end

proc formatter-format-if Formatter* int int int -- int int do
    let formatter if-token parent-region depth do
        formatter parent-region formatter-region-at @FormatRegion.syntax_depth
          formatter if-token formatter-block-end
        let syntax-depth block-end do
            if block-end 0 <= do "internal formatter if region is missing" fail end
            block-end 1 -
            let end-token do
                if formatter @Formatter.module end-token "end" token-equals ! do
                    "internal formatter if region has no end" fail
                end
                formatter if-token syntax-depth formatter-register-syntax-token
                formatter if-token 1 + end-token "do" formatter-find-token
                let do-token do
                    if do-token 0 < do "internal formatter if condition has no do" fail end
                    formatter depth syntax-depth 1 + formatter-add-region
                    let condition-region do
                        formatter if-token 1 + do-token condition-region depth formatter-format-flow-range
                        let condition-depth do
                            if formatter @Formatter.module @ModuleContext.program program-failed do
                                block-end depth
                            else
                                formatter do-token syntax-depth formatter-register-syntax-token
                                condition-depth 1 -
                                let branch-depth do
                                    formatter do-token condition-region condition-depth branch-depth
                                    formatter-register-operation-line
                                    formatter do-token 1 + end-token formatter-find-if-separator
                                    let separator do
                                        formatter do-token 1 + separator syntax-depth 1 + branch-depth formatter-format-flow-region
                                        let result-depth do
                                            if formatter @Formatter.module @ModuleContext.program program-failed do
                                                block-end depth
                                            else
                                                separator
                                                while
                                                    peek current-separator do
                                                        if current-separator end-token < do
                                                            formatter @Formatter.module current-separator "elif" token-equals
                                                        else
                                                            false
                                                        end
                                                        formatter @Formatter.module @ModuleContext.program program-failed ! &&
                                                    end
                                                do
                                                    let elif-token do
                                                        formatter elif-token syntax-depth formatter-register-syntax-token
                                                        formatter elif-token 1 + end-token "do" formatter-find-token
                                                        let elif-do do
                                                            if elif-do 0 < do "internal formatter elif condition has no do" fail end
                                                            formatter branch-depth syntax-depth 1 + formatter-add-region
                                                            let elif-condition-region do
                                                                formatter elif-token 1 + elif-do elif-condition-region branch-depth formatter-format-flow-range
                                                                let elif-condition-depth do
                                                                    if formatter @Formatter.module @ModuleContext.program program-failed do
                                                                        end-token
                                                                    else
                                                                        formatter elif-do syntax-depth formatter-register-syntax-token
                                                                        elif-condition-depth 1 -
                                                                        let elif-branch-depth do
                                                                            formatter elif-do elif-condition-region
                                                                                  elif-condition-depth elif-branch-depth
                                                                            formatter-register-operation-line
                                                                            formatter elif-do 1 + end-token formatter-find-if-separator
                                                                            let next-separator do
                                                                                formatter elif-do 1 + next-separator syntax-depth 1 + elif-branch-depth
                                                                                formatter-format-flow-region
                                                                                let elif-result-depth do
                                                                                    if formatter @Formatter.module @ModuleContext.program program-failed do
                                                                                        end-token
                                                                                    else
                                                                                        if elif-result-depth result-depth != do
                                                                                            "internal formatter if arm depth mismatch" fail
                                                                                        end
                                                                                        next-separator
                                                                                    end
                                                                                end
                                                                            end
                                                                        end
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                                let final-separator do
                                                    if formatter @Formatter.module @ModuleContext.program program-failed do
                                                        block-end depth
                                                    elif
                                                        final-separator end-token <
                                                        formatter @Formatter.module final-separator "else" token-equals &&
                                                    do
                                                        formatter final-separator syntax-depth formatter-register-syntax-token
                                                        formatter final-separator 1 + end-token syntax-depth 1 + branch-depth
                                                        formatter-format-flow-region
                                                        let else-result-depth do
                                                            if formatter @Formatter.module @ModuleContext.program program-failed do
                                                                block-end depth
                                                            else
                                                                if else-result-depth result-depth != do
                                                                    "internal formatter else arm depth mismatch" fail
                                                                end
                                                                formatter end-token syntax-depth formatter-register-syntax-token
                                                                block-end result-depth
                                                            end
                                                        end
                                                    else
                                                        if final-separator end-token != do
                                                            formatter final-separator "internal formatter if separator is invalid"
                                                            formatter-operation-error
                                                            block-end depth
                                                        else
                                                            if result-depth branch-depth != do
                                                                "internal formatter if without else changes stack depth" fail
                                                            end
                                                            formatter end-token syntax-depth formatter-register-syntax-token
                                                            block-end result-depth
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc formatter-format-while Formatter* int int int -- int int do
    let formatter while-token parent-region depth do
        formatter parent-region formatter-region-at @FormatRegion.syntax_depth
          formatter while-token formatter-block-end
        let syntax-depth block-end do
            if block-end 0 <= do "internal formatter while region is missing" fail end
            block-end 1 -
            let end-token do
                formatter while-token syntax-depth formatter-register-syntax-token
                formatter while-token 1 + end-token "do" formatter-find-token
                let do-token do
                    if do-token 0 < do "internal formatter while condition has no do" fail end
                    formatter depth syntax-depth 1 + formatter-add-region
                    let condition-region do
                        formatter while-token 1 + do-token condition-region depth formatter-format-flow-range
                        let condition-depth do
                            if formatter @Formatter.module @ModuleContext.program program-failed do
                                block-end depth
                            else
                                formatter do-token syntax-depth formatter-register-syntax-token
                                condition-depth 1 -
                                let body-depth do
                                    formatter do-token condition-region condition-depth body-depth
                                    formatter-register-operation-line
                                    formatter do-token 1 + end-token syntax-depth 1 + body-depth formatter-format-flow-region
                                    let result-depth do
                                        if formatter @Formatter.module @ModuleContext.program program-failed do
                                            block-end depth
                                        else
                                            if body-depth depth != result-depth depth != || do
                                                "internal formatter while body depth mismatch" fail
                                            end
                                            formatter end-token syntax-depth formatter-register-syntax-token
                                            block-end depth
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc formatter-format-binding Formatter* int int int -- int int do
    let formatter binding-token parent-region depth do
        formatter parent-region formatter-region-at @FormatRegion.syntax_depth
          formatter binding-token formatter-block-end
        let syntax-depth block-end do
            if block-end 0 <= do "internal formatter binding region is missing" fail end
            formatter binding-token syntax-depth formatter-register-syntax-token
            formatter binding-token parent-region depth formatter-apply-operation
            let body-start body-depth do
                if formatter @Formatter.module @ModuleContext.program program-failed do
                    block-end depth
                else
                    if body-start binding-token 1 + <= do "internal formatter binding header is invalid" fail end
                    formatter binding-token 1 + body-start 1 - syntax-depth 1 + formatter-register-syntax-range
                    formatter body-start 1 - syntax-depth formatter-register-syntax-token
                    formatter body-start block-end 1 - syntax-depth 1 + body-depth formatter-format-flow-region
                    let result-depth do
                        if formatter @Formatter.module @ModuleContext.program program-failed do
                            block-end depth
                        else
                            formatter block-end 1 - syntax-depth formatter-register-syntax-token
                            block-end result-depth
                        end
                    end
                end
            end
        end
    end
end

proc formatter-format-flow-range Formatter* int int int int -- int do
    let formatter start end-token region-index entry-depth do
        start entry-depth
        while
            peek token depth do
                token end-token <
                formatter @Formatter.module @ModuleContext.program program-failed ! &&
            end
        do
            let token depth do
                if formatter @Formatter.module token token-at @TokenEntry.kind TokenKind:word == do
                    if formatter @Formatter.module token "if" token-equals do
                        formatter token region-index depth formatter-format-if
                    elif formatter @Formatter.module token "while" token-equals do
                        formatter token region-index depth formatter-format-while
                    elif
                        formatter @Formatter.module token "let" token-equals
                        formatter @Formatter.module token "peek" token-equals ||
                    do
                        formatter token region-index depth formatter-format-binding
                    elif
                        formatter @Formatter.module token "elif" token-equals
                        formatter @Formatter.module token "else" token-equals ||
                        formatter @Formatter.module token "do" token-equals ||
                        formatter @Formatter.module token "end" token-equals ||
                    do
                        "internal unexpected structured formatter token" fail
                        token 1 + depth
                    else
                        formatter token region-index depth formatter-apply-operation
                    end
                else
                    formatter token region-index depth formatter-apply-operation
                end
            end
        end
        let token depth do depth end
    end
end

proc formatter-format-flow-declaration Formatter* int int int -- do
    let formatter declaration-token body-start declaration-end do
        declaration-end 1 -
        let end-token do
            if formatter @Formatter.module end-token "end" token-equals ! do
                "internal formatter flow declaration has no end" fail
            end
            formatter declaration-token 0 formatter-register-syntax-token
            formatter declaration-token 1 + body-start 1 formatter-register-syntax-range
            formatter body-start end-token 1 0 formatter-format-flow-region drop
            if formatter @Formatter.module @ModuleContext.program program-failed ! do
                formatter end-token 0 formatter-register-syntax-token
            end
        end
    end
end

proc formatter-format-procedure-declaration Formatter* int int -- do
    let formatter declaration-token declaration-end do
        declaration-end 1 -
        let end-token do
            if formatter @Formatter.module end-token "end" token-equals ! do
                "internal formatter procedure declaration has no end" fail
            end
            formatter declaration-token 1 + end-token "do" formatter-find-token
            let do-token do
                if do-token 0 < do "internal formatter procedure declaration has no do" fail end
                formatter declaration-token 0 formatter-register-syntax-token
                formatter declaration-token 1 + do-token 1 formatter-register-syntax-range
                formatter do-token 0 formatter-register-syntax-token
                formatter do-token 1 + end-token 1 0 formatter-format-flow-region drop
                if formatter @Formatter.module @ModuleContext.program program-failed ! do
                    formatter end-token 0 formatter-register-syntax-token
                end
            end
        end
    end
end

proc formatter-format-import-declaration Formatter* int int -- do
    let formatter declaration-token declaration-end do
        formatter declaration-token 0 formatter-register-syntax-token
        formatter declaration-token 1 + declaration-end "(" formatter-find-token
        let open-token do
            if open-token 0 < do
                formatter declaration-token 1 + declaration-end 1 formatter-register-syntax-range
            else
                formatter declaration-token 1 + open-token 1 formatter-register-syntax-range
                formatter open-token 0 formatter-register-syntax-token
                formatter open-token 1 + declaration-end ")" formatter-find-token
                let close-token do
                    if close-token 0 < do "internal formatter grouped import has no closing parenthesis" fail end
                    formatter open-token 1 + close-token 1 formatter-register-syntax-range
                    formatter close-token 0 formatter-register-syntax-token
                    formatter close-token 1 + declaration-end 0 formatter-register-syntax-range
                end
            end
        end
    end
end

proc formatter-format-syntax-declaration Formatter* int int -- do
    let formatter declaration-token declaration-end do
        formatter declaration-token 0 formatter-register-syntax-token
        declaration-end 1 -
        let last-token do
            if
                last-token declaration-token >
                formatter @Formatter.module last-token "end" token-equals &&
            do
                formatter declaration-token 1 + last-token 1 formatter-register-syntax-range
                formatter last-token 0 formatter-register-syntax-token
            else
                formatter declaration-token 1 + declaration-end 1 formatter-register-syntax-range
            end
        end
    end
end

proc formatter-layout-module Formatter* -- do
    let formatter do
        0
        while
            peek declaration-token do
                declaration-token formatter @Formatter.module @ModuleContext.token_count <
                formatter @Formatter.module @ModuleContext.program program-failed ! &&
            end
        do
            let declaration-token do
                formatter declaration-token formatter-declaration-end
                let declaration-end do
                    if declaration-end declaration-token <= do
                        "internal formatter token is outside a declaration" fail
                    end
                    if formatter @Formatter.module declaration-token "proc" token-equals do
                        formatter declaration-token declaration-end formatter-format-procedure-declaration
                    elif formatter @Formatter.module declaration-token "macro" token-equals do
                        formatter declaration-token declaration-end formatter-protect-declaration-lines
                    elif formatter @Formatter.module declaration-token "const" token-equals do
                        formatter declaration-token declaration-token 2 + declaration-end formatter-format-flow-declaration
                    elif formatter @Formatter.module declaration-token "from" token-equals do
                        formatter declaration-token declaration-end formatter-format-import-declaration
                    else
                        formatter declaration-token declaration-end formatter-format-syntax-declaration
                    end
                    declaration-end
                end
            end
        end
        drop
        formatter formatter-measure-region-floors
    end
end

proc formatter-line-end ModuleContext* int -- int do
    let module start do
        start false
        while
            peek finish found do
                finish module @ModuleContext.source_length < found ! &&
            end
        do
            let finish found do
                if module finish source-byte-is-newline do
                    finish 1 + true
                else
                    finish 1 + false
                end
            end
        end
        let finish found do finish end
    end
end

proc formatter-line-content-start ModuleContext* int int -- int do
    let module start finish do
        start
        while
            dup finish <
            if dup do
                drop
                dup module swap source-byte
                let byte do byte 32 == byte 9 == || end
            end
        do
            1 +
        end
    end
end

proc formatter-line-indent Formatter* FormatLine* -- int do
    let formatter line do
        if line @FormatLine.state format-line-syntax == do
            line @FormatLine.syntax_depth 4 *
        elif line @FormatLine.state format-line-flow == do
            formatter line @FormatLine.region formatter-region-at @FormatRegion.floor
            let region-floor do
                line @FormatLine.after_depth 1 -
                let column do
                    if column region-floor < do region-floor else column end
                    let column do
                        if line @FormatLine.before_depth column < do
                            line @FormatLine.before_depth
                        else
                            column
                        end
                        let column do
                            if column region-floor < do
                                "internal formatter line is below its region floor" fail
                            end
                            line @FormatLine.syntax_depth 4 *
                            column region-floor - 2 * +
                        end
                    end
                end
            end
        else
            0
        end
    end
end

proc formatter-emit-spaces int -- do
    let count do
        0 while dup count < do 32 putc 1 + end drop
    end
end

proc formatter-emit-source Formatter* -- do
    let formatter do
        formatter @Formatter.module
        let module do
            0 1
            while peek offset line-number do offset module @ModuleContext.source_length < end do
                let offset line-number do
                    module offset formatter-line-end
                    let finish do
                        formatter line-number formatter-line-at
                        let line do
                            if
                                line @FormatLine.state format-line-unassigned ==
                                line @FormatLine.protected ||
                            do
                                module @ModuleContext.source offset + finish offset - emit-bytes
                            else
                                module offset finish formatter-line-content-start
                                let content-start do
                                    formatter line formatter-line-indent formatter-emit-spaces
                                    module @ModuleContext.source content-start + finish content-start - emit-bytes
                                end
                            end
                            finish line-number 1 +
                        end
                    end
                end
            end
            let offset line-number do end
        end
    end
end

proc emit-inspect-module-id ModuleContext* -- do
    let module do
        if module ptr cast int cast 0 == do 0 1 - emit-integer else module @ModuleContext.module_id emit-unsigned end
    end
end

proc emit-inspect-bytes-with-space-policy ptr int bool -- do
    let bytes length escape-spaces do
        0
        while dup length < do
            dup let index do
                bytes index byte-read
                let byte do
                    if byte 9 == do "\\t" emit
                    elif byte 10 == do "\\n" emit
                    elif byte 13 == do "\\r" emit
                    elif byte 92 == do "\\\\" emit
                    elif byte 32 == escape-spaces && do "<space>" emit
                    elif byte 32 >= byte 126 <= && do byte putc
                    else
                        "\\x" emit
                        byte 16 / emit-uppercase-hex-digit
                        byte 16 % emit-uppercase-hex-digit
                    end
                end
            end
            1 +
        end
        drop
    end
end

proc emit-inspect-bytes ptr int -- do false emit-inspect-bytes-with-space-policy end

proc emit-inspect-lexeme-bytes ptr int -- do true emit-inspect-bytes-with-space-policy end

proc emit-inspect-module-path Program* ModuleContext* -- do
    let program module do
        if module @ModuleContext.is_root do
            module @ModuleContext.diagnostic_path module @ModuleContext.diagnostic_path_length emit-inspect-bytes
        else
            if
                module @ModuleContext.canonical_path_length program @Program.standard_library_root_length 1 + >
            do
                if
                    module @ModuleContext.canonical_path program @Program.standard_library_root_length
                    program @Program.standard_library_root program @Program.standard_library_root_length bytes-equal
                    module @ModuleContext.canonical_path program @Program.standard_library_root_length byte-read 47 == &&
                do
                    module @ModuleContext.canonical_path program @Program.standard_library_root_length 1 + +
                      module @ModuleContext.canonical_path_length program @Program.standard_library_root_length 1 + -
                    emit-inspect-bytes
                else
                    module @ModuleContext.canonical_path module @ModuleContext.canonical_path_length emit-inspect-bytes
                end
            else
                module @ModuleContext.canonical_path module @ModuleContext.canonical_path_length emit-inspect-bytes
            end
        end
    end
end

proc emit-inspect-lexeme-kind LexemeKind -- do
    let kind do
        if kind LexemeKind:token == do "token" emit
        elif kind LexemeKind:whitespace == do "whitespace" emit
        else "comment" emit end
    end
end

proc emit-inspect-lexemes ModuleContext* -- do
    let module do
        0 while dup module @ModuleContext.lexeme_count < do
            dup let index do
                module index lexeme-at
                let lexeme do
                    "lexeme\t" emit module @ModuleContext.module_id emit-unsigned 9 putc
                    index emit-unsigned 9 putc
                    lexeme @LexemeEntry.start emit-unsigned 9 putc
                    lexeme @LexemeEntry.length emit-unsigned 9 putc
                    lexeme @LexemeEntry.kind emit-inspect-lexeme-kind 9 putc
                    module @ModuleContext.source lexeme @LexemeEntry.start + lexeme @LexemeEntry.length emit-inspect-lexeme-bytes
                    10 putc
                end
            end
            1 +
        end drop
    end
end

proc emit-inspect-syntax-region-kind SyntaxRegionKind -- do
    let kind do
        if kind SyntaxRegionKind.module? do "module" emit
        elif kind SyntaxRegionKind.declaration? do "declaration" emit
        else "block" emit end
    end
end

proc emit-inspect-syntax-regions ModuleContext* -- do
    let module do
        0 while dup module @ModuleContext.syntax_region_count < do
            dup let index do
                module index syntax-region-at
                let region do
                    "region\t" emit module @ModuleContext.module_id emit-unsigned 9 putc
                    index emit-unsigned 9 putc
                    region @SyntaxRegion.parent emit-integer 9 putc
                    region @SyntaxRegion.kind emit-inspect-syntax-region-kind 9 putc
                    region @SyntaxRegion.start_token emit-unsigned 9 putc
                    region @SyntaxRegion.end_token emit-unsigned 9 putc
                    region @SyntaxRegion.start_byte emit-unsigned 9 putc
                    region @SyntaxRegion.end_byte emit-unsigned
                    10 putc
                end
            end
            1 +
        end drop
    end
end

proc verify-module-syntax-regions ModuleContext* -- do
    let module do
        if module @ModuleContext.syntax_region_count 0 <= do
            "internal missing module syntax region" fail
        end
        0 while dup module @ModuleContext.syntax_region_count < do
            dup let index do
                module index syntax-region-at
                let region do
                    if
                        region @SyntaxRegion.start_token 0 <
                        region @SyntaxRegion.end_token region @SyntaxRegion.start_token < ||
                        region @SyntaxRegion.end_token module @ModuleContext.token_count > ||
                        region @SyntaxRegion.start_byte 0 < ||
                        region @SyntaxRegion.end_byte region @SyntaxRegion.start_byte < ||
                        region @SyntaxRegion.end_byte module @ModuleContext.source_length > ||
                    do
                        "internal invalid syntax region" fail
                    end
                    if index 0 == do
                        if
                            region @SyntaxRegion.kind SyntaxRegionKind.module? !
                            region @SyntaxRegion.parent 0 1 - != ||
                            region @SyntaxRegion.start_token 0 != ||
                            region @SyntaxRegion.end_token module @ModuleContext.token_count != ||
                            region @SyntaxRegion.start_byte 0 != ||
                            region @SyntaxRegion.end_byte module @ModuleContext.source_length != ||
                        do
                            "internal invalid module syntax region" fail
                        end
                    else
                        if region @SyntaxRegion.parent 0 < region @SyntaxRegion.parent index >= || do
                            "internal invalid syntax region parent" fail
                        end
                        module region @SyntaxRegion.parent syntax-region-at
                        let parent do
                            if
                                region @SyntaxRegion.start_token parent @SyntaxRegion.start_token <
                                region @SyntaxRegion.end_token parent @SyntaxRegion.end_token > ||
                            do
                                "internal syntax region escapes parent" fail
                            end
                        end
                    end
                end
            end
            1 +
        end drop
    end
end

proc verify-module-lexemes ModuleContext* -- do
    let module do
        0 0
        while peek index expected-start do index module @ModuleContext.lexeme_count < end do
            let index expected-start do
                module index lexeme-at
                let lexeme do
                    if
                        lexeme @LexemeEntry.start expected-start !=
                        lexeme @LexemeEntry.length 0 <= ||
                        lexeme @LexemeEntry.length module @ModuleContext.source_length expected-start - > ||
                    do
                        "internal lossless lexeme coverage mismatch" fail
                    end
                    index 1 + expected-start lexeme @LexemeEntry.length +
                end
            end
        end
        let index expected-start do
            if expected-start module @ModuleContext.source_length != do
                "internal lossless lexeme coverage mismatch" fail
            end
        end
    end
end

proc emit-inspect-operation-kind OperationKind -- do
