                0 1 - operation !AnalyzedOperation.target_index
                0 ptr cast ModuleContext* cast operation !AnalyzedOperation.secondary_module
                0 1 - operation !AnalyzedOperation.secondary_index
                0 1 - operation !AnalyzedOperation.local_id
                0 1 - operation !AnalyzedOperation.binding_local_start
                0 operation !AnalyzedOperation.binding_local_count
                type-none operation !AnalyzedOperation.value_type
                0 operation !AnalyzedOperation.payload
                IntrinsicOperation:none operation !AnalyzedOperation.intrinsic
                PrivateOperation:none operation !AnalyzedOperation.private_operation
                cc @CompileContext.type_count cc !CompileContext.operation_minimum_type_count
                false cc !CompileContext.operation_identity_set
                false cc !CompileContext.operation_identity_locked
                false cc !CompileContext.operation_binding_active
                true cc !CompileContext.operation_active
            end
        end
    end
end

proc finish-analyzed-operation CompileContext* int -- do
    let cc token-end do
        if cc @CompileContext.operation_active ! do "internal missing analyzed operation" fail end
        cc compile-context-analysis
        let analysis do
            analysis analysis @ProcedureAnalysis.operation_count analyzed-operation-at
            let operation do
                if token-end operation @AnalyzedOperation.token_start <= do
                    "internal invalid analyzed operation token range" fail
                end
                if
                    cc @CompileContext.operation_minimum_type_count 0 <
                    cc @CompileContext.operation_minimum_type_count operation @AnalyzedOperation.before_type_count > ||
                    cc @CompileContext.operation_minimum_type_count cc @CompileContext.type_count > ||
                do
                    "internal invalid analyzed operation stack minimum" fail
                end
                if cc @CompileContext.operation_identity_set ! do
                    "internal unresolved analyzed operation" fail
                end
                token-end operation !AnalyzedOperation.token_end
                analysis cc @CompileContext.type_stack cc @CompileContext.type_count append-operation-types
                operation !AnalyzedOperation.after_type_start
                cc @CompileContext.type_count operation !AnalyzedOperation.after_type_count
                cc @CompileContext.operation_minimum_type_count operation !AnalyzedOperation.minimum_type_count
                analysis @ProcedureAnalysis.operation_count 1 + analysis !ProcedureAnalysis.operation_count
                false cc !CompileContext.operation_active
                false cc !CompileContext.operation_identity_set
                false cc !CompileContext.operation_identity_locked
                false cc !CompileContext.operation_binding_active
            end
        end
    end
end

proc reset-procedure-operations ProcedureAnalysis* -- do
    let analysis do
        if
            analysis @ProcedureAnalysis.operation_capacity 0 <=
            analysis @ProcedureAnalysis.operation_type_capacity 0 <= ||
            analysis @ProcedureAnalysis.operation_count 0 < ||
            analysis @ProcedureAnalysis.operation_count analysis @ProcedureAnalysis.operation_capacity > ||
            analysis @ProcedureAnalysis.operation_type_count 0 < ||
            analysis @ProcedureAnalysis.operation_type_count analysis @ProcedureAnalysis.operation_type_capacity > ||
