        elif cc @CompileContext.defining_module token-index "String.len" token-equals do
            cc type-string type-expect
            cc type-int register-replaced-stack-slot
            cc type-int type-push
            if cc @CompileContext.emitting do
                cc @CompileContext.type_count 1 - let index do
                cc emit-indent "{ const FrogString *value = (const FrogString *)(intptr_t)" emit
                cc index type-string emit-slot-as "; " emit cc index type-int emit-slot-as " = (intptr_t)value->len; }" emit 10 putc
                end
