proc record-typed-record-occurrences CompileContext* TypedInstruction* ptr int -- do
    let cc instruction bytes length do
        instruction @TypedInstruction.operation
        let operation do
            if
                operation RuntimeOperation.record_new?
                operation RuntimeOperation.record_alloc? ||
                operation RuntimeOperation.record_sizeof? ||
            do
                bytes length 58 first-index-of-byte
                let separator do
                    cc instruction @TypedInstruction.token_start 0 separator OccurrenceRole:reference SemanticClass:record_type
                                instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index 0 1 -
                    add-compile-token-part-occurrence
                    let occurrence-index do
                        cc occurrence-index instruction @TypedInstruction.token_start 0 separator ScopeKind:record_type
                                    instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index
                        set-compile-occurrence-binding-part
                    end
                    cc instruction @TypedInstruction.token_start separator 1 + length separator 1 + - add-compile-intrinsic-part
                end
            else
                bytes length 46 first-index-of-byte
                let separator do
                    if separator 1 > do
                        cc instruction @TypedInstruction.token_start 1 separator 1 - OccurrenceRole:reference SemanticClass:record_type
                                    instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index 0 1 -
                        add-compile-token-part-occurrence
                        let occurrence-index do
                            cc occurrence-index instruction @TypedInstruction.token_start 1 separator 1 - ScopeKind:record_type
                                        instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index
                            set-compile-occurrence-binding-part
                        end
                    end
                    cc instruction @TypedInstruction.token_start separator 1 + length separator 1 + -
                            OccurrenceRole:reference SemanticClass:record_field
                                instruction @TypedInstruction.target_module instruction @TypedInstruction.secondary_index
                    instruction @TypedInstruction.target_index add-compile-token-part-occurrence drop
                end
            end
        end
    end
end

proc record-typed-union-occurrences CompileContext* TypedInstruction* ptr int -- do
    let cc instruction bytes length do
        bytes length 58 first-index-of-byte
        peek separator do
            if separator 0 < do drop bytes length 46 first-index-of-byte end
            let separator do
                cc instruction @TypedInstruction.token_start 0 separator OccurrenceRole:reference SemanticClass:union_type
                            instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index 0 1 -
                add-compile-token-part-occurrence
                let occurrence-index do
                    cc occurrence-index instruction @TypedInstruction.token_start 0 separator ScopeKind:union_type
                                instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index
                    set-compile-occurrence-binding-part
                end
                length separator 1 + -
                let member-length do
                    if member-length 0 > bytes length 1 - byte-read 63 == && do member-length 1 - else member-length end
                    let bounded-length do
                        cc instruction @TypedInstruction.token_start separator 1 + bounded-length
                                OccurrenceRole:reference SemanticClass:union_case
                                    instruction @TypedInstruction.target_module instruction @TypedInstruction.secondary_index
                        instruction @TypedInstruction.target_index add-compile-token-part-occurrence drop
                    end
                end
            end
        end
    end
end

proc record-typed-function-occurrences CompileContext* TypedInstruction* ptr int -- do
    let cc instruction bytes length do
        bytes length 58 first-index-of-byte
        let separator do
            cc instruction @TypedInstruction.token_start 0 separator OccurrenceRole:reference SemanticClass:function_type
                        instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index 0 1 -
            add-compile-token-part-occurrence
            let occurrence-index do
                cc occurrence-index instruction @TypedInstruction.token_start 0 separator ScopeKind:function_type
                            instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index
                set-compile-occurrence-binding-part
            end
            if instruction @TypedInstruction.operation RuntimeOperation.function_reference? do
                cc instruction @TypedInstruction.token_start separator 1 + 3 add-compile-intrinsic-part
                separator 5 +
                let procedure-start do
                    cc instruction @TypedInstruction.token_start procedure-start length procedure-start -
                            OccurrenceRole:reference SemanticClass:procedure
                                instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index 0 1 -
                    add-compile-token-part-occurrence
                    let occurrence-index do
                        cc occurrence-index instruction @TypedInstruction.token_start procedure-start length procedure-start -
                                  ScopeKind:procedure instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index
                        set-compile-occurrence-binding-part
                    end
                end
            else
                cc instruction @TypedInstruction.token_start separator 1 + length separator 1 + - add-compile-intrinsic-part
            end
        end
    end
end

proc record-typed-string-occurrences CompileContext* TypedInstruction* ptr int -- do
    let cc instruction bytes length do
        bytes length 46 first-index-of-byte
        let separator do
            cc instruction @TypedInstruction.token_start 0 separator OccurrenceRole:reference SemanticClass:primitive_type
            0 ptr cast ModuleContext* cast type-string 0 1 - add-compile-token-part-occurrence drop
            cc instruction @TypedInstruction.token_start separator 1 + length separator 1 + - add-compile-intrinsic-part
        end
    end
end

proc record-typed-instruction-occurrences CompileContext* TypedInstruction* -- do
    let cc instruction do
        instruction @TypedInstruction.source_module instruction @TypedInstruction.token_start token-slice
        let bytes length do
            instruction @TypedInstruction.operation
            let operation do
                if operation RuntimeOperation.local_load? do
                    cc instruction @TypedInstruction.token_start OccurrenceRole:reference SemanticClass:local
                            cc @CompileContext.procedure_module cc @CompileContext.procedure_index instruction @TypedInstruction.local_id
                    add-compile-token-occurrence drop
                elif operation RuntimeOperation.constant? do
                    cc instruction @TypedInstruction.token_start OccurrenceRole:reference SemanticClass:constant
                            instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index 0 1 -
                    add-compile-token-occurrence
                    let occurrence-index do
                        cc occurrence-index instruction @TypedInstruction.token_start ScopeKind:constant
                                instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index
                        set-compile-occurrence-binding
                    end
                elif operation RuntimeOperation.procedure_call? do
                    cc instruction @TypedInstruction.token_start OccurrenceRole:reference SemanticClass:procedure
                            instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index 0 1 -
                    add-compile-token-occurrence
                    let occurrence-index do
                        cc occurrence-index instruction @TypedInstruction.token_start ScopeKind:procedure
                                instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index
                        set-compile-occurrence-binding
                    end
                elif operation RuntimeOperation.type_literal? do
                    cc instruction @TypedInstruction.token_start instruction @TypedInstruction.value_type record-compile-type-occurrence
                elif
                    operation RuntimeOperation.record_new?
                    operation RuntimeOperation.record_alloc? ||
                    operation RuntimeOperation.record_sizeof? ||
                    operation RuntimeOperation.record_field_read? ||
                    operation RuntimeOperation.record_field_write? ||
                do
                    cc instruction bytes length record-typed-record-occurrences
                elif
                    operation RuntimeOperation.union_construct?
                    operation RuntimeOperation.union_test? ||
                    operation RuntimeOperation.union_project? ||
                do
                    cc instruction bytes length record-typed-union-occurrences
                elif operation RuntimeOperation.function_call? operation RuntimeOperation.function_reference? || do
                    cc instruction bytes length record-typed-function-occurrences
                elif operation RuntimeOperation.string_bytes? operation RuntimeOperation.string_len? || do
                    cc instruction bytes length record-typed-string-occurrences
                elif
                    operation RuntimeOperation.private_intrinsic?
                    operation RuntimeOperation.cast? ||
                    operation RuntimeOperation.args? ||
                    operation RuntimeOperation.print? ||
                    operation RuntimeOperation.noop? ||
                    operation RuntimeOperation.pointer_load? ||
                    operation RuntimeOperation.pointer_store? ||
                    operation RuntimeOperation.assert_fail? ||
                do
                    cc instruction @TypedInstruction.token_start 0 length add-compile-intrinsic-part
                end
            end
        end
    end
end

proc finish-typed-instruction CompileContext* int -- do
    let cc token-end do
        if cc @CompileContext.instruction_active ! do "internal missing typed instruction" fail end
        cc compile-context-analysis
        let analysis do
            cc active-typed-instruction
            let instruction do
                if instruction @TypedInstruction.operation RuntimeOperation.none? do
                    "internal unresolved typed instruction" fail
                end
                token-end instruction !TypedInstruction.token_end
                analysis cc @CompileContext.type_stack cc @CompileContext.type_count append-operation-types
                instruction !TypedInstruction.after_type_start
                cc @CompileContext.type_count instruction !TypedInstruction.after_type_count
                cc @CompileContext.instruction_minimum_type_count instruction !TypedInstruction.minimum_type_count
                cc instruction record-typed-instruction-occurrences
                analysis @ProcedureAnalysis.instruction_count 1 + analysis !ProcedureAnalysis.instruction_count
                false cc !CompileContext.instruction_active
            end
        end
    end
end

proc set-typed-instruction CompileContext* RuntimeOperation -- TypedInstruction* do
    let cc operation do
        if cc @CompileContext.instruction_active ! do "internal missing active typed instruction" fail end
        cc active-typed-instruction
        let instruction do
            if instruction @TypedInstruction.operation RuntimeOperation.none? ! do
                "internal duplicate typed instruction operation: " emit-error
                instruction @TypedInstruction.source_module instruction @TypedInstruction.token_start token-slice emit-error-bytes
                10 eputc 1 exit
            end
            operation instruction !TypedInstruction.operation
            instruction
        end
    end
end

