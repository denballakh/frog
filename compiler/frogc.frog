proc program-allocate-proc-id ptr -- int do
    let program do
        program @program-next-proc-id
        let proc-id do
            proc-id 1 + program !program-next-proc-id
            proc-id
        end
    end
end

proc program-allocate-nominal-type ptr -- int do
