proc set-cc-indent int ptr -- do cc-indent-offset field-write end

proc cc-type-address ptr int -- ptr do
    let cc index do
        cc cc-type-stack index cell-bytes * +
    end
end

proc type-push ptr int -- do
    let cc value do
        value cc cc cc-type-count cc-type-address 0 field-write
        cc cc-type-count 1 + cc set-cc-type-count
    end
end

proc type-pop ptr -- int do
    let cc do
        if cc cc-type-count 0 <= do
            "compile-time stack underflow" fail
        end
        cc cc-type-count 1 -
        let index do
            index cc set-cc-type-count
            cc index cc-type-address 0 field-read
        end
    end
end

proc type-expect ptr int -- do
    let cc expected do
        if cc type-pop expected != do
            "compile-time stack type mismatch" fail
        end
    end
end

proc type-at-depth ptr int -- int do
    let cc index do
        cc index cc-type-address 0 field-read
    end
end

proc type-snapshot ptr -- ptr int do
    let cc do
        cc cc-type-count 1 + cell-bytes * alloc
        let snapshot do
            cc cc-type-stack snapshot cc cc-type-count cell-bytes * memory-copy
            snapshot cc cc-type-count
        end
    end
end

proc restore-type-snapshot ptr ptr int -- do
    let cc snapshot count do
        snapshot cc cc-type-stack count cell-bytes * memory-copy
        count cc set-cc-type-count
    end
end

proc types-match-from ptr ptr int int -- bool do
    let cc snapshot count index do
        if index count >= do
            true
        else
            if cc index type-at-depth snapshot index cell-bytes * field-read != do
                false
            else
                cc snapshot count index 1 + types-match-from
            end
        end
    end
end

proc types-match ptr ptr int -- bool do
    let cc snapshot count do
        if cc cc-type-count count != do
            false
        else
            cc snapshot count 0 types-match-from
        end
    end
end

proc block-address ptr int -- ptr do
    let cc index do
        cc cc-blocks index block-bytes * +
    end
end

proc block-field ptr int -- int do field-read end
proc set-block-field int ptr int -- do field-write end
proc block-pointer-field ptr int -- ptr do pointer-field-read end
proc set-block-pointer-field ptr ptr int -- do pointer-field-write end

proc push-block ptr int -- ptr do
    let cc kind do
        cc cc cc-block-count block-address
        let block do
            kind block block-kind-offset set-block-field
            cc type-snapshot
            let snapshot count do
                snapshot block block-base-types-offset set-block-pointer-field
                count block block-base-count-offset set-block-field
            end
            0 block block-then-types-offset set-block-field
            0 block block-then-count-offset set-block-field
            cc cc-local-count block block-local-base-offset set-block-field
            0 block block-has-else-offset set-block-field
            0 block block-has-do-offset set-block-field
            0 block block-elif-parent-offset set-block-field
            cc cc-block-count 1 + cc set-cc-block-count
            block
        end
    end
end

proc top-block ptr -- ptr do
    let cc do
        if cc cc-block-count 0 <= do
            "control-flow block stack underflow" fail
        end
        cc cc cc-block-count 1 - block-address
    end
end

proc pop-block ptr -- ptr do
    let cc do
        cc top-block
        cc cc-block-count 1 - cc set-cc-block-count
    end
end

proc local-address ptr int -- ptr do
    let cc index do
        cc cc-locals index local-bytes * +
    end
end

proc local-field ptr int -- int do field-read end
proc set-local-field int ptr int -- do field-write end

proc add-local ptr int int -- int do
    let cc name-token value-type do
        cc cc cc-local-count local-address
        let local do
            cc cc-root name-token token-start-at local local-name-start-offset set-local-field
            cc cc-root name-token token-length-at local local-name-length-offset set-local-field
            value-type local local-type-offset set-local-field
            cc cc-next-local local local-id-offset set-local-field
            cc cc-local-count 1 + cc set-cc-local-count
            cc cc-next-local
            cc cc-next-local 1 + cc set-cc-next-local
        end
    end
end

proc local-name-equals ptr ptr int -- bool do
    let cc local token-index do
        cc cc-root ctx-source
        local local-name-start-offset local-field +
        local local-name-length-offset local-field
        cc cc-root token-index token-slice
        bytes-equal
    end
end

proc find-local-from ptr int int -- int do
    let cc token-index local-index do
        if local-index 0 < do
            0 1 -
        else
            cc local-index local-address
            let local do
                if cc local token-index local-name-equals do
                    local-index
                else
                    cc token-index local-index 1 - find-local-from
                end
            end
        end
    end
end

proc find-local ptr int -- int do
    let cc token-index do
        cc token-index cc cc-local-count 1 - find-local-from
    end
end

proc emit-indent ptr -- do
    let cc do
        0
        while dup cc cc-indent < do
            "  " emit
            1 +
        end
        drop
    end
end

proc emit-line ptr ptr int -- do
    let cc bytes length do
        cc emit-indent
        bytes length emit
        10 putc
    end
end

proc indent-more ptr -- do
    let cc do cc cc-indent 1 + cc set-cc-indent end
end

proc indent-less ptr -- do
    let cc do
        if cc cc-indent 0 <= do
            "C emitter indentation underflow" fail
        end
        cc cc-indent 1 - cc set-cc-indent
    end
end

