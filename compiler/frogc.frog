        ctx @ModuleContext.token_count 1 + function-bytes * alloc ctx !ModuleContext.functions
        ctx @ModuleContext.token_count 1 + cell-bytes * alloc ctx !ModuleContext.function_types
        0 ctx !ModuleContext.scope_count
        resolve-new ctx !ModuleContext.resolve_state
