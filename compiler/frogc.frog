proc compile-record-special CompileContext* ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @CompileContext.scope_module bytes separator visible-record-definition
            let module record-index found do
                if found ! do
                    false
                else
                    bytes separator 1 + +
                    length separator 1 + -
                    let operation operation-length do
                        module record-index record-type-at @RecordTypeEntry.record_type
                        let record-type do
                        if operation operation-length "new" bytes-equal-string do
                            cc OperationKind:record_new module record-index set-operation-target
                            cc record-type set-operation-payload
                            cc record-type type-push
                            cc record-type emit-record-zero-value
                            true
                        elif operation operation-length "alloc" bytes-equal-string do
                            cc OperationKind:record_alloc module record-index set-operation-target
                            cc @CompileContext.program record-type program-intern-pointer-type
                            let pointer-type do
                                cc pointer-type set-operation-payload
                                cc pointer-type type-push
                                cc record-type pointer-type emit-record-allocation
                            end
                            true
                        elif operation operation-length "sizeof" bytes-equal-string do
                            cc OperationKind:record_sizeof module record-index set-operation-target
                            cc record-type set-operation-payload
                            cc type-int type-push
                            cc record-type emit-record-sizeof
                            true
                        else
                            cc "unknown record operation" fail-compile-word
                            false
                        end
                        end
                    end
                end
            end
        end
    end
end

