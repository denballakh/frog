    end
end

proc emit-c-parameter-types ModuleContext int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index proc-input-count-at < do
            if input-index 0 != do ", " emit end
            ctx
            ctx proc-index proc-input-start-at input-index +
            type-at emit-c-abi-type
            ctx proc-index input-index 1 + emit-c-parameter-types
        end
    end
end

proc emit-external-c-prototype ModuleContext int -- do
    let ctx proc-index do
        "extern " emit
        if ctx proc-index proc-output-count-at 0 == do
            "void" emit
        else
            ctx ctx proc-index proc-output-start-at type-at emit-c-abi-type
        end
        " " emit ctx proc-index emit-c-symbol "(" emit
        if ctx proc-index proc-input-count-at 0 == do
            "void" emit
        else
            ctx proc-index 0 emit-c-parameter-types
        end
        ");\n" emit
    end
end

proc emit-result-type-name int -- do
    "frog_results_" emit emit-unsigned
end

proc emit-result-fields int int -- do
    let count index do
        if index count < do
            " Cell value_" emit index emit-unsigned ";" emit
            count index 1 + emit-result-fields
        end
    end
end

proc emit-result-typedef int -- do
    let output-count do
        "typedef struct {" emit
        output-count 0 emit-result-fields
        " } " emit output-count emit-result-type-name ";\n" emit
    end
end

proc ctx-proc-uses-result-arity-from ModuleContext int int -- bool do
    let ctx output-count proc-index do
        if proc-index ctx @ModuleContext.proc_count >= do
            false
        elif ctx proc-index proc-output-count-at output-count == do
            true
        else
            ctx output-count proc-index 1 + ctx-proc-uses-result-arity-from
        end
    end
end

proc ctx-function-uses-result-arity-from ModuleContext int int -- bool do
    let ctx output-count function-index do
        if function-index ctx @ModuleContext.function_count >= do
            false
        elif ctx function-index function-output-count-at output-count == do
            true
        else
            ctx output-count function-index 1 + ctx-function-uses-result-arity-from
        end
    end
end

proc ctx-uses-result-arity ModuleContext int -- bool do
    let ctx output-count do
        if ctx output-count 0 ctx-proc-uses-result-arity-from do
            true
        else
            ctx output-count 0 ctx-function-uses-result-arity-from
        end
    end
end

proc modules-use-result-arity ptr int ModuleContext -- bool do
    let program output-count ctx do
        if ctx ptr cast int cast 0 == do
            false
        elif ctx output-count ctx-uses-result-arity do
            true
        else
            program output-count ctx @ModuleContext.next_module modules-use-result-arity
        end
    end
end

proc result-arity-max int int -- int do
    let left right do
        if left right > do left else right end
    end
end

proc ctx-max-proc-output-arity-from ModuleContext int int -- int do
    let ctx proc-index maximum do
        if proc-index ctx @ModuleContext.proc_count >= do
            maximum
        else
            ctx proc-index proc-output-count-at
            peek output-count do maximum result-arity-max
                let next-maximum do
                    ctx proc-index 1 + next-maximum ctx-max-proc-output-arity-from
                end
            end
        end
    end
end

proc ctx-max-proc-output-arity ModuleContext -- int do 0 0 ctx-max-proc-output-arity-from end

proc ctx-max-function-output-arity-from ModuleContext int int -- int do
    let ctx function-index maximum do
        if function-index ctx @ModuleContext.function_count >= do
            maximum
        else
            ctx function-index function-output-count-at
            peek output-count do maximum result-arity-max
                let next-maximum do
                    ctx function-index 1 + next-maximum ctx-max-function-output-arity-from
                end
            end
        end
    end
end

proc ctx-max-function-output-arity ModuleContext -- int do 0 0 ctx-max-function-output-arity-from end

proc program-max-output-arity-from ptr ModuleContext int -- int do
    let program ctx maximum do
        if ctx ptr cast int cast 0 == do
            maximum
        else
            ctx ctx-max-proc-output-arity
            ctx ctx-max-function-output-arity
            peek proc-maximum function-maximum do result-arity-max
                peek ctx-maximum do maximum result-arity-max
                    let next-maximum do
                        program ctx @ModuleContext.next_module next-maximum program-max-output-arity-from
                    end
                end
            end
        end
    end
end

proc program-max-output-arity ptr -- int do
    peek program do program @program-module-head 0 program-max-output-arity-from end
end

proc emit-result-typedefs-from ptr int int -- do
    let program maximum output-count do
        if output-count maximum <= do
            program output-count program @program-module-head modules-use-result-arity
            if dup do
                drop output-count emit-result-typedef
            else
                drop
            end
            program maximum output-count 1 + emit-result-typedefs-from
        end
    end
end

proc emit-result-typedefs ptr -- do
    peek program do program-max-output-arity
        let maximum do
            program maximum 2 emit-result-typedefs-from
        end
    end
end

proc emit-proc-return-type ModuleContext int -- do
    peek ctx proc-index do proc-output-count-at
        let output-count do
            if output-count 0 == do
                "void" emit
            elif output-count 1 == do
                "Cell" emit
            else
                output-count emit-result-type-name
            end
        end
    end
end

proc emit-proc-argument-name int -- do
    "frog_arg_" emit emit-unsigned
end

proc emit-proc-parameters-from ModuleContext int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index proc-input-count-at < do
            if input-index 0 != do ", " emit end
            "Cell " emit input-index emit-proc-argument-name
            ctx proc-index input-index 1 + emit-proc-parameters-from
        end
    end
end

proc emit-proc-parameters ModuleContext int -- do
    let ctx proc-index do
        if ctx proc-index proc-input-count-at 0 == do
            "void" emit
        else
            ctx proc-index 0 emit-proc-parameters-from
        end
    end
end

proc emit-proc-signature ModuleContext int -- do
    peek ctx proc-index do emit-proc-return-type
        " " emit ctx proc-index emit-proc-name
        "(" emit ctx proc-index emit-proc-parameters ")" emit
    end
end

proc emit-c-prototype ModuleContext int -- do
    let ctx proc-index do
        if ctx proc-index proc-external-at do
            ctx proc-index emit-external-c-prototype
        end
        ctx proc-index emit-proc-signature ";\n" emit
    end
end

proc emit-prototypes ModuleContext -- do
    let ctx do
        0
        while dup ctx @ModuleContext.proc_count < do
            dup
            let proc-index do
                ctx proc-index emit-c-prototype
            end
            1 +
        end
        drop
    end
end

proc emit-c-emitter-support ptr -- do
    let program do
        emit-c-preamble
        program emit-string-globals
        program emit-result-typedefs
        program @program-module-head
        while dup ptr cast int cast 0 != do
            dup emit-prototypes
            @ModuleContext.next_module
        end
        drop
    end
end
// END C EMITTER SUPPORT

// BEGIN BODY COMPILER
proc emit-uppercase-hex-digit int -- do
    let digit do
        if digit 10 < do
            digit 48 +
        else
            digit 10 - 65 +
        end
        putc
    end
end

proc emit-proc-name-byte int -- do
    let byte do
        if byte is-ascii-letter byte is-digit || do
            byte putc
        else
            95 putc
            byte 16 / emit-uppercase-hex-digit
            byte 16 % emit-uppercase-hex-digit
        end
    end
end

proc emit-proc-source-name ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup
            let index do
                bytes index byte-read emit-proc-name-byte
            end
            1 +
        end
        drop
    end
end

proc emit-proc-name ModuleContext int -- do
    let ctx proc-index do
        "frog_proc_" emit
        ctx proc-index proc-global-id-at emit-unsigned
        95 putc
        ctx @ModuleContext.source ctx proc-index proc-name-start-at +
        ctx proc-index proc-name-length-at
        emit-proc-source-name
    end
end

proc emit-local-name int -- do
    108 putc
    emit-unsigned
end

proc emit-slot ptr int -- do
    let cc index do
        "frog_slots[" emit index emit-unsigned "]" emit
    end
end

proc emit-top-slot ptr -- do
    peek cc do cc @cc-type-count 1 - emit-slot end
end

proc check-proc-inputs ptr ModuleContext int int -- do
    let cc module proc-index remaining do
        if remaining 0 > do
            module
            module proc-index proc-input-start-at
            remaining 1 - +
            type-at
            let expected do
                cc expected type-expect
                cc module proc-index remaining 1 - check-proc-inputs
            end
        end
    end
end

proc push-proc-outputs ptr ModuleContext int int -- do
    let cc module proc-index output-index do
        if output-index module proc-index proc-output-count-at < do
            module
            module proc-index proc-output-start-at
            output-index +
            type-at
            cc swap type-push
            cc module proc-index output-index 1 + push-proc-outputs
        end
    end
end

proc apply-proc-contract ptr ModuleContext int -- do
    peek cc module proc-index do module proc-index proc-input-count-at check-proc-inputs
        cc module proc-index 0 push-proc-outputs
    end
end

proc check-function-inputs ptr ModuleContext int int -- do
    let cc module function-index remaining do
        if remaining 0 > do
            module function-index remaining 1 - function-input-type-at
            let expected do
                cc expected type-expect
                cc module function-index remaining 1 - check-function-inputs
            end
        end
    end
end

proc push-function-outputs ptr ModuleContext int int -- do
    let cc module function-index output-index do
        if output-index module function-index function-output-count-at < do
            module function-index output-index function-output-type-at
            cc swap type-push
            cc module function-index output-index 1 + push-function-outputs
        end
    end
end

proc apply-function-contract ptr ModuleContext int -- do
    peek cc module function-index do
        module function-index function-input-count-at
        check-function-inputs
        cc module function-index 0 push-function-outputs
    end
end

proc emit-binary-operation ptr String -- do
    let cc operator do
        if cc @cc-emitting do
            cc @cc-type-count 1 -
            let left-index do
                cc @cc-type-count
                let right-index do
                    cc emit-indent
                    cc left-index emit-slot " = " emit
                    cc left-index emit-slot operator emit
                    cc right-index emit-slot ";" emit 10 putc
                end
            end
        end
    end
end

proc emit-unary-operation ptr String -- do
    let cc operator do
        if cc @cc-emitting do
            cc emit-indent
            cc emit-top-slot " = " emit operator emit cc emit-top-slot ";" emit 10 putc
        end
    end
end

proc emit-checked-binary-operation ptr String -- do
    let cc operator do
        if cc @cc-emitting do
            cc @cc-type-count 1 -
            let left-index do
                cc @cc-type-count
                let right-index do
                    cc emit-indent "if (" emit cc right-index emit-slot
                    " == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); }" emit 10 putc
                    cc emit-indent
                    cc left-index emit-slot " = " emit
                    cc left-index emit-slot operator emit
                    cc right-index emit-slot ";" emit 10 putc
                end
            end
        end
    end
end

proc emit-divmod ptr -- do
    let cc do
        if cc @cc-emitting do
            cc @cc-type-count 2 -
            let left-index do
                cc @cc-type-count 1 -
                let right-index do
                    cc emit-indent "{ Cell a = " emit cc left-index emit-slot
                    "; Cell b = " emit cc right-index emit-slot
                    "; if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } " emit
                    cc left-index emit-slot " = a / b; " emit
                    cc right-index emit-slot " = a % b; }" emit 10 putc
                end
            end
        end
    end
end

proc compile-fixed-binary ptr int int String -- do
    let cc input-type output-type operator do
        cc input-type type-expect
        cc input-type type-expect
        cc output-type type-push
        cc operator emit-binary-operation
    end
end

proc compile-fixed-unary ptr int int String -- do
    let cc input-type output-type operator do
        cc input-type type-expect
        cc output-type type-push
        cc operator emit-unary-operation
    end
end

proc compile-checked-binary ptr String -- do
    let cc operator do
        cc type-int type-expect
        cc type-int type-expect
        cc type-int type-push
        cc operator emit-checked-binary-operation
    end
end

proc compile-add-sub ptr bool -- do
    let cc subtract do
        cc type-pop
        cc type-pop
        let right-type left-type do
            if left-type type-int == right-type type-int == && do
                cc type-int type-push
            else
                if left-type type-ptr == right-type type-int == && do
                    cc type-ptr type-push
                else
                    "invalid operand types for pointer/integer arithmetic" fail
                end
            end
            if subtract do
                cc " - " emit-binary-operation
            else
                cc " + " emit-binary-operation
            end
        end
    end
end

proc compile-arithmetic-intrinsic ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "+" token-equals do
            cc false compile-add-sub true
        elif cc @cc-defining-module token-index "-" token-equals do
            cc true compile-add-sub true
        elif cc @cc-defining-module token-index "*" token-equals do
            cc type-int type-int " * " compile-fixed-binary true
        elif cc @cc-defining-module token-index "/" token-equals do
            cc " / " compile-checked-binary true
        elif cc @cc-defining-module token-index "%" token-equals do
            cc " % " compile-checked-binary true
        elif cc @cc-defining-module token-index "/%" token-equals do
            cc type-int type-expect
            cc type-int type-expect
            cc type-int type-push
            cc type-int type-push
            cc emit-divmod
            true
        elif cc @cc-defining-module token-index "<<" token-equals do
            cc type-int type-int " << " compile-fixed-binary true
        elif cc @cc-defining-module token-index ">>" token-equals do
            cc type-int type-int " >> " compile-fixed-binary true
        elif cc @cc-defining-module token-index "|" token-equals do
            cc type-int type-int " | " compile-fixed-binary true
        elif cc @cc-defining-module token-index "&" token-equals do
            cc type-int type-int " & " compile-fixed-binary true
        elif cc @cc-defining-module token-index "^" token-equals do
            cc type-int type-int " ^ " compile-fixed-binary true
        elif cc @cc-defining-module token-index "~" token-equals do
            cc type-int type-int "~" compile-fixed-unary true
        else
            false
        end
    end
end

proc compile-logic-comparison-intrinsic ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "&&" token-equals do
            cc type-bool type-bool " && " compile-fixed-binary true
        elif cc @cc-defining-module token-index "||" token-equals do
            cc type-bool type-bool " || " compile-fixed-binary true
        elif cc @cc-defining-module token-index "!" token-equals do
            cc type-bool type-bool "!" compile-fixed-unary true
        elif cc @cc-defining-module token-index "==" token-equals do
            cc type-int type-bool " == " compile-fixed-binary true
        elif cc @cc-defining-module token-index "!=" token-equals do
            cc type-int type-bool " != " compile-fixed-binary true
        elif cc @cc-defining-module token-index "<" token-equals do
            cc type-int type-bool " < " compile-fixed-binary true
        elif cc @cc-defining-module token-index ">" token-equals do
            cc type-int type-bool " > " compile-fixed-binary true
        elif cc @cc-defining-module token-index "<=" token-equals do
            cc type-int type-bool " <= " compile-fixed-binary true
        elif cc @cc-defining-module token-index ">=" token-equals do
            cc type-int type-bool " >= " compile-fixed-binary true
        else
            false
        end
    end
end

const type-literal-base 100 end
proc type-is-nominal int -- bool do
    dup type-nominal-base >= swap type-function-base < &&
end
proc type-is-function int -- bool do type-function-base >= end

proc compile-cast-intrinsic ptr -- do
    peek cc do type-pop
        cc type-pop
        let target-literal source-type do
            if target-literal 0 < do
                0 target-literal -
            else
                target-literal type-literal-base -
            end
            let target-type do
                if
                    target-type type-int ==
                    target-type type-bool == ||
                    target-type type-ptr == ||
                    target-type type-string == ||
                    target-type type-is-nominal ||
                    target-type type-is-function ||
                    !
                do
                    "cast target is not a type literal" fail
                end
                if
                    source-type target-type ==
                    source-type type-int == target-type type-bool == && ||
                    source-type type-bool == target-type type-int == && ||
                    source-type type-int == target-type type-ptr == && ||
                    source-type type-ptr == target-type type-int == && ||
                    source-type type-ptr == target-type type-is-nominal && ||
                    source-type type-is-nominal target-type type-ptr == && ||
                    !
                do
                    "unsupported cast" fail
                end
                cc target-type type-push
                if source-type type-int == target-type type-bool == && do
                    if cc @cc-emitting do
                        cc emit-indent cc emit-top-slot " = " emit cc emit-top-slot " != 0;" emit 10 putc
                    end
                end
            end
        end
    end
end

proc compile-read-memory ptr String -- do
    let cc function-name do
        cc type-ptr type-expect
        cc type-int type-push
        if cc @cc-emitting do
            cc emit-indent cc emit-top-slot " = " emit function-name emit
            "((const void *)(intptr_t)" emit cc emit-top-slot ");" emit 10 putc
        end
    end
end

proc compile-write-memory ptr String -- do
    let cc function-name do
        cc type-ptr type-expect
        cc type-int type-expect
        if cc @cc-emitting do
            cc @cc-type-count
            peek value-index do 1 +
                let pointer-index do
                    cc emit-indent function-name emit "((void *)(intptr_t)" emit
                    cc pointer-index emit-slot ", " emit cc value-index emit-slot ");" emit 10 putc
                end
            end
        end
    end
end

proc emit-read-file ptr -- do
    let cc do
        if cc @cc-emitting do
            cc @cc-type-count 3 -
            let base do
                cc emit-indent "{ const void *path = (const void *)(intptr_t)" emit
                cc base emit-slot "; Cell path_length = " emit cc base 1 + emit-slot
                "; void *data; Cell data_length; Cell success = frog_read_file(path, path_length, &data, &data_length); " emit
                cc base emit-slot " = (Cell)(intptr_t)data; " emit
                cc base 1 + emit-slot " = data_length; " emit
                cc base 2 + emit-slot " = success; }" emit 10 putc
            end
        end
    end
end

proc emit-read-pointer ptr -- do
    let cc do
        if cc @cc-emitting do
            cc emit-indent cc emit-top-slot
            " = (Cell)(intptr_t)frog_read_ptr((const void *)(intptr_t)" emit
            cc emit-top-slot ");" emit 10 putc
        end
    end
end

proc emit-write-pointer ptr -- do
    let cc do
        if cc @cc-emitting do
            cc @cc-type-count
            peek value-index do 1 +
                let pointer-index do
                    cc emit-indent "frog_write_ptr((void *)(intptr_t)" emit cc pointer-index emit-slot
                    ", (void *)(intptr_t)" emit cc value-index emit-slot ");" emit 10 putc
                end
            end
        end
    end
end

proc compile-memory-io-intrinsic ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "read-file" token-equals do
            cc type-int type-expect
            cc type-ptr type-expect
            cc type-ptr type-push
            cc type-int type-push
            cc type-bool type-push
            cc emit-read-file
            true
        elif cc @cc-defining-module token-index "cast" token-equals do
            cc compile-cast-intrinsic true
        elif cc @cc-defining-module token-index "alloc" token-equals do
            cc type-int type-expect cc type-ptr type-push
            if cc @cc-emitting do
                cc emit-indent cc emit-top-slot " = (Cell)(intptr_t)frog_alloc(" emit
                cc emit-top-slot ");" emit 10 putc
            end
            true
        elif cc @cc-defining-module token-index "args" token-equals do
            cc type-ptr type-push
            cc type-int type-push
            if cc @cc-emitting do
                cc @cc-type-count 2 -
                let argv-index do
                    cc emit-indent cc argv-index emit-slot " = (Cell)(intptr_t)frog_argv;" emit 10 putc
                    cc emit-indent cc argv-index 1 + emit-slot " = (Cell)frog_argc;" emit 10 putc
                end
            end
            true
        elif cc @cc-defining-module token-index "@ptr" token-equals do
            cc type-ptr type-expect
            cc type-ptr type-push
            cc emit-read-pointer true
        elif cc @cc-defining-module token-index "@i8" token-equals do
            cc "frog_read_i8" compile-read-memory true
        elif cc @cc-defining-module token-index "@i16" token-equals do
            cc "frog_read_i16" compile-read-memory true
        elif cc @cc-defining-module token-index "@i32" token-equals do
            cc "frog_read_i32" compile-read-memory true
        elif cc @cc-defining-module token-index "@i64" token-equals do
            cc "frog_read_i64" compile-read-memory true
        elif cc @cc-defining-module token-index "@u8" token-equals do
            cc "frog_read_u8" compile-read-memory true
        elif cc @cc-defining-module token-index "@u16" token-equals do
            cc "frog_read_u16" compile-read-memory true
        elif cc @cc-defining-module token-index "@u32" token-equals do
            cc "frog_read_u32" compile-read-memory true
        elif cc @cc-defining-module token-index "@u64" token-equals do
            cc "frog_read_u64" compile-read-memory true
        elif cc @cc-defining-module token-index "!ptr" token-equals do
            cc type-ptr type-expect
            cc type-ptr type-expect
            cc emit-write-pointer
            true
        elif cc @cc-defining-module token-index "!i8" token-equals do
            cc "frog_write_i8" compile-write-memory true
        elif cc @cc-defining-module token-index "!i16" token-equals do
            cc "frog_write_i16" compile-write-memory true
        elif cc @cc-defining-module token-index "!i32" token-equals do
            cc "frog_write_i32" compile-write-memory true
        elif cc @cc-defining-module token-index "!i64" token-equals do
            cc "frog_write_i64" compile-write-memory true
        elif cc @cc-defining-module token-index "!u8" token-equals do
            cc "frog_write_u8" compile-write-memory true
        elif cc @cc-defining-module token-index "!u16" token-equals do
            cc "frog_write_u16" compile-write-memory true
        elif cc @cc-defining-module token-index "!u32" token-equals do
            cc "frog_write_u32" compile-write-memory true
        elif cc @cc-defining-module token-index "!u64" token-equals do
            cc "frog_write_u64" compile-write-memory true
        elif cc @cc-defining-module token-index "print" token-equals do
            cc type-pop
            let value-type do
                if value-type type-int == do
                    if cc @cc-emitting do
                        cc emit-indent "printf(\"%lld\\n\", (long long)" emit
                        cc cc @cc-type-count emit-slot ");" emit 10 putc
                    end
                elif value-type type-bool == do
                    if cc @cc-emitting do
                        cc emit-indent "fputs(" emit cc cc @cc-type-count emit-slot
                        " ? \"true\\n\" : \"false\\n\", stdout);" emit 10 putc
                    end
                else
                    "printing this type is not supported" fail
                end
            end
            true
        elif cc @cc-defining-module token-index "putc" token-equals do
            cc type-int type-expect
            if cc @cc-emitting do
                cc emit-indent "putchar((int)(unsigned char)" emit cc cc @cc-type-count emit-slot ");" emit 10 putc
            end
            true
        elif cc @cc-defining-module token-index "getc" token-equals do
            cc type-int type-push
            if cc @cc-emitting do
                cc emit-indent cc emit-top-slot " = (Cell)getchar();" emit 10 putc
            end
            true
        elif cc @cc-defining-module token-index "eputc" token-equals do
            cc type-int type-expect
            if cc @cc-emitting do
                cc emit-indent "fputc((int)(unsigned char)" emit cc cc @cc-type-count emit-slot
                ", stderr);" emit 10 putc
            end
            true
        elif cc @cc-defining-module token-index "exit" token-equals do
            cc type-int type-expect
            if cc @cc-emitting do
                cc emit-indent "exit((int)" emit cc cc @cc-type-count emit-slot ");" emit 10 putc
            end
            true
        elif cc @cc-defining-module token-index "?" token-equals do
            true
        else
            false
        end
    end
end

proc compile-intrinsic ptr int -- bool do
    let cc token-index do
        if cc token-index compile-arithmetic-intrinsic do
            true
        elif cc token-index compile-logic-comparison-intrinsic do
            true
        else
            cc token-index compile-memory-io-intrinsic
        end
    end
end

proc emit-push-integer ptr int -- do
    let cc value do
        if cc @cc-emitting do
            cc emit-indent
            cc emit-top-slot " = " emit value emit-integer ";" emit 10 putc
        end
    end
end

proc emit-push-pooled-string ptr int -- do
