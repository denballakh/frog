                    ctx token-index token-at @TokenEntry.length ctx field-index record-field-at !RecordFieldEntry.name_length
                    ctx type-token parse-type-token ctx field-index record-field-at !RecordFieldEntry.field_type
                    type-token ctx field-index record-field-at !RecordFieldEntry.type_token
                    field-index 1 + ctx !ModuleContext.record_field_count
                    ctx record-index record-type-at @RecordTypeEntry.field_count 1 +
                    ctx record-index record-type-at !RecordTypeEntry.field_count
                    ctx record-index type-token 1 + scan-record-fields
