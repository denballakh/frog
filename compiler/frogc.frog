proc ensure-constant-evaluator-capacity ConstantEvaluator* -- do
    let evaluator do
        if evaluator @ConstantEvaluator.count evaluator @ConstantEvaluator.capacity == do
            evaluator @ConstantEvaluator.capacity 2 *
            peek new-capacity do ConstantValue:sizeof * alloc
                let new-values do
                    evaluator @ConstantEvaluator.values
                      new-values
                        evaluator @ConstantEvaluator.count ConstantValue:sizeof *
                    bytes-copy
                    new-values evaluator !ConstantEvaluator.values
                    new-capacity evaluator !ConstantEvaluator.capacity
