end

proc valid-utf8 ptr int -- bool do 0 valid-utf8-from end

proc utf8-codepoint-at ptr int int -- int int do
    peek bytes length index do utf8-sequence-width
        let width do
            if width 0 == do
                "invalid character literal" fail
                0 0
            elif width 1 == do
                bytes index byte-read width
            elif width 2 == do
                bytes index byte-read 192 - 64 *
                bytes index 1 + byte-read 128 - +
                width
            elif width 3 == do
                bytes index byte-read 224 - 4096 *
                bytes index 1 + byte-read 128 - 64 * +
                bytes index 2 + byte-read 128 - +
                width
            else
                bytes index byte-read 240 - 262144 *
                bytes index 1 + byte-read 128 - 4096 * +
                bytes index 2 + byte-read 128 - 64 * +
                bytes index 3 + byte-read 128 - +
                width
            end
        end
    end
end

