proc !cc-max-type-count int ptr -- do cc-max-type-count-offset field-write end
proc !cc-type-capacity int ptr -- do cc-type-capacity-offset field-write end

proc cc-type-address ptr int -- ptr do
    let cc index do
        cc @cc-type-stack index cell-bytes * +
    end
end

proc ensure-type-capacity ptr -- do
    let cc do
        if cc @cc-type-count cc @cc-type-capacity == do
            if cc @cc-type-capacity max-int cell-bytes 2 * / > do
                "internal compile-time type stack capacity overflow" fail
            end
            cc @cc-type-capacity 2 *
            peek new-capacity do cell-bytes * alloc
                let new-stack do
                    cc @cc-type-stack new-stack cc @cc-type-count cell-bytes * memory-copy
                    new-stack cc !cc-type-stack
                    new-capacity cc !cc-type-capacity
                end
            end
        end
    end
end

proc type-push ptr int -- do
    let cc value do
        if cc @cc-emitting do
            if cc @cc-type-count cc @cc-max-type-count >= do
                "internal compile-time stack capacity exceeded" fail
            end
        end
        cc ensure-type-capacity
        value cc cc @cc-type-count cc-type-address 0 field-write
        cc @cc-type-count 1 + cc !cc-type-count
        if cc @cc-emitting ! do
            if cc @cc-type-count cc @cc-max-type-count > do
                cc @cc-type-count cc !cc-max-type-count
            end
        end
    end
end

proc type-pop ptr -- int do
    let cc do
        if cc @cc-type-count 0 <= do
            "compile-time stack underflow" fail
        end
        cc @cc-type-count 1 -
        peek index do cc !cc-type-count
            cc index cc-type-address 0 field-read
        end
    end
end

proc type-expect ptr int -- do
    let cc expected do
        if cc type-pop expected != do
            "compile-time stack type mismatch" fail
        end
    end
end

proc type-at-depth ptr int -- int do
    peek cc index do cc-type-address 0 field-read
    end
end

proc type-snapshot ptr -- ptr int do
    peek cc do @cc-type-count 1 + cell-bytes * alloc
        let snapshot do
            cc @cc-type-stack snapshot cc @cc-type-count cell-bytes * memory-copy
            snapshot cc @cc-type-count
        end
    end
end

proc restore-type-snapshot ptr ptr int -- do
    let cc snapshot count do
        snapshot cc @cc-type-stack count cell-bytes * memory-copy
        count cc !cc-type-count
    end
end

proc types-match-from ptr ptr int int -- bool do
    let cc snapshot count index do
        if index count >= do
            true
        else
            if cc index type-at-depth snapshot index cell-bytes * field-read != do
                false
            else
                cc snapshot count index 1 + types-match-from
            end
        end
    end
end

proc types-match ptr ptr int -- bool do
    let cc snapshot count do
        if cc @cc-type-count count != do
            false
        else
            cc snapshot count 0 types-match-from
        end
    end
end

proc block-address ptr int -- ptr do
    let cc index do
        cc @cc-blocks index block-bytes * +
    end
end

proc block-field ptr int -- int do field-read end
proc set-block-field int ptr int -- do field-write end
proc block-pointer-field ptr int -- ptr do pointer-field-read end
proc set-block-pointer-field ptr ptr int -- do pointer-field-write end

proc push-block ptr int -- ptr do
    let cc kind do
        cc cc @cc-block-count block-address
        let block do
            kind block block-kind-offset set-block-field
            cc type-snapshot
            let snapshot count do
                snapshot block block-base-types-offset set-block-pointer-field
                count block block-base-count-offset set-block-field
            end
            0 block block-then-types-offset set-block-field
            0 block block-then-count-offset set-block-field
            cc @cc-local-count block block-local-base-offset set-block-field
            0 block block-has-else-offset set-block-field
            0 block block-has-do-offset set-block-field
            0 block block-elif-parent-offset set-block-field
            cc @cc-block-count 1 + cc !cc-block-count
            block
        end
    end
end

proc top-block ptr -- ptr do
    let cc do
        if cc @cc-block-count 0 <= do
            "control-flow block stack underflow" fail
        end
        cc cc @cc-block-count 1 - block-address
    end
end

proc pop-block ptr -- ptr do
    peek cc do top-block
        cc @cc-block-count 1 - cc !cc-block-count
    end
end

proc local-address ptr int -- LocalEntry do
    let cc index do
        cc @cc-locals index LocalEntry:sizeof * + LocalEntry cast
    end
end

proc add-local ptr int int -- int do
    let cc name-token value-type do
        cc cc @cc-local-count local-address
        let local do
            cc @cc-defining-module name-token token-start-at local !LocalEntry.name_start
            cc @cc-defining-module name-token token-length-at local !LocalEntry.name_length
            value-type local !LocalEntry.value_type
            cc @cc-next-local local !LocalEntry.id
            cc @cc-defining-module local !LocalEntry.module
            cc @cc-local-count 1 + cc !cc-local-count
            cc @cc-next-local
            cc @cc-next-local 1 + cc !cc-next-local
        end
    end
end

proc local-name-equals ptr LocalEntry int -- bool do
    let cc local token-index do
        local @LocalEntry.module @ModuleContext.source
        local @LocalEntry.name_start +
        local @LocalEntry.name_length
        cc @cc-defining-module token-index token-slice
        bytes-equal
    end
end

proc find-local-from ptr int int -- int do
    let cc token-index local-index do
        if local-index 0 < do
            0 1 -
        else
            cc local-index local-address
            let local do
                if cc local token-index local-name-equals do
                    local-index
                else
                    cc token-index local-index 1 - find-local-from
                end
            end
        end
    end
end

proc find-local ptr int -- int do
    peek cc token-index do cc @cc-local-count 1 - find-local-from
    end
end

proc emit-indent ptr -- do
    let cc do
        0
        while dup cc @cc-indent < do
            "  " emit
            1 +
        end
        drop
    end
end

proc emit-line ptr String -- do
    let cc code do
        if cc @cc-emitting do
            cc emit-indent
            code emit
            10 putc
        end
    end
end

proc indent-more ptr -- do
    peek cc do @cc-indent 1 + cc !cc-indent end
end

proc indent-less ptr -- do
    let cc do
        if cc @cc-indent 0 <= do
            "C emitter indentation underflow" fail
        end
        cc @cc-indent 1 - cc !cc-indent
    end
end

// BEGIN C EMITTER SUPPORT
proc raw-string-byte ModuleContext int int -- int do
    let ctx token raw-index do
        ctx @ModuleContext.source
        ctx token token-start-at
        raw-index +
        byte-read
    end
end

proc raw-string-length ModuleContext int -- int do
    peek ctx token do token-length-at end
end

proc decoded-string-unit ModuleContext int int -- int int do
    peek ctx token raw-index do raw-string-byte
        let byte do
            if byte 92 != do
                byte 1
            else
                raw-index 1 +
                let escape-index do
                    if escape-index ctx token raw-string-length >= do
                        "unterminated string escape" fail
                    end
                    ctx token escape-index raw-string-byte
                    let escaped do
                        if escaped 92 == do 92 2
                        elif escaped 34 == do 34 2
                        elif escaped 110 == do 10 2
                        elif escaped 114 == do 13 2
                        elif escaped 116 == do 9 2
                        elif escaped 48 == do 0 2
                        elif escaped 120 == do
                            if escape-index 2 + ctx token raw-string-length >= do
                                "incomplete hexadecimal string escape" fail
                            end
                            ctx token escape-index 1 + raw-string-byte
                            ctx token escape-index 2 + raw-string-byte
                            let high low do
                                if high is-hex-digit low is-hex-digit && ! do
                                    "invalid hexadecimal string escape" fail
                                end
                                high hex-value 16 * low hex-value + 4
                            end
                        else
                            "invalid string escape" fail
                            0 0
                        end
                    end
                end
            end
        end
    end
end

proc decoded-string-length ModuleContext int -- int do
    let ctx token do
        0 0
        while
            peek raw-index count do
                raw-index ctx token raw-string-length <
            end
        do
            let raw-index count do
                ctx token raw-index decoded-string-unit
                let ignored width do
                    raw-index width + count 1 +
                end
            end
        end
        let raw-index count do count end
    end
end

proc decoded-string-byte-from ModuleContext int int int -- int do
    let ctx token raw-index byte-index do
        if raw-index ctx token raw-string-length >= do
            "decoded string byte index out of bounds" fail
        end
        ctx token raw-index decoded-string-unit
        let value width do
            if byte-index 0 == do
                value
            else
                ctx token raw-index width + byte-index 1 - decoded-string-byte-from
            end
        end
    end
end

proc decoded-string-byte ModuleContext int int -- int do
    let ctx token byte-index do
        ctx token 0 byte-index decoded-string-byte-from
    end
end

proc decode-string-copy-from ModuleContext int int ptr int -- do
    let ctx token raw-index destination destination-index do
        if raw-index ctx token raw-string-length < do
            ctx token raw-index decoded-string-unit let value width do
                value destination destination-index byte-write
                ctx token raw-index width + destination destination-index 1 + decode-string-copy-from
            end
        end
    end
end

proc hash-string-bytes ptr int -- int do
    let bytes length do
        0 fnv-offset-basis
        while
            peek index hash do index length <
            end
        do
            let index hash do
                index 1 +
                hash bytes index byte-read ^ fnv-prime * fnv-modulus %
            end
        end
        let index hash do hash end
    end
end

proc pooled-string-matches ptr int ptr int int -- bool do
    let program string-index bytes length hash do
        if program string-index string-hash-at hash != do
            false
        elif program string-index string-length-at length != do
            false
        else
            program string-index string-data-at
            program string-index string-length-at
            bytes length bytes-equal
        end
    end
end

proc find-pooled-string ptr ptr int int -- int do
    let program bytes length hash do
        0 0 1 -
        while
            peek string-index found do
                string-index program @program-string-count < found 0 < &&
            end
        do
            let string-index found do
                string-index 1 +
                if program string-index bytes length hash pooled-string-matches do
                    string-index
                else
                    found
                end
            end
        end
        let string-index found do found end
    end
end

proc count-string-hash ptr int -- int do
    let program hash do
        0 0
        while
            peek string-index count do string-index program @program-string-count <
            end
        do
            let string-index count do
                string-index 1 +
                if program string-index string-hash-at hash == do
                    count 1 +
                else
                    count
                end
            end
        end
        let string-index count do count end
    end
end

proc add-pooled-string ptr ptr int int int -- int do
    let program bytes length hash collision do
        program @program-string-count
        let string-index do
            bytes program string-index set-string-data
            length program string-index string-length-offset set-string-field
            hash program string-index string-hash-offset set-string-field
            collision program string-index string-collision-offset set-string-field
            string-index 1 + program !program-string-count
            string-index
        end
    end
end

proc intern-string-token ptr ModuleContext int -- do
    let program ctx token do
        ctx token decoded-string-length
        peek length do alloc
            let bytes do
                ctx token 0 bytes 0 decode-string-copy-from
                bytes length hash-string-bytes
                let hash do
                    program bytes length hash find-pooled-string
                    let existing do
