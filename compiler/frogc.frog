            cc cc @CompileContext.format_operation_frame_count format-operation-frame-at
            let frame do
                cc @CompileContext.defining_module frame !FormatOperationFrame.source_module
                token frame !FormatOperationFrame.token_start
                cc @CompileContext.type_count frame !FormatOperationFrame.before_count
                cc @CompileContext.type_count frame !FormatOperationFrame.minimum_count
                cc @CompileContext.format_operation_frame_count 1 + cc !CompileContext.format_operation_frame_count
