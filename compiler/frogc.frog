  int64_t count;
  int64_t capacity;
} FrogStack;

static FrogStack frog_stack = {0};
static int frog_argc;
static char **frog_argv;

void frog_runtime_fail(void) {
  exit(1);
}

void* frog_alloc(Cell size) {
  if (size < 0 || (uint64_t)size > SIZE_MAX) frog_runtime_fail();
  void* value = malloc((size_t)size);
  if (value == NULL && size != 0) frog_runtime_fail();
  return value;
}

void frog_stack_grow(void) {
  int64_t capacity = frog_stack.capacity == 0 ? 16 : frog_stack.capacity * 2;
  if (capacity < frog_stack.capacity || (uint64_t)capacity > SIZE_MAX / sizeof(Cell)) frog_runtime_fail();
  Cell* values = realloc(frog_stack.values, (size_t)capacity * sizeof(Cell));
  if (values == NULL) frog_runtime_fail();
  frog_stack.values = values;
  frog_stack.capacity = capacity;
}

void frog_push(Cell value) {
  if (frog_stack.count == frog_stack.capacity) frog_stack_grow();
  frog_stack.values[frog_stack.count++] = value;
}

Cell frog_pop(void) {
  if (frog_stack.count == 0) frog_runtime_fail();
  return frog_stack.values[--frog_stack.count];
}

" emit
    "Cell frog_read_file(const void* path_bytes, Cell path_length, void** data, Cell* data_length) {
  *data = NULL;
  *data_length = 0;
  if (path_length < 0 || (uint64_t)path_length >= SIZE_MAX) return 0;
  if (path_length > 0 && path_bytes == NULL) return 0;
  if (path_length > 0 && memchr(path_bytes, 0, (size_t)path_length) != NULL) return 0;
  char* path = malloc((size_t)path_length + 1);
  if (path == NULL) return 0;
  if (path_length > 0) memcpy(path, path_bytes, (size_t)path_length);
  path[(size_t)path_length] = '\\0';
  FILE* file = fopen(path, \"rb\");
  free(path);
  if (file == NULL) return 0;
  if (fseek(file, 0, SEEK_END) != 0) { fclose(file); return 0; }
  long end = ftell(file);
  if (end < 0 || (uint64_t)end > INT64_MAX) { fclose(file); return 0; }
  if (fseek(file, 0, SEEK_SET) != 0) { fclose(file); return 0; }
  size_t size = (size_t)end;
  unsigned char* bytes = malloc(size == 0 ? 1 : size);
  if (bytes == NULL) { fclose(file); return 0; }
  if (fread(bytes, 1, size, file) != size) { free(bytes); fclose(file); return 0; }
  if (fclose(file) != 0) { free(bytes); return 0; }
  *data = bytes;
  *data_length = (Cell)size;
  return 1;
}

" emit
    "Cell frog_read_i8(const void* ptr) { int8_t value; memcpy(&value, ptr, sizeof(value)); return value; }
Cell frog_read_i16(const void* ptr) { int16_t value; memcpy(&value, ptr, sizeof(value)); return value; }
Cell frog_read_i32(const void* ptr) { int32_t value; memcpy(&value, ptr, sizeof(value)); return value; }
Cell frog_read_i64(const void* ptr) { int64_t value; memcpy(&value, ptr, sizeof(value)); return value; }
Cell frog_read_u8(const void* ptr) { uint8_t value; memcpy(&value, ptr, sizeof(value)); return (Cell)value; }
Cell frog_read_u16(const void* ptr) { uint16_t value; memcpy(&value, ptr, sizeof(value)); return (Cell)value; }
Cell frog_read_u32(const void* ptr) { uint32_t value; memcpy(&value, ptr, sizeof(value)); return (Cell)value; }
Cell frog_read_u64(const void* ptr) { uint64_t value; memcpy(&value, ptr, sizeof(value)); return (Cell)value; }
void* frog_read_ptr(const void* ptr) { void* value; memcpy(&value, ptr, sizeof(value)); return value; }
void frog_write_ptr(void* ptr, void* value) { memcpy(ptr, &value, sizeof(value)); }

Cell frog_union_tag(const void* value, Cell case_count) {
  if (value == NULL) frog_runtime_fail();
  Cell tag = frog_read_i64(value);
  if (tag < 0 || tag >= case_count) frog_runtime_fail();
  return tag;
}

" emit
    "void frog_write_i8(void* ptr, Cell value) { int8_t stored = (int8_t)value; memcpy(ptr, &stored, sizeof(stored)); }
void frog_write_i16(void* ptr, Cell value) { int16_t stored = (int16_t)value; memcpy(ptr, &stored, sizeof(stored)); }
void frog_write_i32(void* ptr, Cell value) { int32_t stored = (int32_t)value; memcpy(ptr, &stored, sizeof(stored)); }
void frog_write_i64(void* ptr, Cell value) { int64_t stored = (int64_t)value; memcpy(ptr, &stored, sizeof(stored)); }
void frog_write_u8(void* ptr, Cell value) { uint8_t stored = (uint8_t)value; memcpy(ptr, &stored, sizeof(stored)); }
void frog_write_u16(void* ptr, Cell value) { uint16_t stored = (uint16_t)value; memcpy(ptr, &stored, sizeof(stored)); }
void frog_write_u32(void* ptr, Cell value) { uint32_t stored = (uint32_t)value; memcpy(ptr, &stored, sizeof(stored)); }
void frog_write_u64(void* ptr, Cell value) { uint64_t stored = (uint64_t)value; memcpy(ptr, &stored, sizeof(stored)); }

" emit
    "int froglang_fork(void) {
  if (fflush(NULL) != 0) return -1;
  return (int)fork();
}
int froglang_create_file(void* path) { return open((const char*)path, O_WRONLY | O_CREAT | O_TRUNC, 0600); }
int froglang_dup2(int old_fd, int new_fd) { return dup2(old_fd, new_fd); }
int froglang_close(int fd) { return close(fd); }
int froglang_chdir(void* path) { return chdir((const char*)path); }
int froglang_execv(void* path, void* arguments) { return execv((const char*)path, (char* const*)arguments); }
int froglang_execvp(void* file, void* arguments) { return execvp((const char*)file, (char* const*)arguments); }

int froglang_ensure_directory(void* path) {
  const char* directory = (const char*)path;
  if (mkdir(directory, 0777) != 0 && errno != EEXIST) return -1;
  struct stat info;
  if (stat(directory, &info) != 0 || !S_ISDIR(info.st_mode)) return -1;
  return 0;
}

int froglang_path_exists(void* path) {
  struct stat info;
  return stat((const char*)path, &info) == 0;
}

int froglang_wait_child(int child) {
  int status;
  while (waitpid((pid_t)child, &status, 0) < 0) {
    if (errno != EINTR) return -1;
  }
  if (WIFEXITED(status)) return WEXITSTATUS(status);
  if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);
  return 1;
}

void froglang_finish_child(int status) {
  if (fflush(stdout) != 0) status = 1;
  _exit(status);
}

void froglang_reset_child_signals(void) {
  struct sigaction action;
  memset(&action, 0, sizeof(action));
  action.sa_handler = SIG_DFL;
  sigemptyset(&action.sa_mask);
  (void)sigaction(SIGINT, &action, NULL);
  (void)sigaction(SIGTERM, &action, NULL);
  (void)sigaction(SIGPIPE, &action, NULL);
  (void)sigaction(SIGHUP, &action, NULL);
}

" emit
end

proc emit-c-string-byte int -- do
    let byte do
        if byte 34 == do
            "\\\"" emit
        elif byte 92 == do
            "\\\\" emit
        elif byte 10 == do
            "\\n" emit
        elif byte 13 == do
            "\\r" emit
        elif byte 9 == do
            "\\t" emit
        elif byte 63 == do
            "\\?" emit
        elif byte 32 >= byte 126 <= && do
            byte putc
        else
            92 putc
            byte 64 / 48 + putc
            byte 8 / 8 % 48 + putc
            byte 8 % 48 + putc
        end
    end
end

proc emit-c-string-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup
            let index do
                bytes index byte-read emit-c-string-byte
            end
            1 +
        end
        drop
    end
end

proc emit-string-symbol ptr int -- do
    let program string-index do
        "frog_string_" emit
        program string-index string-hash-at emit-unsigned
        program string-index string-collision-at
        let collision do
            if collision 0 > do
                "_" emit collision emit-unsigned
            end
        end
    end
end

proc emit-string-bytes-symbol ptr int -- do
    let program string-index do
        program string-index emit-string-symbol
        "_bytes" emit
    end
end

proc emit-c-string-literal ptr int -- do
    let program string-index do
        "static uint8_t " emit program string-index emit-string-bytes-symbol
        "[] = \"" emit
        program string-index string-data-at
        program string-index string-length-at
        emit-c-string-bytes
        "\";\n" emit
        "static const FrogString " emit program string-index emit-string-symbol
        " = { " emit program string-index emit-string-bytes-symbol ", " emit
        program string-index string-length-at emit-unsigned
        " };\n" emit
    end
end

proc emit-string-globals ptr -- do
    let program do
        0
        while dup program @program-string-count < do
            dup
            let string-index do
                program string-index emit-c-string-literal
            end
            1 +
        end
        drop
    end
end

proc emit-string-references ptr -- do
    let program do
        0
        while dup program @program-string-count < do
            dup
            let string-index do
                "  (void)&" emit program string-index emit-string-symbol ";\n" emit
            end
            1 +
        end
        drop
    end
end

proc emit-c-abi-type int -- do
    let value-type do
        if value-type type-int == do
            "int" emit
        elif value-type type-bool == do
            "int" emit
        elif value-type type-ptr == do
            "void *" emit
        else
            "internal unknown C ABI type" fail
        end
    end
end

proc emit-c-symbol ptr int -- do
    let ctx proc-index do
        ctx ctx proc-index proc-c-symbol-token-at token-slice emit-bytes
    end
end

proc emit-c-parameter-types ptr int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index proc-input-count-at < do
            if input-index 0 != do ", " emit end
            ctx
            ctx proc-index proc-input-start-at input-index +
            type-at emit-c-abi-type
            ctx proc-index input-index 1 + emit-c-parameter-types
        end
    end
end

proc emit-external-c-prototype ptr int -- do
    let ctx proc-index do
        "extern " emit
        if ctx proc-index proc-output-count-at 0 == do
            "void" emit
        else
            ctx ctx proc-index proc-output-start-at type-at emit-c-abi-type
        end
        " " emit ctx proc-index emit-c-symbol "(" emit
        if ctx proc-index proc-input-count-at 0 == do
            "void" emit
        else
            ctx proc-index 0 emit-c-parameter-types
        end
        ");\n" emit
    end
end

proc emit-c-prototype ptr int -- do
    let ctx proc-index do
        if ctx proc-index proc-external-at do
            ctx proc-index emit-external-c-prototype
        end
        "void p" emit
        ctx proc-index proc-global-id-at emit-unsigned
        "(void);\n" emit
    end
end

proc emit-prototypes ptr -- do
    let ctx do
        0
        while dup ctx @ctx-proc-count < do
            dup
            let proc-index do
                ctx proc-index emit-c-prototype
            end
            1 +
        end
        drop
    end
end

proc emit-c-emitter-support ptr -- do
    let program do
        program @program-root-module emit-c-preamble
        program emit-string-globals
        program @program-module-head
        while dup int cast 0 != do
            dup emit-prototypes
            @ctx-next-module
        end
        drop
    end
end
// END C EMITTER SUPPORT

// BEGIN BODY COMPILER
proc emit-proc-name int -- do
    112 putc
    emit-unsigned
end

proc emit-local-name int -- do
    108 putc
    emit-unsigned
end

proc check-proc-inputs ptr ptr int int -- do
    let cc module proc-index remaining do
        if remaining 0 > do
            module
            module proc-index proc-input-start-at
            remaining 1 - +
            type-at
            let expected do
                cc expected type-expect
                cc module proc-index remaining 1 - check-proc-inputs
            end
        end
    end
end

proc push-proc-outputs ptr ptr int int -- do
    let cc module proc-index output-index do
        if output-index module proc-index proc-output-count-at < do
            module
            module proc-index proc-output-start-at
            output-index +
            type-at
            cc swap type-push
            cc module proc-index output-index 1 + push-proc-outputs
        end
    end
end

proc apply-proc-contract ptr ptr int -- do
    let cc module proc-index do
        cc module proc-index module proc-index proc-input-count-at check-proc-inputs
        cc module proc-index 0 push-proc-outputs
    end
end

proc check-function-inputs ptr ptr int int -- do
    let cc module function-index remaining do
        if remaining 0 > do
            module function-index remaining 1 - function-input-type-at
            let expected do
                cc expected type-expect
                cc module function-index remaining 1 - check-function-inputs
            end
        end
    end
end

proc push-function-outputs ptr ptr int int -- do
    let cc module function-index output-index do
        if output-index module function-index function-output-count-at < do
            module function-index output-index function-output-type-at
            cc swap type-push
            cc module function-index output-index 1 + push-function-outputs
        end
    end
end

proc apply-function-contract ptr ptr int -- do
    let cc module function-index do
        cc
        module
        function-index
        module function-index function-input-count-at
        check-function-inputs
        cc module function-index 0 push-function-outputs
    end
end

proc compile-fixed-binary ptr int int String -- do
    let cc input-type output-type code do
        cc input-type type-expect
        cc input-type type-expect
        cc output-type type-push
        cc code emit-line
    end
end

proc compile-fixed-unary ptr int int String -- do
    let cc input-type output-type code do
        cc input-type type-expect
        cc output-type type-push
        cc code emit-line
    end
end

proc compile-add-sub ptr bool -- do
    let cc subtract do
        cc type-pop
        cc type-pop
        let right-type left-type do
            if left-type type-int == right-type type-int == && do
                cc type-int type-push
            else
                if left-type type-ptr == right-type type-int == && do
                    cc type-ptr type-push
                else
                    "invalid operand types for pointer/integer arithmetic" fail
                end
            end
            if subtract do
                cc "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a - b); }" emit-line
            else
                cc "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a + b); }" emit-line
            end
        end
    end
end

proc compile-arithmetic-intrinsic ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "+" token-equals do
            cc false compile-add-sub true
        elif cc @cc-defining-module token-index "-" token-equals do
            cc true compile-add-sub true
        elif cc @cc-defining-module token-index "*" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a * b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "/" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } frog_push(a / b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "%" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } frog_push(a % b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "/%" token-equals do
            cc type-int type-expect
            cc type-int type-expect
            cc type-int type-push
            cc type-int type-push
            cc "{ Cell b = frog_pop(); Cell a = frog_pop(); if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } frog_push(a / b); frog_push(a % b); }" emit-line
            true
        elif cc @cc-defining-module token-index "<<" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a << b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index ">>" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a >> b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "|" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a | b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "&" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a & b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "^" token-equals do
            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a ^ b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "~" token-equals do
            cc type-int type-int "frog_push(~frog_pop());" compile-fixed-unary true
        else
            false
        end
    end
end

proc compile-logic-comparison-intrinsic ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "&&" token-equals do
            cc type-bool type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a && b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "||" token-equals do
            cc type-bool type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a || b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "!" token-equals do
            cc type-bool type-bool "frog_push(!frog_pop());" compile-fixed-unary true
        elif cc @cc-defining-module token-index "==" token-equals do
            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a == b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "!=" token-equals do
            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a != b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "<" token-equals do
            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a < b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index ">" token-equals do
            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a > b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index "<=" token-equals do
            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a <= b); }" compile-fixed-binary true
        elif cc @cc-defining-module token-index ">=" token-equals do
            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a >= b); }" compile-fixed-binary true
        else
            false
        end
    end
end

proc type-literal-base -- int do 100 end
proc type-is-nominal int -- bool do
    dup type-nominal-base >= swap type-function-base < &&
end
proc type-is-function int -- bool do type-function-base >= end

proc compile-cast-intrinsic ptr -- do
    let cc do
        cc type-pop
        cc type-pop
        let target-literal source-type do
            if target-literal 0 < do
                0 target-literal -
            else
                target-literal type-literal-base -
            end
            let target-type do
                if
                    target-type type-int ==
                    target-type type-bool == ||
                    target-type type-ptr == ||
                    target-type type-string == ||
                    target-type type-is-nominal ||
                    target-type type-is-function ||
                    !
                do
                    "cast target is not a type literal" fail
                end
                if
                    source-type target-type ==
                    source-type type-int == target-type type-bool == && ||
                    source-type type-bool == target-type type-int == && ||
                    source-type type-int == target-type type-ptr == && ||
                    source-type type-ptr == target-type type-int == && ||
                    source-type type-ptr == target-type type-is-nominal && ||
                    source-type type-is-nominal target-type type-ptr == && ||
                    !
                do
                    "unsupported cast" fail
                end
                cc target-type type-push
                if source-type type-int == target-type type-bool == && do
                    cc "{ (void)frog_pop(); Cell value = frog_pop(); frog_push(value != 0); }" emit-line
                else
                    cc "(void)frog_pop();" emit-line
                end
            end
        end
    end
end

proc compile-read-memory ptr int String -- do
    let cc token-index code do
        cc type-ptr type-expect
        cc type-int type-push
        cc code emit-line
    end
end

proc compile-write-memory ptr int String -- do
    let cc token-index code do
        cc type-ptr type-expect
        cc type-int type-expect
        cc code emit-line
    end
end

proc compile-memory-io-intrinsic ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "read-file" token-equals do
            cc type-int type-expect
            cc type-ptr type-expect
            cc type-ptr type-push
            cc type-int type-push
            cc type-bool type-push
            cc "{ Cell path_length = frog_pop(); const void* path = (const void*)(intptr_t)frog_pop(); void* data; Cell data_length; Cell success = frog_read_file(path, path_length, &data, &data_length); frog_push((Cell)(intptr_t)data); frog_push(data_length); frog_push(success); }" emit-line
            true
        elif cc @cc-defining-module token-index "cast" token-equals do
            cc compile-cast-intrinsic true
        elif cc @cc-defining-module token-index "alloc" token-equals do
            cc type-int type-expect cc type-ptr type-push
            cc "frog_push((Cell)(intptr_t)frog_alloc(frog_pop()));" emit-line true
        elif cc @cc-defining-module token-index "args" token-equals do
            cc type-ptr type-push
            cc type-int type-push
            cc "frog_push((Cell)(intptr_t)frog_argv); frog_push((Cell)frog_argc);" emit-line true
        elif cc @cc-defining-module token-index "@ptr" token-equals do
            cc type-ptr type-expect
            cc type-ptr type-push
            cc "frog_push((Cell)(intptr_t)frog_read_ptr((const void *)(intptr_t)frog_pop()));" emit-line true
        elif cc @cc-defining-module token-index "@i8" token-equals do
            cc token-index "frog_push(frog_read_i8((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "@i16" token-equals do
            cc token-index "frog_push(frog_read_i16((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "@i32" token-equals do
            cc token-index "frog_push(frog_read_i32((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "@i64" token-equals do
            cc token-index "frog_push(frog_read_i64((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "@u8" token-equals do
            cc token-index "frog_push(frog_read_u8((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "@u16" token-equals do
            cc token-index "frog_push(frog_read_u16((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "@u32" token-equals do
            cc token-index "frog_push(frog_read_u32((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "@u64" token-equals do
            cc token-index "frog_push(frog_read_u64((const void *)(intptr_t)frog_pop()));" compile-read-memory true
        elif cc @cc-defining-module token-index "!ptr" token-equals do
            cc type-ptr type-expect
            cc type-ptr type-expect
            cc "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_ptr((void *)(intptr_t)p, (void *)(intptr_t)v); }" emit-line
            true
        elif cc @cc-defining-module token-index "!i8" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i8((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "!i16" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i16((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "!i32" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i32((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "!i64" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i64((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "!u8" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u8((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "!u16" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u16((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "!u32" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u32((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "!u64" token-equals do
            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u64((void *)(intptr_t)p, v); }" compile-write-memory true
        elif cc @cc-defining-module token-index "print" token-equals do
            cc type-pop
            let value-type do
                if value-type type-int == do
                    cc "printf(\"%lld\\n\", (long long)frog_pop());" emit-line
                elif value-type type-bool == do
                    cc "fputs(frog_pop() ? \"true\\n\" : \"false\\n\", stdout);" emit-line
                else
                    "printing this type is not supported" fail
                end
            end
            true
        elif cc @cc-defining-module token-index "putc" token-equals do
            cc type-int type-expect cc "putchar((int)(unsigned char)frog_pop());" emit-line true
        elif cc @cc-defining-module token-index "getc" token-equals do
            cc type-int type-push cc "frog_push((Cell)getchar());" emit-line true
        elif cc @cc-defining-module token-index "eputc" token-equals do
            cc type-int type-expect cc "fputc((int)(unsigned char)frog_pop(), stderr);" emit-line true
        elif cc @cc-defining-module token-index "exit" token-equals do
            cc type-int type-expect cc "exit((int)frog_pop());" emit-line true
        elif cc @cc-defining-module token-index "?" token-equals do
            true
        else
            false
        end
    end
end

proc compile-intrinsic ptr int -- bool do
    let cc token-index do
        if cc token-index compile-arithmetic-intrinsic do
            true
        elif cc token-index compile-logic-comparison-intrinsic do
            true
        else
            cc token-index compile-memory-io-intrinsic
        end
    end
end

proc emit-push-integer ptr int -- do
    let cc value do
        cc emit-indent
        "frog_push(" emit value emit-integer ");" emit 10 putc
    end
end

proc emit-push-string ptr int -- do
