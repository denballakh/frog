proc program-add-module ptr ptr -- do
    let program module do
        program module !ctx-program
        program @program-module-count module !ctx-module-id
        0 ptr cast module !ctx-next-module
        if program @program-module-count 0 == do
            module program !program-module-head
        else
            module program @program-module-tail !ctx-next-module
        end
        module program !program-module-tail
        program @program-module-count 1 + program !program-module-count
    end
end

proc token-address ptr int -- ptr do
    let ctx index do
        ctx @ctx-tokens index token-bytes * +
    end
end

proc token-field ptr int int -- int do
