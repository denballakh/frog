proc begin-format-operation CompileContext* int -- bool do
    let cc token do
        if
            cc @CompileContext.record_operations
            cc @CompileContext.program @Program.record_format_operations &&
            cc @CompileContext.current_expansion_id 0 < &&
        do
            if
                cc @CompileContext.format_operation_frame_count
