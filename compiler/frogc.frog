                operation !AnalyzedOperation.before_type_start
                cc @CompileContext.type_count operation !AnalyzedOperation.before_type_count
                0 1 - operation !AnalyzedOperation.after_type_start
                0 1 - operation !AnalyzedOperation.after_type_count
