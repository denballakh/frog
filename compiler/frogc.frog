proc load-program-source Program* ptr int ptr int -- do
    let program source source-length diagnostic-path diagnostic-path-length do
        if program @Program.phase ProgramPhase.allocated? ! do
            "internal program must be allocated before loading" fail
        end
        ModuleContext:alloc
        let ctx do
            0 ptr cast ctx !ModuleContext.canonical_path
            0 ctx !ModuleContext.canonical_path_length
            diagnostic-path diagnostic-path-length copy-bytes ctx !ModuleContext.diagnostic_path
            diagnostic-path-length ctx !ModuleContext.diagnostic_path_length
