proc checked-constant-multiply ConstantEvaluator* int int -- int do
    let evaluator left right do
        if left 0 == right 0 == || do
            0
        else
            if
                left min-int == right 0 1 - == &&
                right min-int == left 0 1 - == && ||
            do
                evaluator "constant integer overflow" constant-fail
            end
            if left 0 > do
                if right 0 > do
                    if left max-int right / > do
                        evaluator "constant integer overflow" constant-fail
                    end
                else
                    if right min-int left / < do
                        evaluator "constant integer overflow" constant-fail
                    end
                end
            else
                if right 0 > do
                    if left min-int right / < do
                        evaluator "constant integer overflow" constant-fail
                    end
                else
                    if right max-int left / < do
                        evaluator "constant integer overflow" constant-fail
                    end
                end
            end
            if evaluator @ConstantEvaluator.module @ModuleContext.program program-failed do 0 else left right * end
        end
    end
end

proc require-constant-divisor ConstantEvaluator* int int -- do
    let evaluator left right do
        if right 0 == do
            evaluator "constant division by zero" constant-fail
        end
        if left min-int == right 0 1 - == && do
            evaluator "constant integer overflow" constant-fail
        end
    end
end

proc checked-constant-divide ConstantEvaluator* int int -- int do
    peek evaluator left right do require-constant-divisor
