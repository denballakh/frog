                                    end
                                    module record-index record-type-at
                                    let record-type do
                                        if setter do
                                            cc record-type type-expect
                                            cc module field-index record-field-type-at type-expect
                                            cc module field-index record-field-byte-offset-at emit-record-field-write
                                        else
                                            cc record-type type-expect
                                            cc module field-index record-field-type-at type-push
                                            cc module field-index record-field-byte-offset-at emit-record-field-read
                                        end
