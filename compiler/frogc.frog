        end
    end
end

proc set-compile-occurrence-binding-part CompileContext* int int int int ScopeKind ModuleContext* int -- do
    let cc occurrence-index token relative-start length kind definition-module definition-index do
        cc occurrence-index token relative-start length kind definition-module definition-index
        cc @CompileContext.scope_module set-compile-occurrence-binding-part-in
        if dup ! do
            drop
            if
                cc @CompileContext.scope_module ptr cast int cast
                cc @CompileContext.program @Program.builtins_module ptr cast int cast !=
            do
                cc occurrence-index token relative-start length kind definition-module definition-index
                cc @CompileContext.program @Program.builtins_module set-compile-occurrence-binding-part-in drop
