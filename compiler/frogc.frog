proc finish-analyzed-block-with-types CompileContext* ModuleContext* int CFGTerminatorKind int int ptr int -- int do
    let cc terminator-module terminator-token kind first-target second-target exit-types exit-count do
        if cc cfg-recording ! do 0 1 - else
            cc active-analyzed-block
            let block do
                cc compile-context-analysis
