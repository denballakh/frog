                operation @AnalyzedOperation.intrinsic emit-inspect-intrinsic 9 putc
                operation @AnalyzedOperation.private_operation emit-inspect-private-operation 9 putc
                program analysis @ProcedureAnalysis.operation_types operation @AnalyzedOperation.before_type_start operation @AnalyzedOperation.before_type_count emit-inspect-type-list 9 putc
                program analysis @ProcedureAnalysis.operation_types operation @AnalyzedOperation.after_type_start operation @AnalyzedOperation.after_type_count emit-inspect-type-list
                10 putc
            end
        end
    end
end

