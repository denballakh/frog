                            let target-entry do
                                entry @ImportEntry.alias_token
                                if dup 0 < do
                                    drop entry @ImportEntry.name_token
                                end
                                let visible-token do
                                    if target-entry @ScopeEntry.kind ScopeKind:procedure == do
                                        ctx target entry @ImportEntry.name_token visible-token 0 add-imported-procedures-from
                                    elif
                                        target-entry @ScopeEntry.kind ScopeKind:record_type ==
                                        ctx visible-token identifier-token ! &&
                                    do
                                        ctx visible-token "record import alias must be an identifier" fail-at
                                    end
                                    if
                                        target-entry @ScopeEntry.kind ScopeKind:union_type ==
                                        ctx visible-token identifier-token ! &&
                                    do
                                        ctx visible-token "union import alias must be an identifier" fail-at
                                    end
                                    if
                                        target-entry @ScopeEntry.kind ScopeKind:function_type ==
                                        ctx visible-token identifier-token ! &&
                                    do
                                        ctx visible-token "function import alias must be an identifier" fail-at
                                    end
                                    if
                                        ctx visible-token find-proc 0 >=
                                        target-entry @ScopeEntry.kind ScopeKind:macro_symbol != &&
                                          ctx visible-token find-macro 0 >=
                                        target-entry @ScopeEntry.kind ScopeKind:macro_symbol != && ||
                                        ctx visible-token find-constant 0 >= ||
                                        ctx visible-token find-record 0 >= ||
                                        ctx visible-token find-union 0 >= ||
                                        ctx visible-token find-function 0 >= ||
                                        ctx visible-token find-c-type 0 >= ||
                                    do
                                        ctx visible-token "import alias conflict" fail-at
                                    end
                                    if ctx @ModuleContext.program program-failed ! do
                                        ctx ctx visible-token find-scope-symbol
                                        let existing do
                                            if existing 0 >= do
                                                if ctx existing target target-symbol scope-symbols-identical ! do
                                                    ctx visible-token "import alias conflict" fail-at
                                                end
                                            else
                                                ctx
                                                  ctx
                                                    visible-token
                                                      target-entry @ScopeEntry.kind
                                                        target-entry @ScopeEntry.definition_module
                                                          target-entry @ScopeEntry.definition_index
                                                add-scope-symbol-from-token
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc resolve-module-scope ModuleContext* -- do
    let ctx do
        if ctx @ModuleContext.resolve_state ResolveState:resolved == do
        else
            if ctx @ModuleContext.resolve_state ResolveState:resolving == do
                "cyclic import" fail
            end
            ResolveState:resolving ctx !ModuleContext.resolve_state
            0
            while dup ctx @ModuleContext.macro_count < do
                dup
                let macro-index do
                    ctx
                      ctx
                        ctx macro-index macro-at @MacroEntry.name_start
                          ctx macro-index macro-at @MacroEntry.name_length
                            ScopeKind:macro_symbol
                              ctx
                                macro-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while peek index do index ctx @ModuleContext.import_count < ctx @ModuleContext.program program-failed ! && end do
                dup ctx swap resolve-one-import
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.record_count < do
                dup
                let record-index do
                    ctx
                      ctx
                        ctx record-index record-type-at @RecordTypeEntry.name_start
                          ctx record-index record-type-at @RecordTypeEntry.name_length
                            ScopeKind:record_type
                              ctx
                                record-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.union_count < do
                dup
                let union-index do
                    ctx
                      ctx
                        ctx union-index union-type-at @UnionTypeEntry.name_start
                          ctx union-index union-type-at @UnionTypeEntry.name_length
                            ScopeKind:union_type
                              ctx
                                union-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.function_count < do
                dup
                let function-index do
                    ctx
                      ctx
                        ctx function-index function-type-at @FunctionTypeEntry.name_start
                          ctx function-index function-type-at @FunctionTypeEntry.name_length
                            ScopeKind:function_type
                              ctx
                                function-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.constant_count < do
                dup
                let constant-index do
                    ctx
                      ctx
                        ctx constant-index constant-at @ConstantEntry.name_start
                          ctx constant-index constant-at @ConstantEntry.name_length
                            ScopeKind:constant
                              ctx
                                constant-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.c_type_count < do
                dup let index do
                    ctx ctx ctx index c-type-at @CTypeEntry.name_start ctx index c-type-at @CTypeEntry.name_length ScopeKind:c_type ctx index add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.proc_count < do
                dup
                let proc-index do
                    ctx
                      ctx
                        ctx proc-index procedure-at @ProcedureEntry.name_start
                          ctx proc-index procedure-at @ProcedureEntry.name_length
                            ScopeKind:procedure
                              ctx
                                proc-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            if ctx @ModuleContext.program program-failed ! do ResolveState:resolved ctx !ModuleContext.resolve_state end
        end
    end
end

proc resolve-all-module-scopes Program* -- do
    peek program do @Program.module_head
        while peek module do module ptr cast int cast 0 != program program-failed ! && end do
            dup resolve-module-scope
            @ModuleContext.next_module
        end
        drop
    end
end

proc scope-kind-semantic-class ScopeKind -- SemanticClass do
    let kind do
        if kind ScopeKind:procedure == do SemanticClass:procedure
        elif kind ScopeKind:macro_symbol == do SemanticClass:macro_symbol
        elif kind ScopeKind:record_type == do SemanticClass:record_type
        elif kind ScopeKind:union_type == do SemanticClass:union_type
        elif kind ScopeKind:function_type == do SemanticClass:function_type
        elif kind ScopeKind:constant == do SemanticClass:constant
        elif kind ScopeKind:c_type == do SemanticClass:c_type
        else "internal unknown semantic scope kind" fail SemanticClass:intrinsic end
    end
end

