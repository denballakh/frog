proc evaluate-constant-exact-binary-value ConstantEvaluator* int int int ModuleContext* int -- int do
    let evaluator left right value-type module token-index do
        if
            module token-index "/" token-equals
            module token-index "%" token-equals ||
        do
            if right 0 == do evaluator "constant division by zero" constant-fail end
        end
        if module token-index "+" token-equals do
            left u64 cast right u64 cast + int cast
        elif module token-index "-" token-equals do
            left u64 cast right u64 cast - int cast
        elif module token-index "*" token-equals do
            left u64 cast right u64 cast * int cast
        elif module token-index "/" token-equals do
            if value-type constant-type-is-unsigned do
                left u64 cast right u64 cast / int cast
            else
                left right /
            end
        elif module token-index "%" token-equals do
            if value-type constant-type-is-unsigned do
                left u64 cast right u64 cast % int cast
            else
                left right %
            end
        elif module token-index "|" token-equals do
            left u64 cast right u64 cast | int cast
        elif module token-index "&" token-equals do
            left u64 cast right u64 cast & int cast
        else
            left u64 cast right u64 cast ^ int cast
        end
        value-type normalize-constant-integer
    end
end

proc evaluate-constant-exact-divmod-value ConstantEvaluator* int int int bool -- int do
    let evaluator left right value-type remainder do
        if right 0 == do evaluator "constant division by zero" constant-fail end
        if value-type constant-type-is-unsigned do
            if remainder do left u64 cast right u64 cast % int cast
            else left u64 cast right u64 cast / int cast end
        else
            if remainder do left right % else left right / end
        end
        value-type normalize-constant-integer
    end
end

proc evaluate-constant-exact-comparison-value int int int ModuleContext* int -- int do
    let left right value-type module token-index do
        if module token-index "==" token-equals do left right ==
        elif module token-index "!=" token-equals do left right !=
        elif value-type constant-type-is-unsigned do
            if module token-index "<" token-equals do left u64 cast right u64 cast <
            elif module token-index ">" token-equals do left u64 cast right u64 cast >
            elif module token-index "<=" token-equals do left u64 cast right u64 cast <=
            else left u64 cast right u64 cast >= end
        else
            if module token-index "<" token-equals do left right <
            elif module token-index ">" token-equals do left right >
            elif module token-index "<=" token-equals do left right <=
            else left right >= end
        end
        int cast
    end
end

proc evaluate-constant-exact-shift-value int int int ModuleContext* int -- int do
    let left right value-type module token-index do
