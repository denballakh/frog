proc emit-record-field-write CompileContext* RecordTypeEntry* RecordFieldEntry* -- do
    let cc record-entry field do
        cc @CompileContext.program record-entry @RecordTypeEntry.record_type program-intern-pointer-type let pointer-type do
        field @RecordFieldEntry.field_type let field-type do
        field @RecordFieldEntry.byte_offset let byte-offset do
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count
