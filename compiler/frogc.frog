end

proc finish-analyzed-block CompileContext* ModuleContext* int CFGTerminatorKind int int -- int do
    let cc terminator-module terminator-token kind first-target second-target do
        cc terminator-module terminator-token kind first-target second-target
                    cc @CompileContext.type_stack cc @CompileContext.type_count
        finish-analyzed-block-with-types
