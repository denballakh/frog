    end
end

proc emit-function-call ptr ModuleContext int -- do
    let cc function-module function-index do
        if cc @cc-emitting do
            function-module function-index function-output-count-at
            let output-count do
                cc @cc-type-count output-count -
                let base do
                    function-module function-index function-input-count-at
                    let input-count do
                        cc emit-indent "{ Cell function_id = " emit
                        cc base input-count + emit-slot ";" emit 10 putc
                        cc indent-more
                        cc emit-indent "switch (function_id) {" emit 10 putc
                        cc indent-more
                        cc cc @cc-program function-module function-index base emit-function-dispatch-cases
                        cc emit-indent "default: frog_runtime_fail();" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                    end
                end
            end
        end
    end
end

proc compile-function-operation ptr ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @cc-scope-module bytes separator visible-function-definition
            let function-module function-index found do
                if found ! do
                    false
                else
                    bytes separator 1 + +
                    length separator 1 + -
                    let operation operation-length do
                        if operation operation-length "call" bytes-equal-string do
                            cc function-module function-index function-type-at type-expect
                            cc function-module function-index apply-function-contract
                            cc function-module function-index emit-function-call
                            true
                        elif operation operation-length "ref" bytes-equal-string do
                            "expected function reference target" fail
                            false
                        elif
                            operation-length 4 >=
                            if dup do
                                drop operation 4 "ref:" bytes-equal-string
                            end
                        do
                            if operation-length 4 == do
                                "expected function reference target" fail
                            end
                            cc @cc-scope-module
                            operation 4 +
                            operation-length 4 -
                            visible-procedure-definition
                            let proc-module proc-index proc-found do
                                if proc-found ! do
                                    "function reference target not found" fail
                                end
                                if
                                    function-module function-index proc-module proc-index
                                    function-proc-contracts-equal
                                    !
                                do
                                    "function reference contract mismatch" fail
                                end
                                cc function-module function-index function-type-at type-push
                                cc proc-module proc-index proc-global-id-at emit-push-integer
                                true
                            end
                        else
                            "unknown function operation" fail
                            false
                        end
                    end
                end
            end
        end
    end
end

proc compile-function-word ptr int -- bool do
    let cc token-index do
        cc @cc-defining-module token-index token-slice
        peek bytes length do 58 first-index-of-byte
            let colon do
                if colon 0 >= do
                    cc bytes length colon compile-function-operation
                else
                    false
                end
            end
        end
    end
end

proc compile-string-word ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "String.bytes" token-equals do
            cc type-string type-expect
            cc type-ptr type-push
            if cc @cc-emitting do
                cc emit-indent "{ const FrogString *value = (const FrogString *)(intptr_t)" emit
                cc emit-top-slot "; " emit cc emit-top-slot " = (Cell)(intptr_t)value->bytes; }" emit 10 putc
            end
            true
        elif cc @cc-defining-module token-index "String.len" token-equals do
            cc type-string type-expect
            cc type-int type-push
            if cc @cc-emitting do
                cc emit-indent "{ const FrogString *value = (const FrogString *)(intptr_t)" emit
                cc emit-top-slot "; " emit cc emit-top-slot " = value->len; }" emit 10 putc
            end
            true
        else
            false
        end
    end
end

proc compile-type-word ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "int" token-equals do
            cc type-literal-base type-int + type-push
            cc type-literal-base type-int + emit-push-integer
            true
        elif cc @cc-defining-module token-index "bool" token-equals do
            cc type-literal-base type-bool + type-push
            cc type-literal-base type-bool + emit-push-integer
            true
        elif cc @cc-defining-module token-index "ptr" token-equals do
            cc type-literal-base type-ptr + type-push
            cc type-literal-base type-ptr + emit-push-integer
            true
        elif cc @cc-defining-module token-index "String" token-equals do
            cc type-literal-base type-string + type-push
            cc type-literal-base type-string + emit-push-integer
            true
        else
            if cc token-index compile-record-type-word do
                true
            else
                if cc token-index compile-union-type-word do
                    true
                else
                    cc token-index compile-function-type-word
                end
            end
        end
    end
end

proc compile-constant-values-from ptr ModuleContext int int -- do
    let cc module constant-index value-index do
        if value-index module constant-index constant-value-count-at < do
            module constant-index constant-values-at
            peek values do value-index constant-value-type-at
                values value-index constant-value-payload-at
                let value-type payload do
                    cc value-type type-push
                    if value-type type-int == value-type type-bool == || do
                        cc payload emit-push-integer
                    elif value-type type-string == do
                        cc payload emit-push-pooled-string
                    else
                        "internal unsupported constant value type" fail
                    end
                    cc module constant-index value-index 1 + compile-constant-values-from
                end
            end
        end
    end
end

proc compile-constant ptr ModuleContext int -- do
    peek cc module constant-index do 0 compile-constant-values-from
    end
end

proc compile-macro ptr ModuleContext int -- do
    let cc module macro-index do
        if module macro-index macro-expanding-at do
            "recursive macro expansion" fail
        end
        true module macro-index set-macro-expanding
        cc @cc-defining-module
        cc @cc-scope-module
        let previous-defining-module previous-scope-module do
            module cc !cc-defining-module
            module cc !cc-scope-module
            cc
            module macro-index macro-body-start-at
            module macro-index macro-body-end-at
            compile-body-range
            previous-defining-module cc !cc-defining-module
            previous-scope-module cc !cc-scope-module
        end
        false module macro-index set-macro-expanding
    end
end

proc compile-ordinary-word ptr int -- do
    let cc token-index do
        cc @cc-scope-module cc @cc-defining-module token-index find-scope-symbol
        let symbol-index do
            cc token-index token-resolves-to-macro
            let is-macro do
            if is-macro do
                cc
                cc @cc-scope-module symbol-index scope-at @ScopeEntry.definition_module
                cc @cc-scope-module symbol-index scope-at @ScopeEntry.definition_index
                compile-macro
            elif cc token-index compile-type-word do
            elif cc token-index compile-string-word do
            elif cc token-index compile-record-word do
            elif cc token-index compile-union-word do
            elif cc token-index compile-function-word do
            elif cc token-index compile-intrinsic do
            else
                cc token-index find-local
                let local-index do
                    if local-index 0 >= do
                        cc token-index local-index compile-local-reference
                    else
                        if symbol-index 0 >= do
                            if cc @cc-scope-module symbol-index scope-at @ScopeEntry.kind scope-constant == do
                                cc
                                cc @cc-scope-module symbol-index scope-at @ScopeEntry.definition_module
                                cc @cc-scope-module symbol-index scope-at @ScopeEntry.definition_index
                                compile-constant
                            elif cc @cc-scope-module symbol-index scope-at @ScopeEntry.kind scope-procedure != do
                                "unknown word" fail
                            else
                                cc
                                token-index
                                cc @cc-scope-module symbol-index scope-at @ScopeEntry.definition_module
                                cc @cc-scope-module symbol-index scope-at @ScopeEntry.definition_index
                                compile-procedure-call
                            end
                        else
                            if cc token-index compile-prelude-macro ! do
                                "unknown word" fail
                            end
                        end
                    end
                end
            end
            end
        end
    end
end

proc compile-word-token ptr int -- int do
    let cc token-index do
        if cc @cc-defining-module token-index "if" token-equals do
            cc compile-if token-index 1 +
        elif cc @cc-defining-module token-index "while" token-equals do
            cc compile-while token-index 1 +
        elif cc @cc-defining-module token-index "do" token-equals do
            cc compile-do token-index 1 +
        elif cc @cc-defining-module token-index "else" token-equals do
            cc compile-else token-index 1 +
        elif cc @cc-defining-module token-index "elif" token-equals do
            cc compile-elif token-index 1 +
        elif cc @cc-defining-module token-index "end" token-equals do
            cc compile-end token-index 1 +
        elif cc @cc-defining-module token-index "let" token-equals do
            cc token-index compile-let
        elif cc @cc-defining-module token-index "peek" token-equals do
            cc token-index compile-peek
        else
            cc token-index compile-ordinary-word
            token-index 1 +
        end
    end
end

proc compile-token ptr int -- int do
    let cc token-index do
        cc @cc-defining-module token-index token-kind-at
        let kind do
            if kind token-int == do
                cc type-int type-push
                cc @cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-bool == do
                cc type-bool type-push
                cc @cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-char == do
                cc type-int type-push
                cc @cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-string == do
                cc type-string type-push
                cc token-index emit-push-string
                token-index 1 +
            elif kind token-word == do
                cc token-index compile-word-token
            else
                "unknown token kind" fail
                token-index 1 +
            end
        end
    end
end

proc token-resolves-to-macro ptr int -- bool do
    let cc token-index do
        cc @cc-scope-module cc @cc-defining-module token-index find-scope-symbol
        let symbol-index do
            if symbol-index 0 >= do
                cc @cc-scope-module symbol-index scope-at @ScopeEntry.kind scope-macro ==
            else
                false
            end
        end
    end
end

proc try-compile-constant-add ptr int int -- bool do
    let cc token-index body-end do
        if token-index 2 + body-end >= do
            false
        elif
            cc @cc-defining-module token-index token-kind-at token-int ==
            cc @cc-defining-module token-index 1 + token-kind-at token-int == &&
            cc @cc-defining-module token-index 2 + token-kind-at token-word == &&
            cc @cc-defining-module token-index 2 + "+" token-equals &&
            cc token-index 2 + token-resolves-to-macro ! &&
        do
            cc @cc-defining-module token-index token-value-at
            cc @cc-defining-module token-index 1 + token-value-at
            let left right do
                if left max-int right - <= do
                    cc type-int type-push
                    cc left right + emit-push-integer
                    true
                else
                    false
                end
            end
        else
            false
        end
    end
end

proc initialize-proc-inputs ptr int -- do
    let cc input-index do
        if input-index cc @cc-procedure-module cc @cc-proc proc-input-count-at < do
            cc @cc-procedure-module
            cc @cc-procedure-module cc @cc-proc proc-input-start-at
            input-index +
            type-at
            cc swap type-push
            cc input-index 1 + initialize-proc-inputs
        end
    end
end

proc outputs-match-from ptr int -- bool do
    let cc output-index do
        if output-index cc @cc-type-count >= do
            true
        else
            cc output-index type-at-depth
            cc @cc-procedure-module
            cc @cc-procedure-module cc @cc-proc proc-output-start-at
            output-index +
            type-at
            ==
            let matches do
                if matches do
                    cc output-index 1 + outputs-match-from
                else
                    false
                end
            end
        end
    end
end

proc require-proc-outputs ptr -- do
    let cc do
        if cc @cc-type-count cc @cc-procedure-module cc @cc-proc proc-output-count-at != do
            "procedure output stack depth mismatch" fail
        end
        if cc 0 outputs-match-from ! do
            "procedure output stack type mismatch" fail
        end
    end
end

proc compile-body-range ptr int int -- do
    let cc token-index body-end do
        token-index
        while dup body-end < do
            let current-token do
                if cc current-token body-end try-compile-constant-add do
                    current-token 3 +
                else
                    cc current-token compile-token
                end
            end
        end
        drop
    end
end

proc create-compile-context ptr ModuleContext int -- ptr do
    let program ctx proc-index do
        cc-bytes alloc
        let cc do
            program cc !cc-program
            ctx cc !cc-procedure-module
            ctx cc !cc-defining-module
            ctx cc !cc-scope-module
            proc-index cc !cc-proc
            program @program-token-count 1 +
            peek type-capacity do cell-bytes * alloc cc !cc-type-stack
                type-capacity cc !cc-type-capacity
            end
            0 cc !cc-type-count
            program @program-token-count 1 + block-bytes * alloc cc !cc-blocks
            0 cc !cc-block-count
            program @program-token-count 1 + LocalEntry:sizeof * alloc cc !cc-locals
            0 cc !cc-local-count
            0 cc !cc-next-local
            0 cc !cc-indent
            false cc !cc-emitting
            0 cc !cc-max-type-count
            cc
        end
    end
end

proc proc-input-type-at ModuleContext int int -- int do
    let ctx proc-index input-index do
        ctx ctx proc-index proc-input-start-at input-index + type-at
    end
end

proc emit-ffi-argument-name int -- do
    emit-proc-argument-name
end

proc emit-external-argument ModuleContext int int -- do
    peek ctx proc-index input-index do proc-input-type-at
        let input-type do
            if input-type type-int == do
                "(int)" emit input-index emit-ffi-argument-name
            elif input-type type-bool == do
                "(int)(" emit input-index emit-ffi-argument-name " != 0)" emit
            elif input-type type-ptr == do
                "(void *)(intptr_t)" emit input-index emit-ffi-argument-name
            else
                "internal unknown C ABI argument type" fail
            end
        end
    end
end

proc emit-external-arguments ModuleContext int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index proc-input-count-at < do
            if input-index 0 != do ", " emit end
            ctx proc-index input-index emit-external-argument
            ctx proc-index input-index 1 + emit-external-arguments
        end
    end
end

proc emit-external-call-expression ModuleContext int -- do
    peek ctx proc-index do emit-c-symbol "(" emit
        ctx proc-index 0 emit-external-arguments
        ")" emit
    end
end

proc compile-external-procedure ModuleContext int -- do
    peek ctx proc-index do emit-proc-signature " {\n" emit
        if ctx proc-index proc-output-count-at 0 == do
            "  " emit ctx proc-index emit-external-call-expression ";\n" emit
        else
            ctx ctx proc-index proc-output-start-at type-at
            let output-type do
                if output-type type-int == do
                    "  return (Cell)" emit
                    ctx proc-index emit-external-call-expression
                    ";\n" emit
                elif output-type type-bool == do
                    "  return (Cell)(" emit
                    ctx proc-index emit-external-call-expression
                    " != 0);\n" emit
                elif output-type type-ptr == do
                    "  return (Cell)(intptr_t)" emit
                    ctx proc-index emit-external-call-expression
                    ";\n" emit
                else
                    "internal unknown C ABI return type" fail
                end
            end
        end
        "}\n" emit
    end
end

proc validate-compiled-procedure ptr -- do
    let cc do
        if cc @cc-block-count 0 != do
            "unclosed control-flow block" fail
        end
        if cc @cc-local-count 0 != do
            "unclosed local scope" fail
        end
        cc require-proc-outputs
    end
end

proc compile-procedure-body ptr ModuleContext int -- do
    let cc ctx proc-index do
        cc 0 initialize-proc-inputs
        cc
        ctx proc-index proc-body-start-at
        ctx proc-index proc-body-end-at
        compile-body-range
        cc validate-compiled-procedure
    end
end

proc emit-proc-input-slots ptr ModuleContext int int -- do
    let cc ctx proc-index input-index do
        if input-index ctx proc-index proc-input-count-at < do
            cc emit-indent cc input-index emit-slot " = frog_arg_" emit input-index emit-unsigned ";" emit 10 putc
            cc ctx proc-index input-index 1 + emit-proc-input-slots
        end
    end
end

proc emit-proc-slot-frame ptr -- do
    let cc do
        if cc @cc-max-type-count 0 > do
            cc emit-indent "Cell frog_slots[" emit cc @cc-max-type-count emit-unsigned "];" emit 10 putc
            cc emit-indent "(void)frog_slots;" emit 10 putc
        end
    end
end

proc emit-proc-return-values ptr int -- do
    let cc remaining do
        if remaining 0 > do
            remaining 1 -
            let output-index do
                cc emit-indent "frog_result.value_" emit output-index emit-unsigned " = " emit
                cc output-index emit-slot ";" emit 10 putc
                cc output-index emit-proc-return-values
            end
        end
    end
end

proc emit-proc-return ptr ModuleContext int -- do
    let cc ctx proc-index do
        ctx proc-index proc-output-count-at
        let output-count do
            if output-count 1 == do
                cc emit-indent "return " emit cc 0 emit-slot ";" emit 10 putc
            elif output-count 1 > do
                cc emit-indent output-count emit-result-type-name " frog_result;" emit 10 putc
                cc output-count emit-proc-return-values
                cc emit-indent "return frog_result;" emit 10 putc
            end
        end
    end
end

proc compile-procedure ptr ModuleContext int -- do
    let program ctx proc-index do
        if ctx proc-index proc-external-at do
            ctx proc-index compile-external-procedure
        else
            program ctx proc-index create-compile-context
            peek measurement do ctx proc-index compile-procedure-body
                measurement @cc-max-type-count
                let max-type-count do
                    program ctx proc-index create-compile-context
                    let cc do
                        true cc !cc-emitting
                        max-type-count cc !cc-max-type-count
                        ctx proc-index emit-proc-signature " {" emit 10 putc
                        1 cc !cc-indent
                        cc emit-proc-slot-frame
                        cc ctx proc-index 0 emit-proc-input-slots
                        cc ctx proc-index compile-procedure-body
                        cc ctx proc-index emit-proc-return
                        "}" emit 10 putc
                    end
                end
            end
        end
    end
end

proc compile-module-procedures ptr ModuleContext -- do
    let program ctx do
        0
        while dup ctx @ModuleContext.proc_count < do
            dup program ctx rot compile-procedure
            1 +
        end
        drop
    end
end

proc compile-all-procedures ptr -- do
    peek program do @program-module-head
        while dup ptr cast int cast 0 != do
            dup program swap compile-module-procedures
            @ModuleContext.next_module
        end
        drop
    end
end

proc emit-main-wrapper ptr -- do
    peek program do @program-root-module
        let ctx do
            "int main(int argc, char **argv) {\n  frog_argc = argc;\n  frog_argv = argv;\n" emit
            program emit-string-references
            "  " emit ctx ctx @ModuleContext.main_proc emit-proc-name
            "();\n  return 0;\n}\n" emit
        end
    end
end
// END BODY COMPILER


proc compile-source ptr int -- do
    let source source-length do
        program-bytes alloc
        let program do
            0 ptr cast ModuleContext cast program !program-root-module
            0 ptr cast ModuleContext cast program !program-module-head
            0 ptr cast ModuleContext cast program !program-module-tail
            0 program !program-module-count
            0 program !program-next-proc-id
            type-nominal-base program !program-next-nominal-type
            type-function-base program !program-next-function-type
            0 program !program-token-count
            0 ptr cast program !program-strings
            0 program !program-string-count
            0 ptr cast ModuleContext cast program !program-prelude-module
            ModuleContext:alloc
            let ctx do
                0 ptr cast ctx !ModuleContext.canonical_path
                0 ctx !ModuleContext.canonical_path_length
                0 ptr cast ctx !ModuleContext.imports
                0 ctx !ModuleContext.import_count
                0 ptr cast ctx !ModuleContext.scope
                0 ctx !ModuleContext.scope_count
                load-loading ctx !ModuleContext.load_state
                resolve-new ctx !ModuleContext.resolve_state
                true ctx !ModuleContext.is_root
                program ctx program-add-module
                ctx program !program-root-module
                ctx source source-length initialize-module-source
                program ctx load-module-imports
                load-loaded ctx !ModuleContext.load_state
                program initialize-prelude
                program initialize-string-pool
                program resolve-all-module-scopes
                program evaluate-all-constants
                program resolve-all-types
                program validate-external-declarations

                program emit-c-emitter-support
                program compile-all-procedures
                program emit-main-wrapper
            end
        end
    end
end

const program-prelude-module-offset 64 end
proc @program-prelude-module ptr -- ModuleContext do program-prelude-module-offset pointer-field-read ModuleContext cast end
proc !program-prelude-module ModuleContext ptr -- do let value program do value ptr cast program program-prelude-module-offset pointer-field-write end end

proc initialize-prelude ptr -- do
    let program do
        ModuleContext:alloc
        let prelude do
            0 ptr cast prelude !ModuleContext.canonical_path
            0 prelude !ModuleContext.canonical_path_length
            0 ptr cast prelude !ModuleContext.imports
            0 prelude !ModuleContext.import_count
            0 ptr cast prelude !ModuleContext.scope
            0 prelude !ModuleContext.scope_count
            load-loading prelude !ModuleContext.load_state
            resolve-new prelude !ModuleContext.resolve_state
            false prelude !ModuleContext.is_root
            program prelude program-add-module
            "macro dup peek a do a end end
macro dup2 peek a b do a b end end
macro drop let a do end end
macro swap let a b do b a end end
macro swap2 let a b c d do c d a b end end
macro rot let a b c do b c a end end
"
            let source do
                prelude source String.bytes source String.len initialize-module-source
            end
            load-loaded prelude !ModuleContext.load_state
            prelude program !program-prelude-module
        end
    end
end

proc compile-prelude-macro ptr int -- bool do
    let cc token-index do
        cc @cc-program @program-prelude-module
        peek prelude do cc @cc-defining-module token-index find-scope-symbol
            let symbol-index do
                if symbol-index 0 < do
                    false
                else
                    if prelude symbol-index scope-at @ScopeEntry.kind scope-macro != do
                        "internal prelude symbol is not a macro" fail
                    end
                    cc
                    prelude symbol-index scope-at @ScopeEntry.definition_module
                    prelude symbol-index scope-at @ScopeEntry.definition_index
                    compile-macro
                    true
                end
            end
        end
    end
end

extern cli-fork froglang_fork -- c-int end
extern cli-create-file froglang_create_file c-ptr -- c-int end
extern cli-dup2 froglang_dup2 c-int c-int -- c-int end
extern cli-close froglang_close c-int -- c-int end
extern cli-chdir froglang_chdir c-ptr -- c-int end
extern cli-execv froglang_execv c-ptr c-ptr -- c-int end
extern cli-execvp froglang_execvp c-ptr c-ptr -- c-int end
extern cli-ensure-directory froglang_ensure_directory c-ptr -- c-int end
extern cli-path-exists froglang_path_exists c-ptr -- c-bool end
extern cli-wait-child froglang_wait_child c-int -- c-int end
extern cli-finish-child froglang_finish_child c-int -- end
extern cli-reset-child-signals froglang_reset_child_signals -- end

proc null-pointer -- ptr do 0 ptr cast end

proc cstring-length ptr -- int do
    let bytes do
        0
        while dup bytes swap + @u8 0 != do
            1 +
        end
    end
end

proc cstring-equals ptr String -- bool do
    let cstring value do
        cstring cstring-length
        let cstring-byte-count do
            cstring cstring-byte-count value String.bytes value String.len bytes-equal
        end
    end
end

proc argv-at ptr int -- ptr do cell-bytes * + @ptr end

proc copy-cstring ptr int -- ptr do
    let bytes length do
        length 1 + alloc
        let result do
            bytes result length memory-copy
            0 result length byte-write
            result
        end
    end
end

proc last-index-of-byte ptr int int -- int do
    let bytes length value do
        0 0 1 -
        while
            peek index last-index do index length <
            end
        do
            let index last-index do
                index 1 +
                if bytes index byte-read value == do index else last-index end
            end
        end
        let index last-index do last-index end
    end
end

proc parent-path ptr -- ptr do
    peek path do cstring-length
        let length do
            path length 47 last-index-of-byte
            let slash do
                if slash 0 < do
                    "." String.bytes
                elif slash 0 == do
                    "/" String.bytes
                else
                    path slash copy-cstring
                end
            end
        end
    end
end

proc replace-path-suffix ptr String -- ptr do
    let path suffix do
        suffix String.len
        let suffix-length do
            path cstring-length
            let path-length do
                path path-length 47 last-index-of-byte 1 +
                path path-length 46 last-index-of-byte
                let base dot do
                    if dot base > do dot else path-length end
                    peek prefix-length do suffix-length + 1 + alloc
                        let result do
                            path result prefix-length memory-copy
                            suffix String.bytes result prefix-length + suffix-length memory-copy
                            0 result prefix-length suffix-length + byte-write
                            result
                        end
                    end
                end
            end
        end
    end
end

proc set-pointer-at ptr int ptr -- do
    let array index value do
        value array index cell-bytes * + !ptr
    end
end

proc allocate-pointer-array int -- ptr do
    peek count do 1 + cell-bytes * alloc
        peek array do count null-pointer set-pointer-at
            array
        end
    end
end

proc cli-error String -- do
    let message do
        "frogc: " emit-error
        message emit-error
        10 eputc
    end
end

proc cli-error-path String ptr -- do
    let message path do
        "frogc: " emit-error
        message emit-error
        ": " emit-error
        path path cstring-length emit-error-bytes
        10 eputc
    end
end

proc cli-usage-error String -- do
    cli-error
    "Try `frogc --help`.\n" emit-error
    2 exit
end

proc cli-usage-error-value String ptr -- do
    let message value do
        "frogc: " emit-error
        message emit-error
        value value cstring-length emit-error-bytes
        10 eputc
        "Try `frogc --help`.\n" emit-error
        2 exit
    end
end

proc cli-usage -- do
    "Usage:
  frogc < source.frog > source.c
  frogc <command> [options]

Commands:
  run [-c CODE | FILE]       compile and run Frog source
  build [-o FILE] [-r] FILE  compile Frog source to a binary
" emit
end

proc read-source-path ptr -- ptr int do
    peek path do path cstring-length read-file
        let source source-length success do
            if success do
                source source-length
            else
                if path cli-path-exists do
                    "unable to read" path cli-error-path
                else
                    "source file not found" path cli-error-path
                end
                1 exit
                null-pointer 0
            end
        end
    end
end

proc wait-for-child int -- int do
    cli-wait-child
    let status do
        if status 0 < do
            "unable to wait for child" cli-error
            1
        else
            status
        end
    end
end

proc compile-frog-source ptr int ptr ptr -- int do
    let source source-length directory output do
        output cli-create-file
        let output-fd do
            if output-fd 0 < do
                "unable to prepare compiler input or output" cli-error
                1
            else
                cli-fork
                let child do
                    if child 0 < do
                        output-fd cli-close drop
                        "unable to fork compiler" cli-error
                        1
                    elif child 0 == do
                        cli-reset-child-signals
                        output-fd 1 cli-dup2 0 <
                        directory cli-chdir 0 != ||
                        let preparation-failed do
                            output-fd cli-close drop
                            if preparation-failed do
                                "unable to prepare compiler child" cli-error
                                1 cli-finish-child
                                1
                            else
                                source source-length compile-source
                                0 cli-finish-child
                                0
                            end
                        end
                    else
                        output-fd cli-close drop
                        child wait-for-child
                    end
                end
            end
        end
    end
end

proc compile-c-source ptr ptr -- int do
    let source executable do
        13 allocate-pointer-array
        peek arguments do 0 "gcc" String.bytes set-pointer-at
            arguments 1 "-std=c11" String.bytes set-pointer-at
            arguments 2 "-pedantic" String.bytes set-pointer-at
            arguments 3 "-Wall" String.bytes set-pointer-at
            arguments 4 "-Wextra" String.bytes set-pointer-at
            arguments 5 "-Wconversion" String.bytes set-pointer-at
            arguments 6 "-Werror" String.bytes set-pointer-at
            arguments 7 "-O2" String.bytes set-pointer-at
            arguments 8 "-x" String.bytes set-pointer-at
            arguments 9 "c" String.bytes set-pointer-at
            arguments 10 source set-pointer-at
            arguments 11 "-o" String.bytes set-pointer-at
            arguments 12 executable set-pointer-at
            cli-fork
            let child do
                if child 0 < do
                    "unable to fork gcc" cli-error
                    1
                elif child 0 == do
                    cli-reset-child-signals
                    "gcc" String.bytes arguments cli-execvp drop
                    "unable to run gcc" cli-error
                    127 cli-finish-child
                    127
                else
                    child wait-for-child
                end
            end
        end
    end
end

proc run-executable ptr -- int do
    let executable do
        1 allocate-pointer-array
        peek arguments do 0 executable set-pointer-at
            cli-fork
            let child do
                if child 0 < do
                    "unable to fork executable" cli-error
                    1
                elif child 0 == do
                    cli-reset-child-signals
                    executable arguments cli-execv drop
                    "unable to run " emit-error
                    executable executable cstring-length emit-error-bytes
                    10 eputc
                    127 cli-finish-child
                    127
                else
                    child wait-for-child
                end
            end
        end
    end
end

proc run-source ptr int ptr -- int do
    let source source-length directory do
        if "build" String.bytes cli-ensure-directory 0 != do
            "unable to create build directory" cli-error
            1
        else
            source source-length directory "build/frog-run.c" String.bytes compile-frog-source
            let compile-status do
                if compile-status 0 != do
                    compile-status
                else
                    "build/frog-run.c" String.bytes "build/frog-run.exe" String.bytes compile-c-source
                    let c-status do
                        if c-status 0 != do
                            c-status
                        else
                            "build/frog-run.exe" String.bytes run-executable
                        end
                    end
                end
            end
        end
    end
end

proc run-file ptr -- int do
    peek path do read-source-path
        let source source-length do
            path parent-path
            let directory do
                source source-length directory run-source
            end
        end
    end
end

proc build-file ptr ptr bool -- int do
    let path requested-output should-run do
        path ".c" replace-path-suffix
        let c-file do
            if requested-output int cast 0 == do
                path ".exe" replace-path-suffix
            else
                requested-output
            end
            let executable do
                path read-source-path
                let source source-length do
                    path parent-path
                    let directory do
                        source source-length directory c-file compile-frog-source
                        let frog-status do
                            if frog-status 0 != do
                                frog-status
                            else
                                c-file executable compile-c-source
                                let c-status do
                                    if c-status 0 != do
                                        c-status
                                    elif should-run do
                                        executable run-executable
                                    else
                                        0
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc run-command ptr int -- do
    let argv argc do
        if argc 2 <= do
            "run requires a source file or -c CODE" cli-usage-error
        end
        argv 2 argv-at
        let argument do
            if
                argc 3 ==
                argument "-h" cstring-equals argument "--help" cstring-equals || &&
            do
                "Usage: frogc run [-c CODE | FILE]\n" emit
            elif argument "-c" cstring-equals do
                if argc 4 != do
                    "run -c requires exactly one CODE argument" cli-usage-error
                end
                argv 3 argv-at
                peek code do code cstring-length "." String.bytes run-source exit
                end
            elif argument @u8 45 == do
                "unknown run option: " argument cli-usage-error-value
            elif argc 3 != do
                "run accepts exactly one source file" cli-usage-error
            else
                argument run-file exit
            end
        end
    end
end

proc parse-build-options ptr int int ptr bool -- ptr ptr bool do
    let argv argc index output should-run do
        if index argc >= do
            "build requires exactly one source file" cli-usage-error
            null-pointer null-pointer false
        else
            argv index argv-at
            let argument do
                if argument @u8 45 == do
                    if
                        argument "-h" cstring-equals
                        argument "--help" cstring-equals ||
                    do
                        "Usage: frogc build [-o FILE] [-r] FILE\n" emit
                        0 exit
                        null-pointer null-pointer false
                    elif argument "-r" cstring-equals do
                        argv argc index 1 + output true parse-build-options
                    elif argument "-o" cstring-equals do
                        if index 1 + argc >= do
                            "build -o requires an output file" cli-usage-error
                        end
                        argv argc index 2 + argv index 1 + argv-at should-run parse-build-options
                    else
                        "unknown build option: " argument cli-usage-error-value
                        null-pointer null-pointer false
                    end
                else
                    if argc index - 1 != do
                        "build requires exactly one source file" cli-usage-error
                    end
                    argument output should-run
                end
            end
        end
    end
end

proc build-command ptr int -- do
    peek argv argc do 2 null-pointer false parse-build-options
        peek source output should-run do build-file exit
        end
    end
end

proc main -- do
    args
    let argv argc do
        if argc 1 == do
            read-source compile-source
        else
            argv 1 argv-at
            let command do
                if
                    command "-h" cstring-equals
                    command "--help" cstring-equals ||
                do
                    cli-usage
                elif command "run" cstring-equals do
                    argv argc run-command
                elif command "build" cstring-equals do
                    argv argc build-command
                else
                    "unknown command: " command cli-usage-error-value
                end
            end
        end
    end
end
