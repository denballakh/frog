            end
        end
        0 0
        while peek block-index next-instruction do block-index analysis @ProcedureAnalysis.cfg_block_count < end do
            let block-index next-instruction do
                analysis block-index analyzed-block-at
                let block do
                    if block @AnalyzedBlock.instruction_start next-instruction != do
                        "internal typed block instruction range is not contiguous" fail
                    end
                    if
