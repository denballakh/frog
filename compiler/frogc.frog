proc emit-source-error-prefix CompileContext* -- do
    let cc do
        if cc @CompileContext.diagnostic_active do
            cc @CompileContext.diagnostic_module cc @CompileContext.diagnostic_token emit-diagnostic-prefix
        else
            "frogc: " emit-error
        end
    end
end

proc emit-compile-word-error-prefix CompileContext* -- do
    let cc do
        cc emit-source-error-prefix
        if cc @CompileContext.diagnostic_word do
            cc @CompileContext.diagnostic_module cc @CompileContext.diagnostic_token token-slice emit-error-bytes
            ": " emit-error
        end
    end
end

proc fail-compile-word CompileContext* String -- do
    let cc message do
        cc emit-compile-word-error-prefix
        message emit-error
        10 eputc
        1 exit
    end
end

proc fail-unknown-word CompileContext* int -- do
    let cc token do
        cc emit-source-error-prefix
        "unknown word: " emit-error
        cc @CompileContext.defining_module token token-slice emit-error-bytes
        10 eputc
        1 exit
    end
end

proc emit-error-type-module-prefix ModuleContext* -- do
    let module do
        if module @ModuleContext.canonical_path_length 0 > do
            module @ModuleContext.canonical_path module @ModuleContext.canonical_path_length
            emit-error-bytes
            ":" emit-error
        end
    end
end

proc emit-error-record-type-name ModuleContext* int int -- bool do
    let module value-type record-index do
        if record-index module @ModuleContext.record_count >= do
            false
        elif module record-index record-type-at @RecordTypeEntry.record_type value-type == do
            module emit-error-type-module-prefix
            module @ModuleContext.source module record-index record-type-at @RecordTypeEntry.name_start +
            module record-index record-type-at @RecordTypeEntry.name_length emit-error-bytes
            true
        else
            module value-type record-index 1 + emit-error-record-type-name
        end
    end
end

proc emit-error-union-type-name ModuleContext* int int -- bool do
    let module value-type union-index do
        if union-index module @ModuleContext.union_count >= do
            false
        elif module union-index union-type-at @UnionTypeEntry.union_type value-type == do
            module emit-error-type-module-prefix
            module @ModuleContext.source module union-index union-type-at @UnionTypeEntry.name_start +
            module union-index union-type-at @UnionTypeEntry.name_length emit-error-bytes
            true
        else
            module value-type union-index 1 + emit-error-union-type-name
        end
    end
end

proc emit-error-function-type-name ModuleContext* int int -- bool do
    let module value-type function-index do
        if function-index module @ModuleContext.function_count >= do
            false
        elif module function-index function-type-at @FunctionTypeEntry.function_type value-type == do
            module emit-error-type-module-prefix
            module @ModuleContext.source module function-index function-type-at @FunctionTypeEntry.name_start +
            module function-index function-type-at @FunctionTypeEntry.name_length emit-error-bytes
            true
        else
            module value-type function-index 1 + emit-error-function-type-name
        end
    end
end

proc emit-error-module-type-name ModuleContext* int -- bool do
    let module value-type do
        module value-type 0 emit-error-record-type-name
        let found do
            if found do
                true
            else
                module value-type 0 emit-error-union-type-name
                let found do
                    if found do true else module value-type 0 emit-error-function-type-name end
                end
            end
        end
    end
end

proc emit-error-nominal-type-name ModuleContext* int -- bool do
    let module value-type do
        if module ptr cast int cast 0 == do
            false
        else
            module value-type emit-error-module-type-name
            let found do
                if found do
                    true
                else
                    module @ModuleContext.next_module value-type emit-error-nominal-type-name
                end
            end
        end
    end
end

proc emit-error-type-name Program* int -- do
    let program value-type do
        if
            value-type 0 <
            value-type type-literal-base > value-type type-nominal-base < && ||
        do
            "type" emit-error
        elif value-type type-int == do
            "int" emit-error
        elif value-type type-bool == do
            "bool" emit-error
        elif value-type type-ptr == do
            "ptr" emit-error
        elif value-type type-type == do
            "type" emit-error
        elif value-type type-string == do
            "String" emit-error
        elif value-type type-i8 == do "i8" emit-error
        elif value-type type-i16 == do "i16" emit-error
        elif value-type type-i32 == do "i32" emit-error
        elif value-type type-i64 == do "i64" emit-error
        elif value-type type-u8 == do "u8" emit-error
        elif value-type type-u16 == do "u16" emit-error
        elif value-type type-u32 == do "u32" emit-error
        elif value-type type-u64 == do "u64" emit-error
        elif value-type type-none == do
            "none" emit-error
        elif value-type type-pointer-base >= do
            program program value-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type emit-error-type-name
            "*" emit-error
        else
            if program @Program.module_head value-type emit-error-nominal-type-name ! do
                "unknown" emit-error
            end
        end
    end
end

proc emit-error-type-array-items Program* ptr int int -- do
    let program values start count do
        0
        while dup count < do
            dup
            let index do
                if index 0 > do " " emit-error end
                program values start index + cell-bytes * field-read emit-error-type-name
            end
            1 +
        end
        drop
    end
end

proc emit-error-type-array Program* ptr int int -- do
    let program values start count do
        "[" emit-error
        program values start count emit-error-type-array-items
        "]" emit-error
    end
end

proc cc-debug-tracing CompileContext* -- bool do
    let cc do
        cc @CompileContext.program @Program.debug
        cc @CompileContext.emitting ! &&
        cc @CompileContext.procedure_module ptr cast int cast
        cc @CompileContext.program @Program.builtins_module ptr cast int cast != &&
    end
end

proc cc-diagnostic-is-token CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.diagnostic_module ptr cast int cast
        cc @CompileContext.defining_module ptr cast int cast ==
        cc @CompileContext.diagnostic_token token-index == &&
    end
end

proc emit-debug-word-stack CompileContext* String -- do
    let cc phase do
        "frogc: debug: " emit-error
        cc @CompileContext.diagnostic_module cc @CompileContext.diagnostic_token token-slice emit-error-bytes
        ": " emit-error
        phase emit-error
        " " emit-error
        cc @CompileContext.program cc @CompileContext.type_stack 0 cc @CompileContext.type_count emit-error-type-array
        10 eputc
    end
end

proc cc-type-address CompileContext* int -- ptr do
    let cc index do
        cc @CompileContext.type_stack index cell-bytes * +
    end
end

proc compile-context-analysis CompileContext* -- ProcedureAnalysis* do
    let cc do
        cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.analysis
    end
end

proc analyzed-operation-at ProcedureAnalysis* int -- AnalyzedOperation* do
    let analysis index do
        analysis @ProcedureAnalysis.operations index AnalyzedOperation:sizeof * + AnalyzedOperation* cast
    end
end

proc active-analyzed-operation CompileContext* -- AnalyzedOperation* do
    let cc do
        cc compile-context-analysis
        let analysis do
            analysis analysis @ProcedureAnalysis.operation_count analyzed-operation-at
        end
    end
end

proc analyzed-binding-local-at ProcedureAnalysis* int -- AnalyzedBindingLocal* do
    let analysis index do
        analysis @ProcedureAnalysis.binding_locals index AnalyzedBindingLocal:sizeof * + AnalyzedBindingLocal* cast
    end
end

proc macro-expansion-at ProcedureAnalysis* int -- MacroExpansion* do
    let analysis index do
        analysis @ProcedureAnalysis.macro_expansions index MacroExpansion:sizeof * + MacroExpansion* cast
    end
end

proc grow-macro-expansions ProcedureAnalysis* -- do
    let analysis do
        analysis @ProcedureAnalysis.macro_expansion_capacity 2 *
        let capacity do
            capacity MacroExpansion:sizeof * alloc
            let expansions do
                analysis @ProcedureAnalysis.macro_expansions expansions
                analysis @ProcedureAnalysis.macro_expansion_count MacroExpansion:sizeof * bytes-copy
                expansions analysis !ProcedureAnalysis.macro_expansions
                capacity analysis !ProcedureAnalysis.macro_expansion_capacity
            end
        end
    end
end

proc begin-macro-expansion CompileContext* ModuleContext* int ModuleContext* int -- int do
    let cc invocation-module invocation-token macro-module macro-index do
        cc compile-context-analysis
        let analysis do
            if analysis @ProcedureAnalysis.macro_expansion_count analysis @ProcedureAnalysis.macro_expansion_capacity == do
                analysis grow-macro-expansions
            end
            analysis @ProcedureAnalysis.macro_expansion_count
            let index do
                analysis index macro-expansion-at
                let expansion do
                    invocation-module expansion !MacroExpansion.invocation_module
                    invocation-token expansion !MacroExpansion.invocation_token
                    macro-module expansion !MacroExpansion.macro_module
                    macro-index expansion !MacroExpansion.macro_index
                    cc @CompileContext.current_expansion_id expansion !MacroExpansion.parent_expansion_id
                    analysis @ProcedureAnalysis.instruction_count expansion !MacroExpansion.instruction_start
                    0 expansion !MacroExpansion.instruction_count
                    analysis cc @CompileContext.type_stack cc @CompileContext.type_count append-operation-types
                    expansion !MacroExpansion.before_type_start
                    cc @CompileContext.type_count expansion !MacroExpansion.before_type_count
                    0 1 - expansion !MacroExpansion.after_type_start
                    0 expansion !MacroExpansion.after_type_count
                    cc @CompileContext.type_count expansion !MacroExpansion.minimum_type_count
                    analysis @ProcedureAnalysis.macro_expansion_count 1 + analysis !ProcedureAnalysis.macro_expansion_count
                    index cc !CompileContext.current_expansion_id
                    index
                end
            end
        end
    end
end

proc finish-macro-expansion CompileContext* int -- do
    let cc expansion-id do
        cc compile-context-analysis
        let analysis do
            analysis expansion-id macro-expansion-at
            let expansion do
                analysis @ProcedureAnalysis.instruction_count expansion @MacroExpansion.instruction_start -
                expansion !MacroExpansion.instruction_count
                analysis cc @CompileContext.type_stack cc @CompileContext.type_count append-operation-types
                expansion !MacroExpansion.after_type_start
                cc @CompileContext.type_count expansion !MacroExpansion.after_type_count
                expansion @MacroExpansion.parent_expansion_id cc !CompileContext.current_expansion_id
            end
        end
    end
end

proc update-macro-expansion-minimum ProcedureAnalysis* int int -- do
    let analysis expansion-id type-count do
        if expansion-id 0 >= do
            analysis expansion-id macro-expansion-at
            let expansion do
                if type-count expansion @MacroExpansion.minimum_type_count < do
                    type-count expansion !MacroExpansion.minimum_type_count
                end
                analysis expansion @MacroExpansion.parent_expansion_id type-count update-macro-expansion-minimum
            end
        end
    end
end

proc typed-instruction-at ProcedureAnalysis* int -- TypedInstruction* do
    let analysis index do
        analysis @ProcedureAnalysis.instructions index TypedInstruction:sizeof * + TypedInstruction* cast
    end
end

proc valid-analyzed-type-range ProcedureAnalysis* int int -- bool do
    let analysis start count do
        start 0 >=
        count 0 >= &&
        start analysis @ProcedureAnalysis.operation_type_count <= &&
        count analysis @ProcedureAnalysis.operation_type_count start - <= &&
    end
end

proc analyzed-types-match ProcedureAnalysis* int int int int -- bool do
    let analysis first-start first-count second-start second-count do
        if first-count second-count != do false
        else
            analysis @ProcedureAnalysis.operation_types first-start cell-bytes * + first-count cell-bytes *
            analysis @ProcedureAnalysis.operation_types second-start cell-bytes * + second-count cell-bytes *
            bytes-equal
        end
    end
end

proc valid-instruction-source TypedInstruction* -- bool do
    let instruction do
        if instruction @TypedInstruction.source_module ptr cast int cast 0 == do false
        elif instruction @TypedInstruction.token_start 0 < do false
        elif instruction @TypedInstruction.token_end instruction @TypedInstruction.token_start <= do false
        elif instruction @TypedInstruction.token_end instruction @TypedInstruction.source_module @ModuleContext.token_count > do false
        else true end
    end
end

proc valid-typed-target TypedInstruction* RuntimeOperation -- bool do
    let instruction operation do
        if instruction @TypedInstruction.target_module ptr cast int cast 0 == instruction @TypedInstruction.target_index 0 < || do
            false
        elif operation RuntimeOperation.procedure_call? do
            instruction @TypedInstruction.target_index instruction @TypedInstruction.target_module @ModuleContext.proc_count <
        elif operation RuntimeOperation.constant? do
            instruction @TypedInstruction.target_index instruction @TypedInstruction.target_module @ModuleContext.constant_count <
        elif
            operation RuntimeOperation.record_new?
            operation RuntimeOperation.record_alloc? ||
            operation RuntimeOperation.record_sizeof? ||
        do
            instruction @TypedInstruction.target_index instruction @TypedInstruction.target_module @ModuleContext.record_count <
        elif operation RuntimeOperation.record_field_read? operation RuntimeOperation.record_field_write? || do
            instruction @TypedInstruction.target_index instruction @TypedInstruction.target_module @ModuleContext.record_field_count <
        elif
            operation RuntimeOperation.union_construct?
            operation RuntimeOperation.union_test? ||
            operation RuntimeOperation.union_project? ||
        do
            instruction @TypedInstruction.target_index instruction @TypedInstruction.target_module @ModuleContext.union_case_count <
        elif operation RuntimeOperation.function_call? operation RuntimeOperation.function_reference? || do
            instruction @TypedInstruction.target_index instruction @TypedInstruction.target_module @ModuleContext.function_count <
        else true end
    end
end

proc instruction-type-at ProcedureAnalysis* TypedInstruction* bool int -- int do
    let analysis instruction after index do
        if after do
            analysis @ProcedureAnalysis.operation_types instruction @TypedInstruction.after_type_start index + cell-bytes * field-read
        else
            analysis @ProcedureAnalysis.operation_types instruction @TypedInstruction.before_type_start index + cell-bytes * field-read
        end
    end
end

proc instruction-prefix-matches ProcedureAnalysis* TypedInstruction* int -- bool do
    let analysis instruction count do
        analysis
        instruction @TypedInstruction.before_type_start count
        instruction @TypedInstruction.after_type_start count
        analyzed-types-match
    end
end

proc verify-instruction-depth-effect ProcedureAnalysis* TypedInstruction* int int -- do
    let analysis instruction inputs outputs do
        if
            instruction @TypedInstruction.before_type_count inputs <
            instruction @TypedInstruction.minimum_type_count instruction @TypedInstruction.before_type_count inputs - != ||
            instruction @TypedInstruction.after_type_count instruction @TypedInstruction.before_type_count inputs - outputs + != ||
            analysis instruction instruction @TypedInstruction.minimum_type_count instruction-prefix-matches ! ||
        do
            "internal typed instruction stack effect mismatch" fail
        end
    end
end

proc verify-instruction-unary-replacement ProcedureAnalysis* TypedInstruction* int int -- do
    let analysis instruction input-type output-type do
        analysis instruction 1 1 verify-instruction-depth-effect
        if
            analysis instruction false instruction @TypedInstruction.before_type_count 1 - instruction-type-at input-type !=
            analysis instruction true instruction @TypedInstruction.after_type_count 1 - instruction-type-at output-type != ||
        do
            "internal typed unary instruction type mismatch: " emit-error
            instruction @TypedInstruction.source_module instruction @TypedInstruction.token_start token-slice emit-error-bytes
            ", expected=" emit-error input-type emit-integer-error "/" emit-error output-type emit-integer-error
            10 eputc 1 exit
        end
    end
end

proc instruction-contract-matches ProcedureAnalysis* TypedInstruction* ptr int ptr int -- bool do
    let analysis instruction inputs input-count outputs output-count do
        if instruction @TypedInstruction.before_type_count input-count < do false else
            instruction @TypedInstruction.before_type_count input-count -
            let prefix-count do
                instruction @TypedInstruction.minimum_type_count prefix-count ==
                instruction @TypedInstruction.after_type_count prefix-count output-count + == &&
                analysis instruction prefix-count instruction-prefix-matches &&
                analysis @ProcedureAnalysis.operation_types
                instruction @TypedInstruction.before_type_start prefix-count + cell-bytes * +
                input-count cell-bytes * inputs input-count cell-bytes * bytes-equal &&
                analysis @ProcedureAnalysis.operation_types
                instruction @TypedInstruction.after_type_start prefix-count + cell-bytes * +
                output-count cell-bytes * outputs output-count cell-bytes * bytes-equal &&
            end
        end
    end
end

proc instruction-procedure-contract-matches ProcedureAnalysis* TypedInstruction* -- bool do
    let analysis instruction do
        instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index procedure-at
        let procedure do
            analysis instruction
            instruction @TypedInstruction.target_module @ModuleContext.types procedure @ProcedureEntry.input_start cell-bytes * +
            procedure @ProcedureEntry.input_count
            instruction @TypedInstruction.target_module @ModuleContext.types procedure @ProcedureEntry.output_start cell-bytes * +
            procedure @ProcedureEntry.output_count
            instruction-contract-matches
        end
    end
end

proc instruction-function-inputs-match-from ProcedureAnalysis* TypedInstruction* ModuleContext* int int int -- bool do
    let analysis instruction module function-index input-index prefix-count do
        if input-index module function-index function-type-at @FunctionTypeEntry.input_count >= do true
        elif
            analysis instruction false prefix-count input-index + instruction-type-at
            module function-index input-index function-input-type-at ==
        do
            analysis instruction module function-index input-index 1 + prefix-count instruction-function-inputs-match-from
        else false end
    end
end

proc instruction-function-outputs-match-from ProcedureAnalysis* TypedInstruction* ModuleContext* int int int -- bool do
    let analysis instruction module function-index output-index prefix-count do
        if output-index module function-index function-type-at @FunctionTypeEntry.output_count >= do true
        elif
            analysis instruction true prefix-count output-index + instruction-type-at
            module function-index output-index function-output-type-at ==
        do
            analysis instruction module function-index output-index 1 + prefix-count instruction-function-outputs-match-from
        else false end
    end
end

proc instruction-function-contract-matches ProcedureAnalysis* TypedInstruction* -- bool do
    let analysis instruction do
        instruction @TypedInstruction.target_module
        instruction @TypedInstruction.target_index
        let module function-index do
            module function-index function-type-at
            let function do
                function @FunctionTypeEntry.input_count 1 +
                let input-count do
                    if instruction @TypedInstruction.before_type_count input-count < do false else
                        instruction @TypedInstruction.before_type_count input-count -
                        let prefix-count do
                            instruction @TypedInstruction.minimum_type_count prefix-count ==
                            instruction @TypedInstruction.after_type_count prefix-count function @FunctionTypeEntry.output_count + == &&
                            analysis instruction prefix-count instruction-prefix-matches &&
                            analysis instruction module function-index 0 prefix-count instruction-function-inputs-match-from &&
                            analysis instruction false prefix-count function @FunctionTypeEntry.input_count + instruction-type-at
                            function @FunctionTypeEntry.function_type == &&
                            analysis instruction module function-index 0 prefix-count instruction-function-outputs-match-from &&
                        end
                    end
                end
            end
        end
    end
end

proc analysis-binding-local-id-has-type ProcedureAnalysis* int int int -- bool do
    let analysis local-id value-type index do
        if index analysis @ProcedureAnalysis.binding_local_count >= do false
        else analysis index analyzed-binding-local-at
            let local do
                if local @AnalyzedBindingLocal.local_id local-id == do local @AnalyzedBindingLocal.value_type value-type ==
                else analysis local-id value-type index 1 + analysis-binding-local-id-has-type end
            end
        end
    end
end

proc verify-binding-instruction ProcedureAnalysis* TypedInstruction* bool -- do
    let analysis instruction restore do
        if
            instruction @TypedInstruction.binding_local_start 0 <
            instruction @TypedInstruction.binding_local_count 0 <= ||
            instruction @TypedInstruction.binding_local_start analysis @ProcedureAnalysis.binding_local_count > ||
            instruction @TypedInstruction.binding_local_count
            analysis @ProcedureAnalysis.binding_local_count instruction @TypedInstruction.binding_local_start - > ||
        do
            "internal typed binding range is invalid" fail
        end
        if restore do
            analysis instruction 0 instruction @TypedInstruction.binding_local_count verify-instruction-depth-effect
        else
            analysis instruction instruction @TypedInstruction.binding_local_count 0 verify-instruction-depth-effect
        end
        0
        while dup instruction @TypedInstruction.binding_local_count < do
            dup let offset do
                analysis instruction @TypedInstruction.binding_local_start offset + analyzed-binding-local-at
                let local do
                    if restore do
                        analysis instruction true
                        instruction @TypedInstruction.after_type_count 1 - offset -
                        instruction-type-at
                    else
                        analysis instruction false
                        instruction @TypedInstruction.before_type_count 1 - offset -
                        instruction-type-at
                    end
                    peek actual-type do
                    local @AnalyzedBindingLocal.value_type !=
                    if dup do
                        "internal typed binding local type mismatch: " emit-error
                        instruction @TypedInstruction.source_module instruction @TypedInstruction.token_start token-slice emit-error-bytes
                        ", local=" emit-error local @AnalyzedBindingLocal.value_type emit-integer-error
                        ", actual=" emit-error actual-type emit-integer-error
                        10 eputc 1 exit
                    end
                    drop
                    end
                end
            end
            1 +
        end
        drop
    end
end

proc verify-private-instruction-effect ProcedureAnalysis* TypedInstruction* -- do
    let analysis instruction do
        instruction @TypedInstruction.private_operation
        let operation do
            if operation PrivateOperation.none? do "internal typed private intrinsic is unresolved" fail
            elif operation PrivateOperation.load? do
                analysis instruction 1 1 verify-instruction-depth-effect
                if
                    analysis instruction true instruction @TypedInstruction.after_type_count 1 - instruction-type-at
                    instruction @TypedInstruction.value_type !=
                do "internal typed private load result type mismatch" fail end
            elif operation PrivateOperation.store? do analysis instruction 2 0 verify-instruction-depth-effect
            elif operation PrivateOperation.not? do
                analysis instruction instruction @TypedInstruction.value_type instruction @TypedInstruction.value_type
                verify-instruction-unary-replacement
            elif operation PrivateOperation.divmod? do analysis instruction 2 2 verify-instruction-depth-effect
            elif operation PrivateOperation.shl? operation PrivateOperation.shr? || do analysis instruction 2 1 verify-instruction-depth-effect
            else analysis instruction 2 1 verify-instruction-depth-effect end
        end
    end
end

proc verify-typed-instruction-storage ProcedureAnalysis* TypedInstruction* -- do
    let analysis instruction do
        if instruction valid-instruction-source ! do "internal typed instruction source range is invalid" fail end
        if
            analysis instruction @TypedInstruction.before_type_start instruction @TypedInstruction.before_type_count valid-analyzed-type-range !
            analysis instruction @TypedInstruction.after_type_start instruction @TypedInstruction.after_type_count valid-analyzed-type-range ! ||
        do
            "internal typed instruction stack range is invalid" fail
        end
        if
            instruction @TypedInstruction.minimum_type_count 0 <
            instruction @TypedInstruction.minimum_type_count instruction @TypedInstruction.before_type_count > ||
            instruction @TypedInstruction.minimum_type_count instruction @TypedInstruction.after_type_count > ||
        do
            "internal typed instruction stack minimum is invalid" fail
        end
        if instruction @TypedInstruction.operation RuntimeOperation.none? do "internal unresolved typed instruction" fail end
        if instruction @TypedInstruction.expansion_id 0 >= do
            if instruction @TypedInstruction.expansion_id analysis @ProcedureAnalysis.macro_expansion_count >= do
                "internal typed instruction expansion is out of range" fail
            end
        end
        instruction @TypedInstruction.operation
        let operation do
            if
                operation RuntimeOperation.procedure_call?
                operation RuntimeOperation.constant? ||
                operation RuntimeOperation.record_new? ||
                operation RuntimeOperation.record_alloc? ||
                operation RuntimeOperation.record_sizeof? ||
                operation RuntimeOperation.record_field_read? ||
                operation RuntimeOperation.record_field_write? ||
                operation RuntimeOperation.union_construct? ||
                operation RuntimeOperation.union_test? ||
                operation RuntimeOperation.union_project? ||
                operation RuntimeOperation.function_call? ||
                operation RuntimeOperation.function_reference? ||
            do
                if instruction operation valid-typed-target ! do "internal typed instruction target is invalid" fail end
            end
            if operation RuntimeOperation.literal? operation RuntimeOperation.type_literal? || operation RuntimeOperation.function_reference? || do
                analysis instruction 0 1 verify-instruction-depth-effect
                if operation RuntimeOperation.literal? do
                    if
                        analysis instruction true instruction @TypedInstruction.after_type_count 1 - instruction-type-at
                        instruction @TypedInstruction.value_type !=
                    do
                        "internal typed literal result type mismatch: " emit-error
                        instruction @TypedInstruction.source_module instruction @TypedInstruction.token_start token-slice emit-error-bytes
                        10 eputc 1 exit
                    end
                end
            elif operation RuntimeOperation.local_load? do
                if
                    instruction @TypedInstruction.local_id 0 <
                    analysis instruction @TypedInstruction.local_id instruction @TypedInstruction.value_type 0 analysis-binding-local-id-has-type ! ||
                do "internal typed local load is invalid" fail end
                analysis instruction 0 1 verify-instruction-depth-effect
                if
                    analysis instruction true instruction @TypedInstruction.after_type_count 1 - instruction-type-at
                    instruction @TypedInstruction.value_type !=
                do "internal typed local load result type mismatch" fail end
            elif operation RuntimeOperation.constant? do
                instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index constant-at
                let constant do
                    analysis instruction 0 constant @ConstantEntry.value_count verify-instruction-depth-effect
                end
            elif operation RuntimeOperation.procedure_call? do
                if analysis instruction instruction-procedure-contract-matches ! do
                    "internal typed procedure call contract mismatch" fail
                end
                if instruction @TypedInstruction.payload 0 != do
                    if
                        instruction @TypedInstruction.payload 1 !=
                        instruction @TypedInstruction.target_module @ModuleContext.program @Program.release ! ||
                        instruction @TypedInstruction.target_module ptr cast int cast
                        instruction @TypedInstruction.target_module @ModuleContext.program @Program.builtins_module ptr cast int cast != ||
                        instruction @TypedInstruction.target_index
                        instruction @TypedInstruction.target_module @ModuleContext.program @Program.builtins_assert_proc != ||
                    do "internal typed suppressed call is invalid" fail end
                end
            elif operation RuntimeOperation.bind_locals? do analysis instruction false verify-binding-instruction
            elif operation RuntimeOperation.restore_peek_locals? do analysis instruction true verify-binding-instruction
            elif operation RuntimeOperation.record_new? operation RuntimeOperation.record_alloc? || operation RuntimeOperation.record_sizeof? || do
                analysis instruction 0 1 verify-instruction-depth-effect
            elif operation RuntimeOperation.record_field_read? do
                if
                    instruction @TypedInstruction.secondary_module ptr cast int cast 0 ==
                    instruction @TypedInstruction.secondary_index 0 < ||
                    instruction @TypedInstruction.secondary_index instruction @TypedInstruction.secondary_module @ModuleContext.record_count >= ||
                do "internal typed record field owner is invalid" fail end
                analysis instruction false instruction @TypedInstruction.before_type_count 1 - instruction-type-at
                drop
                analysis instruction 1 1 verify-instruction-depth-effect
            elif operation RuntimeOperation.record_field_write? do
                if
                    instruction @TypedInstruction.secondary_module ptr cast int cast 0 ==
                    instruction @TypedInstruction.secondary_index 0 < ||
                    instruction @TypedInstruction.secondary_index instruction @TypedInstruction.secondary_module @ModuleContext.record_count >= ||
                do "internal typed record field owner is invalid" fail end
                if instruction @TypedInstruction.payload 0 != do analysis instruction 2 0 verify-instruction-depth-effect
                else analysis instruction 2 1 verify-instruction-depth-effect end
            elif operation RuntimeOperation.union_construct? do
                if
                    instruction @TypedInstruction.secondary_module ptr cast int cast 0 ==
                    instruction @TypedInstruction.secondary_index 0 < ||
                    instruction @TypedInstruction.secondary_index instruction @TypedInstruction.secondary_module @ModuleContext.union_count >= ||
                do "internal typed union owner is invalid" fail end
                if instruction @TypedInstruction.secondary_type type-none == do analysis instruction 0 1 verify-instruction-depth-effect
                else analysis instruction 1 1 verify-instruction-depth-effect end
            elif operation RuntimeOperation.union_test? do analysis instruction 1 1 verify-instruction-depth-effect
            elif operation RuntimeOperation.union_project? do
                if
                    instruction @TypedInstruction.secondary_module ptr cast int cast 0 ==
                    instruction @TypedInstruction.secondary_index 0 < ||
                    instruction @TypedInstruction.secondary_index instruction @TypedInstruction.secondary_module @ModuleContext.union_count >= ||
                do "internal typed union owner is invalid" fail end
                if instruction @TypedInstruction.secondary_type type-none == do analysis instruction 1 0 verify-instruction-depth-effect
                else analysis instruction 1 1 verify-instruction-depth-effect end
            elif operation RuntimeOperation.function_call? do
                if analysis instruction instruction-function-contract-matches ! do
                    "internal typed function call contract mismatch" fail
                end
            elif operation RuntimeOperation.private_intrinsic? do analysis instruction verify-private-instruction-effect
            elif operation RuntimeOperation.cast? do analysis instruction 2 1 verify-instruction-depth-effect
            elif operation RuntimeOperation.args? do analysis instruction 0 2 verify-instruction-depth-effect
            elif operation RuntimeOperation.print? do analysis instruction 1 0 verify-instruction-depth-effect
            elif operation RuntimeOperation.noop? do analysis instruction 0 0 verify-instruction-depth-effect
            elif operation RuntimeOperation.string_bytes? do analysis instruction type-string type-ptr verify-instruction-unary-replacement
            elif operation RuntimeOperation.string_len? do analysis instruction type-string type-int verify-instruction-unary-replacement
            elif operation RuntimeOperation.pointer_load? do analysis instruction 1 1 verify-instruction-depth-effect
            elif operation RuntimeOperation.pointer_store? do analysis instruction 2 0 verify-instruction-depth-effect
            elif operation RuntimeOperation.builtins_assert_fail? do analysis instruction 1 0 verify-instruction-depth-effect
            else "internal unknown typed instruction operation" fail end
            if operation RuntimeOperation.function_reference? do
                if
                    instruction @TypedInstruction.secondary_module ptr cast int cast 0 ==
                    instruction @TypedInstruction.secondary_index 0 < ||
                    instruction @TypedInstruction.secondary_index instruction @TypedInstruction.secondary_module @ModuleContext.proc_count >= ||
                    instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index
                    instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index function-proc-contracts-equal ! ||
                do
                    "internal typed function reference target is invalid" fail
                end
            end
        end
    end
end

proc verify-typed-instructions ProcedureAnalysis* -- do
    let analysis do
        0
        while dup analysis @ProcedureAnalysis.instruction_count < do
            dup let index do analysis analysis index typed-instruction-at verify-typed-instruction-storage end
            1 +
        end
        drop
    end
end

proc expansion-contains-instruction MacroExpansion* int -- bool do
    let expansion instruction-index do
        instruction-index expansion @MacroExpansion.instruction_start >=
        instruction-index expansion @MacroExpansion.instruction_start expansion @MacroExpansion.instruction_count + < &&
    end
end

proc expansion-descends-from ProcedureAnalysis* int int -- bool do
    let analysis expansion-id ancestor-id do
        if expansion-id 0 < do false
        elif expansion-id ancestor-id == do true
        else
            analysis analysis expansion-id macro-expansion-at @MacroExpansion.parent_expansion_id ancestor-id
            expansion-descends-from
        end
    end
end

proc verify-macro-expansion ProcedureAnalysis* int -- do
    let analysis expansion-id do
        analysis expansion-id macro-expansion-at
        let expansion do
            if
                expansion @MacroExpansion.invocation_module ptr cast int cast 0 ==
                expansion @MacroExpansion.macro_module ptr cast int cast 0 == ||
                expansion @MacroExpansion.invocation_token 0 < ||
                expansion @MacroExpansion.invocation_token expansion @MacroExpansion.invocation_module @ModuleContext.token_count >= ||
                expansion @MacroExpansion.macro_index 0 < ||
                expansion @MacroExpansion.macro_index expansion @MacroExpansion.macro_module @ModuleContext.macro_count >= ||
            do
                "internal macro expansion origin is invalid" fail
            end
            if
                expansion @MacroExpansion.instruction_start 0 <
                expansion @MacroExpansion.instruction_count 0 < ||
                expansion @MacroExpansion.instruction_start analysis @ProcedureAnalysis.instruction_count > ||
                expansion @MacroExpansion.instruction_count
                analysis @ProcedureAnalysis.instruction_count expansion @MacroExpansion.instruction_start - > ||
            do
                "internal macro expansion instruction range is invalid" fail
            end
            if
                analysis expansion @MacroExpansion.before_type_start expansion @MacroExpansion.before_type_count valid-analyzed-type-range !
                analysis expansion @MacroExpansion.after_type_start expansion @MacroExpansion.after_type_count valid-analyzed-type-range ! ||
            do
                "internal macro expansion stack range is invalid" fail
            end
            if
                expansion @MacroExpansion.minimum_type_count 0 <
                expansion @MacroExpansion.minimum_type_count expansion @MacroExpansion.before_type_count > ||
                expansion @MacroExpansion.minimum_type_count expansion @MacroExpansion.after_type_count > ||
            do
                "internal macro expansion stack minimum is invalid" fail
            end
            expansion @MacroExpansion.parent_expansion_id
            let parent-id do
                if parent-id expansion-id >= do "internal macro expansion parent is invalid" fail end
                if parent-id 0 >= do
                    analysis parent-id macro-expansion-at
                    let parent do
                        if expansion @MacroExpansion.instruction_start parent @MacroExpansion.instruction_start < do
                            "internal nested macro expansion is outside its parent" fail
                        end
                        if
                            expansion @MacroExpansion.instruction_start expansion @MacroExpansion.instruction_count +
                            parent @MacroExpansion.instruction_start parent @MacroExpansion.instruction_count + >
                        do
                            "internal nested macro expansion exceeds its parent" fail
                        end
                    end
                end
            end
            expansion @MacroExpansion.instruction_start
            while dup expansion @MacroExpansion.instruction_start expansion @MacroExpansion.instruction_count + < do
                dup let instruction-index do
                    analysis instruction-index typed-instruction-at @TypedInstruction.expansion_id
                    let instruction-expansion do
                        if analysis instruction-expansion expansion-id expansion-descends-from ! do
                            "internal macro expansion contains an unrelated instruction" fail
                        end
                    end
                end
                1 +
            end
            drop
        end
    end
end

proc verify-macro-expansions ProcedureAnalysis* -- do
    let analysis do
        0
        while dup analysis @ProcedureAnalysis.macro_expansion_count < do
            dup let expansion-id do analysis expansion-id verify-macro-expansion end
            1 +
        end
        drop
        0
        while dup analysis @ProcedureAnalysis.operation_count < do
            dup let operation-index do
                analysis operation-index analyzed-operation-at
                let operation do
                    if operation @AnalyzedOperation.kind OperationKind.macro_call? do
                        operation @AnalyzedOperation.root_expansion_id
                        let expansion-id do
                            if expansion-id 0 < expansion-id analysis @ProcedureAnalysis.macro_expansion_count >= || do
                                "internal macro operation expansion is missing" fail
                            end
                            analysis expansion-id macro-expansion-at
                            let expansion do
                                if expansion @MacroExpansion.parent_expansion_id 0 1 - != do
                                    "internal macro operation expansion is nested" fail
                                end
                                if
                                    operation @AnalyzedOperation.source_module ptr cast int cast
                                    expansion @MacroExpansion.invocation_module ptr cast int cast !=
                                    operation @AnalyzedOperation.token_start expansion @MacroExpansion.invocation_token != ||
                                    operation @AnalyzedOperation.target_module ptr cast int cast expansion @MacroExpansion.macro_module ptr cast int cast != ||
                                    operation @AnalyzedOperation.target_index expansion @MacroExpansion.macro_index != ||
                                do
                                    "internal macro operation expansion origin mismatch" fail
                                end
                                if
                                    analysis
                                    operation @AnalyzedOperation.before_type_start operation @AnalyzedOperation.before_type_count
                                    expansion @MacroExpansion.before_type_start expansion @MacroExpansion.before_type_count
                                    analyzed-types-match !
                                    analysis
                                    operation @AnalyzedOperation.after_type_start operation @AnalyzedOperation.after_type_count
                                    expansion @MacroExpansion.after_type_start expansion @MacroExpansion.after_type_count
                                    analyzed-types-match ! ||
                                    operation @AnalyzedOperation.minimum_type_count expansion @MacroExpansion.minimum_type_count != ||
                                do
                                    "internal macro operation expansion stack mismatch" fail
                                end
                            end
                        end
                    elif operation @AnalyzedOperation.root_expansion_id 0 1 - != do
                        "internal non-macro operation has a root expansion" fail
                    end
                end
            end
            1 +
        end
        drop
    end
end

proc analyzed-block-at ProcedureAnalysis* int -- AnalyzedBlock* do
    let analysis index do
        analysis @ProcedureAnalysis.cfg_blocks index AnalyzedBlock:sizeof * + AnalyzedBlock* cast
    end
end

proc instruction-before-matches-block ProcedureAnalysis* TypedInstruction* AnalyzedBlock* -- bool do
    let analysis instruction block do
        analysis
        instruction @TypedInstruction.before_type_start instruction @TypedInstruction.before_type_count
        block @AnalyzedBlock.entry_type_start block @AnalyzedBlock.entry_type_count
        analyzed-types-match
    end
end

proc instructions-are-adjacent ProcedureAnalysis* TypedInstruction* TypedInstruction* -- bool do
    let analysis first second do
        analysis
        first @TypedInstruction.after_type_start first @TypedInstruction.after_type_count
        second @TypedInstruction.before_type_start second @TypedInstruction.before_type_count
        analyzed-types-match
    end
end

proc emit-instruction-debug ProcedureAnalysis* TypedInstruction* -- do
    let analysis instruction do
        instruction @TypedInstruction.source_module instruction @TypedInstruction.token_start token-slice emit-error-bytes
        " " emit-error
        analysis @ProcedureAnalysis.operation_types instruction @TypedInstruction.before_type_start cell-bytes * +
        instruction @TypedInstruction.before_type_count let types count do
            "[" emit-error 0 while dup count < do
                dup let index do if index 0 > do "," emit-error end types index cell-bytes * field-read emit-integer-error end 1 +
            end drop "]" emit-error
        end
        " -> " emit-error
        analysis @ProcedureAnalysis.operation_types instruction @TypedInstruction.after_type_start cell-bytes * +
        instruction @TypedInstruction.after_type_count let types count do
            "[" emit-error 0 while dup count < do
                dup let index do if index 0 > do "," emit-error end types index cell-bytes * field-read emit-integer-error end 1 +
            end drop "]" emit-error
        end
    end
end

proc block-exit-types ProcedureAnalysis* AnalyzedBlock* -- ptr int do
    let analysis block do
        analysis @ProcedureAnalysis.operation_types block @AnalyzedBlock.exit_type_start cell-bytes * +
        block @AnalyzedBlock.exit_type_count
    end
end

proc block-entry-matches-types ProcedureAnalysis* AnalyzedBlock* ptr int -- bool do
    let analysis block types count do
        analysis @ProcedureAnalysis.operation_types block @AnalyzedBlock.entry_type_start cell-bytes * +
        block @AnalyzedBlock.entry_type_count
        types count bytes-equal
    end
end

proc verify-analyzed-target ModuleContext* int ProcedureAnalysis* int -- AnalyzedBlock* do
    let module procedure-index analysis target do
        if target 0 < target analysis @ProcedureAnalysis.cfg_block_count >= || do
            "internal analyzed block target out of range: " emit-error
            module @ModuleContext.source module procedure-index procedure-at @ProcedureEntry.name_start +
            module procedure-index procedure-at @ProcedureEntry.name_length emit-error-bytes
            ", target=" emit-error target emit-integer-error 10 eputc 1 exit
        end
        analysis target analyzed-block-at
    end
end

proc verify-analyzed-block-instructions ProcedureAnalysis* AnalyzedBlock* -- do
    let analysis block do
        if block @AnalyzedBlock.instruction_count 0 == do
            if
                analysis
                block @AnalyzedBlock.entry_type_start block @AnalyzedBlock.entry_type_count
                block @AnalyzedBlock.exit_type_start block @AnalyzedBlock.exit_type_count
                analyzed-types-match !
            do
                "internal empty analyzed block changes stack" fail
            end
        else
            analysis block @AnalyzedBlock.instruction_start typed-instruction-at
            let first do
                if analysis first block instruction-before-matches-block ! do
                    "internal typed block entry stack mismatch" fail
                end
            end
            1
            while dup block @AnalyzedBlock.instruction_count < do
                dup let offset do
                    analysis block @AnalyzedBlock.instruction_start offset + 1 - typed-instruction-at
                    analysis block @AnalyzedBlock.instruction_start offset + typed-instruction-at
                    let previous current do
                        if analysis previous current instructions-are-adjacent ! do
                            "internal typed instruction stack discontinuity: " emit-error analysis previous emit-instruction-debug
                            " / " emit-error analysis current emit-instruction-debug
                            10 eputc 1 exit
                        end
                    end
                end
                1 +
            end
            drop
            analysis block @AnalyzedBlock.instruction_start block @AnalyzedBlock.instruction_count + 1 - typed-instruction-at
            let last do
                if
                    analysis
                    last @TypedInstruction.after_type_start last @TypedInstruction.after_type_count
                    block @AnalyzedBlock.exit_type_start block @AnalyzedBlock.exit_type_count
                    analyzed-types-match !
                do
                    "internal typed block exit stack mismatch" fail
                end
            end
        end
    end
end

proc set-operation-target CompileContext* OperationKind ModuleContext* int -- do
    let cc kind module index do
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && do
            if cc @CompileContext.operation_identity_locked ! do
                if cc @CompileContext.operation_identity_set do
                    "internal duplicate analyzed operation identity" fail
                end
                cc active-analyzed-operation
                let operation do
                    kind operation !AnalyzedOperation.kind
                    module operation !AnalyzedOperation.target_module
                    index operation !AnalyzedOperation.target_index
                    true cc !CompileContext.operation_identity_set
                end
            end
        end
        if cc @CompileContext.instruction_active do
            kind
            let operation-kind do
                if operation-kind OperationKind.local? do RuntimeOperation:local_load
                elif operation-kind OperationKind.constant? do RuntimeOperation:constant
                elif operation-kind OperationKind.procedure_call? do RuntimeOperation:procedure_call
                elif operation-kind OperationKind.let_binding? do RuntimeOperation:bind_locals
                elif operation-kind OperationKind.peek_binding? do RuntimeOperation:bind_locals
                elif operation-kind OperationKind.record_new? do RuntimeOperation:record_new
                elif operation-kind OperationKind.record_alloc? do RuntimeOperation:record_alloc
                elif operation-kind OperationKind.record_sizeof? do RuntimeOperation:record_sizeof
                elif operation-kind OperationKind.record_field_read? do RuntimeOperation:record_field_read
                elif operation-kind OperationKind.record_field_write? do RuntimeOperation:record_field_write
                elif operation-kind OperationKind.union_construct? do RuntimeOperation:union_construct
                elif operation-kind OperationKind.union_test? do RuntimeOperation:union_test
                elif operation-kind OperationKind.union_project? do RuntimeOperation:union_project
                elif operation-kind OperationKind.function_call? do RuntimeOperation:function_call
                elif operation-kind OperationKind.function_reference? do RuntimeOperation:function_reference
                else RuntimeOperation:none end
            end
            let runtime-operation do
                if runtime-operation RuntimeOperation.none? ! do
                    cc runtime-operation module index set-typed-target drop
                end
            end
        end
    end
end

proc set-operation-type CompileContext* OperationKind int -- do
    let cc kind value-type do
        cc kind 0 ptr cast ModuleContext* cast 0 1 - set-operation-target
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            value-type cc active-analyzed-operation !AnalyzedOperation.value_type
        end
        if cc @CompileContext.instruction_active do
            if kind OperationKind.literal? do cc RuntimeOperation:literal value-type set-typed-type drop
            elif kind OperationKind.type_literal? do cc RuntimeOperation:type_literal value-type set-typed-type drop
            end
        end
    end
end

proc set-operation-payload CompileContext* int -- do
    let cc payload do
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            if cc @CompileContext.operation_identity_set ! do "internal missing analyzed operation identity" fail end
            payload cc active-analyzed-operation !AnalyzedOperation.payload
        end
        if cc @CompileContext.instruction_active do payload cc active-typed-instruction !TypedInstruction.payload end
    end
end

proc set-typed-target CompileContext* RuntimeOperation ModuleContext* int -- TypedInstruction* do
    let cc runtime-operation module index do
        cc runtime-operation set-typed-instruction
        let instruction do
            module instruction !TypedInstruction.target_module
            index instruction !TypedInstruction.target_index
            instruction
        end
    end
end

proc set-typed-type CompileContext* RuntimeOperation int -- TypedInstruction* do
    let cc runtime-operation value-type do
        cc runtime-operation 0 ptr cast ModuleContext* cast 0 1 - set-typed-target
        let instruction do
            value-type instruction !TypedInstruction.value_type
            instruction
        end
    end
end

proc typed-instruction-for-analyzed-operation CompileContext* -- TypedInstruction* do
    let cc do
        if cc @CompileContext.instruction_active ! do "internal missing typed instruction" fail end
        cc active-typed-instruction
    end
end

proc set-operation-secondary-target CompileContext* ModuleContext* int -- do
    let cc module index do
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            if cc @CompileContext.operation_identity_set ! do "internal missing analyzed operation identity" fail end
            module cc active-analyzed-operation !AnalyzedOperation.secondary_module
            index cc active-analyzed-operation !AnalyzedOperation.secondary_index
        end
        if cc @CompileContext.instruction_active do
            module cc active-typed-instruction !TypedInstruction.secondary_module
            index cc active-typed-instruction !TypedInstruction.secondary_index
        end
    end
end

proc set-operation-local CompileContext* LocalEntry* -- do
    let cc local do
        cc OperationKind:local local @LocalEntry.module local @LocalEntry.name_token set-operation-target
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            local @LocalEntry.id cc active-analyzed-operation !AnalyzedOperation.local_id
        end
        if cc @CompileContext.instruction_active do
            local @LocalEntry.id cc active-typed-instruction !TypedInstruction.local_id
            local @LocalEntry.value_type cc active-typed-instruction !TypedInstruction.value_type
        end
    end
end

proc set-operation-binding CompileContext* OperationKind -- do
    let cc kind do
        cc kind 0 ptr cast ModuleContext* cast 0 1 - set-operation-target
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            cc compile-context-analysis @ProcedureAnalysis.binding_local_count
            cc active-analyzed-operation !AnalyzedOperation.binding_local_start
