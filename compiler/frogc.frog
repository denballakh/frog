            cc @CompileContext.procedure_index occurrence !SemanticOccurrence.owner_index
            cc @CompileContext.current_expansion_id occurrence !SemanticOccurrence.expansion_id
            cc @CompileContext.current_cursor_state occurrence !SemanticOccurrence.state_index
