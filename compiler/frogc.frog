proc emit-inspect-macro-expansion Program* ModuleContext* int ProcedureAnalysis* int -- do
    let program procedure-module procedure-index analysis expansion-id do
        analysis expansion-id macro-expansion-at
        let expansion do
            "expansion\t" emit
            procedure-module @ModuleContext.module_id emit-unsigned 9 putc
            procedure-index emit-unsigned 9 putc
            expansion-id emit-unsigned 9 putc
            expansion @MacroExpansion.parent_expansion_id emit-integer 9 putc
