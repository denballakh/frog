proc emit-proc-name int -- do
    112 putc
    emit-unsigned
end

proc emit-local-name int -- do
    108 putc
    emit-unsigned
end

proc check-proc-inputs ptr int int -- do
    let cc proc-index remaining do
        if remaining 0 > do
            cc cc-root
            cc cc-root proc-index proc-input-start-at
            remaining 1 - +
            type-at
            let expected do
                cc expected type-expect
                cc proc-index remaining 1 - check-proc-inputs
            end
        end
    end
end

proc push-proc-outputs ptr int int -- do
    let cc proc-index output-index do
        if output-index cc cc-root proc-index proc-output-count-at < do
            cc cc-root
            cc cc-root proc-index proc-output-start-at
            output-index +
            type-at
            cc swap type-push
            cc proc-index output-index 1 + push-proc-outputs
        end
    end
end

proc apply-proc-contract ptr int -- do
    let cc proc-index do
        cc proc-index cc cc-root proc-index proc-input-count-at check-proc-inputs
        cc proc-index 0 push-proc-outputs
    end
end

proc compile-fixed-binary ptr int int ptr int -- do
    let cc input-type output-type code code-length do
        cc input-type type-expect
        cc input-type type-expect
        cc output-type type-push
        cc code code-length emit-line
    end
end

proc compile-fixed-unary ptr int int ptr int -- do
    let cc input-type output-type code code-length do
        cc input-type type-expect
        cc output-type type-push
        cc code code-length emit-line
    end
end

proc compile-add-sub ptr bool -- do
    let cc subtract do
        cc type-pop
        cc type-pop
        let right-type left-type do
            if left-type type-int == right-type type-int == && do
                cc type-int type-push
            else
                if left-type type-ptr == right-type type-int == && do
                    cc type-ptr type-push
                else
                    "invalid operand types for pointer/integer arithmetic" fail
                end
            end
            if subtract do
                cc "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a - b); }" emit-line
            else
                cc "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a + b); }" emit-line
            end
        end
    end
end

proc compile-arithmetic-intrinsic ptr int -- bool do
    let cc token-index do
        if cc cc-root token-index "+" token-equals do
            cc false compile-add-sub true
        else
            if cc cc-root token-index "-" token-equals do
                cc true compile-add-sub true
            else
                if cc cc-root token-index "*" token-equals do
                    cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a * b); }" compile-fixed-binary true
                else
                    if cc cc-root token-index "/" token-equals do
                        cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } frog_push(a / b); }" compile-fixed-binary true
                    else
                        if cc cc-root token-index "%" token-equals do
                            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } frog_push(a % b); }" compile-fixed-binary true
                        else
                            if cc cc-root token-index "/%" token-equals do
                                cc type-int type-expect
                                cc type-int type-expect
                                cc type-int type-push
                                cc type-int type-push
                                cc "{ Cell b = frog_pop(); Cell a = frog_pop(); if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } frog_push(a / b); frog_push(a % b); }" emit-line
                                true
                            else
                                if cc cc-root token-index "<<" token-equals do
                                    cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a << b); }" compile-fixed-binary true
                                else
                                    if cc cc-root token-index ">>" token-equals do
                                        cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a >> b); }" compile-fixed-binary true
                                    else
                                        if cc cc-root token-index "|" token-equals do
                                            cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a | b); }" compile-fixed-binary true
                                        else
                                            if cc cc-root token-index "&" token-equals do
                                                cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a & b); }" compile-fixed-binary true
                                            else
                                                if cc cc-root token-index "^" token-equals do
                                                    cc type-int type-int "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a ^ b); }" compile-fixed-binary true
                                                else
                                                    if cc cc-root token-index "~" token-equals do
                                                        cc type-int type-int "frog_push(~frog_pop());" compile-fixed-unary true
                                                    else
                                                        false
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc compile-logic-comparison-intrinsic ptr int -- bool do
    let cc token-index do
        if cc cc-root token-index "&&" token-equals do
            cc type-bool type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a && b); }" compile-fixed-binary true
        else
            if cc cc-root token-index "||" token-equals do
                cc type-bool type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a || b); }" compile-fixed-binary true
            else
                if cc cc-root token-index "!" token-equals do
                    cc type-bool type-bool "frog_push(!frog_pop());" compile-fixed-unary true
                else
                    if cc cc-root token-index "==" token-equals do
                        cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a == b); }" compile-fixed-binary true
                    else
                        if cc cc-root token-index "!=" token-equals do
                            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a != b); }" compile-fixed-binary true
                        else
                            if cc cc-root token-index "<" token-equals do
                                cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a < b); }" compile-fixed-binary true
                            else
                                if cc cc-root token-index ">" token-equals do
                                    cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a > b); }" compile-fixed-binary true
                                else
                                    if cc cc-root token-index "<=" token-equals do
                                        cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a <= b); }" compile-fixed-binary true
                                    else
                                        if cc cc-root token-index ">=" token-equals do
                                            cc type-int type-bool "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a >= b); }" compile-fixed-binary true
                                        else
                                            false
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc compile-stack-intrinsic ptr int -- bool do
    let cc token-index do
        if cc cc-root token-index "dup" token-equals do
            cc type-pop let value-type do
                cc value-type type-push cc value-type type-push
                cc "{ Cell a = frog_pop(); frog_push(a); frog_push(a); }" emit-line
            end
            true
        elif cc cc-root token-index "dup2" token-equals do
            cc type-pop cc type-pop
            let right-type left-type do
                cc left-type type-push cc right-type type-push
                cc left-type type-push cc right-type type-push
                cc "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(a); frog_push(b); frog_push(a); frog_push(b); }" emit-line
            end
            true
        elif cc cc-root token-index "drop" token-equals do
            cc type-pop drop cc "(void)frog_pop();" emit-line true
        elif cc cc-root token-index "swap" token-equals do
            cc type-pop cc type-pop
            let right-type left-type do
                cc right-type type-push cc left-type type-push
                cc "{ Cell b = frog_pop(); Cell a = frog_pop(); frog_push(b); frog_push(a); }" emit-line
            end
            true
        elif cc cc-root token-index "swap2" token-equals do
            cc type-pop cc type-pop cc type-pop cc type-pop
            let fourth-type third-type second-type first-type do
                cc third-type type-push cc fourth-type type-push
                cc first-type type-push cc second-type type-push
                cc "{ Cell d = frog_pop(); Cell c = frog_pop(); Cell b = frog_pop(); Cell a = frog_pop(); frog_push(c); frog_push(d); frog_push(a); frog_push(b); }" emit-line
            end
            true
        elif cc cc-root token-index "rot" token-equals do
            cc type-pop cc type-pop cc type-pop
            let third-type second-type first-type do
                cc second-type type-push cc third-type type-push cc first-type type-push
                cc "{ Cell c = frog_pop(); Cell b = frog_pop(); Cell a = frog_pop(); frog_push(b); frog_push(c); frog_push(a); }" emit-line
            end
            true
        else
            false
        end
    end
end

proc type-literal-base -- int do 100 end

proc compile-cast-intrinsic ptr -- do
    let cc do
        cc type-pop
        cc type-pop
        let target-literal source-type do
            target-literal type-literal-base -
            let target-type do
                if
                    target-type type-int ==
                    target-type type-bool == ||
                    target-type type-ptr == ||
                    !
                do
                    "cast target is not a type literal" fail
                end
                if
                    source-type target-type ==
                    source-type type-int == target-type type-bool == && ||
                    source-type type-bool == target-type type-int == && ||
                    source-type type-int == target-type type-ptr == && ||
                    source-type type-ptr == target-type type-int == && ||
                    !
                do
                    "unsupported cast" fail
                end
                cc target-type type-push
                cc "(void)frog_pop();" emit-line
            end
        end
    end
end

proc compile-read-memory ptr int ptr int -- do
    let cc token-index code code-length do
        cc type-ptr type-expect
        cc type-int type-push
        cc code code-length emit-line
    end
end

proc compile-write-memory ptr int ptr int -- do
    let cc token-index code code-length do
        cc type-ptr type-expect
        cc type-int type-expect
        cc code code-length emit-line
    end
end

proc compile-memory-io-intrinsic ptr int -- bool do
    let cc token-index do
        if cc cc-root token-index "read-file" token-equals do
            cc type-int type-expect
            cc type-ptr type-expect
            cc type-ptr type-push
            cc type-int type-push
            cc type-bool type-push
            cc "{ Cell path_length = frog_pop(); const void* path = (const void*)(intptr_t)frog_pop(); void* data; Cell data_length; Cell success = frog_read_file(path, path_length, &data, &data_length); frog_push((Cell)(intptr_t)data); frog_push(data_length); frog_push(success); }" emit-line
            true
        elif cc cc-root token-index "cast" token-equals do
            cc compile-cast-intrinsic true
        else
            if cc cc-root token-index "alloc" token-equals do
                cc type-int type-expect cc type-ptr type-push
                cc "frog_push((Cell)(intptr_t)frog_alloc(frog_pop()));" emit-line true
            else
                if cc cc-root token-index "@i8" token-equals do
                    cc token-index "frog_push(frog_read_i8((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                else
                    if cc cc-root token-index "@i16" token-equals do
                        cc token-index "frog_push(frog_read_i16((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                    else
                        if cc cc-root token-index "@i32" token-equals do
                            cc token-index "frog_push(frog_read_i32((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                        else
                            if cc cc-root token-index "@i64" token-equals do
                                cc token-index "frog_push(frog_read_i64((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                            else
                                if cc cc-root token-index "@u8" token-equals do
                                    cc token-index "frog_push(frog_read_u8((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                                else
                                    if cc cc-root token-index "@u16" token-equals do
                                        cc token-index "frog_push(frog_read_u16((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                                    else
                                        if cc cc-root token-index "@u32" token-equals do
                                            cc token-index "frog_push(frog_read_u32((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                                        else
                                            if cc cc-root token-index "@u64" token-equals do
                                                cc token-index "frog_push(frog_read_u64((const void *)(intptr_t)frog_pop()));" compile-read-memory true
                                            else
                                                if cc cc-root token-index "!i8" token-equals do
                                                    cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i8((void *)(intptr_t)p, v); }" compile-write-memory true
                                                else
                                                    if cc cc-root token-index "!i16" token-equals do
                                                        cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i16((void *)(intptr_t)p, v); }" compile-write-memory true
                                                    else
                                                        if cc cc-root token-index "!i32" token-equals do
                                                            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i32((void *)(intptr_t)p, v); }" compile-write-memory true
                                                        else
                                                            if cc cc-root token-index "!i64" token-equals do
                                                                cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_i64((void *)(intptr_t)p, v); }" compile-write-memory true
                                                            else
                                                                if cc cc-root token-index "!u8" token-equals do
                                                                    cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u8((void *)(intptr_t)p, v); }" compile-write-memory true
                                                                else
                                                                    if cc cc-root token-index "!u16" token-equals do
                                                                        cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u16((void *)(intptr_t)p, v); }" compile-write-memory true
                                                                    else
                                                                        if cc cc-root token-index "!u32" token-equals do
                                                                            cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u32((void *)(intptr_t)p, v); }" compile-write-memory true
                                                                        else
                                                                            if cc cc-root token-index "!u64" token-equals do
                                                                                cc token-index "{ Cell p = frog_pop(); Cell v = frog_pop(); frog_write_u64((void *)(intptr_t)p, v); }" compile-write-memory true
                                                                            else
                                                                                if cc cc-root token-index "print" token-equals do
                                                                                    cc type-pop
                                                                                    let value-type do
                                                                                        if value-type type-int == do
                                                                                            cc "printf(\"%lld\\n\", (long long)frog_pop());" emit-line
                                                                                        else
                                                                                            if value-type type-bool == do
                                                                                                cc "fputs(frog_pop() ? \"true\\n\" : \"false\\n\", stdout);" emit-line
                                                                                            else
                                                                                                "printing this type is not supported" fail
                                                                                            end
                                                                                        end
                                                                                    end
                                                                                    true
                                                                                else
                                                                                    if cc cc-root token-index "putc" token-equals do
                                                                                        cc type-int type-expect cc "putchar((int)(unsigned char)frog_pop());" emit-line true
                                                                                    else
                                                                                        if cc cc-root token-index "getc" token-equals do
                                                                                            cc type-int type-push cc "frog_push((Cell)getchar());" emit-line true
                                                                                        else
                                                                                            if cc cc-root token-index "eputc" token-equals do
                                                                                                cc type-int type-expect cc "fputc((int)(unsigned char)frog_pop(), stderr);" emit-line true
                                                                                            else
                                                                                                if cc cc-root token-index "exit" token-equals do
                                                                                                    cc type-int type-expect cc "exit((int)frog_pop());" emit-line true
                                                                                                else
                                                                                                    if cc cc-root token-index "?" token-equals do
                                                                                                        true
                                                                                                    else
                                                                                                        false
                                                                                                    end
                                                                                                end
                                                                                            end
                                                                                        end
                                                                                    end
                                                                                end
                                                                            end
                                                                        end
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc compile-intrinsic ptr int -- bool do
    let cc token-index do
        if cc token-index compile-arithmetic-intrinsic do
            true
        elif cc token-index compile-logic-comparison-intrinsic do
            true
        elif cc token-index compile-stack-intrinsic do
            true
        else
            cc token-index compile-memory-io-intrinsic
        end
    end
end

proc emit-push-integer ptr int -- do
    let cc value do
        cc emit-indent
        "frog_push(" emit value emit-integer ");" emit 10 putc
    end
end

proc emit-push-string ptr int -- do
    let cc token-index do
        cc emit-indent
        "frog_push((Cell)(intptr_t)frog_string_" emit
        token-index emit-unsigned
        ");" emit 10 putc
        cc emit-indent
        "frog_push(" emit
        cc cc-root token-index decoded-string-length emit-unsigned
        ");" emit 10 putc
    end
end

proc emit-call ptr int -- do
    let cc proc-index do
        cc emit-indent
        proc-index emit-proc-name
        "();" emit 10 putc
    end
end

proc emit-local-load ptr int -- do
    let cc local-id do
        cc emit-indent
        "frog_push(" emit local-id emit-local-name ");" emit 10 putc
    end
end

proc compile-if ptr -- do
    block-if push-block drop
end

proc compile-while ptr -- do
    let cc do
        cc block-while push-block drop
        cc "while (1) {" emit-line
        cc indent-more
    end
end

proc require-block-types ptr ptr -- do
    let cc block do
        block block-base-types-offset block-pointer-field
        block block-base-count-offset block-field
        cc rot rot types-match
        let matches do
            if matches ! do
                "control-flow stack shape mismatch" fail
            end
        end
    end
end

proc compile-do ptr -- do
    let cc do
        cc top-block
        let block do
            if block block-has-do-offset block-field 0 != do
                "duplicate do in control-flow block" fail
            end
            if cc cc-type-count block block-base-count-offset block-field <= do
                if block block-elif-parent-offset block-field 0 != do
                    "elif requires a condition before do" fail
                else
                    "if or while requires a condition before do" fail
                end
            end
            cc type-bool type-expect
            cc block require-block-types
            block block-kind-offset block-field
            let kind do
                if kind block-if == do
                    cc "if (frog_pop() != 0) {" emit-line
                    cc indent-more
                else
                    if kind block-while == do
                        cc "if (frog_pop() == 0) break;" emit-line
                    else
                        "do does not close an if or while condition" fail
                    end
                end
            end
            1 block block-has-do-offset set-block-field
        end
    end
end

proc compile-else ptr -- do
    let cc do
        cc top-block
        let block do
            if block block-kind-offset block-field block-if != do
                "else outside if" fail
            end
            if block block-has-else-offset block-field 0 != do
                "duplicate else" fail
            end
            cc type-snapshot
            let then-types then-count do
                then-types block block-then-types-offset set-block-pointer-field
                then-count block block-then-count-offset set-block-field
            end
            cc
            block block-base-types-offset block-pointer-field
            block block-base-count-offset block-field
            restore-type-snapshot
            1 block block-has-else-offset set-block-field
            cc indent-less
            cc "} else {" emit-line
            cc indent-more
        end
    end
end

proc compile-elif ptr -- do
    let cc do
        cc top-block
        let block do
            if block block-kind-offset block-field block-if != do
                "elif outside if" fail
            end
            if block block-has-do-offset block-field 0 == do
                "elif requires a preceding if arm and do" fail
            end
            if block block-has-else-offset block-field 0 != do
                "elif after else" fail
            end
            cc compile-else
            cc block-if push-block
            let nested do
                1 nested block-elif-parent-offset set-block-field
            end
        end
    end
end

proc close-if-block ptr ptr -- do
    let cc block do
        if block block-has-else-offset block-field 0 == do
            cc block require-block-types
        else
            block block-then-types-offset block-pointer-field
            block block-then-count-offset block-field
            let then-types then-count do
                if cc then-types then-count types-match ! do
                    "if branches leave different stack shapes" fail
                end
                cc then-types then-count restore-type-snapshot
            end
        end
        cc indent-less
        cc "}" emit-line
    end
end

proc close-while-block ptr ptr -- do
    let cc block do
        cc block require-block-types
        cc indent-less
        cc "}" emit-line
    end
end

proc close-let-block ptr ptr -- do
    let cc block do
        block block-local-base-offset block-field cc set-cc-local-count
        cc indent-less
        cc "}" emit-line
    end
end

proc close-end-chain ptr ptr -- do
    let cc block do
        block block-kind-offset block-field
        let kind do
            if kind block-if == do
                cc block close-if-block
            elif kind block-while == do
                cc block close-while-block
            elif kind block-let == do
                cc block close-let-block
            else
                "unknown block kind" fail
            end
        end
        if block block-elif-parent-offset block-field 0 != do
            cc pop-block
            let parent do
                cc parent close-end-chain
            end
        end
    end
end

proc compile-end ptr -- do
    let cc do
        cc pop-block
        let block do
            cc block close-end-chain
        end
    end
end

proc find-let-do ptr int -- int do
    let cc token-index do
        if token-index cc cc-root ctx-token-count >= do
            "unterminated let binding" fail
            token-index
        elif cc cc-root token-index "do" token-equals do
            token-index
        else
            cc cc-root token-index require-word
            cc token-index 1 + find-let-do
        end
    end
end

proc bind-let-names ptr int int -- do
    let cc first-token count do
        if count 0 > do
            first-token count 1 - +
            let name-token do
                cc type-pop
                let value-type do
                    cc name-token value-type add-local
                    let local-id do
                        cc emit-indent
                        "Cell " emit local-id emit-local-name
                        " = frog_pop();" emit 10 putc
                        cc emit-indent
                        "(void)" emit local-id emit-local-name ";" emit 10 putc
                    end
                end
                cc first-token count 1 - bind-let-names
            end
        end
    end
end

proc compile-let ptr int -- int do
    let cc let-token do
        cc let-token 1 + find-let-do
        let do-token do
            do-token let-token 1 + -
            let name-count do
                if name-count 0 <= do
                    "let requires at least one name" fail
                end
                cc block-let push-block drop
                cc "{" emit-line
                cc indent-more
                cc let-token 1 + name-count bind-let-names
                do-token 1 +
            end
        end
    end
end

proc compile-local-reference ptr int int -- do
    let cc token-index local-index do
        cc local-index local-address
        let local do
            local local-type-offset local-field cc swap type-push
            cc local local-id-offset local-field emit-local-load
        end
    end
end

proc compile-procedure-call ptr int int -- do
    let cc token-index proc-index do
        cc proc-index apply-proc-contract
        cc proc-index emit-call
    end
end

proc compile-type-word ptr int -- bool do
    let cc token-index do
        if cc cc-root token-index "int" token-equals do
            cc type-literal-base type-int + type-push
            cc type-literal-base type-int + emit-push-integer
            true
        elif cc cc-root token-index "bool" token-equals do
            cc type-literal-base type-bool + type-push
            cc type-literal-base type-bool + emit-push-integer
            true
        elif cc cc-root token-index "ptr" token-equals do
            cc type-literal-base type-ptr + type-push
            cc type-literal-base type-ptr + emit-push-integer
            true
        else
            false
        end
    end
end

proc compile-macro ptr int -- do
    let cc macro-index do
        if cc cc-root macro-index macro-expanding-at do
            "recursive macro expansion" fail
        end
        true cc cc-root macro-index set-macro-expanding
        cc
        cc cc-root macro-index macro-body-start-at
        cc cc-root macro-index macro-body-end-at
        compile-body-range
        false cc cc-root macro-index set-macro-expanding
    end
end

proc compile-ordinary-word ptr int -- do
    let cc token-index do
        cc cc-root token-index find-macro
        let macro-index do
            if macro-index 0 >= do
                cc macro-index compile-macro
            elif cc token-index compile-type-word do
            elif cc token-index compile-intrinsic do
            else
                cc token-index find-local
                let local-index do
                    if local-index 0 >= do
                        cc token-index local-index compile-local-reference
                    else
                        cc cc-root token-index find-proc
                        let proc-index do
                            if proc-index 0 < do
                                "unknown word" fail
                            end
                            cc token-index proc-index compile-procedure-call
                        end
                    end
                end
            end
        end
    end
end

proc compile-word-token ptr int -- int do
    let cc token-index do
        if cc cc-root token-index "if" token-equals do
            cc compile-if token-index 1 +
        elif cc cc-root token-index "while" token-equals do
            cc compile-while token-index 1 +
        elif cc cc-root token-index "do" token-equals do
            cc compile-do token-index 1 +
        elif cc cc-root token-index "else" token-equals do
            cc compile-else token-index 1 +
        elif cc cc-root token-index "elif" token-equals do
            cc compile-elif token-index 1 +
        elif cc cc-root token-index "end" token-equals do
            cc compile-end token-index 1 +
        elif cc cc-root token-index "let" token-equals do
            cc token-index compile-let
        else
            cc token-index compile-ordinary-word
            token-index 1 +
        end
    end
end

proc compile-token ptr int -- int do
    let cc token-index do
        cc cc-root token-index token-kind-at
        let kind do
            if kind token-int == do
                cc type-int type-push
                cc cc-root token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-bool == do
                cc type-bool type-push
                cc cc-root token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-char == do
                cc type-int type-push
                cc cc-root token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-string == do
                cc type-ptr type-push
                cc type-int type-push
                cc token-index emit-push-string
                token-index 1 +
            elif kind token-word == do
                cc token-index compile-word-token
            else
                "unknown token kind" fail
                token-index 1 +
            end
        end
    end
end

proc initialize-proc-inputs ptr int -- do
    let cc input-index do
        if input-index cc cc-root cc cc-proc proc-input-count-at < do
            cc cc-root
            cc cc-root cc cc-proc proc-input-start-at
            input-index +
            type-at
            cc swap type-push
            cc input-index 1 + initialize-proc-inputs
        end
    end
end

proc outputs-match-from ptr int -- bool do
    let cc output-index do
        if output-index cc cc-type-count >= do
            true
        else
            cc output-index type-at-depth
            cc cc-root
            cc cc-root cc cc-proc proc-output-start-at
            output-index +
            type-at
            ==
            let matches do
                if matches do
                    cc output-index 1 + outputs-match-from
                else
                    false
                end
            end
        end
    end
end

proc require-proc-outputs ptr -- do
    let cc do
        if cc cc-type-count cc cc-root cc cc-proc proc-output-count-at != do
            "procedure output stack depth mismatch" fail
        end
        if cc 0 outputs-match-from ! do
            "procedure output stack type mismatch" fail
        end
    end
end

proc compile-body-range ptr int int -- do
    let cc token-index body-end do
        token-index
        while dup body-end < do
            cc swap compile-token
        end
        drop
    end
end

proc create-compile-context ptr int -- ptr do
    let ctx proc-index do
        cc-bytes alloc
        let cc do
            ctx cc set-cc-root
            proc-index cc set-cc-proc
            ctx ctx-token-count 1 + cell-bytes * alloc cc set-cc-type-stack
            0 cc set-cc-type-count
            ctx ctx-token-count 1 + block-bytes * alloc cc set-cc-blocks
            0 cc set-cc-block-count
            ctx ctx-token-count 1 + local-bytes * alloc cc set-cc-locals
            0 cc set-cc-local-count
            0 cc set-cc-next-local
            0 cc set-cc-indent
            cc
        end
    end
end

proc compile-procedure ptr int -- do
    let ctx proc-index do
        ctx proc-index create-compile-context
        let cc do
            cc 0 initialize-proc-inputs
            "void " emit
            ctx proc-index proc-index-at emit-proc-name
            "(void) {" emit 10 putc
            1 cc set-cc-indent
            cc
            ctx proc-index proc-body-start-at
            ctx proc-index proc-body-end-at
            compile-body-range
            if cc cc-block-count 0 != do
                "unclosed control-flow block" fail
            end
            if cc cc-local-count 0 != do
                "unclosed local scope" fail
            end
            cc require-proc-outputs
            "}" emit 10 putc
        end
    end
end

proc compile-all-procedures ptr -- do
    let ctx do
        0
        while dup ctx ctx-proc-count < do
            dup ctx swap compile-procedure
            1 +
        end
        drop
    end
end

proc emit-main-wrapper ptr -- do
    let ctx do
        "int main(void) {\n  " emit
        ctx ctx-main-proc emit-proc-name
        "();\n  if (frog_stack.count != 0) frog_runtime_fail();\n  free(frog_stack.values);\n  return 0;\n}\n" emit
    end
end
// END BODY COMPILER


proc main -- do
    ctx-bytes alloc
    let ctx do
        read-source
        let source source-length do
            source ctx set-ctx-source
            source-length ctx set-ctx-source-length
            source-length 1 + token-bytes * alloc ctx set-ctx-tokens
            0 ctx set-ctx-token-count
            0 1 - ctx set-ctx-main-proc
            ctx lex

            ctx ctx-token-count 1 + proc-bytes * alloc ctx set-ctx-procs
            ctx ctx-token-count 1 + macro-bytes * alloc ctx set-ctx-macros
            ctx ctx-token-count 1 + cell-bytes * alloc ctx set-ctx-types
            ctx scan-declarations

            ctx emit-c-emitter-support
            ctx compile-all-procedures
            ctx emit-main-wrapper
        end
    end
end
