proc emit-union-constructor CompileContext* int int int -- do
    let cc tag payload-type union-type do
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 -
            let result-index do
                cc emit-indent "{ " emit
                if payload-type type-none != do
                    "Cell payload = " emit
                    if payload-type type-ptr == payload-type type-is-typed-pointer || do "(Cell)(intptr_t)" emit
                    elif payload-type type-bool == payload-type type-is-integer || do "(Cell)" emit
                    end
                    cc result-index payload-type emit-slot-as "; " emit
                end
                "unsigned char *union_value = (unsigned char *)frog_alloc(" emit
                union-storage-bytes emit-unsigned
                "); frog_write_i64(union_value, " emit
                tag emit-unsigned
                "); frog_write_i64(union_value + " emit
                union-payload-offset emit-unsigned
                ", " emit
                if payload-type type-none != do
                    "payload" emit
                else
                    "0" emit
                end
                "); " emit cc result-index union-type emit-slot-as " = (Cell)(intptr_t)union_value; }" emit
                10 putc
            end
        end
    end
end

proc emit-union-predicate CompileContext* int int int -- do
    let cc union-type tag case-count do
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 2 -
            peek union-index do 1 +
                let result-index do
