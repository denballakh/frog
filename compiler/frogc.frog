        ctx token decoded-string-length let length do
            if length 0 == do ctx token "C type must not be empty" fail-at end
            0
            while dup length < do
                dup let index do
                    ctx token index decoded-string-byte let byte do
                        if byte 0 == byte 10 == || byte 13 == || do ctx token "invalid C type spelling" fail-at end
                    end
