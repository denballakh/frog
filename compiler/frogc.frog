                    analysis block verify-analyzed-block-instructions
                    module procedure-index analysis block verify-analyzed-block-terminator
                    block-index 1 + next-instruction block @AnalyzedBlock.instruction_count +
                end
            end
        end
        let block-index next-instruction do
            if next-instruction analysis @ProcedureAnalysis.instruction_count != do
                "internal analyzed blocks do not cover all typed instructions" fail
            end
        end
        analysis verify-procedure-cfg-reachability
    end
