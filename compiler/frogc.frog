                    target ctx entry @ImportEntry.name_token find-scope-macro
                    if dup 0 < do
                        drop target ctx entry @ImportEntry.name_token find-scope-symbol
                    end
                    let target-symbol do
                        if target-symbol 0 < do
                            ctx entry @ImportEntry.name_token "imported name not found" fail-name-at
                        else
