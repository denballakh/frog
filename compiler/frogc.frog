proc emit-c-record-forward-declarations-module ModuleContext* int -- do
    let module index do
        if index module @ModuleContext.record_count < do
            module index record-type-at @RecordTypeEntry.record_type
            let record-type do
                "typedef struct " emit record-type emit-c-record-type-name " " emit record-type emit-c-record-type-name ";\n" emit
            end
            module index 1 + emit-c-record-forward-declarations-module
        end
    end
end

proc emit-c-record-field-type Program* int -- do
    let program field-type do
        if field-type type-is-nominal do
            program @Program.module_head field-type 0 find-record-type-from
            let module record-index found do
                if found do
                    module record-index record-type-at @RecordTypeEntry.record_type emit-c-record-type-name
                else
                    program field-type emit-c-value-type
                end
            end
        elif field-type type-is-typed-pointer do
            program field-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type
            let pointee-type do
                if pointee-type type-is-nominal do
                    program @Program.module_head pointee-type 0 find-record-type-from
                    let module record-index found do
                        if found do
                            module record-index record-type-at @RecordTypeEntry.record_type emit-c-record-type-name " *" emit
                        else
                            program field-type emit-c-value-type
                        end
                    end
                else
                    program field-type emit-c-value-type
                end
            end
        else
            program field-type emit-c-value-type
        end
    end
end

proc emit-c-record-fields Program* ModuleContext* int int -- do
    let program module record-index field-offset do
        if field-offset module record-index record-type-at @RecordTypeEntry.field_count < do
            module module record-index record-type-at @RecordTypeEntry.field_start field-offset + record-field-at
            let field do
                "  " emit program field @RecordFieldEntry.field_type emit-c-record-field-type
                " " emit field-offset emit-c-record-field-name ";\n" emit
            end
            program module record-index field-offset 1 + emit-c-record-fields
