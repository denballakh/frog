                                                    field @RecordFieldEntry.field_type cc active-typed-instruction !TypedInstruction.secondary_type
                                                    module cc active-typed-instruction !TypedInstruction.secondary_module
                                                    record-index cc active-typed-instruction !TypedInstruction.secondary_index
