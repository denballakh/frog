proc emit-c-preamble -- do
    "#define _POSIX_C_SOURCE 200809L

#include <stddef.h>
#include <stdbool.h>
#include <stdint.h>

typedef int64_t Cell;
typedef struct {
  char *bytes;
  intptr_t len;
} FrogString;

static int frog_argc;
static char **frog_argv;

" emit
end

proc emit-c-private-headers -- do
