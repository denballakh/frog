// FrogLang compiler, written in FrogLang.
//
// The bootstrap compiler deliberately uses only the bootstrap-v1 language
// profile.  It reads one Frog source file from stdin and writes C to stdout.

from "stdlib/libc.frog" import (
    alloc putc getc eputc exit read-file
    fork create-file dup2 close chdir get-current-directory execv execvp
    ensure-directory wait-child finish-child reset-child-signals
)

const cell-bytes 8 end

const type-int 1 end
const type-bool 2 end
const type-ptr 3 end
const type-type 4 end
const type-string 5 end
const type-i8 6 end
const type-i16 7 end
const type-i32 8 end
const type-i64 9 end
const type-u8 10 end
const type-u16 11 end
const type-u32 12 end
const type-u64 13 end
const type-none 0 end
// Builtin scalar IDs occupy the low range. Nominal values start at 1000,
// function references at 2^32, and interned typed pointers at 2^40.
const type-nominal-base 1000 end
const type-function-base 1 32 u32 cast << end
const type-pointer-base 1 40 u32 cast << end
const unresolved-pointer-base 1 62 u32 cast << end
const type-literal-base 100 end

const max-int 1 62 u32 cast << 1 62 u32 cast << 1 - + end
const min-int 0 max-int - 1 - end

const fnv-offset-basis 0x811c9dc5 end
const fnv-prime 0x01000193 end
const fnv-modulus 0x100000000 end

record ModuleContext
    source ptr
    source_length int
    diagnostic_path ptr
    diagnostic_path_length int
    tokens ptr
    token_count int
    procs ptr
    proc_count int
    types ptr
    type_count int
    lex_index int
    lex_line int
    lex_column int
    main_proc int
    macros ptr
    macro_count int
    program Program*
    module_id int
    next_module ModuleContext*
    canonical_path ptr
    canonical_path_length int
    imports ptr
    import_count int
    scope ptr
    scope_count int
    load_state LoadState
    resolve_state ResolveState
    is_root bool
    records ptr
    record_count int
    record_fields ptr
    record_field_count int
    unions ptr
    union_count int
    union_cases ptr
    union_case_count int
    functions ptr
    function_count int
    function_types ptr
    function_type_count int
    constants ptr
    constant_count int
    c_types ptr
    c_type_count int
    c_includes ptr
    c_include_count int
    c_signature_types ptr
end

record ConstantEvaluator
    values ptr
    count int
    capacity int
    module ModuleContext*
    token int
end

record ImportEntry
    path_token int
    name_token int
    alias_token int
    target_module ModuleContext*
    canonical_path ptr
    canonical_path_length int
end

record CTypeEntry
    name_start int
    name_length int
    frog_type int
    type_token int
end

record CIncludeEntry
    kind CIncludeKind
    token int
end

record CSignatureType
    active bool
    token int
    definition_module ModuleContext*
    definition_index int
end

record PointerTypeEntry
    pointee_type int
    pointer_type int
end

record UnresolvedPointerTypeEntry
    module ModuleContext*
    token int
    depth int
end

record ScopeEntry
    name_module ModuleContext*
    name_start int
    name_length int
    kind ScopeKind
    definition_module ModuleContext*
    definition_index int
end

const max-source-bytes 4194304 end
const max-import-path-bytes 1024 end

proc field-read ptr int -- int do + i64* cast @ int cast end

proc field-write int ptr int -- do
    let value base offset do value i64 cast base offset + i64* cast ! end
end

proc byte-read ptr int -- int do
    + u8* cast @ int cast
end

proc byte-write int ptr int -- do
    let value base offset do value u8 cast base offset + u8* cast ! end
end

proc memory-copy ptr ptr int -- do
    let source destination count do
        0
        while dup count < do
            dup let index do
                source index byte-read
                destination index byte-write
            end
            1 +
        end
        drop
    end
end

proc emit-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + u8* cast @ int cast putc
            1 +
        end
        drop
    end
end

proc emit String -- do
    peek value do String.bytes value String.len emit-bytes
    end
end

proc emit-error-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + u8* cast @ int cast eputc
            1 +
        end
        drop
    end
end

proc emit-error String -- do
    peek value do String.bytes value String.len emit-error-bytes
    end
end

proc fail String -- do
    "frogc: " emit-error
    emit-error
    10 eputc
    1 exit
end

proc emit-unsigned int -- do
    let value do
        if value 10 >= do
            value 10 / emit-unsigned
        end
        value 10 % 48 + putc
    end
end

proc emit-integer int -- do
    let value do
        if value min-int == do
            "INT64_MIN" emit
        elif value 0 < do
            45 putc
            0 value - emit-unsigned
        else
            value emit-unsigned
        end
    end
end

proc is-space int -- bool do
    peek byte do 32 ==
        byte 9 == ||
        byte 10 == ||
        byte 13 == ||
    end
end

proc is-digit int -- bool do
    peek byte do 48 >= byte 57 <= &&
    end
end

proc is-ascii-letter int -- bool do
    peek byte do 65 >= byte 90 <= &&
        byte 97 >= byte 122 <= && ||
    end
end

proc is-c-identifier-start int -- bool do
    peek byte do is-ascii-letter byte 95 == ||
    end
end

proc is-c-identifier-byte int -- bool do
    peek byte do is-c-identifier-start byte is-digit ||
    end
end

proc digit-value int -- int do
    let byte do
        if byte is-digit do
            byte 48 -
        elif byte 65 >= byte 70 <= && do
            byte 65 - 10 +
        elif byte 97 >= byte 102 <= && do
            byte 97 - 10 +
        else
            0 1 -
        end
    end
end

proc is-hex-digit int -- bool do digit-value 0 >= end

proc hex-value int -- int do
    digit-value
    let value do
        if value 0 >= do
            value
        else
            "invalid hexadecimal digit" fail
            0
        end
    end
end

proc bytes-equal ptr int ptr int -- bool do
    let first first-length second second-length do
        if first-length second-length != do
            false
        else
            0 true
            while
                peek index equal do
                    index first-length < equal &&
                end
            do
                let index equal do
                    index 1 +
                    equal
                    first index byte-read second index byte-read == &&
                end
            end
            let index equal do equal end
        end
    end
end

proc bytes-equal-string ptr int String -- bool do
    peek bytes length value do String.bytes value String.len bytes-equal
    end
end

macro bytes-starts-with-string
    let bytes length prefix do
        if prefix String.len length > do
            false
        else
            bytes prefix String.len prefix String.bytes prefix String.len bytes-equal
        end
    end
end

proc read-source -- ptr int do
    max-source-bytes alloc
    let source do
        0 getc
        while dup 0 >= do
            let length byte do
                if length max-source-bytes >= do
                    "source exceeds max-source-bytes" fail
                end
                byte source length byte-write
                length 1 +
                getc
            end
        end
        drop
        source swap
    end
end

proc string-at Program* int -- StringPoolEntry* do
    let program index do program @Program.strings index StringPoolEntry:sizeof * + StringPoolEntry* cast end
end

proc program-allocate-proc-id Program* -- int do
    peek program do @Program.next_proc_id
        peek proc-id do 1 + program !Program.next_proc_id
            proc-id
        end
    end
end

proc program-allocate-nominal-type Program* -- int do
    peek program do @Program.next_nominal_type
        let nominal-type do
            if nominal-type type-function-base >= do "too many nominal types" fail end
            nominal-type 1 + program !Program.next_nominal_type
            nominal-type
        end
    end
end

proc program-allocate-function-type Program* -- int do
    peek program do @Program.next_function_type
        let function-type do
            if function-type type-pointer-base >= do "too many function types" fail end
            function-type 1 + program !Program.next_function_type
            function-type
        end
    end
end

proc pointer-type-at Program* int -- PointerTypeEntry* do
    let program index do program @Program.pointer_types index PointerTypeEntry:sizeof * + PointerTypeEntry* cast end
end

proc program-grow-pointer-types Program* -- do
    let program do
        program @Program.pointer_type_capacity 2 *
        let capacity do
            capacity PointerTypeEntry:sizeof * alloc
            let entries do
                0
                while dup program @Program.pointer_type_count < do
                    dup let index do
                        program index pointer-type-at @PointerTypeEntry.pointee_type entries index PointerTypeEntry:sizeof * + PointerTypeEntry* cast !PointerTypeEntry.pointee_type
                        program index pointer-type-at @PointerTypeEntry.pointer_type entries index PointerTypeEntry:sizeof * + PointerTypeEntry* cast !PointerTypeEntry.pointer_type
                    end
                    1 +
                end
                drop
                entries program !Program.pointer_types
                capacity program !Program.pointer_type_capacity
            end
        end
    end
end

proc program-find-pointer-type-from Program* int int -- int do
    let program pointee index do
        if index program @Program.pointer_type_count >= do
            0 1 -
        elif program index pointer-type-at @PointerTypeEntry.pointee_type pointee == do
            program index pointer-type-at @PointerTypeEntry.pointer_type
        else
            program pointee index 1 + program-find-pointer-type-from
        end
    end
end

proc program-intern-pointer-type Program* int -- int do
    let program pointee do
        program pointee 0 program-find-pointer-type-from
        let found do
            if found 0 >= do
                found
            else
                if program @Program.pointer_type_count program @Program.pointer_type_capacity == do program program-grow-pointer-types end
                program @Program.pointer_type_count
                let index do
                    if type-pointer-base index + unresolved-pointer-base >= do "too many pointer types" fail end
                    pointee program index pointer-type-at !PointerTypeEntry.pointee_type
                    type-pointer-base index + program index pointer-type-at !PointerTypeEntry.pointer_type
                    index 1 + program !Program.pointer_type_count
                    program index pointer-type-at @PointerTypeEntry.pointer_type
                end
            end
        end
    end
end

proc unresolved-pointer-type-at Program* int -- UnresolvedPointerTypeEntry* do
    let program index do program @Program.unresolved_pointer_types index UnresolvedPointerTypeEntry:sizeof * + UnresolvedPointerTypeEntry* cast end
end

proc program-grow-unresolved-pointer-types Program* -- do
    let program do
        program @Program.unresolved_pointer_type_capacity 2 *
        let capacity do
            capacity UnresolvedPointerTypeEntry:sizeof * alloc
            let entries do
                0
                while dup program @Program.unresolved_pointer_type_count < do
                    dup let index do
                        program index unresolved-pointer-type-at @UnresolvedPointerTypeEntry.module entries index UnresolvedPointerTypeEntry:sizeof * + UnresolvedPointerTypeEntry* cast !UnresolvedPointerTypeEntry.module
                        program index unresolved-pointer-type-at @UnresolvedPointerTypeEntry.token entries index UnresolvedPointerTypeEntry:sizeof * + UnresolvedPointerTypeEntry* cast !UnresolvedPointerTypeEntry.token
                        program index unresolved-pointer-type-at @UnresolvedPointerTypeEntry.depth entries index UnresolvedPointerTypeEntry:sizeof * + UnresolvedPointerTypeEntry* cast !UnresolvedPointerTypeEntry.depth
                    end
                    1 +
                end
                drop
                entries program !Program.unresolved_pointer_types
                capacity program !Program.unresolved_pointer_type_capacity
            end
        end
    end
end

proc program-add-unresolved-pointer-type Program* ModuleContext* int int -- int do
    let program module token depth do
        if program @Program.unresolved_pointer_type_count program @Program.unresolved_pointer_type_capacity == do program program-grow-unresolved-pointer-types end
        program @Program.unresolved_pointer_type_count
        let index do
            module program index unresolved-pointer-type-at !UnresolvedPointerTypeEntry.module
            token program index unresolved-pointer-type-at !UnresolvedPointerTypeEntry.token
            depth program index unresolved-pointer-type-at !UnresolvedPointerTypeEntry.depth
            index 1 + program !Program.unresolved_pointer_type_count
            unresolved-pointer-base index + 0 swap -
        end
    end
end

proc program-add-module Program* ModuleContext* -- do
    peek program module do !ModuleContext.program
        program @Program.module_count module !ModuleContext.module_id
        0 ptr cast ModuleContext* cast module !ModuleContext.next_module
        if program @Program.module_count 0 == do
            module program !Program.module_head
        else
            module program @Program.module_tail !ModuleContext.next_module
        end
        module program !Program.module_tail
        program @Program.module_count 1 + program !Program.module_count
    end
end

proc token-at ModuleContext* int -- TokenEntry* do
    let ctx index do
        ctx @ModuleContext.tokens index TokenEntry:sizeof * + TokenEntry* cast
    end
end

proc token-slice ModuleContext* int -- ptr int do
    let ctx index do
        ctx @ModuleContext.source
        ctx index token-at @TokenEntry.start +
        ctx index token-at @TokenEntry.length
    end
end

proc token-equals ModuleContext* int String -- bool do
    let ctx index value do
        ctx index token-slice value bytes-equal-string
    end
end

proc string-type-name ModuleContext* int -- bool do
    peek ctx token-index do "String" token-equals
    end
end

proc token-type-prefix-equals ModuleContext* int int String -- bool do
    let ctx token-index prefix-length value do
        ctx token-index token-slice
        let bytes length do
            prefix-length value String.len ==
            if dup do
                drop bytes prefix-length value String.bytes value String.len bytes-equal
            else
                drop false
            end
        end
    end
end

proc type-token-pointer-depth-from ModuleContext* int int -- int do
    let ctx token-index depth do
        if depth ctx token-index token-at @TokenEntry.length >= do
            depth
        elif
            ctx @ModuleContext.source ctx token-index token-at @TokenEntry.start +
            ctx token-index token-at @TokenEntry.length depth 1 + - byte-read
            42 ==
        do
            ctx token-index depth 1 + type-token-pointer-depth-from
        else
            depth
        end
    end
end

proc type-token-pointer-depth ModuleContext* int -- int do 0 type-token-pointer-depth-from end

proc type-token-base-has-star-from ModuleContext* int int int -- bool do
    let ctx token-index base-length index do
        if index base-length >= do
            false
        elif
            ctx @ModuleContext.source ctx token-index token-at @TokenEntry.start +
            index byte-read 42 ==
        do
            true
        else
            ctx token-index base-length index 1 + type-token-base-has-star-from
        end
    end
end

proc type-token-base-has-star ModuleContext* int int -- bool do 0 type-token-base-has-star-from end

proc token-is-pointer-type ModuleContext* int -- bool do
    peek ctx token-index do type-token-pointer-depth
        let depth do
            depth 0 >
            depth ctx token-index token-at @TokenEntry.length < &&
        end
    end
end

proc intern-pointer-depth Program* int int -- int do
    let program value-type depth do
        if depth 0 == do
            value-type
        else
            program value-type program-intern-pointer-type
            program swap
            let next-program pointer-type do
                next-program pointer-type depth 1 - intern-pointer-depth
            end
        end
    end
end

proc add-token ModuleContext* TokenKind int int int int int -- do
    let ctx kind start length value line column do
        ctx @ModuleContext.token_count
        let index do
            kind ctx index token-at !TokenEntry.kind
            start ctx index token-at !TokenEntry.start
            length ctx index token-at !TokenEntry.length
            value ctx index token-at !TokenEntry.value
            line ctx index token-at !TokenEntry.line
            column ctx index token-at !TokenEntry.column
            index 1 + ctx !ModuleContext.token_count
        end
    end
end

proc source-byte ModuleContext* int -- int do
    let ctx index do
        ctx @ModuleContext.source index byte-read
    end
end

proc source-byte-is-newline ModuleContext* int -- bool do
    let ctx index do
        if ctx index source-byte 10 == do
            true
        elif ctx index source-byte 13 != do
            false
        elif index 1 + ctx @ModuleContext.source_length >= do
            true
        else
            ctx index 1 + source-byte 10 !=
        end
    end
end

proc source-line-start ModuleContext* int -- int do
    let ctx initial do
        initial
        while
            peek offset do
                offset 0 >
                if dup do drop ctx offset 1 - source-byte-is-newline ! end
            end
        do
            1 -
        end
    end
end

proc source-line-end ModuleContext* int -- int do
    let ctx initial do
        initial
        while
            peek offset do
                offset ctx @ModuleContext.source_length <
                if dup do
                    drop
                    ctx offset source-byte 10 !=
                    ctx offset source-byte 13 != &&
                end
            end
        do
            1 +
        end
    end
end

proc source-line-number ModuleContext* int -- int do
    let ctx finish do
        0 1
        while peek offset line do offset finish < end do
            let offset line do
                if ctx offset source-byte-is-newline do
                    offset 1 + line 1 +
                else
                    offset 1 + line
                end
            end
        end
        let offset line do line end
    end
end

proc emit-error-spaces int -- do
    let count do 0 while dup count < do 32 eputc 1 + end drop end
end

proc emit-error-carets int -- do
    let count do 0 while dup count < do 94 eputc 1 + end drop end
end

proc tab-display-width int -- int do
    let column do 8 column 1 - 8 % - end
end

proc source-display-column-from ModuleContext* int int int -- int do
    let ctx start finish start-column do
        start start-column
        while peek index column do index finish < end do
            let index column do
                if ctx index source-byte 9 == do
                    index 1 + column column tab-display-width +
                else
                    ctx @ModuleContext.source ctx @ModuleContext.source_length index utf8-sequence-width
                    let width do
                        if width 0 == do 1 else width end
                        let advance do index advance + column 1 + end
                    end
                end
            end
        end
        let index column do column end
    end
end

proc emit-source-display-from ModuleContext* int int int -- do
    let ctx start finish start-column do
        start start-column
        while peek index column do index finish < end do
            let index column do
                if ctx index source-byte 9 == do
                    column tab-display-width
                    let width do
                        width emit-error-spaces
                        index 1 + column width +
                    end
                else
                    ctx @ModuleContext.source ctx @ModuleContext.source_length index utf8-sequence-width
                    let width do
                        if width 0 == do 1 else width end
                        let advance do
                            ctx @ModuleContext.source index + advance emit-error-bytes
                            index advance + column 1 +
                        end
                    end
                end
            end
        end
        let index column do end
    end
end

proc source-display-width ModuleContext* int int -- int do
    let ctx start finish do
        ctx start source-line-start
        let line-start do
            ctx line-start start 1 source-display-column-from
            let start-column do
                ctx start finish start-column source-display-column-from start-column -
            end
        end
    end
end

proc smaller-int int int -- int do
    let left right do if left right < do left else right end end
end

proc emit-unsigned-error int -- do
    let value do
        if value 10 >= do value 10 / emit-unsigned-error end
        value 10 % 48 + eputc
    end
end

proc emit-integer-error int -- do
    let value do
        if value min-int == do "INT64_MIN" emit-error
        elif value 0 < do 45 eputc 0 value - emit-unsigned-error
        else value emit-unsigned-error end
    end
end

proc emit-diagnostic-prefix ModuleContext* int -- do
    let ctx token do
        ctx @ModuleContext.diagnostic_path ctx @ModuleContext.diagnostic_path_length emit-error-bytes
        ":" emit-error ctx token token-at @TokenEntry.line emit-integer-error ":" emit-error
        ctx ctx token token-at @TokenEntry.start source-line-start
        let line-start do
            ctx line-start ctx token token-at @TokenEntry.start 1 source-display-column-from emit-integer-error
            ":\n  " emit-error
            ctx ctx token token-at @TokenEntry.start source-line-end
            let line-end do
                ctx line-start line-end 1 emit-source-display-from
                "\n  " emit-error
                ctx line-start ctx token token-at @TokenEntry.start 1 source-display-column-from 1 - emit-error-spaces
                ctx token token-at @TokenEntry.start
                ctx token token-at @TokenEntry.length + line-end smaller-int
                let span-end do
                    ctx ctx token token-at @TokenEntry.start span-end source-display-width
                end
                let width do if width 0 <= do 1 else width end emit-error-carets end
                "\nerror: " emit-error
            end
        end
    end
end

proc fail-at ModuleContext* int String -- do
    let ctx token message do
        ctx token emit-diagnostic-prefix
        message emit-error
        10 eputc
        1 exit
    end
end

proc fail-name-at ModuleContext* int String -- do
    let ctx token message do
        ctx token emit-diagnostic-prefix
        message emit-error
        ": " emit-error
        ctx token token-slice emit-error-bytes
        10 eputc
        1 exit
    end
end

proc fail-span-at ModuleContext* int int int String -- do
    let ctx start length line message do
        ctx @ModuleContext.diagnostic_path ctx @ModuleContext.diagnostic_path_length emit-error-bytes
        ":" emit-error line emit-integer-error ":" emit-error
        ctx start source-line-start
        let line-start do
            ctx line-start start 1 source-display-column-from emit-integer-error
            ":\n  " emit-error
            ctx start source-line-end
            let line-end do
                ctx line-start line-end 1 emit-source-display-from
                "\n  " emit-error
                ctx line-start start 1 source-display-column-from 1 - emit-error-spaces
                start length + line-end smaller-int
                let span-end do ctx start span-end source-display-width end
                let width do if width 0 <= do 1 else width end emit-error-carets end
                "\nerror: " emit-error message emit-error 10 eputc
                1 exit
            end
        end
    end
end

proc fail-eof ModuleContext* String -- do
    let ctx message do
        ctx ctx @ModuleContext.source_length 0 ctx @ModuleContext.lex_line message fail-span-at
    end
end

proc lex-advance ModuleContext* -- do
    peek ctx do @ModuleContext.lex_index
        let index do
            ctx index source-byte
            let byte do
                index 1 + ctx !ModuleContext.lex_index
                if ctx index source-byte-is-newline do
                    ctx @ModuleContext.lex_line 1 + ctx !ModuleContext.lex_line
                    1 ctx !ModuleContext.lex_column
                else
                    if byte 192 & 128 != do
                        ctx @ModuleContext.lex_column 1 + ctx !ModuleContext.lex_column
                    end
                end
            end
        end
    end
end

proc all-digits ptr int int -- bool do
    let source start length do
        0 true
        while
            peek index valid do
                index length < valid &&
            end
        do
            let index valid do
                index 1 +
                valid source start index + byte-read is-digit &&
            end
        end
        let index valid do
            valid length 0 > &&
        end
    end
end

proc integer-literal-base ptr int int -- int do
    let source start length do
        if length 2 >= source start byte-read 48 == && do
            source start 1 + byte-read
            let prefix do
                if prefix 98 == do
                    2
                elif prefix 111 == do
                    8
                elif prefix 120 == do
                    16
                else
                    0
                end
            end
        else
            0
        end
    end
end

proc parse-integer ModuleContext* int int int int int bool int -- int do
    let ctx span-start span-length start length base negative line do
        if length 0 == do
            ctx span-start span-length line "invalid integer literal" fail-span-at
        end
        if negative do min-int else 0 max-int - end
        let limit do
            0 0
            while
                peek index value do index length <
                end
            do
                let index value do
                    ctx @ModuleContext.source start index + byte-read digit-value
                    let digit do
                        if digit 0 < digit base >= || do
                            ctx span-start span-length line "invalid integer literal" fail-span-at
                        end
                        if
                            value limit base / <
                            value limit base / ==
                            digit 0 limit base % - > && ||
                        do
                            ctx span-start span-length line "integer literal exceeds the signed 64-bit range" fail-span-at
                        end
                        index 1 +
                        value base * digit -
                    end
                end
            end
            let index value do
                if negative do value else 0 value - end
            end
        end
    end
end

proc classify-word ModuleContext* int int int -- TokenKind int do
    let ctx start length line do
        ctx @ModuleContext.source
        let source do
        if source start + length "true" bytes-equal-string do
            TokenKind:bool 1
        elif source start + length "false" bytes-equal-string do
            TokenKind:bool 0
        else
            if
                length 1 >
                source start byte-read 43 ==
                source start byte-read 45 == || &&
            do
                1
            else
                0
            end
            let sign-length do
                sign-length 1 == source start byte-read 45 == &&
                let negative do
                    start sign-length + length sign-length -
                    let literal-start literal-length do
                        if source literal-start literal-length all-digits do
                            TokenKind:int ctx start length literal-start literal-length 10 negative line parse-integer
                        else
                            source literal-start literal-length integer-literal-base
                            let base do
                                if base 0 > do
                                    TokenKind:int ctx start length literal-start 2 + literal-length 2 - base negative line parse-integer
                                elif source literal-start byte-read is-digit do
                                    ctx start length line "invalid integer literal" fail-span-at
                                    TokenKind:word 0
                                else
                                    TokenKind:word 0
                                end
                            end
                        end
                    end
                end
            end
        end
        end
    end
end

proc skip-comment ModuleContext* -- do
    let ctx do
        while
            ctx @ModuleContext.lex_index ctx @ModuleContext.source_length <
            if dup do
                drop ctx ctx @ModuleContext.lex_index source-byte-is-newline !
            end
        do
            ctx lex-advance
        end
    end
end

proc lex-string ModuleContext* int int int -- do
    let ctx start line column do
        ctx lex-advance
        ctx @ModuleContext.lex_index
        let content-start do
            false
            while
                peek done do done !
                    ctx @ModuleContext.lex_index ctx @ModuleContext.source_length < &&
                end
            do
                let done do
                    ctx ctx @ModuleContext.lex_index source-byte
                    let byte do
                        if byte '"' == do
                            true
                        else
                            if byte 92 == do
                                ctx lex-advance
                                if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
                                    ctx start ctx @ModuleContext.lex_index start - line "unterminated string escape" fail-span-at
                                end
                            end
                            ctx lex-advance
                            false
                        end
                    end
                end
            end
            drop
            if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
                ctx start ctx @ModuleContext.lex_index start - line "unterminated string literal" fail-span-at
            end
            ctx @ModuleContext.lex_index content-start -
            let content-length do
                ctx TokenKind:string content-start content-length 0 line column add-token
            end
            ctx lex-advance
        end
    end
end

proc character-literal-span-length ModuleContext* int -- int do
    let ctx start do
        start 1 +
        while
            peek finish do
                finish ctx @ModuleContext.source_length <
                if dup do
                    drop
                    ctx finish source-byte 10 !=
                    ctx finish source-byte 13 != &&
                    ctx finish source-byte '\'' != &&
                end
            end
        do
            1 +
        end
        let finish do
            if finish ctx @ModuleContext.source_length < do
                if ctx finish source-byte '\'' == do finish 1 + else finish end
            else
                finish
            end
            start -
        end
    end
end

proc lex-character ModuleContext* int int int -- do
    let ctx start line column do
        ctx lex-advance
        if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
            ctx start ctx @ModuleContext.lex_index start - line "unterminated character literal" fail-span-at
        end
        if
            ctx ctx @ModuleContext.lex_index source-byte 10 ==
            ctx ctx @ModuleContext.lex_index source-byte 13 == ||
        do
            ctx start ctx @ModuleContext.lex_index start - line "unterminated character literal" fail-span-at
        end
        ctx @ModuleContext.lex_index 2 +
        let closing-index do
            if closing-index ctx @ModuleContext.source_length >= do
                false
            else
                ctx ctx @ModuleContext.lex_index source-byte 92 ==
                ctx ctx @ModuleContext.lex_index 1 + source-byte '\'' == &&
                ctx closing-index source-byte '\'' == &&
            end
        end
        let quote-escape do
            if quote-escape do
                ctx 3 lex-advance-count
                ctx TokenKind:char start 4 '\'' line column add-token
            else
                if ctx ctx @ModuleContext.lex_index source-byte '\'' == do
                    ctx start ctx start character-literal-span-length line "invalid character literal" fail-span-at
                end
                ctx @ModuleContext.source ctx @ModuleContext.source_length ctx @ModuleContext.lex_index utf8-sequence-width
                let width do
                    if width 0 == do
                        ctx start ctx start character-literal-span-length line "invalid character literal" fail-span-at
                    end
                    ctx @ModuleContext.source ctx @ModuleContext.source_length ctx @ModuleContext.lex_index utf8-codepoint-at
                    let value ignored-width do
                    ctx width lex-advance-count
                    if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
                        ctx start ctx @ModuleContext.lex_index start - line "unterminated character literal" fail-span-at
                    end
                    if ctx ctx @ModuleContext.lex_index source-byte '\'' != do
                        if
                            ctx ctx @ModuleContext.lex_index source-byte 10 ==
                            ctx ctx @ModuleContext.lex_index source-byte 13 == ||
                        do
                            ctx start ctx @ModuleContext.lex_index start - line "unterminated character literal" fail-span-at
                        else
                            ctx start ctx start character-literal-span-length line "invalid character literal" fail-span-at
                        end
                    end
                    ctx lex-advance
                    ctx TokenKind:char start width 2 + value line column add-token
                    end
                end
            end
        end
    end
end

proc lex-word ModuleContext* int int int -- do
    let ctx start line column do
        while
            ctx @ModuleContext.lex_index ctx @ModuleContext.source_length <
            if dup do
                drop ctx ctx @ModuleContext.lex_index source-byte is-space !
            end
        do
            ctx lex-advance
        end
        ctx @ModuleContext.lex_index start -
        let length do
            if ctx @ModuleContext.source start + length "//" bytes-equal-string do
                ctx skip-comment
            else
                ctx start length line classify-word
                let kind value do
                    ctx kind start length value line column add-token
                end
            end
        end
    end
end

proc lex ModuleContext* -- do
    let ctx do
        0 ctx !ModuleContext.token_count
        0 ctx !ModuleContext.lex_index
        1 ctx !ModuleContext.lex_line
        1 ctx !ModuleContext.lex_column

        while ctx @ModuleContext.lex_index ctx @ModuleContext.source_length < do
            ctx ctx @ModuleContext.lex_index source-byte
            let byte do
                if byte is-space do
                    ctx lex-advance
                else
                    ctx @ModuleContext.lex_index
                    ctx @ModuleContext.lex_line
                    ctx @ModuleContext.lex_column
                    let start line column do
                        if byte '"' == do
                            ctx start line column lex-string
                        else
                            if byte '\'' == do
                                ctx start line column lex-character
                            else
                                ctx start line column lex-word
                            end
                        end
                    end
                end
            end
        end
    end
end

