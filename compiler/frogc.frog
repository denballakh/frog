        module token-index "exit" token-equals ||
        module token-index "?" token-equals ||
    end
end

proc scope-prefix-is-nominal ModuleContext ptr int bool -- bool do
    let scope bytes length allow-function do
        scope bytes length 0 find-scope-symbol-from
        let symbol-index do
            if symbol-index 0 < do
                false
            else
                scope symbol-index scope-at @ScopeEntry.kind
                peek kind do scope-record ==
                    kind scope-union == ||
                    kind scope-function == allow-function && ||
                end
            end
        end
    end
end

proc scope-prefix-has-kind ModuleContext ptr int int -- bool do
    let scope bytes length expected-kind do
        scope bytes length 0 find-scope-symbol-from
