proc emit-function-dispatch-module CompileContext* ModuleContext* int ModuleContext* int -- do
    let cc function-module function-index proc-module base do
        0
        while dup proc-module @ModuleContext.proc_count < do
            dup
            let proc-index do
                if
                    function-module function-index proc-module proc-index
                    function-proc-contracts-equal
                do
                    cc emit-indent "case " emit
                    proc-module proc-index procedure-at @ProcedureEntry.global_id emit-unsigned
                    ": {" emit 10 putc
                    cc indent-more
                    cc proc-module proc-index base emit-procedure-invocation
                    cc emit-indent "break;" emit 10 putc
                    cc indent-less
                    cc emit-indent "}" emit 10 putc
                end
            end
            1 +
        end
        drop
    end
end

proc emit-function-dispatch-cases CompileContext* Program* ModuleContext* int int -- do
    let cc program function-module function-index base do
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            let proc-module do
                cc function-module function-index proc-module base emit-function-dispatch-module
                proc-module @ModuleContext.next_module
            end
        end
        drop
    end
end

proc emit-function-call CompileContext* ModuleContext* int -- do
    let cc function-module function-index do
        if cc @CompileContext.emitting do
            function-module function-index function-type-at @FunctionTypeEntry.output_count
            let output-count do
                cc @CompileContext.type_count output-count -
                let base do
                    function-module function-index function-type-at @FunctionTypeEntry.input_count
                    let input-count do
                        cc emit-indent "{ Cell function_id = " emit
                        cc base input-count +
                        function-module function-index function-type-at @FunctionTypeEntry.function_type
                        emit-slot-as ";" emit 10 putc
                        cc indent-more
                        cc emit-indent "switch (function_id) {" emit 10 putc
                        cc indent-more
                        cc cc @CompileContext.program function-module function-index base emit-function-dispatch-cases
                        cc emit-indent "default: frog_runtime_fail();" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                    end
                end
            end
        end
    end
end

proc fail-function-reference-contract CompileContext* ModuleContext* int ModuleContext* int -- do
    let cc function-module function-index proc-module proc-index do
        "frogc: function reference contract mismatch: expected " emit-error
        cc @CompileContext.program function-module function-index emit-error-function-contract
        ", actual " emit-error
        cc @CompileContext.program proc-module proc-index emit-error-proc-contract
        10 eputc
        1 exit
    end
end

proc compile-function-operation CompileContext* ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @CompileContext.scope_module bytes separator visible-function-definition
            let function-module function-index found do
                if found ! do
                    false
                else
                    bytes separator 1 + +
                    length separator 1 + -
                    let operation operation-length do
                        if operation operation-length "call" bytes-equal-string do
                            cc function-module function-index apply-function-contract
                            cc function-module function-index emit-function-call
                            true
                        elif operation operation-length "ref" bytes-equal-string do
                            "expected function reference target" fail
                            false
                        elif
                            operation-length 4 >=
                            if dup do
                                drop operation 4 "ref:" bytes-equal-string
                            end
                        do
                            if operation-length 4 == do
                                "expected function reference target" fail
                            end
                            function-module function-index
                            cc @CompileContext.scope_module
                            operation 4 +
                            operation-length 4 -
                            visible-function-reference-matches
                            let proc-module proc-index count proc-found do
                                if count 1 > do
                                    "ambiguous function reference target" fail
                                end
                                if count 0 == do
                                    cc @CompileContext.scope_module
                                    operation 4 +
                                    operation-length 4 -
                                    visible-procedure-definition
                                    let actual-module actual-index actual-found do
                                        if actual-found do
                                            cc function-module function-index actual-module actual-index
                                            fail-function-reference-contract
                                        else
                                            "function reference target not found" fail
                                        end
                                    end
                                end
                                cc function-module function-index function-type-at @FunctionTypeEntry.function_type type-push
                                cc proc-module proc-index procedure-at @ProcedureEntry.global_id emit-push-integer
                                true
                            end
                        else
                            "unknown function operation" fail
                            false
                        end
                    end
                end
            end
        end
    end
end

proc compile-function-word CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.defining_module token-index token-slice
        peek bytes length do 58 first-index-of-byte
            let colon do
