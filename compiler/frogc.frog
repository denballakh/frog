proc fail-duplicate-declaration ModuleContext* int -- do
    let ctx token-index do
        ctx token-index "duplicate declaration name" fail-name-at
    end
end

proc scan-record-fields ModuleContext* int int -- int do
    let ctx record-index token-index do
        if token-index ctx @ModuleContext.token_count >= do
            ctx "unterminated record declaration" fail-eof
            token-index
        elif ctx token-index "end" token-equals do
            if ctx record-index record-type-at @RecordTypeEntry.field_count 0 == do
                ctx token-index "record must declare at least one field" fail-at
            end
            token-index 1 +
        else
            ctx token-index require-word
            if ctx token-index identifier-token ! do
                ctx token-index "record field name must be an identifier" fail-at
            end
            ctx record-index ctx token-index token-slice find-record-field
            let existing-field do
                if existing-field 0 >= do
                    ctx token-index "duplicate record field" fail-name-at
                end
            end
            token-index 1 +
            let type-token do
                if type-token ctx @ModuleContext.token_count >= do
                    ctx "expected record field type" fail-eof
                elif ctx type-token "end" token-equals do
                    ctx type-token "expected record field type" fail-at
                end
                ctx type-token require-word
                if ctx type-token reserved-name do
                    ctx type-token "unknown record field type" fail-name-at
                end
                if ctx @ModuleContext.program program-failed do
                    ctx @ModuleContext.token_count
                else
                    ctx @ModuleContext.record_field_count
                    let field-index do
                        ctx token-index token-at @TokenEntry.start ctx field-index record-field-at !RecordFieldEntry.name_start
                        ctx token-index token-at @TokenEntry.length ctx field-index record-field-at !RecordFieldEntry.name_length
                        token-index ctx field-index record-field-at !RecordFieldEntry.name_token
                        ctx type-token parse-type-token ctx field-index record-field-at !RecordFieldEntry.field_type
                        type-token ctx field-index record-field-at !RecordFieldEntry.type_token
                        field-index 1 + ctx !ModuleContext.record_field_count
                        ctx record-index record-type-at @RecordTypeEntry.field_count 1 +
                        ctx record-index record-type-at !RecordTypeEntry.field_count
                        ctx record-index type-token 1 + scan-record-fields
                    end
                end
            end
        end
    end
end

proc scan-one-record ModuleContext* int -- int do
    let ctx record-token do
        record-token 1 +
        let name-token do
            if name-token ctx @ModuleContext.token_count >= do
                ctx "expected record name" fail-eof
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token private-intrinsic-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                ctx name-token "invalid record name" fail-name-at
            end
            if ctx name-token find-record 0 >= do
                ctx name-token "duplicate record name" fail-name-at
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
                ctx name-token find-constant 0 >= ||
                ctx name-token find-union 0 >= ||
                ctx name-token find-function 0 >= ||
                ctx name-token find-c-type 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            if ctx @ModuleContext.program program-failed do
                ctx @ModuleContext.token_count
            else
                ctx @ModuleContext.record_count
                let record-index do
                    ctx name-token token-at @TokenEntry.start ctx record-index record-type-at !RecordTypeEntry.name_start
                    ctx name-token token-at @TokenEntry.length ctx record-index record-type-at !RecordTypeEntry.name_length
                    name-token ctx record-index record-type-at !RecordTypeEntry.name_token
                    ctx @ModuleContext.record_field_count ctx record-index record-type-at !RecordTypeEntry.field_start
                    0 ctx record-index record-type-at !RecordTypeEntry.field_count
                    ctx @ModuleContext.program program-allocate-nominal-type ctx record-index record-type-at !RecordTypeEntry.record_type
                    AggregateCycleState:unvisited ctx record-index record-type-at !RecordTypeEntry.cycle_state
                    false ctx record-index record-type-at !RecordTypeEntry.c_emitted
                    ctx record-index name-token 1 + scan-record-fields
                    let next-token do
                        record-index 1 + ctx !ModuleContext.record_count
                        next-token
                    end
                end
            end
        end
    end
end

proc scan-union-cases ModuleContext* int int -- int do
    let ctx union-index token-index do
        if token-index ctx @ModuleContext.token_count >= do
            ctx "unterminated union declaration" fail-eof
            token-index
        elif ctx token-index "end" token-equals do
            if ctx union-index union-type-at @UnionTypeEntry.case_count 0 == do
                ctx token-index "union must declare at least one variant" fail-at
            end
            token-index 1 +
        elif ctx token-index "case" token-equals ! do
            ctx token-index "expected case or end in union declaration" fail-at
            token-index
        else
            token-index 1 +
            let name-token do
                if name-token ctx @ModuleContext.token_count >= do
                    ctx "expected union variant name" fail-eof
                elif
                    ctx name-token "case" token-equals
                    ctx name-token "end" token-equals ||
                do
                    ctx name-token "expected union variant name" fail-at
                end
                ctx name-token require-word
                if
                    ctx name-token identifier-token !
                    ctx name-token reserved-name ||
                do
                    ctx name-token "invalid union variant name" fail-name-at
                end
                ctx union-index ctx name-token token-slice find-union-case
                let existing-case do
                    if existing-case 0 >= do
                        ctx name-token "duplicate union variant" fail-name-at
                    end
                end
                if ctx @ModuleContext.program program-failed do
                    ctx @ModuleContext.token_count
                else
                    ctx @ModuleContext.union_case_count
                    let case-index do
                        ctx name-token token-at @TokenEntry.start ctx case-index union-case-at !UnionCaseEntry.name_start
                        ctx name-token token-at @TokenEntry.length ctx case-index union-case-at !UnionCaseEntry.name_length
                        name-token ctx case-index union-case-at !UnionCaseEntry.name_token
                        type-none ctx case-index union-case-at !UnionCaseEntry.payload_type
                        0 1 - ctx case-index union-case-at !UnionCaseEntry.type_token
                        ctx union-index union-type-at @UnionTypeEntry.case_count ctx case-index union-case-at !UnionCaseEntry.tag
                        name-token 1 +
                        let after-name do
                            if after-name ctx @ModuleContext.token_count >= do
                                ctx "unterminated union declaration" fail-eof
                            end
                            if
                                ctx after-name "case" token-equals
                                ctx after-name "end" token-equals ||
                            do
                                after-name
                            else
                                ctx after-name require-word
                                if ctx after-name reserved-name do
                                    ctx after-name "unknown union variant type" fail-name-at
                                end
                                ctx after-name parse-type-token ctx case-index union-case-at !UnionCaseEntry.payload_type
                                after-name ctx case-index union-case-at !UnionCaseEntry.type_token
                                after-name 1 +
                                let after-payload do
                                    if after-payload ctx @ModuleContext.token_count >= do
                                        ctx "unterminated union declaration" fail-eof
                                    end
                                    if
                                        ctx after-payload "case" token-equals
                                        ctx after-payload "end" token-equals ||
                                        !
                                    do
                                        ctx after-payload "union variant may carry at most one value" fail-at
                                    end
                                    after-payload
                                end
                            end
                            let next-token do
                                case-index 1 + ctx !ModuleContext.union_case_count
                                ctx union-index union-type-at @UnionTypeEntry.case_count 1 +
                                ctx union-index union-type-at !UnionTypeEntry.case_count
                                ctx union-index next-token scan-union-cases
                            end
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-union ModuleContext* int -- int do
    let ctx union-token do
        union-token 1 +
        let name-token do
            if name-token ctx @ModuleContext.token_count >= do
                ctx "expected union name" fail-eof
            elif
                ctx name-token "case" token-equals
                ctx name-token "end" token-equals ||
            do
                ctx name-token "expected union name" fail-at
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token private-intrinsic-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                ctx name-token "invalid union name" fail-name-at
            end
            if ctx name-token find-union 0 >= do
                ctx name-token "duplicate union name" fail-name-at
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
                ctx name-token find-constant 0 >= ||
                ctx name-token find-record 0 >= ||
                ctx name-token find-function 0 >= ||
                ctx name-token find-c-type 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            if ctx @ModuleContext.program program-failed do
                ctx @ModuleContext.token_count
            else
                ctx @ModuleContext.union_count
                let union-index do
                    ctx name-token token-at @TokenEntry.start ctx union-index union-type-at !UnionTypeEntry.name_start
                    ctx name-token token-at @TokenEntry.length ctx union-index union-type-at !UnionTypeEntry.name_length
                    name-token ctx union-index union-type-at !UnionTypeEntry.name_token
                    ctx @ModuleContext.union_case_count ctx union-index union-type-at !UnionTypeEntry.case_start
                    0 ctx union-index union-type-at !UnionTypeEntry.case_count
                    ctx @ModuleContext.program program-allocate-nominal-type ctx union-index union-type-at !UnionTypeEntry.union_type
                    AggregateCycleState:unvisited ctx union-index union-type-at !UnionTypeEntry.cycle_state
                    false ctx union-index union-type-at !UnionTypeEntry.c_emitted
                    ctx union-index name-token 1 + scan-union-cases
                    let next-token do
                        union-index 1 + ctx !ModuleContext.union_count
                        next-token
                    end
                end
            end
        end
    end
end

proc parse-function-signature-type-token ModuleContext* int -- int do
    peek ctx token-index do require-word
        if ctx token-index reserved-name do
            ctx token-index "unknown type in function signature" fail-name-at
        end
        ctx token-index parse-type-token
    end
end

proc scan-one-function ModuleContext* int -- int do
    let ctx function-token do
        function-token 1 +
        let name-token do
            if name-token ctx @ModuleContext.token_count >= do
                ctx "expected function name" fail-eof
            elif
                ctx name-token "--" token-equals
                ctx name-token "end" token-equals ||
            do
                ctx name-token "expected function name" fail-at
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token private-intrinsic-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                ctx name-token "invalid function name" fail-name-at
            end
            if ctx name-token find-function 0 >= do
                ctx name-token "duplicate function name" fail-name-at
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
                ctx name-token find-constant 0 >= ||
                ctx name-token find-record 0 >= ||
                ctx name-token find-union 0 >= ||
                ctx name-token find-c-type 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            if ctx @ModuleContext.program program-failed do
                ctx @ModuleContext.token_count
            else
                ctx @ModuleContext.function_count
                let function-index do
                    ctx name-token token-at @TokenEntry.start ctx function-index function-type-at !FunctionTypeEntry.name_start
                    ctx name-token token-at @TokenEntry.length ctx function-index function-type-at !FunctionTypeEntry.name_length
                    name-token ctx function-index function-type-at !FunctionTypeEntry.name_token
                    ctx @ModuleContext.program program-allocate-function-type ctx function-index function-type-at !FunctionTypeEntry.function_type
                    ctx @ModuleContext.function_type_count ctx function-index function-type-at !FunctionTypeEntry.input_start
                    name-token 1 + 0
                    while
                        peek token-index count do
                            token-index ctx @ModuleContext.token_count <
                            if dup do
                                drop
                                ctx token-index "--" token-equals !
                                ctx token-index "end" token-equals ! &&
                            end
                        end
                    do
                        let token-index count do
                            ctx token-index ctx token-index parse-function-signature-type-token add-function-signature-type
                            token-index 1 + count 1 +
                        end
                    end
                    let token-index input-count do
                        if token-index ctx @ModuleContext.token_count >= do
                            ctx "expected -- in function signature" fail-eof
                        end
                        if ctx token-index "--" token-equals ! do
                            ctx token-index "expected -- in function signature" fail-at
                        end
                        if ctx @ModuleContext.program program-failed do
                            ctx @ModuleContext.token_count
                        else
                            input-count ctx function-index function-type-at !FunctionTypeEntry.input_count
                            ctx @ModuleContext.function_type_count ctx function-index function-type-at !FunctionTypeEntry.output_start
                            token-index 1 + 0
                            while
                                peek output-token output-count do
                                    output-token ctx @ModuleContext.token_count <
                                    if dup do
                                        drop ctx output-token "end" token-equals !
                                    end
                                end
                            do
                                let output-token output-count do
                                    ctx output-token ctx output-token parse-function-signature-type-token add-function-signature-type
                                    output-token 1 + output-count 1 +
                                end
                            end
                            let output-token output-count do
                                if output-token ctx @ModuleContext.token_count >= do
                                    ctx "expected end after function signature" fail-eof
                                end
                                if ctx @ModuleContext.program program-failed do
                                    ctx @ModuleContext.token_count
                                else
                                    output-count ctx function-index function-type-at !FunctionTypeEntry.output_count
                                    function-index 1 + ctx !ModuleContext.function_count
                                    output-token 1 +
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc scan-macro-body ModuleContext* int -- int do
    let ctx body-start do
        body-start 0 true
        while
            peek token-index depth active do active
            end
        do
            let token-index depth active do
                if token-index ctx @ModuleContext.token_count >= do
                    ctx "unterminated macro body" fail-eof
                    token-index depth false
                elif ctx token-index token-at @TokenEntry.kind TokenKind:word == do
                    if ctx token-index "end" token-equals do
                        if depth 0 == do
                            token-index 1 + depth false
                        else
                            token-index 1 + depth 1 - true
                        end
                    elif
                        ctx token-index "if" token-equals
                        ctx token-index "while" token-equals ||
                        ctx token-index "let" token-equals ||
                        ctx token-index "peek" token-equals ||
                    do
                        token-index 1 + depth 1 + true
                    elif
                        ctx token-index "from" token-equals
                        ctx token-index "import" token-equals ||
                    do
                        ctx token-index "imports are only allowed at top level" fail-at
                        token-index 1 + depth true
                    elif
                        ctx token-index "proc" token-equals
                        ctx token-index "macro" token-equals ||
                        ctx token-index "const" token-equals ||
                        ctx token-index "c-include" token-equals ||
                        ctx token-index "c-type" token-equals ||
                        ctx token-index "c-call" token-equals ||
                        ctx token-index "c-value" token-equals ||
                        ctx token-index "record" token-equals ||
                        ctx token-index "union" token-equals ||
                        ctx token-index "fn" token-equals ||
                    do
                        ctx token-index "declarations are not allowed in macro bodies" fail-at
                        token-index 1 + depth true
                    else
                        token-index 1 + depth true
                    end
                else
                    token-index 1 + depth true
                end
            end
        end
        let next-token depth active do
            next-token
        end
    end
end

record MacroBlockFrame
    kind BlockKind
    has_do bool
    has_else bool
end

proc macro-block-frame-at ptr int -- MacroBlockFrame* do
    let frames index do frames index MacroBlockFrame:sizeof * + MacroBlockFrame* cast end
end

proc validate-macro-body ModuleContext* int int -- do
    let ctx body-start body-end do
        body-end body-start - MacroBlockFrame:sizeof * alloc
        let frames do
            body-start 0
            while
                peek token-index depth do
                    token-index body-end <
                end
            do
                let token-index depth do
                    if ctx token-index token-at @TokenEntry.kind TokenKind:word == do
                        if
                            ctx token-index "from" token-equals
                            ctx token-index "import" token-equals ||
                        do
                            ctx token-index "imports are only allowed at top level" fail-at
                            token-index 1 + depth
                        elif
                            ctx token-index "proc" token-equals
                            ctx token-index "macro" token-equals ||
                            ctx token-index "const" token-equals ||
                            ctx token-index "c-include" token-equals ||
                            ctx token-index "c-type" token-equals ||
                            ctx token-index "c-call" token-equals ||
                            ctx token-index "c-value" token-equals ||
                            ctx token-index "record" token-equals ||
                            ctx token-index "union" token-equals ||
                            ctx token-index "fn" token-equals ||
                        do
                            ctx token-index "declarations are not allowed in macro bodies" fail-at
                            token-index 1 + depth
                        elif
                            ctx token-index "if" token-equals
                            ctx token-index "while" token-equals ||
                            ctx token-index "let" token-equals ||
                            ctx token-index "peek" token-equals ||
                        do
                            if ctx token-index "if" token-equals do
                                BlockKind:conditional frames depth macro-block-frame-at !MacroBlockFrame.kind
                            elif ctx token-index "while" token-equals do
                                BlockKind:loop frames depth macro-block-frame-at !MacroBlockFrame.kind
                            else
                                BlockKind:local_scope frames depth macro-block-frame-at !MacroBlockFrame.kind
                            end
                            false frames depth macro-block-frame-at !MacroBlockFrame.has_do
                            false frames depth macro-block-frame-at !MacroBlockFrame.has_else
                            token-index 1 + depth 1 +
                        elif ctx token-index "do" token-equals do
                            if depth 0 <= do
                                ctx token-index "do outside macro control-flow block" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.has_do do
                                ctx token-index "duplicate do in macro control-flow block" fail-at
                            end
                            true frames depth 1 - macro-block-frame-at !MacroBlockFrame.has_do
                            token-index 1 + depth
                        elif ctx token-index "else" token-equals do
                            if depth 0 <= do
                                ctx token-index "else outside macro if block" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.kind BlockKind:conditional != do
                                ctx token-index "else outside macro if block" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.has_do ! do
                                ctx token-index "else requires a completed macro if arm" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.has_else do
                                ctx token-index "duplicate else in macro if block" fail-at
                            end
                            true frames depth 1 - macro-block-frame-at !MacroBlockFrame.has_else
                            token-index 1 + depth
                        elif ctx token-index "elif" token-equals do
                            if depth 0 <= do
                                ctx token-index "elif outside macro if block" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.kind BlockKind:conditional != do
                                ctx token-index "elif outside macro if block" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.has_do ! do
                                ctx token-index "elif requires a completed macro if arm" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.has_else do
                                ctx token-index "elif after else in macro if block" fail-at
                            end
                            false frames depth 1 - macro-block-frame-at !MacroBlockFrame.has_do
                            token-index 1 + depth
                        elif ctx token-index "end" token-equals do
                            if depth 0 <= do
                                ctx token-index "end outside macro control-flow block" fail-at
                            end
                            if frames depth 1 - macro-block-frame-at @MacroBlockFrame.has_do ! do
                                ctx token-index "macro control-flow block requires do" fail-at
                            end
                            token-index 1 + depth 1 -
                        else
                            token-index 1 + depth
                        end
                    else
                        token-index 1 + depth
                    end
                end
            end
            let token-index depth do
                if depth 0 != do
                    ctx "unclosed blocks in macro body" fail-eof
                end
            end
        end
    end
end

proc scan-one-macro ModuleContext* int -- int do
    let ctx macro-token do
        macro-token 1 +
        let name-token do
            if name-token ctx @ModuleContext.token_count >= do
                ctx "expected macro name" fail-eof
                name-token
            else
                ctx name-token require-word
                if
                    ctx name-token reserved-name
                    ctx name-token private-intrinsic-name ||
                    ctx name-token string-type-name ||
                do
                    ctx name-token "invalid macro name" fail-name-at
                end
                ctx name-token find-macro
                let existing-macro do
                    if existing-macro 0 >= do
                        ctx name-token "duplicate macro name" fail-name-at
                    end
                end
                if
                    ctx name-token find-record 0 >=
                    ctx name-token find-union 0 >= ||
                    ctx name-token find-function 0 >= ||
                      ctx name-token find-c-type 0 >=
                    ||
                do
                    ctx name-token fail-duplicate-declaration
                end
                ctx @ModuleContext.macro_count
                let macro-index do
                    ctx name-token token-at @TokenEntry.start ctx macro-index macro-at !MacroEntry.name_start
                    ctx name-token token-at @TokenEntry.length ctx macro-index macro-at !MacroEntry.name_length
                    name-token ctx macro-index macro-at !MacroEntry.name_token
                    false ctx macro-index macro-at !MacroEntry.expanding
                    ctx name-token 1 + scan-macro-body
                    let next-token do
                        if ctx @ModuleContext.program program-failed ! do
                            ctx name-token 1 + next-token 1 - validate-macro-body
                            name-token 1 + ctx macro-index macro-at !MacroEntry.body_start
                            next-token 1 - ctx macro-index macro-at !MacroEntry.body_end
                            ctx @ModuleContext.macro_count 1 + ctx !ModuleContext.macro_count
                        end
                        next-token
                    end
                end
            end
        end
    end
end

proc constant-expression-forbidden-word ModuleContext* int -- bool do
    peek ctx token-index do "if" token-equals
        ctx token-index "elif" token-equals ||
        ctx token-index "else" token-equals ||
        ctx token-index "while" token-equals ||
        ctx token-index "do" token-equals ||
        ctx token-index "let" token-equals ||
        ctx token-index "peek" token-equals ||
        ctx token-index "proc" token-equals ||
        ctx token-index "macro" token-equals ||
        ctx token-index "const" token-equals ||
        ctx token-index "c-include" token-equals ||
        ctx token-index "c-type" token-equals ||
        ctx token-index "c-call" token-equals ||
        ctx token-index "c-value" token-equals ||
        ctx token-index "record" token-equals ||
        ctx token-index "union" token-equals ||
        ctx token-index "fn" token-equals ||
        ctx token-index "from" token-equals ||
        ctx token-index "import" token-equals ||
    end
end

proc scan-constant-body ModuleContext* int -- int do
    let ctx body-start do
        body-start true
        while
            peek token-index active do active end
        do
            let token-index active do
                if token-index ctx @ModuleContext.token_count >= do
                    ctx "unterminated constant declaration" fail-eof
                    token-index false
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "end" token-equals &&
                do
                    token-index 1 + false
                else
                    if
                        ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                        ctx token-index constant-expression-forbidden-word &&
                    do
                        ctx token-index "unsupported constant expression word" fail-at
                    end
                    token-index 1 + true
                end
            end
        end
        let next-token active do next-token end
    end
end

proc scan-one-constant ModuleContext* int -- int do
    let ctx constant-token do
        constant-token 1 +
        let name-token do
            if name-token ctx @ModuleContext.token_count >= do
                ctx "expected constant name" fail-eof
            end
            ctx name-token require-word
            if
                ctx name-token reserved-name
                ctx name-token private-intrinsic-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                ctx name-token "invalid constant name" fail-name-at
            end
            if ctx name-token find-constant 0 >= do
                ctx name-token "duplicate constant name" fail-name-at
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-record 0 >= ||
                ctx name-token find-union 0 >= ||
                ctx name-token find-function 0 >= ||
                  ctx name-token find-c-type 0 >=
                ||
            do
                ctx name-token fail-duplicate-declaration
            end
            if ctx @ModuleContext.program program-failed do
                ctx @ModuleContext.token_count
            else
                ctx @ModuleContext.constant_count
                let constant-index do
                    ctx name-token token-at @TokenEntry.start ctx constant-index constant-at !ConstantEntry.name_start
                    ctx name-token token-at @TokenEntry.length ctx constant-index constant-at !ConstantEntry.name_length
                    name-token ctx constant-index constant-at !ConstantEntry.name_token
                    ConstantState:new ctx constant-index constant-at !ConstantEntry.state
                    0 ptr cast ctx constant-index constant-at !ConstantEntry.values
                    0 ctx constant-index constant-at !ConstantEntry.value_count
                    ctx name-token 1 + scan-constant-body
                    let next-token do
                        name-token 1 + ctx constant-index constant-at !ConstantEntry.body_start
                        next-token 1 - ctx constant-index constant-at !ConstantEntry.body_end
                        ctx @ModuleContext.constant_count 1 + ctx !ModuleContext.constant_count
                        next-token
                    end
                end
            end
        end
    end
end

proc scan-block-end ModuleContext* int -- int do
    let ctx body-start do
        body-start 1
        while
            peek token-index depth do
                depth 0 >
                token-index ctx @ModuleContext.token_count < &&
            end
        do
            let token-index depth do
                if ctx token-index token-at @TokenEntry.kind TokenKind:word == do
                    if
                        ctx token-index "from" token-equals
                        ctx token-index "import" token-equals ||
                    do
                        ctx token-index "imports are only allowed at top level" fail-at
                        depth
                    elif
                        ctx token-index "proc" token-equals
                        ctx token-index "macro" token-equals ||
                        ctx token-index "const" token-equals ||
                        ctx token-index "c-include" token-equals ||
                        ctx token-index "c-type" token-equals ||
                        ctx token-index "c-call" token-equals ||
                        ctx token-index "c-value" token-equals ||
                        ctx token-index "record" token-equals ||
                        ctx token-index "union" token-equals ||
                        ctx token-index "fn" token-equals ||
                    do
                        ctx token-index "declarations are only allowed at top level" fail-at
                        depth
                    elif ctx token-index "elif" token-equals do
                        if depth 1 <= do
                            ctx token-index "elif outside active if" fail-at
                        end
                        depth
                    else
                        if
                            ctx token-index "if" token-equals
                            ctx token-index "while" token-equals ||
                            ctx token-index "let" token-equals ||
                            ctx token-index "peek" token-equals ||
                        do
                            depth 1 +
                        else
                            if ctx token-index "end" token-equals do
                                depth 1 -
                            else
                                depth
                            end
                        end
                    end
                else
                    depth
                end
                  token-index 1 +
                  swap
            end
        end
        let token-index depth do
            if depth 0 != do
                ctx "unterminated procedure body" fail-eof
            end
            token-index
        end
    end
end

proc allocate-proc ModuleContext* int -- int do
    let ctx name-token do
        if name-token ctx @ModuleContext.token_count >= do
            ctx "expected procedure name" fail-eof
        end
        ctx name-token require-word
        if
            ctx name-token reserved-name
            ctx name-token private-intrinsic-name ||
            ctx name-token string-type-name ||
        do
            ctx name-token "invalid procedure name" fail-name-at
        end
        if
            ctx name-token find-record 0 >=
            ctx name-token find-union 0 >= ||
            ctx name-token find-function 0 >= ||
            ctx name-token find-c-type 0 >= ||
            ctx name-token find-constant 0 >= ||
        do
            ctx name-token fail-duplicate-declaration
        end

        ctx @ModuleContext.proc_count
        let proc-index do
            ctx name-token token-at @TokenEntry.start ctx proc-index procedure-at !ProcedureEntry.name_start
            ctx name-token token-at @TokenEntry.length ctx proc-index procedure-at !ProcedureEntry.name_length
            name-token ctx proc-index procedure-at !ProcedureEntry.name_token
            proc-index ctx proc-index procedure-at !ProcedureEntry.index
            ctx @ModuleContext.program program-allocate-proc-id ctx proc-index procedure-at !ProcedureEntry.global_id
            CBinding:none ctx proc-index procedure-at !ProcedureEntry.c_binding
            ProcedureAnalysis:alloc
            let analysis do
                0 analysis !ProcedureAnalysis.max_type_count
                0 ptr cast analysis !ProcedureAnalysis.stack_slots
                0 analysis !ProcedureAnalysis.stack_slot_count
                0 analysis !ProcedureAnalysis.stack_slot_capacity
                16 AnalyzedOperation:sizeof * alloc analysis !ProcedureAnalysis.operations
                0 analysis !ProcedureAnalysis.operation_count
                16 analysis !ProcedureAnalysis.operation_capacity
                16 cell-bytes * alloc analysis !ProcedureAnalysis.operation_types
                0 analysis !ProcedureAnalysis.operation_type_count
                16 analysis !ProcedureAnalysis.operation_type_capacity
                16 AnalyzedBindingLocal:sizeof * alloc analysis !ProcedureAnalysis.binding_locals
                0 analysis !ProcedureAnalysis.binding_local_count
                16 analysis !ProcedureAnalysis.binding_local_capacity
                16 MacroExpansion:sizeof * alloc analysis !ProcedureAnalysis.macro_expansions
                0 analysis !ProcedureAnalysis.macro_expansion_count
                16 analysis !ProcedureAnalysis.macro_expansion_capacity
                16 TypedInstruction:sizeof * alloc analysis !ProcedureAnalysis.instructions
                0 analysis !ProcedureAnalysis.instruction_count
                16 analysis !ProcedureAnalysis.instruction_capacity
                16 AnalyzedBlock:sizeof * alloc analysis !ProcedureAnalysis.cfg_blocks
                0 analysis !ProcedureAnalysis.cfg_block_count
                16 analysis !ProcedureAnalysis.cfg_block_capacity
                analysis ctx proc-index procedure-at !ProcedureEntry.analysis
            end
            proc-index
        end
    end
end

proc scan-one-proc ModuleContext* int -- int do
    let ctx proc-token do
        proc-token 1 +
        let name-token do
            if name-token ctx @ModuleContext.token_count >= do
                ctx "expected procedure name" fail-eof
                ctx @ModuleContext.token_count
            else
                ctx name-token allocate-proc
                let proc-index do
                    if ctx @ModuleContext.program program-failed do
                        ctx @ModuleContext.token_count
                    else
                        ctx @ModuleContext.type_count ctx proc-index procedure-at !ProcedureEntry.input_start
                        name-token 1 + 0
                        while
                            peek token-index count do
                                token-index ctx @ModuleContext.token_count <
                                if dup do
                                    drop ctx token-index "--" token-equals !
                                end
                            end
                        do
                            let token-index count do
                                ctx token-index ctx token-index parse-type-token add-source-type
                                token-index 1 + count 1 +
                            end
                        end
                        let token-index input-count do
                            if token-index ctx @ModuleContext.token_count >= do
                                ctx "expected -- in procedure signature" fail-eof
                            end
                            input-count ctx proc-index procedure-at !ProcedureEntry.input_count
                            token-index 1 +
                        end

                        ctx @ModuleContext.type_count ctx proc-index procedure-at !ProcedureEntry.output_start
                          0
                        while
                            peek token-index count do
                                token-index ctx @ModuleContext.token_count <
                                if dup do
                                    drop ctx token-index "do" token-equals !
                                end
                            end
                        do
                            let token-index count do
                                ctx token-index ctx token-index parse-type-token add-source-type
                                token-index 1 + count 1 +
                            end
                        end
                        let token-index output-count do
                            if token-index ctx @ModuleContext.token_count >= do
                                ctx "expected do after procedure signature" fail-eof
                            end
                            output-count ctx proc-index procedure-at !ProcedureEntry.output_count
                            token-index 1 +
                        end
                        peek body-start do ctx proc-index procedure-at !ProcedureEntry.body_start
                            ctx body-start scan-block-end
                            peek next-token do 1 - ctx proc-index procedure-at !ProcedureEntry.body_end
                                if ctx @ModuleContext.program program-failed do
                                    ctx @ModuleContext.token_count
                                else
                                    proc-index 1 + ctx !ModuleContext.proc_count

                                    if ctx name-token "main" token-equals do
                                        if ctx @ModuleContext.main_proc 0 >= do
                                            ctx name-token "duplicate main procedure" fail-name-at
                                        end
                                        if
                                            ctx proc-index procedure-at @ProcedureEntry.input_count 0 !=
                                            ctx proc-index procedure-at @ProcedureEntry.output_count 0 != ||
                                        do
                                            ctx name-token "main must have an empty stack contract" fail-at
                                        end
                                        proc-index ctx !ModuleContext.main_proc
                                    end
                                    next-token
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-c-include ModuleContext* int -- int do
    let ctx token do
        token 1 + let kind-token do
            if kind-token ctx @ModuleContext.token_count >= do ctx "expected C include kind" fail-eof end
            if ctx kind-token "system" token-equals do CIncludeKind:system
            elif ctx kind-token "local" token-equals do CIncludeKind:local
            else ctx kind-token "expected C include kind" fail-name-at CIncludeKind:system end
            kind-token 1 + let kind path-token do
                if path-token ctx @ModuleContext.token_count >= do ctx "expected C include path string" fail-eof end
                ctx path-token validate-c-include-token
                path-token 1 + let end-token do
                    if end-token ctx @ModuleContext.token_count >= do ctx "expected end after C include" fail-eof end
                    if ctx end-token "end" token-equals ! do ctx end-token "expected end after C include" fail-at end
                    if ctx @ModuleContext.program program-failed do
                        ctx @ModuleContext.token_count
                    else
                        ctx @ModuleContext.c_include_count dup ctx swap c-include-at let index entry do
                            kind entry !CIncludeEntry.kind
                            path-token entry !CIncludeEntry.token
                            index 1 + ctx !ModuleContext.c_include_count
                            end-token 1 +
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-c-type ModuleContext* int -- int do
    let ctx token do
        token 1 + let name do
            if name ctx @ModuleContext.token_count >= do ctx "expected C type name" fail-eof end
            ctx name require-word
            if ctx name reserved-name ctx name private-intrinsic-name || ctx name string-type-name || do ctx name "invalid C type name" fail-name-at end
            if
                ctx name find-proc 0 >=
                ctx name find-macro 0 >= ||
                ctx name find-constant 0 >= ||
                ctx name find-record 0 >= ||
                ctx name find-union 0 >= ||
                ctx name find-function 0 >= ||
                ctx name find-c-type 0 >= ||
            do
                ctx name fail-duplicate-declaration
            end
            name 1 + let frog-token do
                if frog-token ctx @ModuleContext.token_count >= do ctx "expected C type representation" fail-eof end
                if ctx frog-token "int" token-equals do type-int
                elif ctx frog-token "bool" token-equals do type-bool
                elif ctx frog-token "ptr" token-equals do type-ptr
                else ctx frog-token "expected C type representation" fail-name-at 0 end
                frog-token 1 + let frog-type spelling do
                    if spelling ctx @ModuleContext.token_count >= do ctx "expected C type string" fail-eof end
                    ctx spelling validate-c-type-spelling
                    spelling 1 + let end-token do
                        if end-token ctx @ModuleContext.token_count >= do ctx "expected end after C type" fail-eof end
                        if ctx end-token "end" token-equals ! do ctx end-token "expected end after C type" fail-at end
                        if ctx @ModuleContext.program program-failed do
                            ctx @ModuleContext.token_count
                        else
                            ctx @ModuleContext.c_type_count dup ctx swap c-type-at let index entry do
                                ctx name token-at @TokenEntry.start entry !CTypeEntry.name_start
                                ctx name token-at @TokenEntry.length entry !CTypeEntry.name_length
                                name entry !CTypeEntry.name_token
                                frog-type entry !CTypeEntry.frog_type
                                frog-token entry !CTypeEntry.frog_type_token
                                spelling entry !CTypeEntry.type_token
                                index 1 + ctx !ModuleContext.c_type_count
                                end-token 1 +
                            end
                        end
                    end
                end
            end
        end
    end
end

proc scan-c-signature-types ModuleContext* int String -- int int do
    let ctx token stop do
        token 0
        while peek current count do
                current ctx @ModuleContext.token_count <
                if dup do
                    drop
                    ctx current stop token-equals !
                    ctx current "proc" token-equals ! &&
                    ctx current "macro" token-equals ! &&
                    ctx current "const" token-equals ! &&
                    ctx current "c-include" token-equals ! &&
                    ctx current "c-type" token-equals ! &&
                    ctx current "c-call" token-equals ! &&
                    ctx current "c-value" token-equals ! &&
                    ctx current "record" token-equals ! &&
                    ctx current "union" token-equals ! &&
                    ctx current "fn" token-equals ! &&
                    ctx current "from" token-equals ! &&
                end
            end do
            let current count do
                ctx current require-word
                ctx current add-c-signature-type
                current 1 + count 1 +
            end
        end
    end
end

proc scan-one-c-call ModuleContext* int -- int do
    let ctx token do
        token 1 + let name do
            ctx name allocate-proc let index do
                if ctx @ModuleContext.program program-failed do
                    ctx @ModuleContext.token_count
                else
                    CBinding:call ctx index procedure-at !ProcedureEntry.c_binding
                    if ctx name "main" token-equals do ctx name "main cannot be a C binding" fail-at end
                    name 1 + let symbol do
                        if symbol ctx @ModuleContext.token_count >= do ctx "expected C symbol" fail-eof end
                        ctx symbol require-word
                        if ctx symbol valid-c-symbol ! do ctx symbol "invalid C symbol" fail-name-at end
                        symbol ctx index procedure-at !ProcedureEntry.c_symbol_token
                        ctx @ModuleContext.type_count ctx index procedure-at !ProcedureEntry.input_start
                        ctx symbol 1 + "--" scan-c-signature-types let next count do
                            if next ctx @ModuleContext.token_count >= do ctx "expected -- in C call signature" fail-eof end
                            if ctx next "--" token-equals ! do ctx next "expected -- in C call signature" fail-at end
                            count ctx index procedure-at !ProcedureEntry.input_count
                            ctx @ModuleContext.type_count ctx index procedure-at !ProcedureEntry.output_start
                            ctx next 1 + "end" scan-c-signature-types let end-token outputs do
                                if end-token ctx @ModuleContext.token_count >= do ctx "expected end after C call" fail-eof end
                                if ctx end-token "end" token-equals ! do ctx end-token "expected end after C call" fail-at end
                                if outputs 1 > do ctx end-token "C call may return at most one value" fail-at end
                                if ctx @ModuleContext.program program-failed do
                                    ctx @ModuleContext.token_count
                                else
                                    outputs ctx index procedure-at !ProcedureEntry.output_count
                                    index 1 + ctx !ModuleContext.proc_count
                                    end-token 1 +
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-c-value ModuleContext* int -- int do
    let ctx token do
        token 1 + let name do
            ctx name allocate-proc let index do
                if ctx @ModuleContext.program program-failed do
                    ctx @ModuleContext.token_count
                else
                    CBinding:value ctx index procedure-at !ProcedureEntry.c_binding
                    if ctx name "main" token-equals do ctx name "main cannot be a C binding" fail-at end
                    name 1 + let symbol do
                        if symbol ctx @ModuleContext.token_count >= do ctx "expected C symbol" fail-eof end
                        ctx symbol require-word
                        if ctx symbol valid-c-symbol ! do ctx symbol "invalid C symbol" fail-name-at end
                        symbol ctx index procedure-at !ProcedureEntry.c_symbol_token
                        symbol 1 + let separator do
                            if separator ctx @ModuleContext.token_count >= do ctx "expected -- in C value signature" fail-eof end
                            if ctx separator "--" token-equals ! do ctx separator "expected -- in C value signature" fail-at end
                            0 ctx index procedure-at !ProcedureEntry.input_count
                            ctx @ModuleContext.type_count ctx index procedure-at !ProcedureEntry.input_start
                            ctx @ModuleContext.type_count ctx index procedure-at !ProcedureEntry.output_start
                            ctx separator 1 + "end" scan-c-signature-types let end-token outputs do
                                if end-token ctx @ModuleContext.token_count >= do ctx "expected end after C value" fail-eof end
                                if ctx end-token "end" token-equals ! do ctx end-token "expected end after C value" fail-at end
                                if outputs 1 != do ctx end-token "C value must return exactly one value" fail-at end
                                if ctx @ModuleContext.program program-failed do
                                    ctx @ModuleContext.token_count
                                else
                                    outputs ctx index procedure-at !ProcedureEntry.output_count
                                    index 1 + ctx !ModuleContext.proc_count
                                    end-token 1 +
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc import-at ModuleContext* int -- ImportEntry* do
    let ctx index do
        ctx @ModuleContext.imports index ImportEntry:sizeof * + ImportEntry* cast
    end
end

proc scope-at ModuleContext* int -- ScopeEntry* do
    let ctx index do
        ctx @ModuleContext.scope index ScopeEntry:sizeof * + ScopeEntry* cast
    end
end

proc token-contains-byte ModuleContext* int int -- bool do
    let ctx token byte do
        ctx token token-slice let bytes length do
            0 false
            while peek index found do
                    index length < found ! &&
                end do
                let index found do
                    index 1 +
                      found bytes index byte-read byte == ||
                end
            end
            let index found do found end
        end
    end
end

proc require-import-name ModuleContext* int -- do
    peek ctx token do require-word
        if ctx token "*" token-equals do
            ctx token "wildcard imports are not supported" fail-at
        end
        if ctx token 44 token-contains-byte do
            ctx token "commas are not valid in import lists" fail-at
        end
        if
            ctx token reserved-name
            ctx token private-intrinsic-name ||
            ctx token "(" token-equals ||
            ctx token ")" token-equals ||
            ctx token "int" token-equals ||
            ctx token "bool" token-equals ||
            ctx token "ptr" token-equals ||
            ctx token string-type-name ||
        do
            ctx token "invalid imported name" fail-name-at
        end
    end
end

proc add-import ModuleContext* int int int ptr int -- do
    let ctx path-token name-token alias-token canonical canonical-length do
        if ctx @ModuleContext.program program-failed ! do
            ctx ctx @ModuleContext.import_count import-at
            let entry do
                path-token entry !ImportEntry.path_token
                name-token entry !ImportEntry.name_token
                alias-token entry !ImportEntry.alias_token
                0 ptr cast ModuleContext* cast entry !ImportEntry.target_module
                canonical entry !ImportEntry.canonical_path
                canonical-length entry !ImportEntry.canonical_path_length
                ctx @ModuleContext.import_count 1 + ctx !ModuleContext.import_count
            end
        end
    end
end

proc scan-import-item ModuleContext* int ptr int int -- int do
    let ctx path-token canonical canonical-length token do
        if token ctx @ModuleContext.token_count >= do
            ctx "expected imported name" fail-eof
            ctx @ModuleContext.token_count
        else
            ctx token require-import-name
            if ctx @ModuleContext.program program-failed do
                ctx @ModuleContext.token_count
            else
                token let name-token do
                    token 1 + let next-token do
                        if next-token ctx @ModuleContext.token_count >= do
                            ctx path-token name-token 0 1 - canonical canonical-length add-import
                            next-token
                        elif ctx next-token "as" token-equals do
                            next-token 1 + let alias-token do
                                if alias-token ctx @ModuleContext.token_count >= do
                                    ctx "expected import alias" fail-eof
                                end
                                if ctx @ModuleContext.program program-failed do
                                    ctx @ModuleContext.token_count
                                else
                                    ctx alias-token require-import-name
                                    ctx path-token name-token alias-token canonical canonical-length add-import
                                    alias-token 1 +
                                end
                            end
                        else
                            ctx path-token name-token 0 1 - canonical canonical-length add-import
                            next-token
                        end
                    end
                end
            end
        end
    end
end

proc import-list-continues ModuleContext* int -- bool do
    let ctx token do
        if token ctx @ModuleContext.token_count >= do
            false
        else
            ctx token ")" token-equals !
        end
    end
end

proc scan-one-import ModuleContext* int -- int do
    let ctx token do
        token 1 + let path-token do
            if path-token ctx @ModuleContext.token_count >= do
                ctx "expected import path string" fail-eof
                ctx @ModuleContext.token_count
            else
                if ctx path-token token-at @TokenEntry.kind TokenKind:string != do
                    ctx path-token "expected import path string" fail-at
                end
                if ctx @ModuleContext.program program-failed do
                    ctx @ModuleContext.token_count
                else
                    path-token 1 + let import-token do
                        if import-token ctx @ModuleContext.token_count >= do ctx "expected import after import path" fail-eof end
                        if ctx import-token "import" token-equals ! do ctx import-token "expected import after import path" fail-at end
                        if ctx @ModuleContext.program program-failed do
                            ctx @ModuleContext.token_count
                        else
                            ctx path-token ctx path-token decoded-import-path normalize-path let canonical canonical-length do
                                import-token 1 + let item-token do
                                    if item-token ctx @ModuleContext.token_count >= do ctx "expected imported name" fail-eof end
                                    if ctx @ModuleContext.program program-failed do
                                        ctx @ModuleContext.token_count
                                    else
                                        if ctx item-token "(" token-equals do
                                            item-token 1 + let next-token do
                                                if next-token ctx @ModuleContext.token_count >= do ctx "expected ) after import list" fail-eof end
                                                if ctx next-token ")" token-equals do ctx next-token "expected imported name" fail-at end
                                                if ctx @ModuleContext.program program-failed do
                                                    ctx @ModuleContext.token_count
                                                else
                                                    next-token
                                                    while dup ctx swap import-list-continues do
                                                        let list-token do ctx path-token canonical canonical-length list-token scan-import-item end
                                                    end
                                                    let list-token do
                                                        if list-token ctx @ModuleContext.token_count >= do ctx "expected ) after import list" fail-eof end
                                                        if ctx @ModuleContext.program program-failed do
                                                            ctx @ModuleContext.token_count
                                                        else
                                                            if ctx list-token ")" token-equals ! do
                                                                if ctx list-token 44 token-contains-byte do ctx list-token "commas are not valid in import lists" fail-at end
                                                                ctx list-token "expected ) after import list" fail-at
                                                            end
                                                            list-token 1 +
                                                        end
                                                    end
                                                end
                                            end
                                        else
                                            ctx path-token canonical canonical-length item-token scan-import-item
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc token-starts-block ModuleContext* int -- bool do
    let ctx token do
        if ctx token token-at @TokenEntry.kind TokenKind:word != do
            false
        else
            ctx token "if" token-equals
            ctx token "while" token-equals ||
            ctx token "let" token-equals ||
            ctx token "peek" token-equals ||
        end
    end
end

proc scan-declarations ModuleContext* -- do
    let ctx do
        0 ctx !ModuleContext.proc_count
        0 ctx !ModuleContext.type_count
        0 ctx !ModuleContext.macro_count
        0 ctx !ModuleContext.constant_count
        0 ctx !ModuleContext.import_count
        0 ctx !ModuleContext.record_count
        0 ctx !ModuleContext.record_field_count
        0 ctx !ModuleContext.union_count
        0 ctx !ModuleContext.union_case_count
        0 ctx !ModuleContext.function_count
        0 ctx !ModuleContext.function_type_count
        0 ctx !ModuleContext.c_type_count
        0 ctx !ModuleContext.c_include_count
        0
        while peek token-index do
                token-index ctx @ModuleContext.token_count <
                ctx @ModuleContext.program program-failed ! &&
            end do
            let token-index do
                if
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "from" token-equals &&
                do
                    ctx token-index scan-one-import
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "import" token-equals &&
                do
                    ctx token-index "module aliases are not supported" fail-at
                    token-index 1 +
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "macro" token-equals &&
                do
                    ctx token-index scan-one-macro
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "const" token-equals &&
                do
                    ctx token-index scan-one-constant
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "proc" token-equals &&
                do
                    ctx token-index scan-one-proc
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "c-include" token-equals &&
                do
                    ctx token-index scan-one-c-include
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "c-type" token-equals &&
                do
                    ctx token-index scan-one-c-type
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "c-call" token-equals &&
                do
                    ctx token-index scan-one-c-call
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "c-value" token-equals &&
                do
                    ctx token-index scan-one-c-value
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "record" token-equals &&
                do
                    ctx token-index scan-one-record
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "union" token-equals &&
                do
                    ctx token-index scan-one-union
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                elif
                    ctx token-index token-at @TokenEntry.kind TokenKind:word ==
                    ctx token-index "fn" token-equals &&
                do
                    ctx token-index scan-one-function
                    peek next-token do ctx token-index next-token add-declaration-syntax-region end
                else
                    if ctx token-index token-at @TokenEntry.kind TokenKind:word == do
                        ctx token-index "unexpected top-level word" fail-name-at
                    else
                        ctx token-index "unexpected top-level token" fail-name-at
                    end
                    token-index 1 +
                end
            end
        end
        drop
        if
            ctx @ModuleContext.is_root
            ctx @ModuleContext.program @Program.require_main &&
            ctx @ModuleContext.program program-failed ! &&
        do
            if ctx @ModuleContext.main_proc 0 < do
                ctx "missing main procedure" fail-eof
            end
        end
    end
end

