proc evaluate-constant-intrinsic ConstantEvaluator* ModuleContext* int -- bool do
    let evaluator module token-index do
        if
            module token-index constant-int-binary-word
            module token-index constant-shift-word ||
            module token-index constant-comparison-word ||
            module token-index constant-bool-binary-word ||
            module token-index "/%" token-equals ||
            module token-index "~" token-equals ||
            module token-index "!" token-equals ||
        do
            if module token-index constant-bool-binary-word do
                evaluator constant-evaluator-top-type
                let value-type do
                    if
                        value-type type-bool ==
                        module module token-index type-bool type-bool word-resolves-to-builtin-2 &&
                    do evaluator module token-index evaluate-constant-bool-binary true
                    else false end
