                    cc record-index pointer-type emit-slot-as " + " emit byte-offset emit-unsigned ", " emit
                    if field-type type-ptr == field-type type-is-typed-pointer || do "(Cell)(intptr_t)" emit
                    elif field-type type-bool == do "(Cell)" emit
                    elif field-type type-is-integer do "(Cell)" emit
