            false evaluator !ConstantEvaluator.format_operation_active
            0 evaluator !ConstantEvaluator.format_operation_before
            0 evaluator !ConstantEvaluator.format_operation_minimum
            8
            peek capacity do ConstantValue:sizeof * alloc evaluator !ConstantEvaluator.values
                0 evaluator !ConstantEvaluator.count
                capacity evaluator !ConstantEvaluator.capacity
                evaluator
            end
        end
    end
end

