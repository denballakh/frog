                        ctx token-index "from" token-equals
                        ctx token-index "import" token-equals ||
                    do
                        "imports are only allowed at top level" fail
                        token-index 1 + depth true
                    elif
                        ctx token-index "proc" token-equals
                        ctx token-index "macro" token-equals ||
                        ctx token-index "const" token-equals ||
                        ctx token-index "c-include" token-equals ||
                        ctx token-index "c-type" token-equals ||
                        ctx token-index "c-call" token-equals ||
                        ctx token-index "c-value" token-equals ||
                        ctx token-index "record" token-equals ||
                        ctx token-index "union" token-equals ||
                        ctx token-index "fn" token-equals ||
                    do
                        "declarations are not allowed in macro bodies" fail
                        token-index 1 + depth true
                    else
                        token-index 1 + depth true
                    end
                else
                    token-index 1 + depth true
                end
            end
        end
        let next-token depth active do
            next-token
        end
    end
end

proc validate-macro-body ModuleContext* int int -- do
    let ctx body-start body-end do
        body-end body-start - cell-bytes * alloc
        let kinds do
            body-end body-start - cell-bytes * alloc
            let has-dos do
                body-end body-start - cell-bytes * alloc
                let has-elses do
                    body-start 0
                    while
                        peek token-index depth do
                            token-index body-end <
                        end
                    do
                        let token-index depth do
                            if ctx token-index token-at @TokenEntry.kind token-word == do
                                if
                                    ctx token-index "from" token-equals
                                    ctx token-index "import" token-equals ||
                                do
                                    "imports are only allowed at top level" fail
                                    token-index 1 + depth
                                elif
                                    ctx token-index "proc" token-equals
                                    ctx token-index "macro" token-equals ||
                                    ctx token-index "const" token-equals ||
                                    ctx token-index "c-include" token-equals ||
                                    ctx token-index "c-type" token-equals ||
                                    ctx token-index "c-call" token-equals ||
                                    ctx token-index "c-value" token-equals ||
                                    ctx token-index "record" token-equals ||
                                    ctx token-index "union" token-equals ||
                                    ctx token-index "fn" token-equals ||
                                do
                                    "declarations are not allowed in macro bodies" fail
                                    token-index 1 + depth
                                elif
                                    ctx token-index "if" token-equals
                                    ctx token-index "while" token-equals ||
                                    ctx token-index "let" token-equals ||
                                    ctx token-index "peek" token-equals ||
                                do
                                    if ctx token-index "if" token-equals do
                                        block-if kinds depth cell-bytes * field-write
                                    elif ctx token-index "while" token-equals do
                                        block-while kinds depth cell-bytes * field-write
                                    else
                                        block-let kinds depth cell-bytes * field-write
                                    end
                                    0 has-dos depth cell-bytes * field-write
                                    0 has-elses depth cell-bytes * field-write
                                    token-index 1 + depth 1 +
                                elif ctx token-index "do" token-equals do
                                    if depth 0 <= do
                                        "do outside macro control-flow block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 != do
                                        "duplicate do in macro control-flow block" fail
                                    end
                                    1 has-dos depth 1 - cell-bytes * field-write
                                    token-index 1 + depth
                                elif ctx token-index "else" token-equals do
                                    if depth 0 <= do
                                        "else outside macro if block" fail
                                    end
                                    if kinds depth 1 - cell-bytes * field-read block-if != do
                                        "else outside macro if block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 == do
                                        "else requires a completed macro if arm" fail
                                    end
                                    if has-elses depth 1 - cell-bytes * field-read 0 != do
                                        "duplicate else in macro if block" fail
                                    end
                                    1 has-elses depth 1 - cell-bytes * field-write
                                    token-index 1 + depth
                                elif ctx token-index "elif" token-equals do
                                    if depth 0 <= do
                                        "elif outside macro if block" fail
                                    end
                                    if kinds depth 1 - cell-bytes * field-read block-if != do
                                        "elif outside macro if block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 == do
                                        "elif requires a completed macro if arm" fail
                                    end
                                    if has-elses depth 1 - cell-bytes * field-read 0 != do
                                        "elif after else in macro if block" fail
                                    end
                                    0 has-dos depth 1 - cell-bytes * field-write
                                    token-index 1 + depth
                                elif ctx token-index "end" token-equals do
                                    if depth 0 <= do
                                        "end outside macro control-flow block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 == do
                                        "macro control-flow block requires do" fail
                                    end
                                    token-index 1 + depth 1 -
                                else
                                    token-index 1 + depth
                                end
                            else
                                token-index 1 + depth
                            end
                        end
                    end
                    let token-index depth do
                        if depth 0 != do
                            "unclosed blocks in macro body" fail
                        end
                    end
                end
            end
        end
