proc fail-compile-word CompileContext* String -- do
    let cc message do
        if cc @CompileContext.diagnostic_word do
            cc @CompileContext.diagnostic_module cc @CompileContext.diagnostic_token token-slice
        else 0 ptr cast 0 end
        let subject subject-length do
            cc DiagnosticCode:type_error message subject subject-length add-compile-diagnostic
        end
    end
end

proc fail-unknown-word CompileContext* int -- do
    let cc token do
        cc @CompileContext.defining_module token token-slice
        let subject subject-length do
