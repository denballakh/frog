            evaluator @ConstantEvaluator.values index constant-value-at @ConstantValue.value_type
        end
    end
end

proc constant-type-is-unsigned int -- bool do
    let value-type do
        value-type type-u8 ==
        value-type type-u16 == ||
        value-type type-u32 == ||
        value-type type-u64 == ||
    end
