            elif module token-index constant-int-binary-word do
                evaluator constant-evaluator-top-type
                let value-type do
                    if
                        value-type type-is-integer
                        module module token-index value-type value-type word-resolves-to-builtin-2 &&
                    do
                        evaluator module token-index value-type evaluate-constant-integer-binary true
                    else false end
                end
            elif module token-index constant-comparison-word do
                evaluator constant-evaluator-top-type
                let value-type do
                    if
                        value-type type-is-integer
                        module module token-index value-type value-type word-resolves-to-builtin-2 &&
                    do
                        evaluator module token-index value-type evaluate-constant-integer-comparison true
                    else false end
                end
            elif module token-index "/%" token-equals do
                evaluator constant-evaluator-top-type
                let value-type do
                    if
                        value-type type-is-integer
                        module module token-index value-type value-type word-resolves-to-builtin-2 &&
                    do
                        evaluator value-type evaluate-constant-integer-divmod true
                    else false end
