        0 analysis !ProcedureAnalysis.operation_count
        0 analysis !ProcedureAnalysis.operation_type_count
        0 analysis !ProcedureAnalysis.binding_local_count
        0 analysis !ProcedureAnalysis.macro_expansion_count
        0 analysis !ProcedureAnalysis.instruction_count
        0 analysis !ProcedureAnalysis.cfg_block_count
    end
end

proc valid-block-source-range AnalyzedBlock* -- bool do
    let block do
        if block @AnalyzedBlock.source_module ptr cast int cast 0 == do false
        elif block @AnalyzedBlock.terminator_module ptr cast int cast 0 == do false
        elif block @AnalyzedBlock.token_start 0 < do false
        elif block @AnalyzedBlock.token_start block @AnalyzedBlock.source_module @ModuleContext.token_count > do false
        elif block @AnalyzedBlock.terminator_token 0 < do false
        elif block @AnalyzedBlock.terminator_token block @AnalyzedBlock.terminator_module @ModuleContext.token_count >= do false
        else true end
    end
end

proc verify-block-expansion-provenance ProcedureAnalysis* AnalyzedBlock* -- do
    let analysis block do
        block @AnalyzedBlock.source_expansion_id
        let source-expansion do
            if source-expansion 0 >= do
                if source-expansion analysis @ProcedureAnalysis.macro_expansion_count >= do
                    "internal analyzed block source expansion is invalid" fail
                end
            end
        end
        block @AnalyzedBlock.terminator_expansion_id
        let terminator-expansion do
            if terminator-expansion 0 >= terminator-expansion analysis @ProcedureAnalysis.macro_expansion_count >= && do
                "internal analyzed block terminator expansion is invalid" fail
            end
        end
    end
end

proc verify-analyzed-jump ModuleContext* int ProcedureAnalysis* AnalyzedBlock* ptr int -- do
    let module procedure-index analysis block exit-types exit-count do
        if block @AnalyzedBlock.second_target 0 1 - != do
            "internal analyzed jump has a second target" fail
        end
        module procedure-index analysis block @AnalyzedBlock.first_target verify-analyzed-target
        let target do
