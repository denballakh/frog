proc emit-c-type-identity int -- do
    let value-type do
        if value-type type-int == do "int" emit
        elif value-type type-bool == do "bool" emit
        elif value-type type-ptr == do "ptr" emit
        elif value-type type-string == do "string" emit
        elif value-type type-i8 == do "i8" emit
        elif value-type type-i16 == do "i16" emit
        elif value-type type-i32 == do "i32" emit
