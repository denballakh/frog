proc record-compile-type-occurrence CompileContext* int int -- do
    let cc token value-type do
        cc @CompileContext.defining_module token type-token-pointer-depth
        let pointer-depth do
            cc @CompileContext.defining_module token token-at @TokenEntry.length pointer-depth -
            let base-length do
                cc @CompileContext.program value-type semantic-type-identity
                let semantic-class definition-module definition-index definition-subindex do
                    cc token 0 base-length OccurrenceRole:reference semantic-class
                    definition-module definition-index definition-subindex add-compile-token-part-occurrence
                    let occurrence-index do
                        if semantic-class SemanticClass.record_type? do
                            cc occurrence-index token 0 base-length ScopeKind:record_type definition-module definition-index
                            set-compile-occurrence-binding-part
                        elif semantic-class SemanticClass.union_type? do
                            cc occurrence-index token 0 base-length ScopeKind:union_type definition-module definition-index
                            set-compile-occurrence-binding-part
                        elif semantic-class SemanticClass.function_type? do
                            cc occurrence-index token 0 base-length ScopeKind:function_type definition-module definition-index
                            set-compile-occurrence-binding-part
                        end
                    end
                end
            end
        end
    end
end


