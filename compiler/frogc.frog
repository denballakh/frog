proc evaluate-constant-word ptr ModuleContext int -- do
    let evaluator module token-index do
        module module token-index find-scope-symbol
        let symbol-index do
            if module symbol-index scope-macro scope-symbol-has-kind do
                "unsupported constant expression word" fail
            elif evaluator module token-index evaluate-constant-intrinsic do
            elif module module token-index constant-higher-priority-word do
                "unsupported constant expression word" fail
            elif module symbol-index scope-constant scope-symbol-has-kind do
                evaluator
