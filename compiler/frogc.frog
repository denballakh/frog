proc patch-analyzed-block-target CompileContext* int bool int -- do
    let cc block-index second target do
        if cc cfg-recording do
            cc compile-context-analysis block-index analyzed-block-at
            let block do
                if second do
                    if block @AnalyzedBlock.terminator_kind CFGTerminatorKind.branch? ! do
                        "internal second target on non-branch analyzed block" fail
                    end
                    if block @AnalyzedBlock.second_target 0 >= do
                        "internal analyzed block second target already set" fail
                    end
                    target block !AnalyzedBlock.second_target
                else
                    if
                        block @AnalyzedBlock.terminator_kind CFGTerminatorKind.jump?
                        block @AnalyzedBlock.terminator_kind CFGTerminatorKind.branch? || !
                    do
                        "internal first target on non-control-flow analyzed block" fail
                    end
                    if block @AnalyzedBlock.first_target 0 >= do
                        "internal analyzed block first target already set" fail
                    end
                    target block !AnalyzedBlock.first_target
                end
            end
        end
    end
end

proc begin-analyzed-operation CompileContext* int -- do
    let cc token-index do
        if cc @CompileContext.operation_active do "internal nested analyzed operation" fail end
        cc compile-context-analysis
        let analysis do
            if analysis @ProcedureAnalysis.operation_count analysis @ProcedureAnalysis.operation_capacity == do
                analysis grow-analyzed-operations
            end
            analysis analysis @ProcedureAnalysis.operation_count analyzed-operation-at
            let operation do
                cc @CompileContext.defining_module operation !AnalyzedOperation.source_module
