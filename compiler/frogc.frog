            end
            drop
            0
            while dup ctx @ModuleContext.union_count < do
                dup
                let union-index do
                    ctx
                    ctx
                    ctx union-index union-type-at @UnionTypeEntry.name_start
                    ctx union-index union-type-at @UnionTypeEntry.name_length
                    scope-union
                    ctx
                    union-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.function_count < do
                dup
                let function-index do
                    ctx
                    ctx
                    ctx function-index function-type-at @FunctionTypeEntry.name_start
                    ctx function-index function-type-at @FunctionTypeEntry.name_length
                    scope-function
                    ctx
                    function-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.constant_count < do
                dup
                let constant-index do
                    ctx
                    ctx
                    ctx constant-index constant-at @ConstantEntry.name_start
                    ctx constant-index constant-at @ConstantEntry.name_length
                    scope-constant
