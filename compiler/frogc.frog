        if case-offset module union-index union-type-at @UnionTypeEntry.case_count < do
            module
            module union-index union-type-at @UnionTypeEntry.case_start case-offset +
            union-case-at
            let case-entry do
                if case-entry @UnionCaseEntry.payload_type type-none != do
                    " " emit program case-entry @UnionCaseEntry.payload_type emit-c-value-type
                    " " emit case-entry @UnionCaseEntry.tag emit-c-union-case-member-name ";\n" emit
                end
            end
            program module union-index case-offset 1 + emit-c-union-case-members
        end
