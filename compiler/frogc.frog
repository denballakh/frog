            end
        end
    end
end

proc frog-internal-symbol ptr int -- bool do
    let ctx token-index do
        ctx token-index token-slice
        let bytes length do
            if length 5 < do
                false
            else
                bytes 0 byte-read 102 ==
                bytes 1 byte-read 114 == &&
                bytes 2 byte-read 111 == &&
                bytes 3 byte-read 103 == &&
                bytes 4 byte-read 95 == &&
            end
        end
    end
end

