proc compile-record-special ptr ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @cc-scope-module bytes separator visible-record-definition
            let module record-index found do
                if found ! do
                    false
                else
                    bytes separator 1 + +
                    length separator 1 + -
                    let operation operation-length do
                        if operation operation-length "alloc" bytes-equal-string do
                            module record-index record-type-at cc swap type-push
                            cc module record-index record-field-count-at cell-bytes * emit-record-allocation
                            true
                        elif operation operation-length "sizeof" bytes-equal-string do
                            cc type-int type-push
                            cc module record-index record-field-count-at cell-bytes * emit-push-integer
                            true
                        else
                            "unknown record operation" fail
                            false
                        end
                    end
                end
            end
        end
    end
end

