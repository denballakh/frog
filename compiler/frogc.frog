proc fail-duplicate-declaration ModuleContext int -- do
    let ctx token-index do
        "frogc: " emit-error
        "duplicate declaration name: " emit-error
        ctx token-index token-slice emit-error-bytes
        10 eputc
        1 exit
    end
end

proc scan-record-fields ModuleContext int int -- int do
    let ctx record-index token-index do
        if token-index ctx @ModuleContext.token_count >= do
            "unterminated record declaration" fail
            token-index
        elif ctx token-index "end" token-equals do
            if ctx record-index record-field-count-at 0 == do
                "record must declare at least one field" fail
            end
            token-index 1 +
        else
            ctx token-index require-word
            if ctx token-index identifier-token ! do
                "record field name must be an identifier" fail
            end
            ctx record-index ctx token-index token-slice find-record-field
            let existing-field do
                if existing-field 0 >= do
                    "frogc: " emit-error
                    "duplicate record field: " emit-error
                    ctx token-index token-slice emit-error-bytes
                    10 eputc
                    1 exit
                end
            end
            token-index 1 +
            let type-token do
                if
                    type-token ctx @ModuleContext.token_count >=
                    if dup ! do
                        drop ctx type-token "end" token-equals
                    end
                do
                    "expected record field type" fail
                end
                ctx type-token require-word
                if ctx type-token reserved-name do
                    "unknown type in record field" fail
                end
                ctx @ModuleContext.record_field_count
                let field-index do
                    ctx token-index token-start-at
                    ctx field-index record-field-name-start-offset set-record-field-entry-field
                    ctx token-index token-length-at
                    ctx field-index record-field-name-length-offset set-record-field-entry-field
                    ctx type-token parse-type-token
                    ctx field-index record-field-type-offset set-record-field-entry-field
                    ctx record-index record-field-count-at cell-bytes *
                    ctx field-index record-field-byte-offset-offset set-record-field-entry-field
                    field-index 1 + ctx !ModuleContext.record_field_count
                    ctx record-index record-field-count-at 1 +
                    ctx record-index record-field-count-offset set-record-entry-field
                    ctx record-index type-token 1 + scan-record-fields
                end
            end
        end
    end
end

proc scan-one-record ModuleContext int -- int do
    let ctx record-token do
        record-token 1 +
        let name-token do
            if name-token ctx @ModuleContext.token_count >= do
                "expected record name" fail
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                "invalid record name" fail
            end
            if ctx name-token find-record 0 >= do
                "frogc: " emit-error
                "duplicate record name: " emit-error
                ctx name-token token-slice emit-error-bytes
                10 eputc
                1 exit
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
                ctx name-token find-constant 0 >= ||
                ctx name-token find-union 0 >= ||
                ctx name-token find-function 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            ctx @ModuleContext.record_count
            let record-index do
                ctx name-token token-start-at
                ctx record-index record-name-start-offset set-record-entry-field
                ctx name-token token-length-at
                ctx record-index record-name-length-offset set-record-entry-field
                ctx @ModuleContext.record_field_count
                ctx record-index record-field-start-offset set-record-entry-field
                0 ctx record-index record-field-count-offset set-record-entry-field
                ctx @ModuleContext.program program-allocate-nominal-type
                ctx record-index record-type-offset set-record-entry-field
                ctx record-index name-token 1 + scan-record-fields
                let next-token do
                    record-index 1 + ctx !ModuleContext.record_count
                    next-token
                end
            end
        end
    end
end

proc scan-union-cases ModuleContext int int -- int do
    let ctx union-index token-index do
        if token-index ctx @ModuleContext.token_count >= do
            "unterminated union declaration" fail
            token-index
        elif ctx token-index "end" token-equals do
            if ctx union-index union-case-count-at 0 == do
                "union must declare at least one variant" fail
            end
            token-index 1 +
        elif ctx token-index "case" token-equals ! do
            "expected case or end in union declaration" fail
            token-index
        else
            token-index 1 +
            let name-token do
                if
                    name-token ctx @ModuleContext.token_count >=
                    if dup ! do
                        drop
                        ctx name-token "case" token-equals
                        ctx name-token "end" token-equals ||
                    end
                do
                    "expected union variant name" fail
                end
                ctx name-token require-word
                if
                    ctx name-token identifier-token !
                    ctx name-token reserved-name ||
                do
                    "union variant name must be an identifier" fail
                end
                ctx union-index ctx name-token token-slice find-union-case
                let existing-case do
                    if existing-case 0 >= do
                        "frogc: " emit-error
                        "duplicate union variant: " emit-error
                        ctx name-token token-slice emit-error-bytes
                        10 eputc
                        1 exit
                    end
                end
                ctx @ModuleContext.union_case_count
                let case-index do
                    ctx name-token token-start-at
                    ctx case-index union-case-name-start-offset set-union-case-entry-field
                    ctx name-token token-length-at
                    ctx case-index union-case-name-length-offset set-union-case-entry-field
                    type-none ctx case-index union-case-payload-type-offset set-union-case-entry-field
                    ctx union-index union-case-count-at
                    ctx case-index union-case-tag-offset set-union-case-entry-field
                    name-token 1 +
                    let after-name do
                        if after-name ctx @ModuleContext.token_count >= do
                            "unterminated union declaration" fail
                        end
                        if
                            ctx after-name "case" token-equals
                            ctx after-name "end" token-equals ||
                        do
                            after-name
                        else
                            ctx after-name require-word
                            if ctx after-name reserved-name do
                                "unknown type in union variant" fail
                            end
                            ctx after-name parse-type-token
                            ctx case-index union-case-payload-type-offset set-union-case-entry-field
                            after-name 1 +
                            let after-payload do
                                if after-payload ctx @ModuleContext.token_count >= do
                                    "unterminated union declaration" fail
                                end
                                if
                                    ctx after-payload "case" token-equals
                                    ctx after-payload "end" token-equals ||
                                    !
                                do
                                    "union variant may carry at most one value" fail
                                end
                                after-payload
                            end
                        end
                        let next-token do
                            case-index 1 + ctx !ModuleContext.union_case_count
                            ctx union-index union-case-count-at 1 +
                            ctx union-index union-case-count-offset set-union-entry-field
                            ctx union-index next-token scan-union-cases
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-union ModuleContext int -- int do
    let ctx union-token do
        union-token 1 +
        let name-token do
            if
                name-token ctx @ModuleContext.token_count >=
                if dup ! do
                    drop
                    ctx name-token "case" token-equals
                    ctx name-token "end" token-equals ||
                end
            do
                "expected union name" fail
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                "invalid union name" fail
            end
            if ctx name-token find-union 0 >= do
                "frogc: " emit-error
                "duplicate union name: " emit-error
                ctx name-token token-slice emit-error-bytes
                10 eputc
                1 exit
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
