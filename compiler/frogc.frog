end

proc emit-proc-return-type ModuleContext* int -- do
    peek ctx proc-index do procedure-at @ProcedureEntry.output_count
        let output-count do
            if output-count 0 == do
                "void" emit
            elif output-count 1 == do
                ctx @ModuleContext.program
                  ctx ctx proc-index procedure-at @ProcedureEntry.output_start type-at
                emit-c-value-type
            else
                ctx @ModuleContext.types ctx proc-index procedure-at @ProcedureEntry.output_start cell-bytes * +
                output-count emit-result-type-name
            end
        end
    end
end

