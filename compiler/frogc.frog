proc scan-one-c-type ModuleContext* int -- int do
    let ctx token do
        token 1 + let name do
            if name ctx @ModuleContext.token_count >= do "expected C type name" fail end
            ctx name require-word
            if ctx name reserved-name ctx name private-intrinsic-name || ctx name string-type-name || do "invalid C type name" fail end
            if
                ctx name find-proc 0 >=
                ctx name find-macro 0 >= ||
                ctx name find-constant 0 >= ||
                ctx name find-record 0 >= ||
                ctx name find-union 0 >= ||
                ctx name find-function 0 >= ||
                ctx name find-c-type 0 >= ||
