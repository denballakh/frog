proc function-proc-inputs-equal ModuleContext int ModuleContext int -- bool do
    let function-module function-index proc-module proc-index do
        if
            function-module function-index function-input-count-at
            proc-module proc-index proc-input-count-at
            !=
        do
            false
        else
            0 true
            while
                peek input-index equal do
                    input-index function-module function-index function-input-count-at < equal &&
                end
            do
                let input-index equal do
                    input-index 1 +
                    equal
                    function-module function-index input-index function-input-type-at
                    proc-module proc-module proc-index proc-input-start-at input-index + type-at
                    == &&
                end
            end
            let input-index equal do equal end
        end
    end
end

proc function-proc-outputs-equal ModuleContext int ModuleContext int -- bool do
    let function-module function-index proc-module proc-index do
        if
            function-module function-index function-output-count-at
            proc-module proc-index proc-output-count-at
            !=
        do
            false
        else
            0 true
            while
                peek output-index equal do
                    output-index function-module function-index function-output-count-at < equal &&
                end
            do
                let output-index equal do
                    output-index 1 +
                    equal
                    function-module function-index output-index function-output-type-at
                    proc-module proc-module proc-index proc-output-start-at output-index + type-at
                    == &&
                end
