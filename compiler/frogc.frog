proc fail-duplicate-declaration ptr int -- do
    let ctx token-index do
        "frogc: " emit-error
        "duplicate declaration name: " emit-error
        ctx token-index token-slice emit-error-bytes
        10 eputc
        1 exit
    end
end

proc scan-record-fields ptr int int -- int do
    let ctx record-index token-index do
        if token-index ctx @ctx-token-count >= do
            "unterminated record declaration" fail
            token-index
        elif ctx token-index "end" token-equals do
            if ctx record-index record-field-count-at 0 == do
                "record must declare at least one field" fail
            end
            token-index 1 +
        else
            ctx token-index require-word
            if ctx token-index identifier-token ! do
                "record field name must be an identifier" fail
            end
            ctx record-index ctx token-index token-slice find-record-field
            let existing-field do
                if existing-field 0 >= do
                    "frogc: " emit-error
                    "duplicate record field: " emit-error
                    ctx token-index token-slice emit-error-bytes
                    10 eputc
                    1 exit
                end
            end
            token-index 1 +
            let type-token do
                if
                    type-token ctx @ctx-token-count >=
                    if dup ! do
                        drop ctx type-token "end" token-equals
                    end
                do
                    "expected record field type" fail
                end
                ctx type-token require-word
                if ctx type-token reserved-name do
                    "unknown type in record field" fail
                end
                ctx @ctx-record-field-count
                let field-index do
                    ctx token-index token-start-at
                    ctx field-index record-field-name-start-offset set-record-field-entry-field
                    ctx token-index token-length-at
                    ctx field-index record-field-name-length-offset set-record-field-entry-field
                    ctx type-token parse-type-token
                    ctx field-index record-field-type-offset set-record-field-entry-field
                    ctx record-index record-field-count-at cell-bytes *
                    ctx field-index record-field-byte-offset-offset set-record-field-entry-field
                    field-index 1 + ctx !ctx-record-field-count
                    ctx record-index record-field-count-at 1 +
                    ctx record-index record-field-count-offset set-record-entry-field
                    ctx record-index type-token 1 + scan-record-fields
                end
            end
        end
    end
end

proc scan-one-record ptr int -- int do
    let ctx record-token do
        record-token 1 +
        let name-token do
            if name-token ctx @ctx-token-count >= do
                "expected record name" fail
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                "invalid record name" fail
            end
            if ctx name-token find-record 0 >= do
                "frogc: " emit-error
                "duplicate record name: " emit-error
                ctx name-token token-slice emit-error-bytes
                10 eputc
                1 exit
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
                ctx name-token find-union 0 >= ||
                ctx name-token find-function 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            ctx @ctx-record-count
            let record-index do
                ctx name-token token-start-at
                ctx record-index record-name-start-offset set-record-entry-field
                ctx name-token token-length-at
                ctx record-index record-name-length-offset set-record-entry-field
                ctx @ctx-record-field-count
                ctx record-index record-field-start-offset set-record-entry-field
                0 ctx record-index record-field-count-offset set-record-entry-field
                ctx @ctx-program program-allocate-nominal-type
                ctx record-index record-type-offset set-record-entry-field
                ctx record-index name-token 1 + scan-record-fields
                let next-token do
                    record-index 1 + ctx !ctx-record-count
                    next-token
                end
            end
        end
    end
end

proc scan-union-cases ptr int int -- int do
    let ctx union-index token-index do
        if token-index ctx @ctx-token-count >= do
            "unterminated union declaration" fail
            token-index
        elif ctx token-index "end" token-equals do
            if ctx union-index union-case-count-at 0 == do
                "union must declare at least one variant" fail
            end
            token-index 1 +
        elif ctx token-index "case" token-equals ! do
            "expected case or end in union declaration" fail
            token-index
        else
            token-index 1 +
            let name-token do
                if
                    name-token ctx @ctx-token-count >=
                    if dup ! do
                        drop
                        ctx name-token "case" token-equals
                        ctx name-token "end" token-equals ||
                    end
                do
                    "expected union variant name" fail
                end
                ctx name-token require-word
                if
                    ctx name-token identifier-token !
                    ctx name-token reserved-name ||
                do
                    "union variant name must be an identifier" fail
                end
                ctx union-index ctx name-token token-slice find-union-case
                let existing-case do
                    if existing-case 0 >= do
                        "frogc: " emit-error
                        "duplicate union variant: " emit-error
                        ctx name-token token-slice emit-error-bytes
                        10 eputc
                        1 exit
                    end
                end
                ctx @ctx-union-case-count
                let case-index do
                    ctx name-token token-start-at
                    ctx case-index union-case-name-start-offset set-union-case-entry-field
                    ctx name-token token-length-at
                    ctx case-index union-case-name-length-offset set-union-case-entry-field
                    type-none ctx case-index union-case-payload-type-offset set-union-case-entry-field
                    ctx union-index union-case-count-at
                    ctx case-index union-case-tag-offset set-union-case-entry-field
                    name-token 1 +
                    let after-name do
                        if after-name ctx @ctx-token-count >= do
                            "unterminated union declaration" fail
                        end
                        if
                            ctx after-name "case" token-equals
                            ctx after-name "end" token-equals ||
                        do
                            after-name
                        else
                            ctx after-name require-word
                            if ctx after-name reserved-name do
                                "unknown type in union variant" fail
                            end
                            ctx after-name parse-type-token
                            ctx case-index union-case-payload-type-offset set-union-case-entry-field
                            after-name 1 +
                            let after-payload do
                                if after-payload ctx @ctx-token-count >= do
                                    "unterminated union declaration" fail
                                end
                                if
                                    ctx after-payload "case" token-equals
                                    ctx after-payload "end" token-equals ||
                                    !
                                do
                                    "union variant may carry at most one value" fail
                                end
                                after-payload
                            end
                        end
                        let next-token do
                            case-index 1 + ctx !ctx-union-case-count
                            ctx union-index union-case-count-at 1 +
                            ctx union-index union-case-count-offset set-union-entry-field
                            ctx union-index next-token scan-union-cases
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-union ptr int -- int do
    let ctx union-token do
        union-token 1 +
        let name-token do
            if
                name-token ctx @ctx-token-count >=
                if dup ! do
                    drop
                    ctx name-token "case" token-equals
                    ctx name-token "end" token-equals ||
                end
            do
                "expected union name" fail
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                "invalid union name" fail
            end
            if ctx name-token find-union 0 >= do
                "frogc: " emit-error
                "duplicate union name: " emit-error
                ctx name-token token-slice emit-error-bytes
                10 eputc
                1 exit
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
                ctx name-token find-record 0 >= ||
                ctx name-token find-function 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            ctx @ctx-union-count
            let union-index do
                ctx name-token token-start-at
                ctx union-index union-name-start-offset set-union-entry-field
                ctx name-token token-length-at
                ctx union-index union-name-length-offset set-union-entry-field
                ctx @ctx-union-case-count
                ctx union-index union-case-start-offset set-union-entry-field
                0 ctx union-index union-case-count-offset set-union-entry-field
                ctx @ctx-program program-allocate-nominal-type
                ctx union-index union-type-offset set-union-entry-field
                ctx union-index name-token 1 + scan-union-cases
                let next-token do
                    union-index 1 + ctx !ctx-union-count
                    next-token
                end
            end
        end
    end
end

proc parse-function-signature-type-token ptr int -- int do
    let ctx token-index do
        ctx token-index require-word
        if ctx token-index reserved-name do
            "unknown type in function signature" fail
        end
        ctx token-index parse-type-token
    end
end

proc scan-one-function ptr int -- int do
    let ctx function-token do
        function-token 1 +
        let name-token do
            if
                name-token ctx @ctx-token-count >=
                if dup ! do
                    drop
                    ctx name-token "--" token-equals
                    ctx name-token "end" token-equals ||
                end
            do
                "expected function name" fail
            end
            ctx name-token require-word
            if
                ctx name-token identifier-token !
                ctx name-token reserved-name ||
                ctx name-token "int" token-equals ||
                ctx name-token "bool" token-equals ||
                ctx name-token "ptr" token-equals ||
                ctx name-token string-type-name ||
            do
                "invalid function name" fail
            end
            if ctx name-token find-function 0 >= do
                "frogc: " emit-error
                "duplicate function name: " emit-error
                ctx name-token token-slice emit-error-bytes
                10 eputc
                1 exit
            end
            if
                ctx name-token find-proc 0 >=
                ctx name-token find-macro 0 >= ||
                ctx name-token find-record 0 >= ||
                ctx name-token find-union 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            ctx @ctx-function-count
            let function-index do
                ctx name-token token-start-at
                ctx function-index function-name-start-offset set-function-entry-field
                ctx name-token token-length-at
                ctx function-index function-name-length-offset set-function-entry-field
                ctx @ctx-program program-allocate-function-type
                ctx function-index function-type-offset set-function-entry-field
                ctx @ctx-function-type-count
                ctx function-index function-input-start-offset set-function-entry-field
                name-token 1 + 0
                while
                    let token-index count do
                        token-index count
                        token-index ctx @ctx-token-count <
                        if dup do
                            drop
                            ctx token-index "--" token-equals !
                            ctx token-index "end" token-equals ! &&
                        end
                    end
                do
                    let token-index count do
                        ctx token-index parse-function-signature-type-token ctx swap add-function-signature-type
                        token-index 1 + count 1 +
                    end
                end
                let token-index input-count do
                    if token-index ctx @ctx-token-count >= do
                        "expected -- in function signature" fail
                    end
                    if ctx token-index "--" token-equals ! do
                        "expected -- in function signature" fail
                    end
                    input-count ctx function-index function-input-count-offset set-function-entry-field
                    ctx @ctx-function-type-count
                    ctx function-index function-output-start-offset set-function-entry-field
                    token-index 1 + 0
                    while
                        let output-token output-count do
                            output-token output-count
                            output-token ctx @ctx-token-count <
                            if dup do
                                drop ctx output-token "end" token-equals !
                            end
                        end
                    do
                        let output-token output-count do
                            ctx output-token parse-function-signature-type-token ctx swap add-function-signature-type
                            output-token 1 + output-count 1 +
                        end
                    end
                    let output-token output-count do
                        if output-token ctx @ctx-token-count >= do
                            "expected end after function signature" fail
                        end
                        output-count ctx function-index function-output-count-offset set-function-entry-field
                        function-index 1 + ctx !ctx-function-count
                        output-token 1 +
                    end
                end
            end
        end
    end
end

proc scan-macro-body ptr int -- int do
    let ctx body-start do
        body-start 0 true
        while
            let token-index depth active do
                token-index depth active active
            end
        do
            let token-index depth active do
                if token-index ctx @ctx-token-count >= do
                    "unterminated macro body" fail
                    token-index depth false
                elif ctx token-index token-kind-at token-word == do
                    if ctx token-index "end" token-equals do
                        if depth 0 == do
                            token-index 1 + depth false
                        else
                            token-index 1 + depth 1 - true
                        end
                    elif
                        ctx token-index "if" token-equals
                        ctx token-index "while" token-equals ||
                        ctx token-index "let" token-equals ||
                    do
                        token-index 1 + depth 1 + true
                    elif
                        ctx token-index "from" token-equals
                        ctx token-index "import" token-equals ||
                    do
                        "imports are only allowed at top level" fail
                        token-index 1 + depth true
                    elif
                        ctx token-index "proc" token-equals
                        ctx token-index "macro" token-equals ||
                        ctx token-index "extern" token-equals ||
                        ctx token-index "record" token-equals ||
                        ctx token-index "union" token-equals ||
                        ctx token-index "fn" token-equals ||
                    do
                        "declarations are not allowed in macro bodies" fail
                        token-index 1 + depth true
                    else
                        token-index 1 + depth true
                    end
                else
                    token-index 1 + depth true
                end
            end
        end
        let next-token depth active do
            next-token
        end
    end
end

proc validate-macro-body ptr int int -- do
    let ctx body-start body-end do
        body-end body-start - cell-bytes * alloc
        let kinds do
            body-end body-start - cell-bytes * alloc
            let has-dos do
                body-end body-start - cell-bytes * alloc
                let has-elses do
                    body-start 0
                    while
                        let token-index depth do
                            token-index depth
                            token-index body-end <
                        end
                    do
                        let token-index depth do
                            if ctx token-index token-kind-at token-word == do
                                if
                                    ctx token-index "from" token-equals
                                    ctx token-index "import" token-equals ||
                                do
                                    "imports are only allowed at top level" fail
                                    token-index 1 + depth
                                elif
                                    ctx token-index "proc" token-equals
                                    ctx token-index "macro" token-equals ||
                                    ctx token-index "extern" token-equals ||
                                    ctx token-index "record" token-equals ||
                                    ctx token-index "union" token-equals ||
                                    ctx token-index "fn" token-equals ||
                                do
                                    "declarations are not allowed in macro bodies" fail
                                    token-index 1 + depth
                                elif
                                    ctx token-index "if" token-equals
                                    ctx token-index "while" token-equals ||
                                    ctx token-index "let" token-equals ||
                                do
                                    if ctx token-index "if" token-equals do
                                        block-if kinds depth cell-bytes * field-write
                                    elif ctx token-index "while" token-equals do
                                        block-while kinds depth cell-bytes * field-write
                                    else
                                        block-let kinds depth cell-bytes * field-write
                                    end
                                    0 has-dos depth cell-bytes * field-write
                                    0 has-elses depth cell-bytes * field-write
                                    token-index 1 + depth 1 +
                                elif ctx token-index "do" token-equals do
                                    if depth 0 <= do
                                        "do outside macro control-flow block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 != do
                                        "duplicate do in macro control-flow block" fail
                                    end
                                    1 has-dos depth 1 - cell-bytes * field-write
                                    token-index 1 + depth
                                elif ctx token-index "else" token-equals do
                                    if depth 0 <= do
                                        "else outside macro if block" fail
                                    end
                                    if kinds depth 1 - cell-bytes * field-read block-if != do
                                        "else outside macro if block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 == do
                                        "else requires a completed macro if arm" fail
                                    end
                                    if has-elses depth 1 - cell-bytes * field-read 0 != do
                                        "duplicate else in macro if block" fail
                                    end
                                    1 has-elses depth 1 - cell-bytes * field-write
                                    token-index 1 + depth
                                elif ctx token-index "elif" token-equals do
                                    if depth 0 <= do
                                        "elif outside macro if block" fail
                                    end
                                    if kinds depth 1 - cell-bytes * field-read block-if != do
                                        "elif outside macro if block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 == do
                                        "elif requires a completed macro if arm" fail
                                    end
                                    if has-elses depth 1 - cell-bytes * field-read 0 != do
                                        "elif after else in macro if block" fail
                                    end
                                    0 has-dos depth 1 - cell-bytes * field-write
                                    token-index 1 + depth
                                elif ctx token-index "end" token-equals do
                                    if depth 0 <= do
                                        "end outside macro control-flow block" fail
                                    end
                                    if has-dos depth 1 - cell-bytes * field-read 0 == do
                                        "macro control-flow block requires do" fail
                                    end
                                    token-index 1 + depth 1 -
                                else
                                    token-index 1 + depth
                                end
                            else
                                token-index 1 + depth
                            end
                        end
                    end
                    let token-index depth do
                        if depth 0 != do
                            "unclosed blocks in macro body" fail
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-macro ptr int -- int do
    let ctx macro-token do
        macro-token 1 +
        let name-token do
            if name-token ctx @ctx-token-count >= do
                "expected macro name" fail
            end
            ctx name-token require-word
            if
                ctx name-token reserved-name
                ctx name-token string-type-name ||
            do
                "reserved keyword cannot be a macro name" fail
            end
            ctx name-token find-macro
            let existing-macro do
                if existing-macro 0 >= do
                    "duplicate macro name" fail
                end
            end
            if
                ctx name-token find-record 0 >=
                ctx name-token find-union 0 >= ||
                ctx name-token find-function 0 >= ||
            do
                ctx name-token fail-duplicate-declaration
            end
            ctx @ctx-macro-count
            let macro-index do
                ctx name-token token-start-at ctx macro-index macro-name-start-offset set-macro-field
                ctx name-token token-length-at ctx macro-index macro-name-length-offset set-macro-field
                false ctx macro-index set-macro-expanding
                ctx name-token 1 + scan-macro-body
                let next-token do
                    ctx name-token 1 + next-token 1 - validate-macro-body
                    name-token 1 + ctx macro-index macro-body-start-offset set-macro-field
                    next-token 1 - ctx macro-index macro-body-end-offset set-macro-field
                    ctx @ctx-macro-count 1 + ctx !ctx-macro-count
                    next-token
                end
            end
        end
    end
end

proc scan-block-end-with-outer-elif ptr int bool -- int do
    let ctx body-start allow-outer-elif do
        body-start 1
        while
            let token-index depth do
                token-index depth
                depth 0 >
                token-index ctx @ctx-token-count < &&
            end
        do
            let token-index depth do
                if ctx token-index token-kind-at token-word == do
                    if
                        ctx token-index "from" token-equals
                        ctx token-index "import" token-equals ||
                    do
                        "imports are only allowed at top level" fail
                        depth
                    elif
                        ctx token-index "proc" token-equals
                        ctx token-index "macro" token-equals ||
                        ctx token-index "extern" token-equals ||
                        ctx token-index "record" token-equals ||
                        ctx token-index "union" token-equals ||
                        ctx token-index "fn" token-equals ||
                    do
                        "declarations are only allowed at top level" fail
                        depth
                    elif ctx token-index "elif" token-equals do
                        if depth 1 <= allow-outer-elif ! && do
                            "elif outside active if" fail
                        end
                        depth
                    else
                        if
                            ctx token-index "if" token-equals
                            ctx token-index "while" token-equals ||
                            ctx token-index "let" token-equals ||
                        do
                            depth 1 +
                        else
                            if ctx token-index "end" token-equals do
                                depth 1 -
                            else
                                depth
                            end
                        end
                    end
                else
                    depth
                end
                token-index 1 +
                swap
            end
        end
        let token-index depth do
            if depth 0 != do
                "unterminated procedure body" fail
            end
            token-index
        end
    end
end

proc scan-block-end ptr int -- int do false scan-block-end-with-outer-elif end
proc scan-ignored-block-end ptr int -- int do true scan-block-end-with-outer-elif end

proc allocate-proc ptr int bool -- int do
    let ctx name-token external do
        if name-token ctx @ctx-token-count >= do
            "expected procedure name" fail
        end
        ctx name-token require-word
        if
            ctx name-token reserved-name
            ctx name-token string-type-name ||
        do
            "reserved keyword cannot be a procedure name" fail
        end
        ctx name-token find-proc
        let existing-proc do
            if existing-proc 0 >= do
                "duplicate procedure name: " emit-error
                ctx name-token token-slice emit-error-bytes
                10 eputc
                1 exit
            end
        end
        if
            ctx name-token find-record 0 >=
            ctx name-token find-union 0 >= ||
            ctx name-token find-function 0 >= ||
        do
            ctx name-token fail-duplicate-declaration
        end

        ctx @ctx-proc-count
        let proc-index do
            ctx name-token token-start-at ctx proc-index proc-name-start-offset set-proc-field
            ctx name-token token-length-at ctx proc-index proc-name-length-offset set-proc-field
            proc-index ctx proc-index proc-index-offset set-proc-field
            ctx @ctx-program program-allocate-proc-id ctx proc-index proc-global-id-offset set-proc-field
            external ctx proc-index set-proc-external
            proc-index
        end
    end
end

proc scan-one-proc ptr int -- int do
    let ctx proc-token do
        proc-token 1 +
        let name-token do
            ctx name-token false allocate-proc
            let proc-index do
                ctx @ctx-type-count ctx proc-index proc-input-start-offset set-proc-field
                name-token 1 + 0
                while
                    let token-index count do
                        token-index count
                        token-index ctx @ctx-token-count <
                        if dup do
                            drop ctx token-index "--" token-equals !
                        end
                    end
                do
                    let token-index count do
                        ctx token-index parse-type-token ctx swap add-type
                        token-index 1 + count 1 +
                    end
                end
                let token-index input-count do
                    if token-index ctx @ctx-token-count >= do
                        "expected -- in procedure signature" fail
                    end
                    input-count ctx proc-index proc-input-count-offset set-proc-field
                    token-index 1 +
                end

                ctx @ctx-type-count ctx proc-index proc-output-start-offset set-proc-field
                0
                while
                    let token-index count do
                        token-index count
                        token-index ctx @ctx-token-count <
                        if dup do
                            drop ctx token-index "do" token-equals !
                        end
                    end
                do
                    let token-index count do
                        ctx token-index parse-type-token ctx swap add-type
                        token-index 1 + count 1 +
                    end
                end
                let token-index output-count do
                    if token-index ctx @ctx-token-count >= do
                        "expected do after procedure signature" fail
                    end
                    output-count ctx proc-index proc-output-count-offset set-proc-field
                    token-index 1 +
                end
                let body-start do
                    body-start ctx proc-index proc-body-start-offset set-proc-field
                    ctx body-start scan-block-end
                    let next-token do
                        next-token 1 - ctx proc-index proc-body-end-offset set-proc-field
                        proc-index 1 + ctx !ctx-proc-count

                        if ctx name-token "main" token-equals do
                            if ctx @ctx-main-proc 0 >= do
                                "duplicate main procedure" fail
                            end
                            if
                                ctx proc-index proc-input-count-at 0 !=
                                ctx proc-index proc-output-count-at 0 != ||
                            do
                                "main must have an empty stack contract" fail
                            end
                            proc-index ctx !ctx-main-proc
                        end
                        next-token
                    end
                end
            end
        end
    end
end

proc scan-one-extern ptr int -- int do
    let ctx extern-token do
        extern-token 1 +
        let name-token do
            ctx name-token true allocate-proc
            let proc-index do
                if ctx name-token "main" token-equals do
                    "main cannot be external" fail
                end
                name-token 1 +
                let symbol-token do
                    if symbol-token ctx @ctx-token-count >= do
                        "expected C symbol" fail
                    end
                    ctx symbol-token require-word
                    if ctx symbol-token valid-c-symbol ! do
                        "invalid C symbol" fail
                    end
                    symbol-token ctx proc-index proc-c-symbol-token-offset set-proc-field

                    ctx @ctx-type-count ctx proc-index proc-input-start-offset set-proc-field
                    symbol-token 1 + 0
                    while
                        let token-index count do
                            token-index count
                            token-index ctx @ctx-token-count <
                            if dup do
                                drop ctx token-index "--" token-equals !
                            end
                        end
                    do
                        let token-index count do
                            ctx token-index parse-c-abi-type-token ctx swap add-type
                            token-index 1 + count 1 +
                        end
                    end
                    let token-index input-count do
                        if token-index ctx @ctx-token-count >= do
                            "expected -- in external signature" fail
                        end
                        input-count ctx proc-index proc-input-count-offset set-proc-field
                        token-index 1 +
                    end

                    ctx @ctx-type-count ctx proc-index proc-output-start-offset set-proc-field
                    0
                    while
                        let token-index count do
                            token-index count
                            token-index ctx @ctx-token-count <
                            if dup do
                                drop ctx token-index "end" token-equals !
                            end
                        end
                    do
                        let token-index count do
                            ctx token-index parse-c-abi-type-token ctx swap add-type
                            token-index 1 + count 1 +
                        end
                    end
                    let token-index output-count do
                        if token-index ctx @ctx-token-count >= do
                            "expected end after external signature" fail
                        end
                        if output-count 1 > do
                            "external procedure may return at most one value" fail
                        end
                        output-count ctx proc-index proc-output-count-offset set-proc-field
                        proc-index 1 + ctx !ctx-proc-count
                        token-index 1 +
                    end
                end
            end
        end
    end
end

proc import-address ptr int -- ptr do
    let ctx index do
        ctx @ctx-imports index import-bytes * +
    end
end

proc import-field ptr int int -- int do
    let ctx index offset do
        ctx index import-address offset field-read
    end
end

proc set-import-field int ptr int int -- do
    let value ctx index offset do
        value ctx index import-address offset field-write
    end
end

proc import-path-token-at ptr int -- int do import-path-token-offset import-field end
proc import-name-token-at ptr int -- int do import-name-token-offset import-field end
proc import-alias-token-at ptr int -- int do import-alias-token-offset import-field end
proc import-target-module-at ptr int -- ptr do
    let ctx index do ctx index import-address import-target-module-offset pointer-field-read end
end
proc import-canonical-path-at ptr int -- ptr do
    let ctx index do ctx index import-address import-canonical-path-offset pointer-field-read end
end
proc import-canonical-path-length-at ptr int -- int do import-canonical-path-length-offset import-field end

proc set-import-target-module ptr ptr int -- do
    let module ctx index do module ctx index import-address import-target-module-offset pointer-field-write end
end

proc scope-address ptr int -- ptr do
    let ctx index do ctx @ctx-scope index scope-bytes * + end
end

proc scope-field ptr int int -- int do
    let ctx index offset do ctx index scope-address offset field-read end
end

proc set-scope-field int ptr int int -- do
    let value ctx index offset do value ctx index scope-address offset field-write end
end

proc scope-name-module-at ptr int -- ptr do
