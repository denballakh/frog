proc resolve-one-import ModuleContext int -- do
    let ctx import-index do
        ctx import-index import-at
        let entry do
            entry @ImportEntry.target_module
            let target do
                if target ptr cast int cast 0 == do
                    "internal import target is missing" fail
                end
                target resolve-module-scope
                target ctx entry @ImportEntry.name_token find-scope-symbol
                let target-symbol do
                    if target-symbol 0 < do
                        "imported name not found" fail
                    end
                    target target-symbol scope-at
                    let target-entry do
                        entry @ImportEntry.alias_token
                        if dup 0 < do
                            drop entry @ImportEntry.name_token
                        end
                        let visible-token do
                            if
                                target-entry @ScopeEntry.kind scope-record ==
                                ctx visible-token identifier-token ! &&
                            do
                                "record import alias must be an identifier" fail
                            end
                            if
                                target-entry @ScopeEntry.kind scope-union ==
                                ctx visible-token identifier-token ! &&
                            do
                                "union import alias must be an identifier" fail
                            end
                            if
                                target-entry @ScopeEntry.kind scope-function ==
                                ctx visible-token identifier-token ! &&
                            do
                                "function import alias must be an identifier" fail
                            end
                            if
                                ctx visible-token find-proc 0 >=
                                ctx visible-token find-macro 0 >= ||
                                ctx visible-token find-constant 0 >= ||
                                ctx visible-token find-record 0 >= ||
                                ctx visible-token find-union 0 >= ||
                                ctx visible-token find-function 0 >= ||
                            do
                                "import alias conflict" fail
                            end
                            ctx ctx visible-token find-scope-symbol
                            let existing do
                                if existing 0 >= do
                                    if ctx existing target target-symbol scope-symbols-identical ! do
                                        "import alias conflict" fail
                                    end
                                else
                                    ctx
                                    ctx
                                    visible-token
                                    target-entry @ScopeEntry.kind
                                    target-entry @ScopeEntry.definition_module
                                    target-entry @ScopeEntry.definition_index
                                    add-scope-symbol-from-token
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc resolve-module-scope ModuleContext -- do
    let ctx do
        if ctx @ModuleContext.resolve_state resolve-resolved == do
        else
            if ctx @ModuleContext.resolve_state resolve-resolving == do
                "cyclic import" fail
            end
            resolve-resolving ctx !ModuleContext.resolve_state
            0
            while dup ctx @ModuleContext.import_count < do
                dup ctx swap resolve-one-import
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.record_count < do
                dup
                let record-index do
                    ctx
                    ctx
                    ctx record-index record-name-start-at
                    ctx record-index record-name-length-at
                    scope-record
                    ctx
                    record-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.union_count < do
                dup
                let union-index do
                    ctx
                    ctx
                    ctx union-index union-name-start-at
                    ctx union-index union-name-length-at
                    scope-union
                    ctx
                    union-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.function_count < do
                dup
                let function-index do
                    ctx
                    ctx
                    ctx function-index function-name-start-at
                    ctx function-index function-name-length-at
                    scope-function
                    ctx
                    function-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.macro_count < do
                dup
                let macro-index do
                    ctx
                    ctx
                    ctx macro-index macro-name-start-at
                    ctx macro-index macro-name-length-at
                    scope-macro
                    ctx
                    macro-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.constant_count < do
                dup
                let constant-index do
                    ctx
                    ctx
                    ctx constant-index constant-name-start-at
                    ctx constant-index constant-name-length-at
                    scope-constant
                    ctx
                    constant-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            0
            while dup ctx @ModuleContext.proc_count < do
                dup
                let proc-index do
                    ctx
                    ctx
                    ctx proc-index proc-name-start-at
                    ctx proc-index proc-name-length-at
                    scope-procedure
                    ctx
                    proc-index
                    add-scope-symbol
                end
                1 +
            end
            drop
            resolve-resolved ctx !ModuleContext.resolve_state
        end
    end
end

proc resolve-all-module-scopes ptr -- do
    peek program do @program-module-head
        while dup ptr cast int cast 0 != do
            dup resolve-module-scope
            @ModuleContext.next_module
        end
        drop
    end
end

proc @constant-evaluator-values ptr -- ptr do
    constant-evaluator-values-offset pointer-field-read
end

proc @constant-evaluator-count ptr -- int do
    constant-evaluator-count-offset field-read
end

proc @constant-evaluator-capacity ptr -- int do
    constant-evaluator-capacity-offset field-read
end

proc !constant-evaluator-values ptr ptr -- do
    constant-evaluator-values-offset pointer-field-write
end

proc !constant-evaluator-count int ptr -- do
    constant-evaluator-count-offset field-write
end

proc !constant-evaluator-capacity int ptr -- do
    constant-evaluator-capacity-offset field-write
end

proc create-constant-evaluator -- ptr do
    constant-evaluator-bytes alloc
    let evaluator do
        8
        peek capacity do constant-value-bytes * alloc evaluator !constant-evaluator-values
            0 evaluator !constant-evaluator-count
            capacity evaluator !constant-evaluator-capacity
            evaluator
        end
    end
end

proc ensure-constant-evaluator-capacity ptr -- do
    let evaluator do
        if evaluator @constant-evaluator-count evaluator @constant-evaluator-capacity == do
            evaluator @constant-evaluator-capacity 2 *
            peek new-capacity do constant-value-bytes * alloc
                let new-values do
                    evaluator @constant-evaluator-values
                    new-values
                    evaluator @constant-evaluator-count constant-value-bytes *
                    memory-copy
                    new-values evaluator !constant-evaluator-values
                    new-capacity evaluator !constant-evaluator-capacity
                end
            end
        end
    end
end

proc constant-evaluator-push ptr int int -- do
    let evaluator type payload do
        evaluator ensure-constant-evaluator-capacity
        type
        payload
        evaluator @constant-evaluator-values
        evaluator @constant-evaluator-count
        set-constant-value
        evaluator @constant-evaluator-count 1 + evaluator !constant-evaluator-count
    end
end

proc constant-evaluator-pop ptr -- int int do
    let evaluator do
        if evaluator @constant-evaluator-count 0 <= do
            "constant expression stack underflow" fail
        end
        evaluator @constant-evaluator-count 1 -
        peek index do evaluator !constant-evaluator-count
            evaluator @constant-evaluator-values index constant-value-type-at
            evaluator @constant-evaluator-values index constant-value-payload-at
        end
    end
end

proc constant-evaluator-pop-expected ptr int -- int do
    let evaluator expected-type do
        evaluator constant-evaluator-pop
        let actual-type payload do
            if actual-type expected-type != do
                "constant expression type mismatch" fail
            end
            payload
        end
    end
end

proc checked-constant-add int int -- int do
    let left right do
        if right 0 > do
            if left max-int right - > do
                "constant integer overflow" fail
            end
        elif right 0 < do
            if left min-int right - < do
                "constant integer overflow" fail
            end
        end
        left right +
    end
end

proc checked-constant-subtract int int -- int do
    let left right do
        if right 0 > do
            if left min-int right + < do
                "constant integer overflow" fail
            end
        elif right 0 < do
            if left max-int right + > do
                "constant integer overflow" fail
            end
        end
        left right -
    end
end

proc checked-constant-multiply int int -- int do
    let left right do
        if left 0 == right 0 == || do
            0
        else
            if
                left min-int == right 0 1 - == &&
                right min-int == left 0 1 - == && ||
            do
                "constant integer overflow" fail
            end
            if left 0 > do
                if right 0 > do
                    if left max-int right / > do
                        "constant integer overflow" fail
                    end
                else
                    if right min-int left / < do
                        "constant integer overflow" fail
                    end
                end
            else
                if right 0 > do
                    if left min-int right / < do
                        "constant integer overflow" fail
                    end
                else
                    if right max-int left / < do
                        "constant integer overflow" fail
                    end
                end
            end
            left right *
        end
    end
end

proc require-constant-divisor int int -- do
    let left right do
        if right 0 == do
            "constant division by zero" fail
        end
        if left min-int == right 0 1 - == && do
            "constant integer overflow" fail
        end
    end
end

proc checked-constant-divide int int -- int do
    peek left right do require-constant-divisor
        left right /
    end
end

proc checked-constant-modulo int int -- int do
    peek left right do require-constant-divisor
        left right %
    end
end

proc require-constant-shift int int -- do
    let value count do
        if value 0 < count 0 < || count 63 >= || do
            "invalid shift in constant expression" fail
        end
    end
end

proc checked-constant-shift-left int int -- int do
    peek value count do require-constant-shift
        if value max-int count >> > do
            "constant integer overflow" fail
        end
        value count <<
    end
end

proc checked-constant-shift-right int int -- int do
    peek value count do require-constant-shift
        value count >>
    end
end

proc constant-int-binary-word ModuleContext int -- bool do
    peek module token-index do "+" token-equals
        module token-index "-" token-equals ||
        module token-index "*" token-equals ||
        module token-index "/" token-equals ||
        module token-index "%" token-equals ||
        module token-index "<<" token-equals ||
        module token-index ">>" token-equals ||
        module token-index "|" token-equals ||
        module token-index "&" token-equals ||
        module token-index "^" token-equals ||
    end
end

proc constant-comparison-word ModuleContext int -- bool do
    peek module token-index do "==" token-equals
        module token-index "!=" token-equals ||
        module token-index "<" token-equals ||
        module token-index ">" token-equals ||
        module token-index "<=" token-equals ||
        module token-index ">=" token-equals ||
    end
end

proc constant-bool-binary-word ModuleContext int -- bool do
    peek module token-index do "&&" token-equals
        module token-index "||" token-equals ||
    end
end

proc evaluate-constant-int-binary ptr ModuleContext int -- do
    let evaluator module token-index do
        evaluator type-int constant-evaluator-pop-expected
        let right do
            evaluator type-int constant-evaluator-pop-expected
            let left do
                if module token-index "+" token-equals do
                    left right checked-constant-add
                elif module token-index "-" token-equals do
                    left right checked-constant-subtract
                elif module token-index "*" token-equals do
                    left right checked-constant-multiply
                elif module token-index "/" token-equals do
                    left right checked-constant-divide
                elif module token-index "%" token-equals do
                    left right checked-constant-modulo
                elif module token-index "<<" token-equals do
                    left right checked-constant-shift-left
                elif module token-index ">>" token-equals do
                    left right checked-constant-shift-right
                elif module token-index "|" token-equals do
                    left right |
                elif module token-index "&" token-equals do
                    left right &
                else
                    left right ^
                end
                let result do
                    evaluator type-int result constant-evaluator-push
                end
            end
        end
    end
end

proc evaluate-constant-comparison ptr ModuleContext int -- do
    let evaluator module token-index do
        evaluator type-int constant-evaluator-pop-expected
        let right do
            evaluator type-int constant-evaluator-pop-expected
            let left do
                if module token-index "==" token-equals do
                    left right ==
                elif module token-index "!=" token-equals do
                    left right !=
                elif module token-index "<" token-equals do
                    left right <
                elif module token-index ">" token-equals do
                    left right >
                elif module token-index "<=" token-equals do
                    left right <=
                else
                    left right >=
                end
                let result do
                    evaluator type-bool result int cast constant-evaluator-push
                end
            end
        end
    end
end

proc evaluate-constant-bool-binary ptr ModuleContext int -- do
    let evaluator module token-index do
        evaluator type-bool constant-evaluator-pop-expected
        let right do
            evaluator type-bool constant-evaluator-pop-expected
            let left do
                if module token-index "&&" token-equals do
                    left 0 != right 0 != &&
                else
                    left 0 != right 0 != ||
                end
                let result do
                    evaluator type-bool result int cast constant-evaluator-push
                end
            end
        end
    end
end

proc evaluate-constant-divmod ptr -- do
    peek evaluator do type-int constant-evaluator-pop-expected
        let right do
            evaluator type-int constant-evaluator-pop-expected
            peek left do right checked-constant-divide
                left right checked-constant-modulo
                let quotient remainder do
                    evaluator type-int quotient constant-evaluator-push
                    evaluator type-int remainder constant-evaluator-push
                end
            end
        end
    end
end

proc evaluate-constant-unary ptr ModuleContext int -- do
    let evaluator module token-index do
        if module token-index "~" token-equals do
            evaluator type-int constant-evaluator-pop-expected
            let value do evaluator type-int value ~ constant-evaluator-push end
        else
            evaluator type-bool constant-evaluator-pop-expected
            let value do evaluator type-bool value 0 == int cast constant-evaluator-push end
        end
    end
end

proc evaluate-constant-intrinsic ptr ModuleContext int -- bool do
    let evaluator module token-index do
        if module token-index constant-int-binary-word do
            evaluator module token-index evaluate-constant-int-binary true
        elif module token-index constant-comparison-word do
            evaluator module token-index evaluate-constant-comparison true
        elif module token-index constant-bool-binary-word do
            evaluator module token-index evaluate-constant-bool-binary true
        elif module token-index "/%" token-equals do
            evaluator evaluate-constant-divmod true
        elif
            module token-index "~" token-equals
            module token-index "!" token-equals ||
        do
            evaluator module token-index evaluate-constant-unary true
        else
            false
        end
    end
end

proc constant-runtime-intrinsic-word ModuleContext int -- bool do
    peek module token-index do "read-file" token-equals
        module token-index "cast" token-equals ||
        module token-index "alloc" token-equals ||
        module token-index "args" token-equals ||
        module token-index "@ptr" token-equals ||
        module token-index "@i8" token-equals ||
        module token-index "@i16" token-equals ||
        module token-index "@i32" token-equals ||
        module token-index "@i64" token-equals ||
        module token-index "@u8" token-equals ||
        module token-index "@u16" token-equals ||
        module token-index "@u32" token-equals ||
        module token-index "@u64" token-equals ||
        module token-index "!ptr" token-equals ||
        module token-index "!i8" token-equals ||
