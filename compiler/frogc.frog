                    analysis @ProcedureAnalysis.instruction_count block @AnalyzedBlock.instruction_start -
                    block !AnalyzedBlock.instruction_count
                    analysis exit-types exit-count append-operation-types block !AnalyzedBlock.exit_type_start
                    exit-count block !AnalyzedBlock.exit_type_count
                    terminator-module block !AnalyzedBlock.terminator_module
                    terminator-token block !AnalyzedBlock.terminator_token
