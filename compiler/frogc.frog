proc evaluate-constant ModuleContext int -- do
    peek module constant-index do constant-state-at
        let state do
            if state constant-evaluated == do
            elif state constant-evaluating == do
                "recursive constant" fail
            else
                constant-evaluating module constant-index constant-state-offset set-constant-field
                create-constant-evaluator
                peek evaluator do
                    module
                    module constant-index constant-body-start-at
                    module constant-index constant-body-end-at
                    evaluate-constant-range
                    evaluator @constant-evaluator-count
                    let value-count do
                        if value-count 0 == do
                            "constant must produce at least one value" fail
                        end
                        value-count constant-value-bytes * alloc
                        let values do
                            evaluator @constant-evaluator-values
                            values
                            value-count constant-value-bytes *
                            memory-copy
                            values module constant-index set-constant-values
                            value-count module constant-index constant-value-count-offset set-constant-field
                            constant-evaluated module constant-index constant-state-offset set-constant-field
                        end
                    end
                end
            end
        end
    end
end

proc append-constant-values ptr ModuleContext int -- do
    let evaluator module constant-index do
