                                                    module case-index union-case-at @UnionCaseEntry.payload_type cc active-typed-instruction !TypedInstruction.secondary_type
                                                    module cc active-typed-instruction !TypedInstruction.secondary_module
                                                    union-index cc active-typed-instruction !TypedInstruction.secondary_index
                                                    module case-index union-case-at @UnionCaseEntry.tag cc active-typed-instruction !TypedInstruction.payload
