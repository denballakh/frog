proc collect-path-components ptr int bool ptr ptr int int -- int do
    let bytes length absolute starts lengths index count do
        bytes length index skip-path-separators
        let start do
            if start length >= do
                count
            else
                bytes length start find-path-component-end
                peek next do start -
                    let component-length do
                        if bytes start component-length bytes-are-dot do
                            count
                        elif bytes start component-length bytes-are-dot-dot do
                            if count 0 > do
                                if bytes starts lengths count last-path-component-is-dot-dot do
                                    starts lengths count start component-length add-path-component
                                else
                                    count 1 -
                                end
                            else
                                if absolute do
                                    count
                                else
                                    starts lengths count start component-length add-path-component
                                end
                            end
                        else
                            starts lengths count start component-length add-path-component
                        end
                        let next-count do
