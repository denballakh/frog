proc macro-name-length-offset -- int do 8 end
proc macro-body-start-offset -- int do 16 end
proc macro-body-end-offset -- int do 24 end
proc macro-expanding-offset -- int do 32 end
proc macro-bytes -- int do 40 end

proc ctx-source-offset -- int do 0 end
proc ctx-source-length-offset -- int do 8 end
proc ctx-tokens-offset -- int do 16 end
proc ctx-token-count-offset -- int do 24 end
proc ctx-procs-offset -- int do 32 end
proc ctx-proc-count-offset -- int do 40 end
proc ctx-types-offset -- int do 48 end
proc ctx-type-count-offset -- int do 56 end
proc ctx-lex-index-offset -- int do 64 end
proc ctx-lex-line-offset -- int do 72 end
proc ctx-lex-column-offset -- int do 80 end
proc ctx-main-proc-offset -- int do 88 end
proc ctx-macros-offset -- int do 96 end
proc ctx-macro-count-offset -- int do 104 end
proc ctx-program-offset -- int do 112 end
proc ctx-module-id-offset -- int do 120 end
proc ctx-next-module-offset -- int do 128 end
proc ctx-canonical-path-offset -- int do 136 end
proc ctx-canonical-path-length-offset -- int do 144 end
proc ctx-imports-offset -- int do 152 end
proc ctx-import-count-offset -- int do 160 end
proc ctx-scope-offset -- int do 168 end
proc ctx-scope-count-offset -- int do 176 end
proc ctx-load-state-offset -- int do 184 end
proc ctx-resolve-state-offset -- int do 192 end
proc ctx-is-root-offset -- int do 200 end
proc ctx-bytes -- int do 208 end

proc import-path-token-offset -- int do 0 end
proc import-name-token-offset -- int do 8 end
proc import-alias-token-offset -- int do 16 end
proc import-target-module-offset -- int do 24 end
proc import-canonical-path-offset -- int do 32 end
proc import-canonical-path-length-offset -- int do 40 end
proc import-bytes -- int do 48 end

proc scope-name-module-offset -- int do 0 end
proc scope-name-start-offset -- int do 8 end
proc scope-name-length-offset -- int do 16 end
proc scope-kind-offset -- int do 24 end
proc scope-definition-module-offset -- int do 32 end
proc scope-definition-index-offset -- int do 40 end
proc scope-bytes -- int do 48 end

proc scope-procedure -- int do 1 end
proc scope-macro -- int do 2 end

proc load-new -- int do 0 end
proc load-loading -- int do 1 end
proc load-loaded -- int do 2 end

proc resolve-new -- int do 0 end
proc resolve-resolving -- int do 1 end
proc resolve-resolved -- int do 2 end

proc max-source-bytes -- int do 4194304 end
proc max-import-path-bytes -- int do 1024 end

proc field-read ptr int -- int do + @i64 end

proc field-write int ptr int -- do
    + !i64
end

proc pointer-field-read ptr int -- ptr do
    field-read ptr cast
end

proc pointer-field-write ptr ptr int -- do
    let value base offset do
        value int cast base offset field-write
    end
end

proc byte-read ptr int -- int do
    + @u8
end

proc byte-write int ptr int -- do
    + !u8
end

proc memory-copy ptr ptr int -- do
    let source destination count do
        0
        while dup count < do
            dup let index do
                source index byte-read
                destination index byte-write
            end
            1 +
        end
        drop
    end
end

proc emit ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + @u8 putc
            1 +
        end
        drop
    end
end

proc emit-error ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + @u8 eputc
            1 +
        end
        drop
    end
end

proc fail ptr int -- do
    "frogc: " emit-error
    emit-error
    10 eputc
    1 exit
end

proc emit-unsigned int -- do
    let value do
        if value 10 >= do
            value 10 / emit-unsigned
        end
        value 10 % 48 + putc
    end
end

proc emit-integer int -- do
    if dup 0 < do
        45 putc
        0 swap -
    end
    emit-unsigned
end

proc is-space int -- bool do
    let byte do
        byte 32 ==
        byte 9 == ||
        byte 10 == ||
        byte 13 == ||
    end
end

proc is-digit int -- bool do
    let byte do
        byte 48 >= byte 57 <= &&
    end
end

proc is-hex-digit int -- bool do
    let byte do
        byte is-digit
        byte 65 >= byte 70 <= && ||
        byte 97 >= byte 102 <= && ||
    end
end

proc hex-value int -- int do
    let byte do
        if byte is-digit do
            byte 48 -
        elif byte 65 >= byte 70 <= && do
            byte 65 - 10 +
        elif byte 97 >= byte 102 <= && do
            byte 97 - 10 +
        else
            "invalid hexadecimal digit" fail
            0
        end
    end
end

proc bytes-equal ptr int ptr int -- bool do
    let first first-length second second-length do
        if first-length second-length != do
            false
        else
            0 true
            while
                let index equal do
                    index equal
                    index first-length < equal &&
                end
            do
                let index equal do
                    index 1 +
                    equal
                    first index byte-read second index byte-read == &&
                end
            end
            let index equal do equal end
        end
    end
end

proc read-source -- ptr int do
    max-source-bytes alloc
    let source do
        0 getc
        while dup 0 >= do
            let length byte do
                if length max-source-bytes >= do
                    "source exceeds max-source-bytes" fail
                end
                byte source length byte-write
                length 1 +
                getc
            end
        end
        drop
        source swap
    end
end

proc ctx-source ptr -- ptr do ctx-source-offset pointer-field-read end
proc ctx-source-length ptr -- int do ctx-source-length-offset field-read end
proc ctx-tokens ptr -- ptr do ctx-tokens-offset pointer-field-read end
proc ctx-token-count ptr -- int do ctx-token-count-offset field-read end
proc ctx-procs ptr -- ptr do ctx-procs-offset pointer-field-read end
proc ctx-proc-count ptr -- int do ctx-proc-count-offset field-read end
proc ctx-types ptr -- ptr do ctx-types-offset pointer-field-read end
proc ctx-type-count ptr -- int do ctx-type-count-offset field-read end
proc ctx-lex-index ptr -- int do ctx-lex-index-offset field-read end
proc ctx-lex-line ptr -- int do ctx-lex-line-offset field-read end
proc ctx-lex-column ptr -- int do ctx-lex-column-offset field-read end
proc ctx-main-proc ptr -- int do ctx-main-proc-offset field-read end
proc ctx-macros ptr -- ptr do ctx-macros-offset pointer-field-read end
proc ctx-macro-count ptr -- int do ctx-macro-count-offset field-read end
proc ctx-program ptr -- ptr do ctx-program-offset pointer-field-read end
proc ctx-module-id ptr -- int do ctx-module-id-offset field-read end
proc ctx-next-module ptr -- ptr do ctx-next-module-offset pointer-field-read end
proc ctx-canonical-path ptr -- ptr do ctx-canonical-path-offset pointer-field-read end
proc ctx-canonical-path-length ptr -- int do ctx-canonical-path-length-offset field-read end
proc ctx-imports ptr -- ptr do ctx-imports-offset pointer-field-read end
proc ctx-import-count ptr -- int do ctx-import-count-offset field-read end
proc ctx-scope ptr -- ptr do ctx-scope-offset pointer-field-read end
proc ctx-scope-count ptr -- int do ctx-scope-count-offset field-read end
proc ctx-load-state ptr -- int do ctx-load-state-offset field-read end
proc ctx-resolve-state ptr -- int do ctx-resolve-state-offset field-read end
proc ctx-is-root ptr -- bool do ctx-is-root-offset field-read 0 != end

proc set-ctx-source ptr ptr -- do ctx-source-offset pointer-field-write end
proc set-ctx-source-length int ptr -- do ctx-source-length-offset field-write end
proc set-ctx-tokens ptr ptr -- do ctx-tokens-offset pointer-field-write end
proc set-ctx-token-count int ptr -- do ctx-token-count-offset field-write end
proc set-ctx-procs ptr ptr -- do ctx-procs-offset pointer-field-write end
proc set-ctx-proc-count int ptr -- do ctx-proc-count-offset field-write end
proc set-ctx-types ptr ptr -- do ctx-types-offset pointer-field-write end
proc set-ctx-type-count int ptr -- do ctx-type-count-offset field-write end
proc set-ctx-lex-index int ptr -- do ctx-lex-index-offset field-write end
proc set-ctx-lex-line int ptr -- do ctx-lex-line-offset field-write end
proc set-ctx-lex-column int ptr -- do ctx-lex-column-offset field-write end
proc set-ctx-main-proc int ptr -- do ctx-main-proc-offset field-write end
proc set-ctx-macros ptr ptr -- do ctx-macros-offset pointer-field-write end
proc set-ctx-macro-count int ptr -- do ctx-macro-count-offset field-write end
proc set-ctx-program ptr ptr -- do ctx-program-offset pointer-field-write end
proc set-ctx-module-id int ptr -- do ctx-module-id-offset field-write end
proc set-ctx-next-module ptr ptr -- do ctx-next-module-offset pointer-field-write end
proc set-ctx-canonical-path ptr ptr -- do ctx-canonical-path-offset pointer-field-write end
proc set-ctx-canonical-path-length int ptr -- do ctx-canonical-path-length-offset field-write end
proc set-ctx-imports ptr ptr -- do ctx-imports-offset pointer-field-write end
proc set-ctx-import-count int ptr -- do ctx-import-count-offset field-write end
proc set-ctx-scope ptr ptr -- do ctx-scope-offset pointer-field-write end
proc set-ctx-scope-count int ptr -- do ctx-scope-count-offset field-write end
proc set-ctx-load-state int ptr -- do ctx-load-state-offset field-write end
proc set-ctx-resolve-state int ptr -- do ctx-resolve-state-offset field-write end
proc set-ctx-is-root bool ptr -- do
    let value ctx do
        if value do 1 else 0 end
        ctx ctx-is-root-offset field-write
    end
end

proc program-root-module ptr -- ptr do program-root-module-offset pointer-field-read end
proc program-module-head ptr -- ptr do program-module-head-offset pointer-field-read end
proc program-module-tail ptr -- ptr do program-module-tail-offset pointer-field-read end
proc program-module-count ptr -- int do program-module-count-offset field-read end
proc program-next-proc-id ptr -- int do program-next-proc-id-offset field-read end
proc program-token-count ptr -- int do program-token-count-offset field-read end

proc set-program-root-module ptr ptr -- do program-root-module-offset pointer-field-write end
proc set-program-module-head ptr ptr -- do program-module-head-offset pointer-field-write end
proc set-program-module-tail ptr ptr -- do program-module-tail-offset pointer-field-write end
proc set-program-module-count int ptr -- do program-module-count-offset field-write end
proc set-program-next-proc-id int ptr -- do program-next-proc-id-offset field-write end
proc set-program-token-count int ptr -- do program-token-count-offset field-write end

proc program-allocate-proc-id ptr -- int do
    let program do
        program program-next-proc-id
        let proc-id do
            proc-id 1 + program set-program-next-proc-id
            proc-id
        end
    end
end

proc program-add-module ptr ptr -- do
    let program module do
        program module set-ctx-program
        program program-module-count module set-ctx-module-id
        0 ptr cast module set-ctx-next-module
        if program program-module-count 0 == do
            module program set-program-module-head
        else
            module program program-module-tail set-ctx-next-module
        end
        module program set-program-module-tail
        program program-module-count 1 + program set-program-module-count
    end
end

proc token-address ptr int -- ptr do
    let ctx index do
        ctx ctx-tokens index token-bytes * +
    end
end

proc token-field ptr int int -- int do
    let ctx index offset do
        ctx index token-address offset field-read
    end
end

proc set-token-field int ptr int int -- do
    let value ctx index offset do
        value ctx index token-address offset field-write
    end
end

proc token-kind-at ptr int -- int do token-kind-offset token-field end
proc token-start-at ptr int -- int do token-start-offset token-field end
proc token-length-at ptr int -- int do token-length-offset token-field end
proc token-value-at ptr int -- int do token-value-offset token-field end
proc token-line-at ptr int -- int do token-line-offset token-field end
proc token-column-at ptr int -- int do token-column-offset token-field end

proc token-slice ptr int -- ptr int do
    let ctx index do
        ctx ctx-source
        ctx index token-start-at +
        ctx index token-length-at
    end
end

proc token-equals ptr int ptr int -- bool do
    let ctx index bytes length do
        ctx index token-slice bytes length bytes-equal
    end
end

proc add-token ptr int int int int int int -- do
    let ctx kind start length value line column do
        ctx ctx-token-count
        let index do
            kind ctx index token-kind-offset set-token-field
            start ctx index token-start-offset set-token-field
            length ctx index token-length-offset set-token-field
            value ctx index token-value-offset set-token-field
            line ctx index token-line-offset set-token-field
            column ctx index token-column-offset set-token-field
            index 1 + ctx set-ctx-token-count
        end
    end
end

proc source-byte ptr int -- int do
    let ctx index do
        ctx ctx-source index byte-read
    end
end

proc lex-advance ptr -- do
    let ctx do
        ctx ctx-lex-index
        let index do
            ctx index source-byte
            let byte do
                index 1 + ctx set-ctx-lex-index
                if byte 10 == do
                    ctx ctx-lex-line 1 + ctx set-ctx-lex-line
                    1 ctx set-ctx-lex-column
                else
                    ctx ctx-lex-column 1 + ctx set-ctx-lex-column
                end
            end
        end
    end
end

proc all-digits ptr int int -- bool do
    let source start length do
        0 true
        while
            let index valid do
                index valid
                index length < valid &&
            end
        do
            let index valid do
                index 1 +
                valid source start index + byte-read is-digit &&
            end
        end
        let index valid do
            valid length 0 > &&
        end
    end
end

proc parse-decimal ptr int int -- int do
    let source start length do
        0 0
        while
            let index value do
                index value index length <
            end
        do
            let index value do
                index 1 +
                value 10 * source start index + byte-read 48 - +
            end
        end
        let index value do value end
    end
end

proc classify-word ptr int int -- int int do
    let source start length do
        if source start + length "true" bytes-equal do
            token-bool 1
        elif source start + length "false" bytes-equal do
            token-bool 0
        elif source start length all-digits do
            token-int source start length parse-decimal
        else
            token-word 0
        end
    end
end

proc skip-comment ptr -- do
    let ctx do
        while
            ctx ctx-lex-index ctx ctx-source-length <
            if dup do
                drop ctx ctx ctx-lex-index source-byte 10 !=
            end
        do
            ctx lex-advance
        end
    end
end

proc lex-string ptr int int int -- do
    let ctx start line column do
        ctx lex-advance
        ctx ctx-lex-index
        let content-start do
            false
            while
                let done do
                    done done !
                    ctx ctx-lex-index ctx ctx-source-length < &&
                end
            do
                let done do
                    ctx ctx ctx-lex-index source-byte
                    let byte do
                        if byte 34 == do
                            true
                        else
                            if byte 10 == do
                                "unterminated string literal" fail
                            end
                            if byte 92 == do
                                ctx lex-advance
                                if ctx ctx-lex-index ctx ctx-source-length >= do
                                    "unterminated string escape" fail
                                end
                            end
                            ctx lex-advance
                            false
                        end
                    end
                end
            end
            drop
            if ctx ctx-lex-index ctx ctx-source-length >= do
                "unterminated string literal" fail
            end
            ctx ctx-lex-index content-start -
            let content-length do
                ctx token-string content-start content-length 0 line column add-token
            end
            ctx lex-advance
        end
    end
end

proc lex-character ptr int int int -- do
    let ctx start line column do
        ctx lex-advance
        if ctx ctx-lex-index ctx ctx-source-length >= do
            "unterminated character literal" fail
        end
        ctx ctx ctx-lex-index source-byte
        let value do
            ctx lex-advance
            if ctx ctx-lex-index ctx ctx-source-length >= do
                "unterminated character literal" fail
            end
            if ctx ctx ctx-lex-index source-byte 39 != do
                "character literal must contain one byte" fail
            end
            ctx lex-advance
            ctx token-char start 3 value line column add-token
        end
    end
end

proc lex-word ptr int int int -- do
    let ctx start line column do
        while
            ctx ctx-lex-index ctx ctx-source-length <
            if dup do
                drop ctx ctx ctx-lex-index source-byte is-space !
            end
        do
            ctx lex-advance
        end
        ctx ctx-lex-index start -
        let length do
            if ctx ctx-source start + length "//" bytes-equal do
                ctx skip-comment
            else
                ctx ctx-source start length classify-word
                let kind value do
                    ctx kind start length value line column add-token
                end
            end
        end
    end
end

proc lex ptr -- do
    let ctx do
        0 ctx set-ctx-token-count
        0 ctx set-ctx-lex-index
        1 ctx set-ctx-lex-line
        1 ctx set-ctx-lex-column

        while ctx ctx-lex-index ctx ctx-source-length < do
            ctx ctx ctx-lex-index source-byte
            let byte do
                if byte is-space do
                    ctx lex-advance
                else
                    ctx ctx-lex-index
                    ctx ctx-lex-line
                    ctx ctx-lex-column
                    let start line column do
                        if byte 34 == do
                            ctx start line column lex-string
                        else
                            if byte 39 == do
                                ctx start line column lex-character
                            else
                                ctx start line column lex-word
                            end
                        end
                    end
                end
            end
        end
    end
end

proc proc-address ptr int -- ptr do
    let ctx index do
        ctx ctx-procs index proc-bytes * +
    end
end

proc proc-field ptr int int -- int do
    let ctx index offset do
        ctx index proc-address offset field-read
    end
end

proc set-proc-field int ptr int int -- do
    let value ctx index offset do
        value ctx index proc-address offset field-write
    end
end

proc proc-name-start-at ptr int -- int do proc-name-start-offset proc-field end
proc proc-name-length-at ptr int -- int do proc-name-length-offset proc-field end
proc proc-body-start-at ptr int -- int do proc-body-start-offset proc-field end
proc proc-body-end-at ptr int -- int do proc-body-end-offset proc-field end
proc proc-input-start-at ptr int -- int do proc-input-start-offset proc-field end
proc proc-input-count-at ptr int -- int do proc-input-count-offset proc-field end
proc proc-output-start-at ptr int -- int do proc-output-start-offset proc-field end
proc proc-output-count-at ptr int -- int do proc-output-count-offset proc-field end
proc proc-index-at ptr int -- int do proc-index-offset proc-field end
proc proc-global-id-at ptr int -- int do proc-global-id-offset proc-field end

proc macro-address ptr int -- ptr do
    let ctx index do
        ctx ctx-macros index macro-bytes * +
    end
end

proc macro-field ptr int int -- int do
    let ctx index offset do
        ctx index macro-address offset field-read
    end
end

proc set-macro-field int ptr int int -- do
    let value ctx index offset do
        value ctx index macro-address offset field-write
    end
end

proc macro-name-start-at ptr int -- int do macro-name-start-offset macro-field end
proc macro-name-length-at ptr int -- int do macro-name-length-offset macro-field end
proc macro-body-start-at ptr int -- int do macro-body-start-offset macro-field end
proc macro-body-end-at ptr int -- int do macro-body-end-offset macro-field end
proc macro-expanding-at ptr int -- bool do macro-expanding-offset macro-field 0 != end

proc set-macro-expanding bool ptr int -- do
    let value ctx index do
        if value do 1 else 0 end
        ctx index macro-expanding-offset set-macro-field
    end
end

proc type-at ptr int -- int do
    let ctx index do
        ctx ctx-types index cell-bytes * field-read
    end
end

proc add-type ptr int -- do
    let ctx value do
        value ctx ctx-types ctx ctx-type-count cell-bytes * field-write
        ctx ctx-type-count 1 + ctx set-ctx-type-count
    end
end

proc require-word ptr int -- do
    let ctx token-index do
        if ctx token-index token-kind-at token-word != do
            "expected word token" fail
        end
    end
end

proc reserved-name ptr int -- bool do
    let ctx token-index do
        ctx token-index "proc" token-equals
        ctx token-index "macro" token-equals ||
        ctx token-index "if" token-equals ||
        ctx token-index "elif" token-equals ||
        ctx token-index "else" token-equals ||
        ctx token-index "while" token-equals ||
        ctx token-index "do" token-equals ||
        ctx token-index "end" token-equals ||
        ctx token-index "let" token-equals ||
        ctx token-index "from" token-equals ||
        ctx token-index "import" token-equals ||
        ctx token-index "as" token-equals ||
        ctx token-index "--" token-equals ||
    end
end

proc parse-type-token ptr int -- int do
    let ctx token-index do
        ctx token-index require-word
        if ctx token-index "int" token-equals do
            type-int
        elif ctx token-index "bool" token-equals do
            type-bool
        elif ctx token-index "ptr" token-equals do
            type-ptr
        else
            "unknown type in procedure signature" fail
            0
        end
    end
end

proc proc-name-equals-token ptr int int -- bool do
    let ctx proc-index token-index do
        ctx ctx-source
        ctx proc-index proc-name-start-at
        +
        ctx proc-index proc-name-length-at
        ctx token-index token-slice
        bytes-equal
    end
end

proc find-proc-from ptr int int -- int do
    let ctx token-index proc-index do
        if proc-index ctx ctx-proc-count >= do
            0 1 -
        elif ctx proc-index token-index proc-name-equals-token do
            proc-index
        else
            ctx token-index proc-index 1 + find-proc-from
        end
    end
end

proc find-proc ptr int -- int do
    0 find-proc-from
end

proc macro-name-equals-token ptr int int -- bool do
    let ctx macro-index token-index do
        ctx ctx-source
        ctx macro-index macro-name-start-at
        +
        ctx macro-index macro-name-length-at
        ctx token-index token-slice
        bytes-equal
    end
end

proc find-macro-from ptr int int -- int do
    let ctx token-index macro-index do
        if macro-index ctx ctx-macro-count >= do
            0 1 -
        elif ctx macro-index token-index macro-name-equals-token do
            macro-index
        else
            ctx token-index macro-index 1 + find-macro-from
        end
    end
end

proc find-macro ptr int -- int do
    0 find-macro-from
end

proc scan-macro-body ptr int -- int do
    let ctx body-start do
        body-start 0 true
        while
            let token-index depth active do
                token-index depth active active
            end
        do
            let token-index depth active do
                if token-index ctx ctx-token-count >= do
                    "unterminated macro body" fail
                    token-index depth false
                elif ctx token-index token-kind-at token-word == do
                    if ctx token-index "end" token-equals do
                        if depth 0 == do
                            token-index 1 + depth false
                        else
                            token-index 1 + depth 1 - true
                        end
                    elif
                        ctx token-index "if" token-equals
                        ctx token-index "while" token-equals ||
                        ctx token-index "let" token-equals ||
                    do
                        token-index 1 + depth 1 + true
                    elif
                        ctx token-index "from" token-equals
                        ctx token-index "import" token-equals ||
                    do
                        "imports are only allowed at top level" fail
                        token-index 1 + depth true
                    elif
                        ctx token-index "proc" token-equals
                        ctx token-index "macro" token-equals ||
                    do
                        "declarations are not allowed in macro bodies" fail
                        token-index 1 + depth true
                    else
                        token-index 1 + depth true
                    end
                else
                    token-index 1 + depth true
                end
            end
        end
        let next-token depth active do
