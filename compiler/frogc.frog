proc set-cc-root ptr ptr -- do cc-root-offset pointer-field-write end
proc set-cc-proc int ptr -- do cc-proc-offset field-write end
proc set-cc-type-stack ptr ptr -- do cc-type-stack-offset pointer-field-write end
