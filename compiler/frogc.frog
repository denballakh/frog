    end
end

proc function-proc-contracts-equal ModuleContext int ModuleContext int -- bool do
    peek function-module function-index proc-module proc-index do function-proc-inputs-equal
        function-module function-index proc-module proc-index function-proc-outputs-equal &&
    end
end

proc require-external-compatible-with-module ModuleContext int ModuleContext int -- do
    let ctx proc-index other limit do
        0
        while dup limit < do
            dup
            let other-index do
                if other other-index proc-external-at do
                    if ctx proc-index other other-index external-symbols-equal do
                        if ctx proc-index other other-index external-contracts-equal ! do
                            "incompatible declarations for C symbol" fail
                        end
                    end
                end
            end
            1 +
        end
        drop
    end
end

proc require-external-compatible-with-earlier ptr ModuleContext int -- do
    let program ctx proc-index do
        program @program-module-head
        while dup ptr cast int cast ctx ptr cast int cast != do
            dup
            let other do
                ctx proc-index other other @ModuleContext.proc_count require-external-compatible-with-module
            end
            @ModuleContext.next_module
        end
        drop
        ctx proc-index ctx proc-index require-external-compatible-with-module
    end
