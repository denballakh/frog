        cc @CompileContext.format_operation_frame_count 1 -
        peek index do index cc !CompileContext.format_operation_frame_count end
        cc swap format-operation-frame-at
        let frame do
            frame @FormatOperationFrame.source_module
              frame @FormatOperationFrame.token_start
                token-end
                  frame @FormatOperationFrame.before_count
                    frame @FormatOperationFrame.minimum_count
                      cc @CompileContext.type_count
            record-format-operation
