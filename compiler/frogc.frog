proc add-type ModuleContext* int -- do
    let ctx value do
        ctx ctx @ModuleContext.type_count c-signature-type-at
        let signature do
            false signature !CSignatureType.active
            0 signature !CSignatureType.token
            0 ptr cast ModuleContext* cast signature !CSignatureType.definition_module
            0 1 - signature !CSignatureType.definition_index
        end
        value ctx @ModuleContext.types ctx @ModuleContext.type_count cell-bytes * field-write
        ctx @ModuleContext.type_count 1 + ctx !ModuleContext.type_count
    end
end

proc add-c-signature-type ModuleContext* int -- do
    let ctx token do
        ctx type-none add-type
        ctx ctx @ModuleContext.type_count 1 - c-signature-type-at
        let signature do
            true signature !CSignatureType.active
            token signature !CSignatureType.token
        end
    end
end

proc require-word ModuleContext* int -- do
    let ctx token-index do
