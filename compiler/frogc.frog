proc ensure-constant-evaluator-capacity ConstantEvaluator* -- do
    let evaluator do
        if evaluator @ConstantEvaluator.count evaluator @ConstantEvaluator.capacity == do
            evaluator @ConstantEvaluator.capacity 2 *
            peek new-capacity do ConstantValue:sizeof * alloc
                let new-values do
                    evaluator @ConstantEvaluator.values
                    new-values
                    evaluator @ConstantEvaluator.count ConstantValue:sizeof *
                    memory-copy
                    new-values evaluator !ConstantEvaluator.values
                    new-capacity evaluator !ConstantEvaluator.capacity
                end
            end
        end
    end
end

proc constant-evaluator-push ConstantEvaluator* int int -- do
    let evaluator type payload do
        evaluator ensure-constant-evaluator-capacity
        type
        payload
        evaluator @ConstantEvaluator.values
        evaluator @ConstantEvaluator.count
        set-constant-value
        evaluator @ConstantEvaluator.count 1 + evaluator !ConstantEvaluator.count
    end
end

proc constant-evaluator-pop ConstantEvaluator* -- int int do
    let evaluator do
        if evaluator @ConstantEvaluator.count 0 <= do
            evaluator "constant expression stack underflow" constant-fail
        end
        evaluator @ConstantEvaluator.count 1 -
        peek index do evaluator !ConstantEvaluator.count
            evaluator @ConstantEvaluator.values index constant-value-at @ConstantValue.value_type
            evaluator @ConstantEvaluator.values index constant-value-at @ConstantValue.payload
        end
    end
end

proc constant-evaluator-pop-expected ConstantEvaluator* int -- int do
    let evaluator expected-type do
        evaluator constant-evaluator-pop
        let actual-type payload do
            if actual-type expected-type != do
                evaluator "constant expression type mismatch" constant-fail
            end
            payload
        end
    end
end

proc checked-constant-add ConstantEvaluator* int int -- int do
    let evaluator left right do
        if right 0 > do
            if left max-int right - > do
                evaluator "constant integer overflow" constant-fail
            end
        elif right 0 < do
            if left min-int right - < do
                evaluator "constant integer overflow" constant-fail
            end
        end
        left right +
    end
end

proc checked-constant-subtract ConstantEvaluator* int int -- int do
    let evaluator left right do
        if right 0 > do
            if left min-int right + < do
                evaluator "constant integer overflow" constant-fail
            end
        elif right 0 < do
            if left max-int right + > do
                evaluator "constant integer overflow" constant-fail
            end
        end
        left right -
    end
end

proc checked-constant-multiply ConstantEvaluator* int int -- int do
    let evaluator left right do
        if left 0 == right 0 == || do
            0
        else
            if
                left min-int == right 0 1 - == &&
                right min-int == left 0 1 - == && ||
            do
                evaluator "constant integer overflow" constant-fail
            end
            if left 0 > do
                if right 0 > do
                    if left max-int right / > do
                        evaluator "constant integer overflow" constant-fail
                    end
                else
                    if right min-int left / < do
                        evaluator "constant integer overflow" constant-fail
                    end
                end
            else
                if right 0 > do
                    if left min-int right / < do
                        evaluator "constant integer overflow" constant-fail
                    end
                else
                    if right max-int left / < do
                        evaluator "constant integer overflow" constant-fail
                    end
                end
            end
            left right *
        end
    end
end

proc require-constant-divisor ConstantEvaluator* int int -- do
    let evaluator left right do
        if right 0 == do
            evaluator "constant division by zero" constant-fail
        end
        if left min-int == right 0 1 - == && do
            evaluator "constant integer overflow" constant-fail
        end
    end
end

proc checked-constant-divide ConstantEvaluator* int int -- int do
    peek evaluator left right do require-constant-divisor
        left right /
    end
end

proc checked-constant-modulo ConstantEvaluator* int int -- int do
    peek evaluator left right do require-constant-divisor
        left right %
    end
end

proc require-constant-shift ConstantEvaluator* int int -- do
    let evaluator value count do
        if value 0 < count 0 < || count 63 >= || do
            evaluator "invalid shift in constant expression" constant-fail
        end
    end
end

proc checked-constant-shift-left ConstantEvaluator* int int -- int do
    peek evaluator value count do require-constant-shift
