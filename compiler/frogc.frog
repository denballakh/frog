proc emit-call-arguments-from CompileContext* ModuleContext* int int int -- do
    let cc ctx proc-index base input-index do
        if input-index ctx proc-index procedure-at @ProcedureEntry.input_count < do
            if input-index 0 != do ", " emit end
            cc base input-index +
            ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + type-at
            emit-slot-as
            cc ctx proc-index base input-index 1 + emit-call-arguments-from
        end
    end
end

proc emit-call-arguments CompileContext* ModuleContext* int int -- do
    peek cc ctx proc-index base do 0 emit-call-arguments-from end
end

proc emit-call-result-slots CompileContext* ModuleContext* int int int -- do
    let cc module proc-index base output-count do
        0
        while dup output-count < do
            dup
            let output-index do
                cc emit-indent
                cc base output-index +
                module module proc-index procedure-at @ProcedureEntry.output_start output-index + type-at
                emit-slot-as " = frog_call_result.value_" emit
                output-index emit-unsigned ";" emit 10 putc
            end
            1 +
        end
        drop
    end
end

proc emit-procedure-invocation CompileContext* ModuleContext* int int -- do
    let cc module proc-index base do
        module proc-index procedure-at @ProcedureEntry.output_count
        let output-count do
            if output-count 0 == do
                cc emit-indent
                module proc-index emit-proc-name
                "(" emit cc module proc-index base emit-call-arguments ");" emit 10 putc
            elif output-count 1 == do
                cc emit-indent cc base
                module module proc-index procedure-at @ProcedureEntry.output_start type-at
                emit-slot-as " = " emit
                module proc-index emit-proc-name
                "(" emit cc module proc-index base emit-call-arguments ");" emit 10 putc
            else
                cc emit-indent
                module @ModuleContext.types module proc-index procedure-at @ProcedureEntry.output_start cell-bytes * +
                output-count emit-result-type-name " frog_call_result = " emit
                module proc-index emit-proc-name
                "(" emit cc module proc-index base emit-call-arguments ");" emit 10 putc
                cc module proc-index base output-count emit-call-result-slots
            end
        end
    end
end

proc emit-call CompileContext* ModuleContext* int -- do
    let cc module proc-index do
        if cc @CompileContext.emitting do
            module proc-index procedure-at @ProcedureEntry.output_count
            let output-count do
                cc @CompileContext.type_count output-count -
                let base do
                    cc emit-indent "{" emit 10 putc
                    cc indent-more
                    cc module proc-index base emit-procedure-invocation
                    cc indent-less
                    cc emit-indent "}" emit 10 putc
                end
            end
        end
    end
end

proc emit-local-load CompileContext* int -- do
