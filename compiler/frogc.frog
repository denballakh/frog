            0 ptr cast ModuleContext* cast signature !CSignatureType.definition_module
            0 1 - signature !CSignatureType.definition_index
        end
        value ctx @ModuleContext.types ctx @ModuleContext.type_count cell-bytes * field-write
        ctx @ModuleContext.type_count 1 + ctx !ModuleContext.type_count
