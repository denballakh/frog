proc emit-ir-bind-locals CompileContext* ProcedureAnalysis* TypedInstruction* -- do
    let cc analysis instruction do
        if instruction @TypedInstruction.binding_local_count 0 <= do
            "internal empty typed binding at " emit-error
            instruction @TypedInstruction.source_module instruction @TypedInstruction.token_start token-slice emit-error-bytes
            10 eputc 1 exit
        end
        0
        while dup instruction @TypedInstruction.binding_local_count < do
            dup let offset do
                instruction @TypedInstruction.binding_local_count offset 1 + -
                let reverse-offset do
                    analysis instruction @TypedInstruction.binding_local_start reverse-offset + analyzed-binding-local-at
                    let local do
                        instruction @TypedInstruction.before_type_count reverse-offset 1 + -
                        let source-index do
                            cc emit-indent cc @CompileContext.program local @AnalyzedBindingLocal.value_type emit-c-value-type
                            " " emit local @AnalyzedBindingLocal.local_id emit-local-name " = " emit
                            cc source-index local @AnalyzedBindingLocal.value_type emit-slot-as ";" emit 10 putc
                            cc emit-indent "(void)" emit local @AnalyzedBindingLocal.local_id emit-local-name ";" emit 10 putc
                        end
                    end
                end
            end
            1 +
        end
        drop
    end
end

proc emit-ir-restore-peek-locals CompileContext* ProcedureAnalysis* TypedInstruction* -- do
    let cc analysis instruction do
        0
        while dup instruction @TypedInstruction.binding_local_count < do
            dup let offset do
                instruction @TypedInstruction.binding_local_count offset 1 + -
                let reverse-offset do
                    analysis instruction @TypedInstruction.binding_local_start reverse-offset + analyzed-binding-local-at
                    let local do
                    cc instruction @TypedInstruction.before_type_count offset + local @AnalyzedBindingLocal.value_type emit-slot-as
                    " = " emit local @AnalyzedBindingLocal.local_id emit-local-name ";" emit 10 putc
                    end
                end
            end
            1 +
        end
        drop
    end
end

proc emit-ir-record-field CompileContext* TypedInstruction* -- do
    let cc instruction do
        instruction @TypedInstruction.target_module instruction @TypedInstruction.target_index record-field-at
        let field do
            instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index record-type-at
                let record-entry do
                    instruction @TypedInstruction.target_index record-entry @RecordTypeEntry.field_start -
                    let field-offset do
                        instruction @TypedInstruction.operation
                        let operation do
                            if operation RuntimeOperation.record_field_read? do
                                instruction @TypedInstruction.after_type_count cc !CompileContext.type_count
                                cc record-entry field field-offset instruction @TypedInstruction.payload 0 != emit-record-field-read
                            elif instruction @TypedInstruction.payload 0 != do
                                instruction @TypedInstruction.after_type_count cc !CompileContext.type_count
                                cc record-entry field field-offset emit-record-pointer-field-write
                            else
                                instruction @TypedInstruction.after_type_count cc !CompileContext.type_count
                                cc record-entry field field-offset emit-record-value-field-write
                            end
                        end
                    end
            end
        end
    end
end

proc emit-ir-union CompileContext* TypedInstruction* -- do
    let cc instruction do
        instruction @TypedInstruction.secondary_module instruction @TypedInstruction.secondary_index
        let union-module union-index do
                instruction @TypedInstruction.operation
                let operation do
                    if operation RuntimeOperation.union_construct? do
                        cc instruction @TypedInstruction.payload instruction @TypedInstruction.secondary_type instruction @TypedInstruction.value_type emit-union-constructor
                    elif operation RuntimeOperation.union_test? do
                        cc instruction @TypedInstruction.value_type instruction @TypedInstruction.payload
                        union-module union-index union-type-at @UnionTypeEntry.case_count emit-union-predicate
                    else
                        cc instruction @TypedInstruction.value_type instruction @TypedInstruction.secondary_type instruction @TypedInstruction.payload
                        union-module union-index union-type-at @UnionTypeEntry.case_count emit-union-projection
                    end
                end
        end
    end
end

proc emit-ir-cast CompileContext* TypedInstruction* -- do
    let cc instruction do
        instruction @TypedInstruction.before_type_count 2 - let index do
            cc emit-indent cc index instruction @TypedInstruction.secondary_type emit-slot-as " = " emit
            if instruction @TypedInstruction.secondary_type instruction @TypedInstruction.value_type == do
                cc index instruction @TypedInstruction.value_type emit-slot-as
            elif instruction @TypedInstruction.secondary_type type-bool == do
                "(" emit cc index instruction @TypedInstruction.value_type emit-slot-as " != 0)" emit
            else
                "(" emit cc @CompileContext.program instruction @TypedInstruction.secondary_type emit-c-value-type ")" emit
                cc index instruction @TypedInstruction.value_type emit-slot-as
            end
            ";" emit 10 putc
        end
    end
end

proc emit-ir-simple-intrinsic CompileContext* TypedInstruction* -- do
    let cc instruction do
        instruction @TypedInstruction.operation let operation do
            if operation RuntimeOperation.args? do
                instruction @TypedInstruction.before_type_count let index do
                    cc emit-indent cc index type-ptr emit-slot-as " = (void *)frog_argv;" emit 10 putc
                    cc emit-indent cc index 1 + type-int emit-slot-as " = (intptr_t)frog_argc;" emit 10 putc
                end
            elif operation RuntimeOperation.print? do
                instruction @TypedInstruction.before_type_count 1 - let index do
                    if instruction @TypedInstruction.value_type type-int == do
                        cc emit-indent "printf(\"%lld\\n\", (long long)" emit cc index type-int emit-slot-as ");" emit 10 putc
                    else
                        cc emit-indent "fputs(" emit cc index type-bool emit-slot-as " ? \"true\\n\" : \"false\\n\", stdout);" emit 10 putc
                    end
                end
            elif operation RuntimeOperation.string_bytes? do
                instruction @TypedInstruction.before_type_count 1 - let index do
                    cc emit-indent cc index type-ptr emit-slot-as " = (void *)" emit cc index type-string emit-slot-as ".bytes;" emit 10 putc
                end
            elif operation RuntimeOperation.string_len? do
                instruction @TypedInstruction.before_type_count 1 - let index do
                    cc emit-indent cc index type-int emit-slot-as " = " emit cc index type-string emit-slot-as ".len;" emit 10 putc
                end
            elif operation RuntimeOperation.pointer_load? do cc instruction @TypedInstruction.value_type compile-generic-pointer-load drop
            elif operation RuntimeOperation.pointer_store? do cc instruction @TypedInstruction.value_type compile-generic-pointer-store drop
            elif operation RuntimeOperation.noop? do
            elif operation RuntimeOperation.builtins_assert_fail? do
                instruction @TypedInstruction.before_type_count 1 - let index do
                    cc emit-indent "{ FrogString value = " emit cc index type-string emit-slot-as
                    "; (void)fwrite(value.bytes, 1, (size_t)value.len, stderr); (void)fputc(10, stderr); exit(1); }" emit 10 putc
                end
            else "internal unsupported simple typed instruction" fail end
        end
    end
end

proc compile-if CompileContext* int -- do
    let cc token-index do
        cc BlockKind:conditional push-block drop
    end
end

proc compile-while CompileContext* int -- do
    let cc token-index do cc BlockKind:loop push-block
        let block do
            if cc cfg-recording do
                cc cc @CompileContext.defining_module token-index CFGTerminatorKind:jump 0 1 - 0 1 - finish-analyzed-block
                let preheader do
                    cc cc @CompileContext.defining_module token-index begin-analyzed-block
                    let header do
                        header block !BlockFrame.cfg_loop_header
                        cc preheader false header patch-analyzed-block-target
                    end
                end
            else
                0 1 - block !BlockFrame.cfg_loop_header
            end
        end
        cc "while (1) {" emit-line
        cc indent-more
    end
end

proc require-block-types CompileContext* BlockFrame* -- do
    let cc block do
        block @BlockFrame.base_types
        block @BlockFrame.base_count
        cc rot rot types-match
        let matches do
            if matches ! do
                cc "control-flow stack shape mismatch" fail-compile-word
            end
        end
    end
end

proc compile-do CompileContext* int -- do
    let cc token-index do cc top-block
        let block do
            if block @BlockFrame.has_do do
                cc "duplicate do in control-flow block" fail-compile-word
            end
            if cc @CompileContext.type_count block @BlockFrame.base_count <= do
                if block @BlockFrame.elif_parent do
                    cc "elif requires a condition before do" fail-compile-word
                else
                    cc "if or while requires a condition before do" fail-compile-word
                end
            end
            cc @CompileContext.type_count
            let condition-count do
                cc type-bool type-expect
                cc block require-block-types
                block @BlockFrame.kind
                let kind do
                if kind BlockKind:conditional == do
                    if cc cfg-recording do
                        cc cc @CompileContext.defining_module token-index CFGTerminatorKind:branch 0 1 - 0 1 -
                        cc @CompileContext.type_stack condition-count finish-analyzed-block-with-types
                        let condition-block do
                            cc cc @CompileContext.defining_module token-index 1 + condition-block
                            begin-analyzed-branch-target drop
                            condition-block block !BlockFrame.cfg_condition_block
                        end
                    end
                    cc @CompileContext.type_count
                    let condition-index do
                        if cc @CompileContext.emitting do
                            cc emit-indent "if (" emit cc condition-index emit-slot " != 0) {" emit 10 putc
                        end
                    end
                    cc indent-more
                else
                    if kind BlockKind:loop == do
                        if cc cfg-recording do
                            cc cc @CompileContext.defining_module token-index CFGTerminatorKind:branch 0 1 - 0 1 -
                            cc @CompileContext.type_stack condition-count finish-analyzed-block-with-types
                            let condition-block do
                                condition-block block !BlockFrame.cfg_condition_block
                                cc cc @CompileContext.defining_module token-index 1 + condition-block
                                begin-analyzed-branch-target drop
                            end
                        end
                        cc @CompileContext.type_count
                        let condition-index do
                            if cc @CompileContext.emitting do
                                cc emit-indent "if (" emit cc condition-index emit-slot " == 0) break;" emit 10 putc
                            end
                        end
                    else
                        cc "do does not close an if or while condition" fail-compile-word
                    end
                end
                end
                true block !BlockFrame.has_do
            end
        end
    end
end

proc compile-else CompileContext* int -- do
    let cc token-index do cc top-block
        let block do
            if block @BlockFrame.kind BlockKind:conditional != do
                cc "else outside if" fail-compile-word
            end
            if block @BlockFrame.has_else do
                cc "duplicate else" fail-compile-word
            end
            if block @BlockFrame.has_do ! do
                cc "else requires a preceding if arm and do" fail-compile-word
            end
            if block @BlockFrame.then_count 0 < do
                cc type-snapshot
                let then-types then-count do
                    then-types block !BlockFrame.then_types
                    then-count block !BlockFrame.then_count
                end
            elif cc block @BlockFrame.then_types block @BlockFrame.then_count types-match ! do
                cc "if branches leave different stack shapes" fail-compile-word
            end
            if cc cfg-recording do
                cc cc @CompileContext.defining_module token-index CFGTerminatorKind:jump 0 1 - 0 1 - finish-analyzed-block
                let arm-block do block arm-block append-pending-merge-source end
            end
            cc block @BlockFrame.base_types block @BlockFrame.base_count restore-type-snapshot
            if cc cfg-recording do
                cc cc @CompileContext.defining_module token-index 1 + begin-analyzed-block
                let else-block do
                    cc block @BlockFrame.cfg_condition_block true else-block patch-analyzed-block-target
                end
            end
            true block !BlockFrame.has_else
            cc indent-less
            cc "} else {" emit-line
            cc indent-more
        end
    end
end

proc append-pending-merge-source BlockFrame* int -- do
    let block source do
        block @BlockFrame.cfg_pending_merge_count 1 + cell-bytes * alloc
        let sources do
            block @BlockFrame.cfg_pending_merge_sources sources
            block @BlockFrame.cfg_pending_merge_count cell-bytes * bytes-copy
            source sources block @BlockFrame.cfg_pending_merge_count cell-bytes * + 0 field-write
            sources block !BlockFrame.cfg_pending_merge_sources
            block @BlockFrame.cfg_pending_merge_count 1 + block !BlockFrame.cfg_pending_merge_count
        end
    end
end

proc compile-elif CompileContext* int -- do
    let cc token-index do cc top-block
        let block do
            if block @BlockFrame.kind BlockKind:conditional != do
                cc "elif outside if" fail-compile-word
            end
            if block @BlockFrame.has_do ! do
                cc "elif requires a preceding if arm and do" fail-compile-word
            end
            if block @BlockFrame.has_else do
                cc "elif after else" fail-compile-word
            end
            block @BlockFrame.then_count 0 <
            let first-elif do
            cc token-index compile-else
            if first-elif do
                block @BlockFrame.then_types block @BlockFrame.then_count
            else
                block @BlockFrame.elif_result_types block @BlockFrame.elif_result_count
            end
            let result-types result-count do
            cc BlockKind:conditional push-block
            let nested do
                true nested !BlockFrame.elif_parent
                block @BlockFrame.then_types nested !BlockFrame.then_types
                block @BlockFrame.then_count nested !BlockFrame.then_count
                result-types nested !BlockFrame.elif_result_types
                result-count nested !BlockFrame.elif_result_count
                block @BlockFrame.cfg_pending_merge_sources nested !BlockFrame.cfg_pending_merge_sources
                block @BlockFrame.cfg_pending_merge_count nested !BlockFrame.cfg_pending_merge_count
                0 ptr cast block !BlockFrame.cfg_pending_merge_sources
                0 block !BlockFrame.cfg_pending_merge_count
            end
            end
            end
        end
    end
end

proc close-if-block CompileContext* BlockFrame* int -- do
    let cc block token-index do
        if block @BlockFrame.has_do ! do
            cc "if requires do before end" fail-compile-word
        end
        if block @BlockFrame.elif_parent do
            if cc block @BlockFrame.elif_result_types block @BlockFrame.elif_result_count types-match ! do
                cc "if branches leave different stack shapes" fail-compile-word
            end
            if block @BlockFrame.has_else ! do cc block require-block-types end
        elif block @BlockFrame.then_count 0 < do
            cc block require-block-types
        else
            block @BlockFrame.then_types
            block @BlockFrame.then_count
            let then-types then-count do
                if cc then-types then-count types-match ! do
                    cc "if branches leave different stack shapes" fail-compile-word
                end
            end
        end
        if cc cfg-recording do
            cc cc @CompileContext.defining_module token-index CFGTerminatorKind:jump 0 1 - 0 1 - finish-analyzed-block
            let final-arm do
                block final-arm append-pending-merge-source
                cc cc @CompileContext.defining_module token-index begin-analyzed-block
                let merge-block do
                    0
                    while dup block @BlockFrame.cfg_pending_merge_count < do
                        dup let index do
                            block @BlockFrame.cfg_pending_merge_sources index cell-bytes * + 0 field-read
                            let source do cc source false merge-block patch-analyzed-block-target end
                        end
                        1 +
                    end
                    drop
                    if block @BlockFrame.has_else ! do
                        cc block @BlockFrame.cfg_condition_block true merge-block patch-analyzed-block-target
                    end
                end
            end
        end
        cc indent-less
        cc "}" emit-line
    end
end

proc close-elif-parent-types CompileContext* BlockFrame* int -- do
    let cc block token-index do
        if block @BlockFrame.has_do ! do cc "if requires do before end" fail-compile-word end
        if block @BlockFrame.has_else ! do "internal elif parent without else" fail end
        cc indent-less
        cc "}" emit-line
        if block @BlockFrame.elif_parent do
            cc pop-block
            let parent do cc parent token-index close-elif-parent-types end
        end
    end
end

proc close-while-block CompileContext* BlockFrame* int -- do
    let cc block token-index do
        if block @BlockFrame.has_do ! do
            cc "while requires do before end" fail-compile-word
        end
        cc block require-block-types
        if cc cfg-recording do
            cc cc @CompileContext.defining_module token-index CFGTerminatorKind:jump block @BlockFrame.cfg_loop_header 0 1 - finish-analyzed-block drop
            cc cc @CompileContext.defining_module token-index begin-analyzed-block
            let exit-block do
                cc block @BlockFrame.cfg_condition_block true exit-block patch-analyzed-block-target
            end
        end
        cc indent-less
        cc "}" emit-line
    end
end

proc close-let-block CompileContext* BlockFrame* -- do
    let cc block do
        block @BlockFrame.local_base cc !CompileContext.local_count
        cc indent-less
        cc "}" emit-line
    end
end

proc close-end-chain CompileContext* BlockFrame* int -- do
    let cc block token-index do
        block @BlockFrame.kind
        let kind do
            if kind BlockKind:conditional == do
                cc block token-index close-if-block
            elif kind BlockKind:loop == do
                cc block token-index close-while-block
            elif kind BlockKind:local_scope == do
                cc block close-let-block
            else
                "unknown block kind" fail
            end
        end
        if block @BlockFrame.elif_parent do
            cc pop-block
            let parent do cc parent token-index close-elif-parent-types end
        end
    end
end

proc compile-end CompileContext* int -- do
    let cc token-index do cc pop-block
        let block do
            cc block token-index close-end-chain
        end
    end
end

proc find-binding-do CompileContext* int String -- int do
    let cc token-index error-message do
        if token-index cc @CompileContext.defining_module @ModuleContext.token_count >= do
            cc error-message fail-compile-word
            token-index
        elif cc @CompileContext.defining_module token-index "do" token-equals do
            token-index
        else
            cc @CompileContext.defining_module token-index require-word
            cc token-index 1 + error-message find-binding-do
        end
    end
end

proc bind-let-names CompileContext* int int -- do
    let cc first-token count do
        if count 0 > do
            first-token count 1 - +
            let name-token do
                if cc @CompileContext.defining_module name-token string-type-name do
                    cc "String cannot be a local name" fail-compile-word
                end
                cc type-pop
                let value-type do
                    cc name-token value-type add-local
                    let local-id do
                        cc cc cc @CompileContext.local_count 1 - local-address record-binding-local
                        if cc @CompileContext.emitting do
                            cc emit-indent
                            cc @CompileContext.program value-type emit-c-value-type
                            " " emit local-id emit-local-name " = " emit
                            cc cc @CompileContext.type_count value-type emit-slot-as ";" emit 10 putc
                            cc emit-indent
                            "(void)" emit local-id emit-local-name ";" emit 10 putc
                        end
                    end
                end
                cc first-token count 1 - bind-let-names
            end
        end
    end
end

proc begin-binding-block CompileContext* int int -- do
    let cc first-token name-count do
        cc BlockKind:local_scope push-block drop
        cc "{" emit-line
        cc indent-more
        cc first-token name-count bind-let-names
    end
end

proc restore-peek-names CompileContext* int int -- do
    let cc first-token name-count do
        if name-count 0 > do
            cc first-token find-local
            let local-index do
                if local-index 0 < do
                    "internal peek binding not found" fail
                end
                cc local-index local-address
                let local do
                    local @LocalEntry.value_type cc swap type-push
                    cc local @LocalEntry.id emit-local-load
                end
                cc first-token 1 + name-count 1 - restore-peek-names
            end
        end
    end
end

proc compile-let CompileContext* int -- int do
    peek cc let-token do 1 + "unterminated let binding" find-binding-do
        peek do-token do let-token 1 + -
            let name-count do
                if name-count 0 <= do
                    cc "let requires at least one name" fail-compile-word
                end
                cc let-token begin-typed-instruction
                cc OperationKind:let_binding set-operation-binding
                cc let-token 1 + name-count begin-binding-block
                cc do-token 1 + finish-typed-instruction
                do-token 1 +
            end
        end
    end
end

proc compile-peek CompileContext* int -- int do
    peek cc peek-token do 1 + "unterminated peek binding" find-binding-do
        peek do-token do peek-token 1 + -
            let name-count do
                if name-count 0 <= do
                    cc "peek requires at least one name" fail-compile-word
                end
                cc peek-token begin-typed-instruction
                cc OperationKind:peek_binding set-operation-binding
                cc peek-token 1 + name-count begin-binding-block
                cc do-token 1 + finish-typed-instruction
                cc peek-token begin-typed-instruction
                cc RuntimeOperation:restore_peek_locals set-typed-instruction
                let restore-instruction do
                    cc compile-context-analysis @ProcedureAnalysis.binding_local_count name-count -
                    restore-instruction !TypedInstruction.binding_local_start
                    name-count restore-instruction !TypedInstruction.binding_local_count
                end
                cc peek-token 1 + name-count restore-peek-names
                cc do-token 1 + finish-typed-instruction
                do-token 1 +
            end
        end
    end
end

proc compile-local-reference CompileContext* int int -- do
    let cc token-index local-index do
        cc local-index local-address
        peek local do
            cc local set-operation-local
            @LocalEntry.value_type cc swap type-push
            cc local @LocalEntry.id emit-local-load
        end
    end
end

proc compile-procedure-call CompileContext* int ModuleContext* int -- do
    let cc token-index module proc-index do
        cc OperationKind:procedure_call module proc-index set-operation-target
        cc module proc-index apply-proc-contract
        cc module proc-index emit-call
    end
end

