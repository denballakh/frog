        let kind do
            if kind TokenKind:int == kind TokenKind:char == || do
                evaluator type-int module token-index token-at @TokenEntry.value constant-evaluator-push
            elif kind TokenKind:bool == do
                evaluator type-bool module token-index token-at @TokenEntry.value constant-evaluator-push
            elif kind TokenKind:string == do
                evaluator type-string module token-index token-at @TokenEntry.value constant-evaluator-push
            elif kind TokenKind:word == do
                evaluator module token-index evaluate-constant-word
            else
                evaluator "unknown token kind" constant-fail
            end
        end
        if
            evaluator @ConstantEvaluator.format_operation_active
            module @ModuleContext.program program-failed ! &&
        do
            module token-index token-index 1 +
                  evaluator @ConstantEvaluator.format_operation_before
                    evaluator @ConstantEvaluator.format_operation_minimum
                      evaluator @ConstantEvaluator.count
            record-format-operation
        end
        false evaluator !ConstantEvaluator.format_operation_active
    end
end

