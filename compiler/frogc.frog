                                if count 1 > do
                                    cc "ambiguous function reference target" fail-compile-word
                                end
                                if count 0 == do
                                    cc @CompileContext.scope_module
                                      operation 4 +
                                        operation-length 4 -
                                        visible-procedure-definition
                                    let actual-module actual-index actual-found do
                                        if actual-found do
                                            cc function-module function-index actual-module actual-index
                                            fail-function-reference-contract
                                        else
                                            cc "function reference target not found" fail-compile-word
                                        end
                                    end
                                end
                                if cc @CompileContext.program program-failed do
                                    false
                                else
                                    cc OperationKind:function_reference function-module function-index set-operation-target
                                    cc proc-module proc-index set-operation-secondary-target
                                    cc proc-module proc-index procedure-at @ProcedureEntry.global_id set-operation-payload
                                    cc function-module function-index function-type-at @FunctionTypeEntry.function_type type-push
                                    cc proc-module proc-index procedure-at @ProcedureEntry.global_id emit-push-integer
                                    true
                                end
                            end
                        else
                            cc "unknown function operation" fail-compile-word
                            false
                        end
                    end
                end
            end
        end
    end
end

proc compile-function-word CompileContext* int -- bool do
    let cc token-index do
