proc emit-c-type-map Program* -- do
    let program do
        type-int "int" emit-c-type-map-fixed
        type-bool "bool" emit-c-type-map-fixed
        type-ptr "ptr" emit-c-type-map-fixed
        type-type "type" emit-c-type-map-fixed
        type-string "String" emit-c-type-map-fixed
        type-i8 "i8" emit-c-type-map-fixed
        type-i16 "i16" emit-c-type-map-fixed
        type-i32 "i32" emit-c-type-map-fixed
        type-i64 "i64" emit-c-type-map-fixed
        type-u8 "u8" emit-c-type-map-fixed
        type-u16 "u16" emit-c-type-map-fixed
        type-u32 "u32" emit-c-type-map-fixed
        type-u64 "u64" emit-c-type-map-fixed
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            let module do
                module 0 emit-c-type-map-records
                module 0 emit-c-type-map-unions
                module 0 emit-c-type-map-functions
                module @ModuleContext.next_module
            end
        end
        drop
        0
        while dup program @Program.pointer_type_count < do
            dup let index do
                program index pointer-type-at let entry do
                    "/* Frog type " emit entry @PointerTypeEntry.pointer_type emit-unsigned
                    " = pointer to Frog type " emit entry @PointerTypeEntry.pointee_type emit-unsigned " */\n" emit
                end
            end
            1 +
        end
        drop
    end
end

proc emit-result-type-name-from ptr int int -- do
    let types count index do
        if index count < do
            "_" emit types index cell-bytes * field-read emit-c-type-identity
            types count index 1 + emit-result-type-name-from
        end
    end
end

proc emit-result-type-name ptr int -- do
    let types count do "frog_results_" emit count emit-unsigned
        types count 0 emit-result-type-name-from
    end
end

proc result-type-at Program* int -- ResultTypeEntry* do
    let program index do program @Program.result_types index ResultTypeEntry:sizeof * + ResultTypeEntry* cast end
end

proc result-types-equal-from ptr ptr int int -- bool do
    let left right count index do
        if index count >= do true
        elif left index cell-bytes * field-read right index cell-bytes * field-read != do false
        else left right count index 1 + result-types-equal-from end
    end
end

proc find-result-type-from Program* ptr int int -- int do
    let program types count index do
        if index program @Program.result_type_count >= do 0 1 -
        elif
            program index result-type-at @ResultTypeEntry.count count ==
            program index result-type-at @ResultTypeEntry.types types count 0 result-types-equal-from &&
        do index
        else program types count index 1 + find-result-type-from end
    end
end

proc grow-result-types Program* -- do
    let program do
        program @Program.result_type_capacity 2 *
        let capacity do
            capacity ResultTypeEntry:sizeof * alloc
            let entries do
                program @Program.result_types entries program @Program.result_type_count ResultTypeEntry:sizeof * bytes-copy
                entries program !Program.result_types
                capacity program !Program.result_type_capacity
            end
        end
    end
end

proc register-result-type Program* ptr int -- do
    let program types count do
        if count 1 > do
            program types count 0 find-result-type-from
            let found do
                if found 0 < do
                    if program @Program.result_type_count program @Program.result_type_capacity == do program grow-result-types end
                    program @Program.result_type_count
                    let index do
                        types program index result-type-at !ResultTypeEntry.types
                        count program index result-type-at !ResultTypeEntry.count
                        index 1 + program !Program.result_type_count
                    end
                end
            end
        end
    end
end

proc collect-module-result-types Program* ModuleContext* -- do
    let program module do
        0
        while dup module @ModuleContext.proc_count < do
            dup let index do
                module @ModuleContext.types module index procedure-at @ProcedureEntry.output_start cell-bytes * +
                module index procedure-at @ProcedureEntry.output_count
                program rot rot register-result-type
            end
            1 +
        end
        drop
        0
        while dup module @ModuleContext.function_count < do
            dup let index do
                module @ModuleContext.function_types module index function-type-at @FunctionTypeEntry.output_start cell-bytes * +
                module index function-type-at @FunctionTypeEntry.output_count
                program rot rot register-result-type
            end
            1 +
        end
        drop
    end
end

proc collect-result-types Program* -- do
    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup program swap collect-module-result-types
            @ModuleContext.next_module
        end
        drop
    end
end

proc emit-result-fields Program* ptr int int -- do
    let program types count index do
        if index count < do
            " " emit program types index cell-bytes * field-read emit-c-value-type
            " value_" emit index emit-unsigned ";" emit
            program types count index 1 + emit-result-fields
        end
    end
end

proc emit-result-typedef Program* int -- do
    let program index do program index result-type-at let result do
        "typedef struct {" emit
        program result @ResultTypeEntry.types result @ResultTypeEntry.count 0 emit-result-fields
        " } " emit result @ResultTypeEntry.types result @ResultTypeEntry.count emit-result-type-name ";\n" emit
    end end
end

proc emit-result-typedefs Program* -- do
    let program do
        program collect-result-types
        0
        while dup program @Program.result_type_count < do
            dup program swap emit-result-typedef
            1 +
        end
        drop
    end
end

proc emit-proc-return-type ModuleContext* int -- do
    peek ctx proc-index do procedure-at @ProcedureEntry.output_count
        let output-count do
            if output-count 0 == do
                "void" emit
            elif output-count 1 == do
                ctx @ModuleContext.program
                ctx ctx proc-index procedure-at @ProcedureEntry.output_start type-at
                emit-c-value-type
            else
                ctx @ModuleContext.types ctx proc-index procedure-at @ProcedureEntry.output_start cell-bytes * +
                output-count emit-result-type-name
            end
        end
    end
end

proc emit-proc-argument-name int -- do
    "frog_arg_" emit emit-unsigned
end

proc emit-proc-parameters-from ModuleContext* int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index procedure-at @ProcedureEntry.input_count < do
            if input-index 0 != do ", " emit end
            ctx @ModuleContext.program
            ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + type-at
            emit-c-value-type
            " " emit input-index emit-proc-argument-name
            ctx proc-index input-index 1 + emit-proc-parameters-from
        end
    end
end

proc emit-proc-parameters ModuleContext* int -- do
    let ctx proc-index do
        if ctx proc-index procedure-at @ProcedureEntry.input_count 0 == do
            "void" emit
        else
            ctx proc-index 0 emit-proc-parameters-from
        end
    end
end

proc emit-proc-signature ModuleContext* int -- do
    peek ctx proc-index do emit-proc-return-type
        " " emit ctx proc-index emit-proc-name
        "(" emit ctx proc-index emit-proc-parameters ")" emit
    end
end

proc emit-c-prototype ModuleContext* int -- do
    let ctx proc-index do
        ctx proc-index emit-proc-signature ";\n" emit
    end
end

proc emit-prototypes ModuleContext* -- do
    let ctx do
        0
        while dup ctx @ModuleContext.proc_count < do
            dup
            let proc-index do
                ctx proc-index emit-c-prototype
            end
            1 +
        end
        drop
    end
end

proc emit-c-emitter-support Program* -- do
    let program do
        emit-c-preamble
        program emit-c-includes
        program emit-c-types
        program emit-c-record-forward-declarations
        program emit-c-union-forward-declarations
        program emit-c-aggregate-definitions
        program emit-c-type-map
        program emit-all-c-bindings
        emit-c-private-headers
        emit-c-runtime
        program emit-string-globals
        program emit-result-typedefs
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            dup emit-prototypes
            @ModuleContext.next_module
        end
        drop
    end
end

proc emit-decoded-string ModuleContext* int -- do
    let ctx token do
        0
        while dup ctx token decoded-string-length < do
            dup let index do ctx token index decoded-string-byte putc end
            1 +
        end
        drop
    end
end

proc emit-c-type-spelling ModuleContext* int -- do
    let ctx index do ctx index c-type-at @CTypeEntry.type_token ctx swap emit-decoded-string end
end

proc emit-c-includes-module ModuleContext* int -- do
    let ctx index do
        index
        while dup ctx @ModuleContext.c_include_count < do
            dup let include-index do
                ctx include-index c-include-at let entry do
                    "#include " emit
                    if entry @CIncludeEntry.kind CIncludeKind:system == do "<" emit else "\"" emit end
                    ctx entry @CIncludeEntry.token emit-decoded-string
                    if entry @CIncludeEntry.kind CIncludeKind:system == do ">\n" emit else "\"\n" emit end
                end
            end
            1 +
        end
        drop
    end
end

proc emit-c-includes Program* -- do
    let program do
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            dup 0 emit-c-includes-module
            @ModuleContext.next_module
        end
        drop
    end
end

proc emit-c-types-module ModuleContext* int -- do
    let ctx index do
        index
        while dup ctx @ModuleContext.c_type_count < do
            dup let type-index do
                "_Static_assert(sizeof(" emit ctx type-index emit-c-type-spelling ") <= sizeof(Cell), \"C FFI type exceeds Cell\");\n" emit
            end
            1 +
        end
        drop
    end
end

proc emit-c-types Program* -- do
    let program do program @Program.module_head
        while dup ptr cast int cast 0 != do dup 0 emit-c-types-module @ModuleContext.next_module end
        drop
    end
end
// END C EMITTER SUPPORT

// BEGIN BODY COMPILER
proc emit-uppercase-hex-digit int -- do
    let digit do
        if digit 10 < do
            digit 48 +
        else
            digit 10 - 65 +
        end
        putc
    end
end

proc emit-proc-name-byte int -- do
    let byte do
        if byte is-ascii-letter byte is-digit || byte '_' == || do
            byte putc
        elif byte '-' == byte ':' == || do
            '_' putc
        elif
            byte '!' ==
            byte '@' == ||
            byte '?' == ||
            byte '~' == ||
        do
        else
            '_' putc
            byte 16 / emit-uppercase-hex-digit
            byte 16 % emit-uppercase-hex-digit
        end
    end
end

proc emit-proc-source-name ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup
            let index do
                bytes index byte-read emit-proc-name-byte
            end
            1 +
        end
        drop
    end
end

proc emit-proc-name ModuleContext* int -- do
    let ctx proc-index do
        "frog_proc_" emit
        ctx proc-index procedure-at @ProcedureEntry.global_id emit-unsigned
        95 putc
        ctx @ModuleContext.source ctx proc-index procedure-at @ProcedureEntry.name_start +
        ctx proc-index procedure-at @ProcedureEntry.name_length
        emit-proc-source-name
    end
end

proc emit-local-name int -- do
    108 putc
    emit-unsigned
end

proc emit-slot-as CompileContext* int int -- do
    let cc index value-type do
        if cc index value-type find-stack-slot 0 < do
            "frogc: internal missing typed stack slot type " emit-error
            value-type emit-integer-error " at depth " emit-error index emit-integer-error
            " in " emit-error cc @CompileContext.diagnostic_module cc @CompileContext.diagnostic_token token-slice emit-error-bytes
            10 eputc 1 exit
        end
        "frog_value_" emit index emit-unsigned "_" emit
        if value-type 0 < do "n" emit 0 value-type - emit-unsigned else value-type emit-unsigned end
    end
end

proc emit-slot CompileContext* int -- do
    let cc index do cc index cc index type-at-depth emit-slot-as end
end

proc load-ir-before-types CompileContext* ProcedureAnalysis* TypedInstruction* -- do
    let cc analysis instruction do
        analysis @ProcedureAnalysis.operation_types instruction @TypedInstruction.before_type_start cell-bytes * +
        cc @CompileContext.type_stack instruction @TypedInstruction.before_type_count cell-bytes * bytes-copy
        instruction @TypedInstruction.before_type_count cc !CompileContext.type_count
    end
end

proc load-ir-after-types CompileContext* ProcedureAnalysis* TypedInstruction* -- do
    let cc analysis instruction do
        analysis @ProcedureAnalysis.operation_types instruction @TypedInstruction.after_type_start cell-bytes * +
        cc @CompileContext.type_stack instruction @TypedInstruction.after_type_count cell-bytes * bytes-copy
        instruction @TypedInstruction.after_type_count cc !CompileContext.type_count
    end
end

proc load-ir-block-exit-types CompileContext* ProcedureAnalysis* AnalyzedBlock* -- do
    let cc analysis block do
        analysis @ProcedureAnalysis.operation_types block @AnalyzedBlock.exit_type_start cell-bytes * +
        cc @CompileContext.type_stack block @AnalyzedBlock.exit_type_count cell-bytes * bytes-copy
        block @AnalyzedBlock.exit_type_count cc !CompileContext.type_count
    end
end

proc emit-top-slot CompileContext* -- do
    peek cc do cc @CompileContext.type_count 1 - emit-slot end
end

proc cc-range-matches-type-array-from CompileContext* int ptr int int int -- bool do
    let cc actual-start expected-values expected-start count index do
        if index count >= do
            true
        elif
            cc actual-start index + type-at-depth
            expected-values expected-start index + cell-bytes * field-read
            !=
        do
            false
        else
            cc actual-start expected-values expected-start count index 1 +
            cc-range-matches-type-array-from
        end
    end
end

proc proc-input-contract-matches CompileContext* ModuleContext* int -- bool do
    let cc module proc-index do
        module proc-index procedure-at @ProcedureEntry.input_count
        let input-count do
            if cc @CompileContext.type_count input-count < do
                false
            else
                cc
                cc @CompileContext.type_count input-count -
                module @ModuleContext.types
                module proc-index procedure-at @ProcedureEntry.input_start
                input-count 0
                cc-range-matches-type-array-from
            end
        end
    end
end

proc function-call-contract-matches CompileContext* ModuleContext* int -- bool do
    let cc module function-index do
        module function-index function-type-at @FunctionTypeEntry.input_count
        peek input-count do 1 +
            let expected-count do
                if cc @CompileContext.type_count expected-count < do
                    false
                else
                    cc @CompileContext.type_count expected-count -
                    let actual-start do
                        cc actual-start
                        module @ModuleContext.function_types
                        module function-index function-type-at @FunctionTypeEntry.input_start
                        input-count 0
                        cc-range-matches-type-array-from
                        cc actual-start input-count + type-at-depth
                        module function-index function-type-at @FunctionTypeEntry.function_type ==
                        &&
                    end
                end
            end
        end
    end
end

proc emit-error-cc-suffix CompileContext* int -- do
    let cc expected-count do
        cc @CompileContext.type_count expected-count -
        if dup 0 < do drop 0 end
        let start do
            cc @CompileContext.program cc @CompileContext.type_stack start cc @CompileContext.type_count start -
            emit-error-type-array
        end
    end
end

proc emit-error-proc-inputs Program* ModuleContext* int -- do
    let program module proc-index do
        program module @ModuleContext.types
        module proc-index procedure-at @ProcedureEntry.input_start
        module proc-index procedure-at @ProcedureEntry.input_count
        emit-error-type-array
    end
end

proc emit-error-proc-outputs Program* ModuleContext* int -- do
    let program module proc-index do
        program module @ModuleContext.types
        module proc-index procedure-at @ProcedureEntry.output_start
        module proc-index procedure-at @ProcedureEntry.output_count
        emit-error-type-array
    end
end

proc emit-error-proc-contract Program* ModuleContext* int -- do
    peek program module proc-index do emit-error-proc-inputs
        " -- " emit-error
        program module proc-index emit-error-proc-outputs
    end
end

proc emit-error-function-inputs Program* ModuleContext* int -- do
    let program module function-index do
        program module @ModuleContext.function_types
        module function-index function-type-at @FunctionTypeEntry.input_start
        module function-index function-type-at @FunctionTypeEntry.input_count
        emit-error-type-array
    end
end

proc emit-error-function-outputs Program* ModuleContext* int -- do
    let program module function-index do
        program module @ModuleContext.function_types
        module function-index function-type-at @FunctionTypeEntry.output_start
        module function-index function-type-at @FunctionTypeEntry.output_count
        emit-error-type-array
    end
end

proc emit-error-function-contract Program* ModuleContext* int -- do
    peek program module function-index do emit-error-function-inputs
        " -- " emit-error
        program module function-index emit-error-function-outputs
    end
end

proc emit-error-function-call-suffix Program* ModuleContext* int -- do
    let program module function-index do
        "[" emit-error
        program module @ModuleContext.function_types
        module function-index function-type-at @FunctionTypeEntry.input_start
        module function-index function-type-at @FunctionTypeEntry.input_count
        emit-error-type-array-items
        if module function-index function-type-at @FunctionTypeEntry.input_count 0 > do " " emit-error end
        program module function-index function-type-at @FunctionTypeEntry.function_type emit-error-type-name
        "]" emit-error
    end
end

proc fail-proc-input-contract CompileContext* ModuleContext* int -- do
    let cc module proc-index do
        cc emit-compile-word-error-prefix
        "stack contract mismatch: expected " emit-error
        cc @CompileContext.program module proc-index emit-error-proc-inputs
        ", actual " emit-error
        cc module proc-index procedure-at @ProcedureEntry.input_count emit-error-cc-suffix
        10 eputc
        1 exit
    end
end

proc fail-function-call-contract CompileContext* ModuleContext* int -- do
    let cc module function-index do
        cc emit-compile-word-error-prefix
        "stack contract mismatch: expected " emit-error
        cc @CompileContext.program module function-index emit-error-function-call-suffix
        ", actual " emit-error
        cc module function-index function-type-at @FunctionTypeEntry.input_count 1 + emit-error-cc-suffix
        10 eputc
        1 exit
    end
end

proc consume-types CompileContext* int -- do
    consume-type-count
end

proc push-proc-outputs CompileContext* ModuleContext* int int -- do
    let cc module proc-index output-index do
        if output-index module proc-index procedure-at @ProcedureEntry.output_count < do
            module
            module proc-index procedure-at @ProcedureEntry.output_start
            output-index +
            type-at
            cc swap type-push
            cc module proc-index output-index 1 + push-proc-outputs
        end
    end
end

proc apply-proc-contract CompileContext* ModuleContext* int -- do
    peek cc module proc-index do
        if cc module proc-index proc-input-contract-matches ! do
            cc module proc-index fail-proc-input-contract
        end
        procedure-at @ProcedureEntry.input_count consume-types
        cc module proc-index 0 push-proc-outputs
    end
end

proc push-function-outputs CompileContext* ModuleContext* int int -- do
    let cc module function-index output-index do
        if output-index module function-index function-type-at @FunctionTypeEntry.output_count < do
            module function-index output-index function-output-type-at
            cc swap type-push
            cc module function-index output-index 1 + push-function-outputs
        end
    end
end

proc apply-function-contract CompileContext* ModuleContext* int -- do
    peek cc module function-index do
        if cc module function-index function-call-contract-matches ! do
            cc module function-index fail-function-call-contract
        end
        function-type-at @FunctionTypeEntry.input_count 1 + consume-types
        cc module function-index 0 push-function-outputs
    end
end

proc type-is-nominal int -- bool do
    dup type-nominal-base >= swap type-function-base < &&
end
proc type-is-function int -- bool do
    dup type-function-base >= swap type-pointer-base < &&
end
proc type-is-integer int -- bool do
    let value-type do
        value-type type-int ==
        value-type type-i8 == ||
        value-type type-i16 == ||
        value-type type-i32 == ||
        value-type type-i64 == ||
        value-type type-u8 == ||
        value-type type-u16 == ||
        value-type type-u32 == ||
        value-type type-u64 == ||
    end
end
proc type-is-typed-pointer int -- bool do
    dup type-pointer-base >= swap unresolved-pointer-base < &&
end

union PrivateOperation
    case none
    case add
    case sub
    case mul
    case div
    case mod
    case divmod
    case or
    case and
    case xor
    case not
    case shl
    case shr
    case eq
    case ne
    case lt
    case gt
    case le
    case ge
    case load
    case store
end

proc == PrivateOperation PrivateOperation -- bool do
    let first second do
        first PrivateOperation.none? second PrivateOperation.none? &&
        first PrivateOperation.add? second PrivateOperation.add? && ||
        first PrivateOperation.sub? second PrivateOperation.sub? && ||
        first PrivateOperation.mul? second PrivateOperation.mul? && ||
        first PrivateOperation.div? second PrivateOperation.div? && ||
        first PrivateOperation.mod? second PrivateOperation.mod? && ||
        first PrivateOperation.divmod? second PrivateOperation.divmod? && ||
        first PrivateOperation.or? second PrivateOperation.or? && ||
        first PrivateOperation.and? second PrivateOperation.and? && ||
        first PrivateOperation.xor? second PrivateOperation.xor? && ||
        first PrivateOperation.not? second PrivateOperation.not? && ||
        first PrivateOperation.shl? second PrivateOperation.shl? && ||
        first PrivateOperation.shr? second PrivateOperation.shr? && ||
        first PrivateOperation.eq? second PrivateOperation.eq? && ||
        first PrivateOperation.ne? second PrivateOperation.ne? && ||
        first PrivateOperation.lt? second PrivateOperation.lt? && ||
        first PrivateOperation.gt? second PrivateOperation.gt? && ||
        first PrivateOperation.le? second PrivateOperation.le? && ||
        first PrivateOperation.ge? second PrivateOperation.ge? && ||
        first PrivateOperation.load? second PrivateOperation.load? && ||
        first PrivateOperation.store? second PrivateOperation.store? && ||
    end
end

proc != PrivateOperation PrivateOperation -- bool do == ! end

macro bytes-ends-with-string
    let bytes length suffix do
        suffix String.bytes suffix String.len
        let suffix-bytes suffix-length do
            if suffix-length length > do
                false
            else
                bytes length suffix-length - + suffix-length suffix-bytes suffix-length bytes-equal
            end
        end
    end
end

proc private-intrinsic-type ModuleContext* int -- int do
    let ctx token-index do
        ctx token-index token-slice
        let bytes length do
            if bytes length "_bool" bytes-ends-with-string do type-bool
            elif bytes length "_ptr" bytes-ends-with-string do type-ptr
            elif bytes length "_i8" bytes-ends-with-string do type-i8
            elif bytes length "_i16" bytes-ends-with-string do type-i16
            elif bytes length "_i32" bytes-ends-with-string do type-i32
            elif bytes length "_i64" bytes-ends-with-string do type-i64
            elif bytes length "_u8" bytes-ends-with-string do type-u8
            elif bytes length "_u16" bytes-ends-with-string do type-u16
            elif bytes length "_u32" bytes-ends-with-string do type-u32
            elif bytes length "_u64" bytes-ends-with-string do type-u64
            elif bytes length "_int" bytes-ends-with-string do type-int
            else type-none
            end
        end
    end
end

proc private-intrinsic-suffix-length int -- int do
    let value-type do
        if value-type type-bool == do 5
        elif value-type type-ptr == do 4
        elif value-type type-int == do 4
        elif value-type type-i8 == value-type type-u8 == || do 3
        else 4
        end
    end
end

proc private-intrinsic-operation ModuleContext* int int -- PrivateOperation do
    let ctx token-index value-type do
        ctx token-index token-slice
        let bytes length do
            length value-type private-intrinsic-suffix-length -
            let operation-length do
                if bytes operation-length "__intrinsic_add" bytes-equal-string do PrivateOperation:add
                elif bytes operation-length "__intrinsic_sub" bytes-equal-string do PrivateOperation:sub
                elif bytes operation-length "__intrinsic_mul" bytes-equal-string do PrivateOperation:mul
                elif bytes operation-length "__intrinsic_div" bytes-equal-string do PrivateOperation:div
                elif bytes operation-length "__intrinsic_mod" bytes-equal-string do PrivateOperation:mod
                elif bytes operation-length "__intrinsic_divmod" bytes-equal-string do PrivateOperation:divmod
                elif bytes operation-length "__intrinsic_or" bytes-equal-string do PrivateOperation:or
                elif bytes operation-length "__intrinsic_and" bytes-equal-string do PrivateOperation:and
                elif bytes operation-length "__intrinsic_xor" bytes-equal-string do PrivateOperation:xor
                elif bytes operation-length "__intrinsic_not" bytes-equal-string do PrivateOperation:not
                elif bytes operation-length "__intrinsic_shl" bytes-equal-string do PrivateOperation:shl
                elif bytes operation-length "__intrinsic_shr" bytes-equal-string do PrivateOperation:shr
                elif bytes operation-length "__intrinsic_eq" bytes-equal-string do PrivateOperation:eq
                elif bytes operation-length "__intrinsic_ne" bytes-equal-string do PrivateOperation:ne
                elif bytes operation-length "__intrinsic_lt" bytes-equal-string do PrivateOperation:lt
                elif bytes operation-length "__intrinsic_gt" bytes-equal-string do PrivateOperation:gt
                elif bytes operation-length "__intrinsic_le" bytes-equal-string do PrivateOperation:le
                elif bytes operation-length "__intrinsic_ge" bytes-equal-string do PrivateOperation:ge
                elif bytes operation-length "__intrinsic_load" bytes-equal-string do PrivateOperation:load
                elif bytes operation-length "__intrinsic_store" bytes-equal-string do PrivateOperation:store
                else PrivateOperation:none
                end
            end
        end
    end
end

proc private-operation-is-comparison PrivateOperation -- bool do
    let operation do
        operation PrivateOperation:eq == operation PrivateOperation:ne == ||
        operation PrivateOperation:lt == || operation PrivateOperation:gt == ||
        operation PrivateOperation:le == || operation PrivateOperation:ge == ||
    end
end

proc private-operation-is-integer-binary PrivateOperation -- bool do
    let operation do
        operation PrivateOperation:add == operation PrivateOperation:sub == ||
        operation PrivateOperation:mul == || operation PrivateOperation:div == ||
        operation PrivateOperation:mod == || operation PrivateOperation:or == ||
        operation PrivateOperation:and == || operation PrivateOperation:xor == ||
    end
end

proc private-operation-supported PrivateOperation int -- bool do
    let operation value-type do
        operation PrivateOperation:load == operation PrivateOperation:store == ||
        value-type type-is-integer operation PrivateOperation:not == && ||
        value-type type-is-integer operation PrivateOperation:shl == operation PrivateOperation:shr == || && ||
        value-type type-is-integer operation PrivateOperation:divmod == && ||
        value-type type-is-integer operation private-operation-is-comparison && ||
        value-type type-is-integer operation private-operation-is-integer-binary && ||
        value-type type-bool == operation PrivateOperation:not == && ||
        value-type type-bool == operation PrivateOperation:and == operation PrivateOperation:or == || && ||
        value-type type-ptr == operation PrivateOperation:add == operation PrivateOperation:sub == || && ||
        value-type type-ptr == operation PrivateOperation:eq == operation PrivateOperation:ne == || && ||
    end
end

proc emit-private-operation PrivateOperation -- do
    let operation do
        if operation PrivateOperation:add == do "add" emit
        elif operation PrivateOperation:sub == do "sub" emit
        elif operation PrivateOperation:mul == do "mul" emit
        elif operation PrivateOperation:div == do "div" emit
        elif operation PrivateOperation:mod == do "mod" emit
        elif operation PrivateOperation:divmod == do "divmod" emit
        elif operation PrivateOperation:or == do "or" emit
        elif operation PrivateOperation:and == do "and" emit
        elif operation PrivateOperation:xor == do "xor" emit
        elif operation PrivateOperation:not == do "not" emit
        elif operation PrivateOperation:shl == do "shl" emit
        elif operation PrivateOperation:shr == do "shr" emit
        elif operation PrivateOperation:eq == do "eq" emit
        elif operation PrivateOperation:ne == do "ne" emit
        elif operation PrivateOperation:lt == do "lt" emit
        elif operation PrivateOperation:gt == do "gt" emit
        elif operation PrivateOperation:le == do "le" emit
        elif operation PrivateOperation:ge == do "ge" emit
        elif operation PrivateOperation:load == do "load" emit
        else "store" emit
        end
    end
end

proc emit-private-helper PrivateOperation int -- do
    let operation value-type do
        "frog_" emit operation emit-private-operation "_" emit value-type emit-c-type-identity
    end
end

proc emit-ir-private-instruction CompileContext* TypedInstruction* -- do
    let cc instruction do
        instruction @TypedInstruction.private_operation let operation do
        instruction @TypedInstruction.value_type let value-type do
            if operation PrivateOperation.load? do cc value-type compile-private-load
            elif operation PrivateOperation.store? do cc value-type compile-private-store
            elif operation PrivateOperation.not? do cc operation value-type value-type compile-private-unary
            elif operation PrivateOperation.shl? operation PrivateOperation.shr? || do cc operation value-type compile-private-shift
            elif operation PrivateOperation.divmod? do cc value-type compile-private-divmod
            elif operation private-operation-is-comparison do cc operation value-type type-bool compile-private-binary
            elif value-type type-ptr == operation PrivateOperation.add? operation PrivateOperation.sub? || && do cc operation compile-private-pointer-arithmetic
            else cc operation value-type value-type compile-private-binary
            end
        end
        end
    end
end

proc compile-private-binary CompileContext* PrivateOperation int int -- do
    let cc operation input-type output-type do
        cc input-type type-expect cc input-type type-expect cc output-type type-push
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 - let left-index do
                cc @CompileContext.type_count let right-index do
                    cc emit-indent cc left-index output-type emit-slot-as " = " emit
                    operation input-type emit-private-helper "(" emit
                    cc left-index input-type emit-slot-as ", " emit cc right-index input-type emit-slot-as ");\n" emit
                end
            end
        end
    end
end

proc compile-private-unary CompileContext* PrivateOperation int int -- do
    let cc operation input-type output-type do
        cc input-type type-expect cc output-type type-push
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 - let index do
                cc emit-indent cc index output-type emit-slot-as " = " emit operation input-type emit-private-helper
                "(" emit cc index input-type emit-slot-as ");\n" emit
            end
        end
    end
end

proc compile-private-load CompileContext* int -- do
    let cc value-type do
        cc cc @CompileContext.program value-type program-intern-pointer-type type-expect
        cc value-type register-replaced-stack-slot cc value-type type-push
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 - let index do
                cc emit-indent cc index value-type emit-slot-as " = " emit PrivateOperation:load value-type emit-private-helper
                "((const void *)" emit cc index cc @CompileContext.program value-type program-intern-pointer-type emit-slot-as ");\n" emit
            end
        end
    end
end

proc compile-private-shift CompileContext* PrivateOperation int -- do
    let cc operation value-type do
        cc type-u32 type-expect cc value-type type-expect cc value-type type-push
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 - let left-index do
                cc @CompileContext.type_count let right-index do
                    cc emit-indent cc left-index value-type emit-slot-as " = " emit operation value-type emit-private-helper
                    "(" emit cc left-index value-type emit-slot-as ", " emit cc right-index type-u32 emit-slot-as ");\n" emit
                end
            end
        end
    end
end

proc compile-private-pointer-arithmetic CompileContext* PrivateOperation -- do
    let cc operation do
        cc type-int type-expect cc type-ptr type-expect cc type-ptr type-push
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 - let left-index do
                cc @CompileContext.type_count let right-index do
                    cc emit-indent cc left-index type-ptr emit-slot-as " = " emit operation type-ptr emit-private-helper
                    "(" emit cc left-index type-ptr emit-slot-as ", " emit cc right-index type-int emit-slot-as ");\n" emit
                end
            end
        end
    end
end

proc compile-private-divmod CompileContext* int -- do
    let cc value-type do
        cc value-type type-expect cc value-type type-expect
        cc value-type type-push cc value-type type-push
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 2 - let left-index do
                cc @CompileContext.type_count 1 - let right-index do
                    cc emit-indent "{ " emit PrivateOperation:divmod value-type emit-private-helper "_result result = " emit
                    PrivateOperation:divmod value-type emit-private-helper "(" emit cc left-index value-type emit-slot-as ", " emit
                    cc right-index value-type emit-slot-as "); " emit
                    cc left-index value-type emit-slot-as " = result.quotient; " emit
                    cc right-index value-type emit-slot-as " = result.remainder; }\n" emit
                end
            end
        end
    end
end

proc compile-private-store CompileContext* int -- do
    let cc value-type do
        cc cc @CompileContext.program value-type program-intern-pointer-type type-expect
        cc value-type type-expect
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count let value-index do
                cc @CompileContext.type_count 1 +
                let pointer-index do
                    cc emit-indent PrivateOperation:store value-type emit-private-helper "((void *)" emit
                    cc pointer-index cc @CompileContext.program value-type program-intern-pointer-type emit-slot-as
                    ", " emit cc value-index value-type emit-slot-as ");\n" emit
                end
            end
        end
    end
end

proc compile-private-intrinsic CompileContext* int -- bool do
    let cc token-index do
        if
            cc @CompileContext.procedure_module ptr cast int cast
            cc @CompileContext.program @Program.builtins_module ptr cast int cast
            !=
        do
            false
        elif cc @CompileContext.defining_module token-index token-slice "__intrinsic_" bytes-starts-with-string ! do
            false
        else
            cc @CompileContext.defining_module token-index private-intrinsic-type
            let value-type do
                if value-type type-none == do false else
                    cc @CompileContext.defining_module token-index value-type private-intrinsic-operation
                    let operation do
                        if operation PrivateOperation:none == do false
                        elif operation value-type private-operation-supported do
                            cc IntrinsicOperation:private value-type operation set-operation-intrinsic
                            if operation PrivateOperation:load == do cc value-type compile-private-load true
                        elif operation PrivateOperation:store == do cc value-type compile-private-store true
                        elif value-type type-is-integer do
                            if operation PrivateOperation:not == do cc operation value-type value-type compile-private-unary true
                            elif operation PrivateOperation:shl == operation PrivateOperation:shr == || do cc operation value-type compile-private-shift true
                            elif operation PrivateOperation:divmod == do cc value-type compile-private-divmod true
                            elif operation private-operation-is-comparison do cc operation value-type type-bool compile-private-binary true
                            elif operation private-operation-is-integer-binary do cc operation value-type value-type compile-private-binary true
                            else false end
                        elif value-type type-bool == do
                            if operation PrivateOperation:not == do cc operation type-bool type-bool compile-private-unary true
                            elif operation PrivateOperation:and == operation PrivateOperation:or == || do cc operation type-bool type-bool compile-private-binary true
                            else false end
                        elif value-type type-ptr == do
                            if operation PrivateOperation:add == operation PrivateOperation:sub == || do cc operation compile-private-pointer-arithmetic true
                            elif operation PrivateOperation:eq == operation PrivateOperation:ne == || do cc operation type-ptr type-bool compile-private-binary true
                            else false end
                        else false end
                        else false end
                    end
                end
            end
        end
    end
end

proc type-is-cast-target int -- bool do
    let value-type do
        value-type type-is-integer
        value-type type-bool == ||
        value-type type-ptr == ||
        value-type type-string == ||
        value-type type-is-nominal ||
        value-type type-is-function ||
        value-type type-is-typed-pointer ||
    end
end

proc compile-primitive-type-literal CompileContext* int -- bool do
    let cc value-type do
        cc OperationKind:type_literal value-type set-operation-type
        type-literal-base value-type +
        let literal-type do
            cc literal-type set-operation-payload
            cc literal-type type-push
            cc literal-type emit-push-integer
            true
        end
    end
end

proc compile-cast-intrinsic CompileContext* -- do
    peek cc do type-pop
        cc type-pop
        let target-literal source-type do
            if target-literal 0 < do
                0 target-literal -
            else
                target-literal type-literal-base -
            end
            let target-type do
                if cc @CompileContext.instruction_active do
                    source-type cc active-typed-instruction !TypedInstruction.value_type
                    target-type cc active-typed-instruction !TypedInstruction.secondary_type
                end
                if target-type type-is-cast-target ! do
                    cc "cast target is not a type literal" fail-compile-word
                end
                if
                    source-type target-type ==
                    source-type type-is-integer target-type type-is-integer && ||
                    source-type type-int == target-type type-bool == && ||
                    source-type type-bool == target-type type-int == && ||
                    source-type type-int == target-type type-ptr == && ||
                    source-type type-ptr == target-type type-int == && ||
                    source-type type-ptr == target-type type-is-typed-pointer && ||
                    source-type type-is-typed-pointer target-type type-ptr == && ||
                    !
                do
                    cc "unsupported cast" fail-compile-word
                end
                cc target-type register-replaced-stack-slot
                cc target-type type-push
                if cc @CompileContext.emitting do
                    cc @CompileContext.type_count 1 -
                    let index do
                        cc emit-indent cc index target-type emit-slot-as " = " emit
                        if target-type source-type == do cc index source-type emit-slot-as
                        elif target-type type-bool == do "(" emit cc index source-type emit-slot-as " != 0)" emit
                        else "(" emit cc @CompileContext.program target-type emit-c-value-type ")" emit cc index source-type emit-slot-as end
                        ";" emit 10 putc
                    end
                end
            end
        end
    end
end

proc compile-memory-io-intrinsic CompileContext* int -- bool do
    let cc token-index do
        if cc @CompileContext.defining_module token-index "cast" token-equals do
            cc IntrinsicOperation:cast type-none PrivateOperation:none set-operation-intrinsic
            cc compile-cast-intrinsic true
        elif cc @CompileContext.defining_module token-index "args" token-equals do
            cc IntrinsicOperation:args type-none PrivateOperation:none set-operation-intrinsic
            cc type-ptr type-push
            cc type-int type-push
            if cc @CompileContext.emitting do
                cc @CompileContext.type_count 2 -
                let argv-index do
                    cc emit-indent cc argv-index type-ptr emit-slot-as " = (void *)frog_argv;" emit 10 putc
                    cc emit-indent cc argv-index 1 + type-int emit-slot-as " = (intptr_t)frog_argc;" emit 10 putc
                end
            end
            true
        elif cc @CompileContext.defining_module token-index "print" token-equals do
            cc type-pop
            let value-type do
                cc IntrinsicOperation:print value-type PrivateOperation:none set-operation-intrinsic
                if value-type type-int == do
                    if cc @CompileContext.emitting do
                        cc emit-indent "printf(\"%lld\\n\", (long long)" emit
                        cc cc @CompileContext.type_count value-type emit-slot-as ");" emit 10 putc
                    end
                elif value-type type-bool == do
                    if cc @CompileContext.emitting do
                        cc emit-indent "fputs(" emit cc cc @CompileContext.type_count value-type emit-slot-as
                        " ? \"true\\n\" : \"false\\n\", stdout);" emit 10 putc
                    end
                else
                    cc "printing this type is not supported" fail-compile-word
                end
            end
            true
        elif cc @CompileContext.defining_module token-index "?" token-equals do
            cc IntrinsicOperation:noop type-none PrivateOperation:none set-operation-intrinsic
            true
        else
            false
        end
    end
end

proc compile-generic-pointer-load CompileContext* int -- bool do
    let cc pointer-type do
        if pointer-type type-is-typed-pointer ! do
            false
        else
            cc @CompileContext.program pointer-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type
            let value-type do
                cc pointer-type type-expect
                cc value-type type-push
                if cc @CompileContext.emitting do
                    cc @CompileContext.type_count 1 -
                    let index do
                        cc emit-indent "memcpy(&" emit cc index value-type emit-slot-as ", (const void *)" emit
                        cc index pointer-type emit-slot-as ", sizeof(" emit cc index value-type emit-slot-as "));" emit 10 putc
                    end
                end
                true
            end
        end
    end
end

proc compile-generic-pointer-store CompileContext* int -- bool do
    let cc pointer-type do
        if pointer-type type-is-typed-pointer ! do
            false
        else
            cc @CompileContext.program pointer-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type
            let value-type do
                cc pointer-type type-expect
                cc value-type type-expect
                if cc @CompileContext.emitting do
                    cc @CompileContext.type_count
                    let value-index do
                        cc @CompileContext.type_count 1 +
                        let pointer-index do
                            cc emit-indent "memcpy((void *)" emit cc pointer-index pointer-type emit-slot-as ", &" emit
                            cc value-index value-type emit-slot-as ", sizeof(" emit cc value-index value-type emit-slot-as "));" emit 10 putc
                        end
                    end
                end
                true
            end
        end
    end
end

proc compile-generic-pointer-memory CompileContext* int -- bool do
    let cc token-index do
        if cc @CompileContext.type_count 0 <= do
            false
        else
            cc cc @CompileContext.type_count 1 - type-at-depth
            let pointer-type do
                if cc @CompileContext.defining_module token-index "@" token-equals do
                    cc pointer-type compile-generic-pointer-load
                    peek success do
                        if success do cc IntrinsicOperation:pointer_load pointer-type PrivateOperation:none set-operation-intrinsic end
                    end
                elif cc @CompileContext.defining_module token-index "!" token-equals do
                    cc pointer-type compile-generic-pointer-store
                    peek success do
                        if success do cc IntrinsicOperation:pointer_store pointer-type PrivateOperation:none set-operation-intrinsic end
                    end
                else
                    false
                end
            end
        end
    end
end

