proc resolve-nominal-type-token ModuleContext int String -- int do
    let ctx token-index error-message do
        ctx ctx token-index find-scope-symbol
        let symbol-index do
            if symbol-index 0 < do
                error-message fail
                0
            else
                ctx symbol-index scope-at @ScopeEntry.kind
                let kind do
                    if kind scope-record == do
                        ctx symbol-index scope-at @ScopeEntry.definition_module
                        ctx symbol-index scope-at @ScopeEntry.definition_index
                        record-type-at
                    elif kind scope-union == do
                        ctx symbol-index scope-at @ScopeEntry.definition_module
                        ctx symbol-index scope-at @ScopeEntry.definition_index
                        union-type-at
                    elif kind scope-function == do
                        ctx symbol-index scope-at @ScopeEntry.definition_module
                        ctx symbol-index scope-at @ScopeEntry.definition_index
                        function-type-at
                    else
                        error-message fail
                        0
                    end
                end
            end
        end
    end
end

