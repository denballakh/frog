                    cc union-index union-type emit-slot-as "; Cell union_tag = frog_union_tag(union_value, " emit
                    case-count emit-unsigned "); " emit cc result-index type-bool emit-slot-as " = union_tag == " emit
                    tag emit-unsigned "; }" emit 10 putc
                end
            end
        end
    end
end

proc emit-union-projection CompileContext* int int int int -- do
    let cc union-type payload-type tag case-count do
        if cc @CompileContext.emitting do
            if payload-type type-none != do cc @CompileContext.type_count 1 - else cc @CompileContext.type_count end
            let value-index do
                cc emit-indent "{ const unsigned char *union_value = (const unsigned char *)(intptr_t)" emit
                cc value-index union-type emit-slot-as "; if (frog_union_tag(union_value, " emit
                case-count emit-unsigned
                ") != " emit
                tag emit-unsigned
                ") frog_runtime_fail();" emit
                if payload-type type-none != do
                    " " emit cc value-index payload-type emit-slot-as " = " emit
                    if payload-type type-ptr == payload-type type-is-typed-pointer || do
                        "(" emit cc @CompileContext.program payload-type emit-c-value-type ")(intptr_t)" emit
                    elif payload-type type-bool == do "(bool)" emit
                    elif payload-type type-is-integer do "(" emit cc @CompileContext.program payload-type emit-c-value-type ")" emit
                    end
                    "frog_read_i64(union_value + " emit
                    union-payload-offset emit-unsigned
                    ");" emit
                end
                " }" emit
                10 putc
            end
        end
    end
end

proc compile-union-constructor CompileContext* ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @CompileContext.scope_module bytes separator visible-union-definition
            let module union-index found do
                if found ! do
                    false
