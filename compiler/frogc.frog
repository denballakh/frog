            name 1 + let frog-token do
                if frog-token ctx @ModuleContext.token_count >= do "expected C type representation" fail end
                if ctx frog-token "int" token-equals do type-int
                elif ctx frog-token "bool" token-equals do type-bool
                elif ctx frog-token "ptr" token-equals do type-ptr
