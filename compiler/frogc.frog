proc visible-builtin-procedure-matches-from CompileContext* ModuleContext* ModuleContext* ptr int int -- ModuleContext* int int bool do
    let cc visible-scope builtins bytes length scope-index do
        if scope-index builtins @ModuleContext.scope_count >= do
            0 ptr cast ModuleContext* cast 0 1 - 0 false
        else
            cc visible-scope builtins bytes length scope-index 1 + visible-builtin-procedure-matches-from
            let selected-module selected-index count found do
                builtins scope-index scope-at
                let symbol do
                    if
                        symbol @ScopeEntry.kind ScopeKind:procedure ==
                        builtins scope-index bytes length scope-name-equals &&
                          symbol @ScopeEntry.definition_module symbol @ScopeEntry.definition_index
                        procedure-at @ProcedureEntry.c_binding CBinding:none == &&
                          cc symbol @ScopeEntry.definition_module symbol @ScopeEntry.definition_index
                        proc-input-contract-matches &&
                          visible-scope bytes length
                                symbol @ScopeEntry.definition_module symbol @ScopeEntry.definition_index
                        scope-has-procedure-inputs ! &&
