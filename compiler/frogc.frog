end

proc emit-c-abi-type int -- do
    let value-type do
        if value-type type-int == do
            "int" emit
        elif value-type type-bool == do
            "int" emit
        elif value-type type-ptr == do
            "void *" emit
        else
            "internal unknown C ABI type" fail
        end
    end
end

proc emit-c-symbol ModuleContext int -- do
