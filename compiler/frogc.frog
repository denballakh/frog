proc set-compile-occurrence-binding-part-in CompileContext* int int int int ScopeKind ModuleContext* int ModuleContext* -- bool do
    let cc occurrence-index token relative-start length kind definition-module definition-index scope do
        cc @CompileContext.defining_module @ModuleContext.source
        cc @CompileContext.defining_module token token-at @TokenEntry.start + relative-start +
        let bytes do
            scope bytes length kind definition-module definition-index 0 find-scope-binding-identity-bytes-from
            let scope-index do
                if scope-index 0 < do
                    false
                else
                    scope cc @CompileContext.program occurrence-index semantic-occurrence-at !SemanticOccurrence.binding_module
                    scope-index cc @CompileContext.program occurrence-index semantic-occurrence-at !SemanticOccurrence.binding_scope_index
                    true
                end
