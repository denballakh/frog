proc valid-block-source-range AnalyzedBlock* -- bool do
    let block do
        if block @AnalyzedBlock.source_module ptr cast int cast 0 == do false
        elif block @AnalyzedBlock.terminator_module ptr cast int cast 0 == do false
        elif block @AnalyzedBlock.token_start 0 < do false
        elif block @AnalyzedBlock.token_start block @AnalyzedBlock.source_module @ModuleContext.token_count > do false
        elif block @AnalyzedBlock.terminator_token 0 < do false
        elif block @AnalyzedBlock.terminator_token block @AnalyzedBlock.terminator_module @ModuleContext.token_count >= do false
        else true end
    end
end

proc verify-block-expansion-provenance ProcedureAnalysis* AnalyzedBlock* -- do
    let analysis block do
        block @AnalyzedBlock.source_expansion_id
        let source-expansion do
            if source-expansion 0 >= do
                if source-expansion analysis @ProcedureAnalysis.macro_expansion_count >= do
                    "internal analyzed block source expansion is invalid" fail
                end
            end
        end
        block @AnalyzedBlock.terminator_expansion_id
        let terminator-expansion do
            if terminator-expansion 0 >= terminator-expansion analysis @ProcedureAnalysis.macro_expansion_count >= && do
                "internal analyzed block terminator expansion is invalid" fail
            end
        end
    end
end

proc verify-analyzed-jump ModuleContext* int ProcedureAnalysis* AnalyzedBlock* ptr int -- do
    let module procedure-index analysis block exit-types exit-count do
        if block @AnalyzedBlock.second_target 0 1 - != do
            "internal analyzed jump has a second target" fail
        end
        module procedure-index analysis block @AnalyzedBlock.first_target verify-analyzed-target
        let target do
            if analysis target exit-types exit-count block-entry-matches-types ! do
                "internal analyzed jump stack mismatch" fail
            end
        end
    end
end

proc verify-analyzed-branch ModuleContext* int ProcedureAnalysis* AnalyzedBlock* ptr int -- do
    let module procedure-index analysis block exit-types exit-count do
        if exit-count 0 <= do "internal analyzed branch is missing its condition" fail end
        if exit-types exit-count 1 - cell-bytes * + 0 field-read type-bool != do
            "internal analyzed branch condition is not bool" fail
        end
        module procedure-index analysis block @AnalyzedBlock.first_target verify-analyzed-target
        module procedure-index analysis block @AnalyzedBlock.second_target verify-analyzed-target
        let first-target second-target do
            if
                analysis first-target
                analysis @ProcedureAnalysis.operation_types second-target @AnalyzedBlock.entry_type_start cell-bytes * +
                second-target @AnalyzedBlock.entry_type_count
                block-entry-matches-types !
            do
                "internal analyzed branch target stack mismatch: " emit-error
                "procedure " emit-error
                module @ModuleContext.source module procedure-index procedure-at @ProcedureEntry.name_start +
                module procedure-index procedure-at @ProcedureEntry.name_length emit-error-bytes
                ", " emit-error
                block @AnalyzedBlock.terminator_module block @AnalyzedBlock.terminator_token token-slice emit-error-bytes
                " at token " emit-error block @AnalyzedBlock.terminator_token emit-integer-error
                ", first=" emit-error
                "block " emit-error block @AnalyzedBlock.first_target emit-integer-error " " emit-error
                analysis @ProcedureAnalysis.operation_types first-target @AnalyzedBlock.entry_type_start cell-bytes * +
                first-target @AnalyzedBlock.entry_type_count
                let types count do
                    block @AnalyzedBlock.terminator_module @ModuleContext.program types 0 count emit-error-type-array
                end
                ", second=" emit-error
                "block " emit-error block @AnalyzedBlock.second_target emit-integer-error " " emit-error
                analysis @ProcedureAnalysis.operation_types second-target @AnalyzedBlock.entry_type_start cell-bytes * +
                second-target @AnalyzedBlock.entry_type_count
                let types count do
                    block @AnalyzedBlock.terminator_module @ModuleContext.program types 0 count emit-error-type-array
                end
                10 eputc
                1 exit
            end
            if analysis first-target exit-types exit-count 1 - block-entry-matches-types ! do
                "internal analyzed branch exit stack mismatch" fail
            end
        end
    end
end

proc verify-analyzed-return ModuleContext* int AnalyzedBlock* ptr int -- do
    let module procedure-index block exit-types exit-count do
        if block @AnalyzedBlock.first_target 0 1 - != block @AnalyzedBlock.second_target 0 1 - != || do
            "internal analyzed return has a target" fail
        end
        if exit-count module procedure-index procedure-at @ProcedureEntry.output_count != do
            "internal analyzed return stack depth mismatch" fail
        end
        if
            exit-types exit-count cell-bytes *
            module @ModuleContext.types module procedure-index procedure-at @ProcedureEntry.output_start cell-bytes * +
            module procedure-index procedure-at @ProcedureEntry.output_count cell-bytes *
            bytes-equal !
        do
            "internal analyzed return stack type mismatch" fail
        end
    end
end

proc verify-analyzed-block-terminator ModuleContext* int ProcedureAnalysis* AnalyzedBlock* -- do
    let module procedure-index analysis block do
        analysis block block-exit-types
        let exit-types exit-count do
            block @AnalyzedBlock.terminator_kind
            let kind do
                if kind CFGTerminatorKind.jump? do
                    if block @AnalyzedBlock.first_target 0 < do "internal unresolved analyzed jump" fail end
                    module procedure-index analysis block exit-types exit-count verify-analyzed-jump
                elif kind CFGTerminatorKind.branch? do module procedure-index analysis block exit-types exit-count verify-analyzed-branch
                elif kind CFGTerminatorKind.return? do module procedure-index block exit-types exit-count verify-analyzed-return
                else "internal unresolved analyzed block terminator" fail end
            end
        end
    end
end

proc enqueue-unvisited-analyzed-block ptr ptr int int -- int do
    let reachable pending pending-count target do
        if reachable target byte-read 0 == do
            1 reachable target byte-write
            target pending pending-count cell-bytes * field-write
            pending-count 1 +
        else
            pending-count
        end
    end
end

proc verify-procedure-cfg-reachability ProcedureAnalysis* -- do
    let analysis do
        analysis @ProcedureAnalysis.cfg_block_count
        let block-count do
            block-count alloc
            let reachable do
                0
                while dup block-count < do
                    dup let block-index do 0 reachable block-index byte-write end
                    1 +
                end
                drop

                block-count cell-bytes * alloc
                let pending do
                    1 reachable 0 byte-write
                    0 pending 0 field-write
                    1
                    while dup 0 > do
                        1 -
                        let pending-count do
                            pending pending-count cell-bytes * field-read
                            let block-index do
                                analysis block-index analyzed-block-at
                                let block do
                                    if block @AnalyzedBlock.terminator_kind CFGTerminatorKind.jump? do
                                        reachable pending pending-count block @AnalyzedBlock.first_target
                                        enqueue-unvisited-analyzed-block
                                    elif block @AnalyzedBlock.terminator_kind CFGTerminatorKind.branch? do
                                        reachable pending
                                        reachable pending pending-count block @AnalyzedBlock.first_target
                                        enqueue-unvisited-analyzed-block
                                        block @AnalyzedBlock.second_target enqueue-unvisited-analyzed-block
                                    else
                                        pending-count
                                    end
                                end
                            end
                        end
                    end
                    drop
                end

                0
                while dup block-count < do
                    dup let block-index do
                        if reachable block-index byte-read 0 == do
                            "internal unreachable analyzed block" fail
                        end
                    end
                    1 +
                end
                drop
            end
        end
    end
end

proc verify-procedure-cfg ModuleContext* int ProcedureAnalysis* -- do
    let module procedure-index analysis do
        if analysis @ProcedureAnalysis.cfg_block_count 0 <= do "internal empty procedure CFG" fail end
        analysis 0 analyzed-block-at
        let entry do
            if
                entry @AnalyzedBlock.entry_type_count module procedure-index procedure-at @ProcedureEntry.input_count !=
                analysis @ProcedureAnalysis.operation_types entry @AnalyzedBlock.entry_type_start cell-bytes * +
                entry @AnalyzedBlock.entry_type_count cell-bytes *
                module @ModuleContext.types module procedure-index procedure-at @ProcedureEntry.input_start cell-bytes * +
                module procedure-index procedure-at @ProcedureEntry.input_count cell-bytes * bytes-equal ! ||
            do
