                else
                    argument debug release standard-library-root standard-library-root-length fmt-file exit
                end
            end
        end
    end
end

proc inspect-command ptr int int bool bool ptr int -- do
    let argv argc command-index debug release standard-library-root standard-library-root-length do
        argv argc command-index 1 + false false parse-inspect-options
        let argument-index include-builtins include-lexemes do
            if argument-index argc >= do
                read-source "<stdin>" String.bytes "<stdin>" String.len "." String.bytes debug release include-builtins include-lexemes
                standard-library-root standard-library-root-length inspect-frog-source exit
            end
            argv argument-index argv-at
            let argument do
                if
                    argc argument-index 1 + ==
                    argument "-h" cstring-equals argument "--help" cstring-equals || &&
                do
                    "Usage: frogc [--debug] [--release] inspect [--builtins] [--lexemes] [FILE]\n" emit
                elif argument u8* cast @ int cast 45 == do
                    "unknown inspect option: " argument cli-usage-error-value
                elif argc argument-index 1 + != do
                    "inspect accepts at most one source file" cli-usage-error
                else
                    argument debug release include-builtins include-lexemes
                    standard-library-root standard-library-root-length inspect-file exit
                end
            end
        end
    end
end

proc cursor-command ptr int int bool bool ptr int -- do
    let argv argc command-index debug release standard-library-root standard-library-root-length do
        command-index 1 +
        let option-index do
            if option-index argc >= do
                "cursor requires --byte OFFSET" cli-usage-error
            end
            argv option-index argv-at
            let option do
                if
                    argc option-index 1 + ==
                    option "-h" cstring-equals option "--help" cstring-equals || &&
                do
                    "Usage: frogc [--debug] [--release] cursor --byte OFFSET [FILE]\n" emit
                elif option "--byte" cstring-equals ! do
                    if option u8* cast @ int cast 45 == do
                        "unknown cursor option: " option cli-usage-error-value
                    else
                        "cursor requires --byte OFFSET" cli-usage-error
                    end
                elif option-index 1 + argc >= do
                    "cursor --byte requires an offset" cli-usage-error
                else
                    argv option-index 1 + argv-at
                    peek offset-argument do parse-nonnegative-decimal
                        let byte valid do
                            if valid ! do "invalid cursor byte offset: " offset-argument cli-usage-error-value end
                            option-index 2 +
                            let file-index do
                                if file-index argc >= do
                                    read-source "<stdin>" String.bytes "<stdin>" String.len "." String.bytes byte debug release
                                    standard-library-root standard-library-root-length cursor-frog-source exit
                                elif file-index 1 + argc != do
                                    "cursor accepts at most one source file" cli-usage-error
                                else
                                    argv file-index argv-at byte debug release standard-library-root standard-library-root-length
                                    cursor-file exit
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc parse-build-options ptr int int ptr bool -- ptr ptr bool do
    let argv argc index output should-run do
        if index argc >= do
            "build requires exactly one source file" cli-usage-error
            NULL NULL false
        else
            argv index argv-at
            let argument do
                if argument u8* cast @ int cast 45 == do
                    if
                        argument "-h" cstring-equals
                        argument "--help" cstring-equals ||
                    do
                        "Usage: frogc [--debug] [--release] build [-o FILE] [-r] FILE\n" emit
                        0 exit
                        NULL NULL false
                    elif argument "-r" cstring-equals do
                        argv argc index 1 + output true parse-build-options
                    elif argument "-o" cstring-equals do
                        if index 1 + argc >= do
                            "build -o requires an output file" cli-usage-error
                        end
                        argv argc index 2 + argv index 1 + argv-at should-run parse-build-options
                    else
                        "unknown build option: " argument cli-usage-error-value
                        NULL NULL false
                    end
                else
                    if argc index - 1 != do
                        "build requires exactly one source file" cli-usage-error
                    end
                    argument output should-run
                end
            end
        end
    end
end

proc build-command ptr int int bool bool ptr int -- do
    let argv argc command-index debug release standard-library-root standard-library-root-length do
        argv argc command-index 1 + NULL false parse-build-options
        let source output should-run do
            source output should-run debug release standard-library-root standard-library-root-length build-file exit
        end
    end
end

proc parse-global-options ptr int int bool bool -- int bool bool do
    let argv argc index debug release do
        if index argc >= do
            index debug release
        else
            argv index argv-at
            let argument do
                if argument "--debug" cstring-equals do
                    argv argc index 1 + true release parse-global-options
                elif argument "--release" cstring-equals do
                    argv argc index 1 + debug true parse-global-options
                else
                    index debug release
                end
            end
        end
    end
end

proc main -- do
    args
    let argv argc do
        argv 0 argv-at compiler-distribution-root
        let standard-library-root standard-library-root-length do
            argv argc 1 false false parse-global-options
            let command-index debug release do
                if command-index argc >= do
                    read-source "<stdin>" String.bytes "<stdin>" String.len debug release standard-library-root standard-library-root-length compile-source
                else
                    argv command-index argv-at
                    let command do
                        if
                            command "-h" cstring-equals
                            command "--help" cstring-equals ||
                        do
                            cli-usage
                        elif command "check" cstring-equals do
                            argv argc command-index debug release standard-library-root standard-library-root-length check-command
                        elif command "fmt" cstring-equals do
                            argv argc command-index debug release standard-library-root standard-library-root-length fmt-command
                        elif command "inspect" cstring-equals do
                            argv argc command-index debug release standard-library-root standard-library-root-length inspect-command
                        elif command "cursor" cstring-equals do
                            argv argc command-index debug release standard-library-root standard-library-root-length cursor-command
                        elif command "run" cstring-equals do
                            argv argc command-index debug release standard-library-root standard-library-root-length run-command
                        elif command "build" cstring-equals do
                            argv argc command-index debug release standard-library-root standard-library-root-length build-command
                        else
                            "unknown command: " command cli-usage-error-value
                        end
                    end
                end
            end
        end
    end
end
