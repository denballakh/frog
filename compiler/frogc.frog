proc semantic-occurrence-at Program* int -- SemanticOccurrence* do
    let program index do
        program @Program.semantic_occurrences index SemanticOccurrence:sizeof * + SemanticOccurrence* cast
    end
end

proc cursor-state-at Program* int -- CursorState* do
    let program index do
        program @Program.cursor_states index CursorState:sizeof * + CursorState* cast
    end
end

proc local-visibility-at Program* int -- LocalVisibility* do
    let program index do
        program @Program.local_visibilities index LocalVisibility:sizeof * + LocalVisibility* cast
    end
end

proc grow-semantic-occurrences Program* -- do
    let program do
        if program @Program.semantic_occurrence_capacity max-int SemanticOccurrence:sizeof 2 * / > do
            "internal semantic occurrence capacity overflow" fail
        end
        program @Program.semantic_occurrence_capacity 2 *
        let capacity do
            capacity SemanticOccurrence:sizeof * alloc
            let occurrences do
                program @Program.semantic_occurrences occurrences
                program @Program.semantic_occurrence_count SemanticOccurrence:sizeof * bytes-copy
                occurrences program !Program.semantic_occurrences
                capacity program !Program.semantic_occurrence_capacity
            end
        end
    end
end

proc grow-cursor-states Program* -- do
    let program do
        if program @Program.cursor_state_capacity max-int CursorState:sizeof 2 * / > do
            "internal cursor state capacity overflow" fail
        end
        program @Program.cursor_state_capacity 2 *
        let capacity do
            capacity CursorState:sizeof * alloc
            let states do
                program @Program.cursor_states states
                program @Program.cursor_state_count CursorState:sizeof * bytes-copy
                states program !Program.cursor_states
                capacity program !Program.cursor_state_capacity
            end
        end
    end
end

proc ensure-cursor-type-capacity Program* int -- do
    let program additional do
        if additional 0 < program @Program.cursor_type_count max-int additional - > || do
            "internal cursor type count overflow" fail
        end
        program @Program.cursor_type_count additional +
        let required do
            while required program @Program.cursor_type_capacity > do
                if program @Program.cursor_type_capacity max-int cell-bytes 2 * / > do
                    "internal cursor type capacity overflow" fail
                end
                program @Program.cursor_type_capacity 2 *
                let capacity do
                    capacity cell-bytes * alloc
                    let types do
                        program @Program.cursor_types types
                        program @Program.cursor_type_count cell-bytes * bytes-copy
                        types program !Program.cursor_types
                        capacity program !Program.cursor_type_capacity
                    end
                end
            end
        end
    end
end

proc append-cursor-types Program* ptr int -- int do
    let program types count do
        program count ensure-cursor-type-capacity
        program @Program.cursor_type_count
        let start do
            types program @Program.cursor_types start cell-bytes * + count cell-bytes * bytes-copy
            start count + program !Program.cursor_type_count
            start
        end
    end
end

proc grow-local-visibilities Program* -- do
    let program do
        if program @Program.local_visibility_capacity max-int LocalVisibility:sizeof 2 * / > do
            "internal local visibility capacity overflow" fail
        end
        program @Program.local_visibility_capacity 2 *
        let capacity do
            capacity LocalVisibility:sizeof * alloc
            let visibilities do
                program @Program.local_visibilities visibilities
                program @Program.local_visibility_count LocalVisibility:sizeof * bytes-copy
                visibilities program !Program.local_visibilities
                capacity program !Program.local_visibility_capacity
            end
        end
    end
end

proc add-semantic-occurrence Program* ModuleContext* int int OccurrenceRole SemanticClass ModuleContext* int int -- int do
    let program source-module start-byte end-byte role semantic-class identity-module identity-index identity-subindex do
        if start-byte 0 < end-byte start-byte <= || do
            "internal invalid semantic occurrence span" fail
        end
        if program @Program.semantic_occurrence_count program @Program.semantic_occurrence_capacity == do
            program grow-semantic-occurrences
        end
        program @Program.semantic_occurrence_count
        let index do
            program index semantic-occurrence-at
            let occurrence do
                source-module occurrence !SemanticOccurrence.source_module
                start-byte occurrence !SemanticOccurrence.start_byte
                end-byte occurrence !SemanticOccurrence.end_byte
                CursorOwnerKind:none occurrence !SemanticOccurrence.owner_kind
                0 ptr cast ModuleContext* cast occurrence !SemanticOccurrence.owner_module
                0 1 - occurrence !SemanticOccurrence.owner_index
                0 1 - occurrence !SemanticOccurrence.expansion_id
                0 1 - occurrence !SemanticOccurrence.state_index
                role occurrence !SemanticOccurrence.role
                semantic-class occurrence !SemanticOccurrence.semantic_class
                identity-module occurrence !SemanticOccurrence.identity_module
                identity-index occurrence !SemanticOccurrence.identity_index
                identity-subindex occurrence !SemanticOccurrence.identity_subindex
                0 ptr cast ModuleContext* cast occurrence !SemanticOccurrence.binding_module
                0 1 - occurrence !SemanticOccurrence.binding_scope_index
                index 1 + program !Program.semantic_occurrence_count
                index
            end
        end
    end
end

proc add-token-semantic-occurrence Program* ModuleContext* int OccurrenceRole SemanticClass ModuleContext* int int -- int do
    let program source-module token role semantic-class identity-module identity-index identity-subindex do
        source-module token token-at
        let entry do
            program source-module entry @TokenEntry.start entry @TokenEntry.start entry @TokenEntry.length +
            role semantic-class identity-module identity-index identity-subindex add-semantic-occurrence
        end
    end
end

proc add-token-part-semantic-occurrence Program* ModuleContext* int int int OccurrenceRole SemanticClass ModuleContext* int int -- int do
    let program source-module token relative-start length role semantic-class identity-module identity-index identity-subindex do
        source-module token token-at @TokenEntry.start relative-start +
        let start-byte do
            program source-module start-byte start-byte length + role semantic-class
            identity-module identity-index identity-subindex add-semantic-occurrence
        end
    end
end

proc add-local-visibility Program* ModuleContext* int int int int int -- int do
    let program procedure-module procedure-index local-id binding-occurrence start-state end-state do
        if program @Program.local_visibility_count program @Program.local_visibility_capacity == do
            program grow-local-visibilities
        end
        program @Program.local_visibility_count
        let index do
            program index local-visibility-at
            let visibility do
                procedure-module visibility !LocalVisibility.procedure_module
                procedure-index visibility !LocalVisibility.procedure_index
                local-id visibility !LocalVisibility.local_id
                binding-occurrence visibility !LocalVisibility.binding_occurrence
                start-state visibility !LocalVisibility.start_state
                end-state visibility !LocalVisibility.end_state
                index 1 + program !Program.local_visibility_count
                index
            end
        end
    end
end

proc add-cursor-state Program* CursorOwnerKind ModuleContext* int int ModuleContext* int ModuleContext* ptr int -- int do
    let program owner-kind owner-module owner-index expansion-id source-module token scope-module types type-count do
        if token 0 < token source-module @ModuleContext.token_count > || do
            "internal invalid cursor state token" fail
        end
        if program @Program.cursor_state_count program @Program.cursor_state_capacity == do
            program grow-cursor-states
        end
        program @Program.cursor_state_count
        let index do
            program index cursor-state-at
            let state do
                owner-kind state !CursorState.owner_kind
                owner-module state !CursorState.owner_module
                owner-index state !CursorState.owner_index
                expansion-id state !CursorState.expansion_id
                source-module state !CursorState.source_module
                token state !CursorState.token
                scope-module state !CursorState.scope_module
                program types type-count append-cursor-types state !CursorState.type_start
                type-count state !CursorState.type_count
                index 1 + program !Program.cursor_state_count
                index
            end
        end
    end
end

proc record-compile-cursor-state CompileContext* int -- int do
    let cc token do
        if cc @CompileContext.record_operations ! do
            0 1 -
        else
            cc @CompileContext.program CursorOwnerKind:procedure
                cc @CompileContext.procedure_module cc @CompileContext.procedure_index
                    cc @CompileContext.current_expansion_id cc @CompileContext.defining_module token
                          cc @CompileContext.scope_module cc @CompileContext.type_stack cc @CompileContext.type_count
            add-cursor-state
            peek state-index do state-index cc !CompileContext.current_cursor_state end
        end
    end
end

proc record-compile-cursor-state-with-types CompileContext* int ptr int -- int do
    let cc token types type-count do
        if cc @CompileContext.record_operations ! do
            0 1 -
        else
            cc @CompileContext.program CursorOwnerKind:procedure
                cc @CompileContext.procedure_module cc @CompileContext.procedure_index
                    cc @CompileContext.current_expansion_id cc @CompileContext.defining_module token
            cc @CompileContext.scope_module types type-count add-cursor-state
            peek state-index do state-index cc !CompileContext.current_cursor_state end
        end
    end
end

proc record-constant-add-cursor-states CompileContext* int -- do
    let cc token do
        if cc @CompileContext.record_operations do
            cc token record-compile-cursor-state drop
            cc @CompileContext.type_count 2 + cell-bytes * alloc
            let types do
                cc @CompileContext.type_stack types cc @CompileContext.type_count cell-bytes * bytes-copy
                type-int types cc @CompileContext.type_count cell-bytes * field-write
                cc token 1 + types cc @CompileContext.type_count 1 + record-compile-cursor-state-with-types drop
                type-int types cc @CompileContext.type_count 1 + cell-bytes * field-write
                cc token 2 + types cc @CompileContext.type_count 2 + record-compile-cursor-state-with-types drop
            end
        end
    end
end

proc record-constant-add-occurrence CompileContext* int -- do
    let cc token do
        cc @CompileContext.program cc @CompileContext.defining_module token token-slice type-int type-int 0
            find-builtin-procedure-2-from
        let module procedure-index found do
            if found ! do
                "internal constant add builtin is missing" fail
            end
            cc token OccurrenceRole:reference SemanticClass:procedure module procedure-index 0 1 -
            add-compile-token-occurrence
            let occurrence-index do
                cc occurrence-index token ScopeKind:procedure module procedure-index set-compile-occurrence-binding
            end
        end
    end
end

proc find-cursor-state-for-token-from Program* ModuleContext* int ModuleContext* int int int -- int do
    let program procedure-module procedure-index source-module token expansion-id state-index do
        if state-index 0 < do
            0 1 -
        else
            program state-index cursor-state-at
            let state do
                if
                    state @CursorState.owner_kind CursorOwnerKind.procedure?
                    state @CursorState.owner_module ptr cast int cast procedure-module ptr cast int cast == &&
                    state @CursorState.owner_index procedure-index == &&
                    state @CursorState.source_module ptr cast int cast source-module ptr cast int cast == &&
                    state @CursorState.token token == &&
                    state @CursorState.expansion_id expansion-id == &&
                do
                    state-index
                else
                    program procedure-module procedure-index source-module token expansion-id state-index 1 -
                    find-cursor-state-for-token-from
                end
            end
        end
    end
end

proc find-compile-cursor-state-for-token CompileContext* ModuleContext* int int -- int do
    let cc source-module token expansion-id do
        cc @CompileContext.program cc @CompileContext.procedure_module cc @CompileContext.procedure_index
              source-module token expansion-id cc @CompileContext.program @Program.cursor_state_count 1 -
        find-cursor-state-for-token-from
