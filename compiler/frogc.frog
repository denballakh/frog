                                cc field @RecordFieldEntry.field_type type-expect
                                cc record-entry field emit-record-field-write
                            else
                                cc cc @CompileContext.program record-entry @RecordTypeEntry.record_type program-intern-pointer-type type-expect
                                cc field @RecordFieldEntry.field_type register-replaced-stack-slot
                                cc field @RecordFieldEntry.field_type type-push
                                cc record-entry field emit-record-field-read
                            end
                            end
                            true
                        end
                    end
                end
            end
        end
    end
end

