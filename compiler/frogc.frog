proc emit-function-dispatch-module ptr ModuleContext int ModuleContext int -- do
    let cc function-module function-index proc-module base do
        0
        while dup proc-module @ModuleContext.proc_count < do
            dup
            let proc-index do
                if
                    function-module function-index proc-module proc-index
                    function-proc-contracts-equal
