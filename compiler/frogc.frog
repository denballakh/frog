proc set-operation-binding CompileContext* OperationKind -- do
    let cc kind do
        cc kind 0 ptr cast ModuleContext* cast 0 1 - set-operation-target
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            cc compile-context-analysis @ProcedureAnalysis.binding_local_count
            cc active-analyzed-operation !AnalyzedOperation.binding_local_start
            0 cc active-analyzed-operation !AnalyzedOperation.binding_local_count
            true cc !CompileContext.operation_identity_locked
            true cc !CompileContext.operation_binding_active
        end
        if cc @CompileContext.instruction_active do
            cc compile-context-analysis @ProcedureAnalysis.binding_local_count
            cc active-typed-instruction !TypedInstruction.binding_local_start
        end
    end
end

proc grow-analyzed-binding-locals ProcedureAnalysis* -- do
    let analysis do
        if analysis @ProcedureAnalysis.binding_local_capacity max-int AnalyzedBindingLocal:sizeof 2 * / > do
            "internal analyzed binding local capacity overflow" fail
        end
        analysis @ProcedureAnalysis.binding_local_capacity 2 *
        let capacity do
            capacity AnalyzedBindingLocal:sizeof * alloc
            let binding-locals do
                analysis @ProcedureAnalysis.binding_locals binding-locals
                analysis @ProcedureAnalysis.binding_local_count AnalyzedBindingLocal:sizeof * bytes-copy
                binding-locals analysis !ProcedureAnalysis.binding_locals
                capacity analysis !ProcedureAnalysis.binding_local_capacity
            end
        end
    end
end

proc record-binding-local CompileContext* LocalEntry* -- do
    let cc local do
        if
            cc @CompileContext.record_operations
            cc @CompileContext.instruction_active &&
        do
            cc compile-context-analysis
            let analysis do
                cc local @LocalEntry.name_token OccurrenceRole:declaration SemanticClass:local
                        cc @CompileContext.procedure_module cc @CompileContext.procedure_index local @LocalEntry.id
                add-compile-token-occurrence
                let occurrence-index do
                    cc local @LocalEntry.module local @LocalEntry.name_token local @LocalEntry.declaration_expansion_id
                    find-compile-cursor-state-for-token
                    let declaration-state do
                        declaration-state cc @CompileContext.program occurrence-index semantic-occurrence-at
                        !SemanticOccurrence.state_index
                    end
                    occurrence-index local !LocalEntry.binding_occurrence
                    cc @CompileContext.program cc @CompileContext.procedure_module cc @CompileContext.procedure_index
                          local @LocalEntry.id occurrence-index local @LocalEntry.visibility_start_state 0 1 -
                    add-local-visibility drop
                end
                if analysis @ProcedureAnalysis.binding_local_count analysis @ProcedureAnalysis.binding_local_capacity == do
                    analysis grow-analyzed-binding-locals
                end
                analysis analysis @ProcedureAnalysis.binding_local_count analyzed-binding-local-at
                let binding-local do
                    local @LocalEntry.module binding-local !AnalyzedBindingLocal.source_module
                    local @LocalEntry.name_token binding-local !AnalyzedBindingLocal.name_token
                    local @LocalEntry.id binding-local !AnalyzedBindingLocal.local_id
                    local @LocalEntry.value_type binding-local !AnalyzedBindingLocal.value_type
                    local @LocalEntry.declaration_expansion_id binding-local !AnalyzedBindingLocal.declaration_expansion_id
                    local @LocalEntry.binding_occurrence binding-local !AnalyzedBindingLocal.binding_occurrence
                    local @LocalEntry.visibility_start_state binding-local !AnalyzedBindingLocal.visibility_start_state
                    0 1 - binding-local !AnalyzedBindingLocal.visibility_end_state
                    analysis @ProcedureAnalysis.binding_local_count 1 + analysis !ProcedureAnalysis.binding_local_count
                    if cc @CompileContext.operation_active cc @CompileContext.operation_binding_active && do
                        cc active-analyzed-operation @AnalyzedOperation.binding_local_count 1 +
                        cc active-analyzed-operation !AnalyzedOperation.binding_local_count
                    end
                end
            end
        end
        if cc @CompileContext.instruction_active do
            cc active-typed-instruction @TypedInstruction.binding_local_count 1 +
            cc active-typed-instruction !TypedInstruction.binding_local_count
        end
    end
end

proc set-operation-intrinsic CompileContext* IntrinsicOperation int PrivateOperation -- do
    let cc intrinsic value-type private-operation do
        cc OperationKind:intrinsic 0 ptr cast ModuleContext* cast 0 1 - set-operation-target
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            intrinsic cc active-analyzed-operation !AnalyzedOperation.intrinsic
            value-type cc active-analyzed-operation !AnalyzedOperation.value_type
            private-operation cc active-analyzed-operation !AnalyzedOperation.private_operation
        end
        if cc @CompileContext.instruction_active do
            intrinsic
            let operation do
                if operation IntrinsicOperation.private? do RuntimeOperation:private_intrinsic
                elif operation IntrinsicOperation.cast? do RuntimeOperation:cast
                elif operation IntrinsicOperation.args? do RuntimeOperation:args
                elif operation IntrinsicOperation.print? do RuntimeOperation:print
                elif operation IntrinsicOperation.noop? do RuntimeOperation:noop
                elif operation IntrinsicOperation.string_bytes? do RuntimeOperation:string_bytes
                elif operation IntrinsicOperation.string_len? do RuntimeOperation:string_len
                elif operation IntrinsicOperation.pointer_load? do RuntimeOperation:pointer_load
                elif operation IntrinsicOperation.pointer_store? do RuntimeOperation:pointer_store
                elif operation IntrinsicOperation.assert_fail? do RuntimeOperation:assert_fail
                else "internal unsupported intrinsic operation" fail RuntimeOperation:none end
            end
            let runtime-operation do
                cc runtime-operation value-type set-typed-type
                let instruction do private-operation instruction !TypedInstruction.private_operation end
            end
        end
    end
end

proc set-operation-macro CompileContext* ModuleContext* int -- do
    let cc module index do
