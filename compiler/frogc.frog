proc set-operation-intrinsic CompileContext* IntrinsicOperation int PrivateOperation -- do
    let cc intrinsic value-type private-operation do
        cc OperationKind:intrinsic 0 ptr cast ModuleContext* cast 0 1 - set-operation-target
        if cc @CompileContext.record_operations cc @CompileContext.operation_active && cc @CompileContext.operation_identity_locked ! && do
            intrinsic cc active-analyzed-operation !AnalyzedOperation.intrinsic
            value-type cc active-analyzed-operation !AnalyzedOperation.value_type
            private-operation cc active-analyzed-operation !AnalyzedOperation.private_operation
        end
        if cc @CompileContext.instruction_active do
            intrinsic
            let operation do
                if operation IntrinsicOperation.private? do RuntimeOperation:private_intrinsic
                elif operation IntrinsicOperation.cast? do RuntimeOperation:cast
                elif operation IntrinsicOperation.args? do RuntimeOperation:args
                elif operation IntrinsicOperation.print? do RuntimeOperation:print
                elif operation IntrinsicOperation.noop? do RuntimeOperation:noop
                elif operation IntrinsicOperation.string_bytes? do RuntimeOperation:string_bytes
                elif operation IntrinsicOperation.string_len? do RuntimeOperation:string_len
                elif operation IntrinsicOperation.pointer_load? do RuntimeOperation:pointer_load
                elif operation IntrinsicOperation.pointer_store? do RuntimeOperation:pointer_store
                else RuntimeOperation:builtins_assert_fail end
            end
            let runtime-operation do
                cc runtime-operation value-type set-typed-type
                let instruction do private-operation instruction !TypedInstruction.private_operation end
            end
        end
    end
end

