proc constant-cast-target int -- bool do
    let value-type do
        value-type type-is-integer
        value-type type-bool == ||
    end
end

proc normalize-constant-integer int int -- int do
    let payload value-type do
        if value-type type-int == do payload
        elif value-type type-i8 == do payload i8 cast int cast
        elif value-type type-i16 == do payload i16 cast int cast
        elif value-type type-i32 == do payload i32 cast int cast
        elif value-type type-i64 == do payload i64 cast int cast
        elif value-type type-u8 == do payload u8 cast int cast
        elif value-type type-u16 == do payload u16 cast int cast
        elif value-type type-u32 == do payload u32 cast int cast
        else payload u64 cast int cast
        end
    end
end

proc evaluate-constant-cast ConstantEvaluator* -- do
    let evaluator do
        evaluator constant-evaluator-pop
        let target-literal target-payload do
            evaluator constant-evaluator-pop
            let source-type payload do
                if target-literal 0 < do 0 target-literal - else target-literal type-literal-base - end
                let target-type do
                    if target-payload target-type != do evaluator "invalid constant cast target" constant-fail end
                    if target-type constant-cast-target ! do evaluator "invalid constant cast target" constant-fail end
                    if source-type type-is-integer target-type type-is-integer && do
                        payload target-type normalize-constant-integer
                        let normalized do evaluator target-type normalized constant-evaluator-push end
                    elif source-type type-int == target-type type-bool == && do
                        evaluator type-bool payload 0 != int cast constant-evaluator-push
                    elif source-type type-bool == target-type type-int == && do
                        evaluator type-int payload constant-evaluator-push
                    else
                        evaluator "unsupported constant cast" constant-fail
                    end
                end
            end
        end
    end
end

proc constant-primitive-type-literal ModuleContext* int -- int bool do
    let module token-index do
        if module token-index "int" token-equals do type-int true
        elif module token-index "i8" token-equals do type-i8 true
        elif module token-index "i16" token-equals do type-i16 true
        elif module token-index "i32" token-equals do type-i32 true
        elif module token-index "i64" token-equals do type-i64 true
        elif module token-index "u8" token-equals do type-u8 true
        elif module token-index "u16" token-equals do type-u16 true
        elif module token-index "u32" token-equals do type-u32 true
        elif module token-index "u64" token-equals do type-u64 true
        elif module token-index "bool" token-equals do type-bool true
        else 0 false
