proc emit-c-type-identity int -- do
    let value-type do
        if value-type type-int == do "int" emit
        elif value-type type-bool == do "bool" emit
        elif value-type type-ptr == do "ptr" emit
        elif value-type type-string == do "string" emit
        elif value-type type-i8 == do "i8" emit
        elif value-type type-i16 == do "i16" emit
        elif value-type type-i32 == do "i32" emit
        elif value-type type-i64 == do "i64" emit
        elif value-type type-u8 == do "u8" emit
        elif value-type type-u16 == do "u16" emit
        elif value-type type-u32 == do "u32" emit
        elif value-type type-u64 == do "u64" emit
        elif value-type type-is-typed-pointer do "pointer_" emit value-type emit-unsigned
        elif value-type type-is-function do "function_" emit value-type emit-unsigned
        else "type_" emit value-type emit-unsigned
        end
    end
end

proc emit-c-type-map-fixed int String -- do
