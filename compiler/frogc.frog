                bytes index 1 + byte-read 128 - +
                width
            elif width 3 == do
                bytes index byte-read 224 - 4096 *
                bytes index 1 + byte-read 128 - 64 * +
                bytes index 2 + byte-read 128 - +
                width
            else
                bytes index byte-read 240 - 262144 *
                bytes index 1 + byte-read 128 - 4096 * +
                bytes index 2 + byte-read 128 - 64 * +
                bytes index 3 + byte-read 128 - +
                width
            end
        end
    end
end

proc lex-advance-count ModuleContext int -- do
    let ctx remaining do
        remaining
        while dup 0 > do
            ctx lex-advance
            1 -
        end
        drop
    end
end

proc skip-path-separators ptr int int -- int do
    let bytes length index do
        if index length < do
            if bytes index byte-read 47 == do
                bytes length index 1 + skip-path-separators
            else
                index
            end
        else
            index
        end
