            if path-token ctx @ModuleContext.token_count >= do "expected import path string" fail end
            if ctx path-token token-kind-at token-string != do "expected import path string" fail end
            path-token 1 + let import-token do
                if import-token ctx @ModuleContext.token_count >= do "expected import after import path" fail end
                if ctx import-token "import" token-equals ! do "expected import after import path" fail end
                ctx path-token normalize-import-path let canonical canonical-length do
                    import-token 1 + let item-token do
                        if item-token ctx @ModuleContext.token_count >= do "expected imported name" fail end
                        if ctx item-token "(" token-equals do
                            item-token 1 + let next-token do
                                if next-token ctx @ModuleContext.token_count >= do "expected ) after import list" fail end
                                if ctx next-token ")" token-equals do "expected imported name" fail end
                                next-token
                                while dup ctx swap import-list-continues do
                                    let list-token do ctx path-token canonical canonical-length list-token scan-import-item end
                                end
                                let list-token do
                                    if list-token ctx @ModuleContext.token_count >= do "expected ) after import list" fail end
                                    if ctx list-token ")" token-equals ! do
                                        if ctx list-token 44 token-contains-byte do "commas are not valid in import lists" fail end
                                        "expected ) after import list" fail
                                    end
                                    list-token 1 +
                                end
                            end
                        else
                            ctx path-token canonical canonical-length item-token scan-import-item
                        end
                    end
                end
            end
        end
    end
end

proc token-starts-block ModuleContext int -- bool do
    let ctx token do
        if ctx token token-kind-at token-word != do
            false
        else
            ctx token "if" token-equals
            ctx token "while" token-equals ||
            ctx token "let" token-equals ||
            ctx token "peek" token-equals ||
        end
    end
end

proc scan-declarations ModuleContext -- do
    let ctx do
        0 ctx !ModuleContext.proc_count
        0 ctx !ModuleContext.type_count
        0 ctx !ModuleContext.macro_count
        0 ctx !ModuleContext.constant_count
        0 ctx !ModuleContext.import_count
        0 ctx !ModuleContext.record_count
        0 ctx !ModuleContext.record_field_count
        0 ctx !ModuleContext.union_count
        0 ctx !ModuleContext.union_case_count
        0 ctx !ModuleContext.function_count
        0 ctx !ModuleContext.function_type_count
        0
        while dup ctx @ModuleContext.token_count < do
            let token-index do
                if
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "from" token-equals &&
                do
                    ctx token-index scan-one-import
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "import" token-equals &&
                do
                    "module aliases are not supported" fail
                    token-index 1 +
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "macro" token-equals &&
                do
                    ctx token-index scan-one-macro
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "const" token-equals &&
                do
                    ctx token-index scan-one-constant
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "proc" token-equals &&
                do
                    ctx token-index scan-one-proc
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "extern" token-equals &&
                do
                    ctx token-index scan-one-extern
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "record" token-equals &&
                do
                    ctx token-index scan-one-record
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "union" token-equals &&
                do
                    ctx token-index scan-one-union
                elif
                    ctx token-index token-kind-at token-word ==
                    ctx token-index "fn" token-equals &&
                do
                    ctx token-index scan-one-function
                else
                    if ctx @ModuleContext.is_root do
                        "only declarations and imports are allowed at top level" fail
                        token-index 1 +
                    elif ctx token-index token-starts-block do
                        ctx token-index 1 + scan-ignored-block-end
                    else
                        token-index 1 +
                    end
                end
            end
        end
        drop
        if ctx @ModuleContext.is_root do
            if ctx @ModuleContext.main_proc 0 < do
                "missing main procedure" fail
            end
        end
    end
end

const cc-defining-module-offset 0 end
const cc-proc-offset 8 end
const cc-type-stack-offset 16 end
const cc-type-count-offset 24 end
const cc-blocks-offset 32 end
const cc-block-count-offset 40 end
const cc-locals-offset 48 end
const cc-local-count-offset 56 end
const cc-next-local-offset 64 end
const cc-indent-offset 72 end
const cc-program-offset 80 end
const cc-procedure-module-offset 88 end
const cc-scope-module-offset 96 end
const cc-emitting-offset 104 end
const cc-max-type-count-offset 112 end
const cc-type-capacity-offset 120 end
const cc-bytes 128 end

const block-if 1 end
const block-while 2 end
const block-let 3 end

const block-kind-offset 0 end
const block-base-types-offset 8 end
const block-base-count-offset 16 end
const block-then-types-offset 24 end
const block-then-count-offset 32 end
const block-local-base-offset 40 end
const block-has-else-offset 48 end
const block-has-do-offset 56 end
const block-elif-parent-offset 64 end
const block-bytes 72 end

record LocalEntry
    name_start int
    name_length int
    value_type int
