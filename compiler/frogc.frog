proc require-word ModuleContext int -- do
    let ctx token-index do
        if ctx token-index token-kind-at token-word != do
            "expected word token" fail
        end
    end
end

proc reserved-name ModuleContext int -- bool do
    peek ctx token-index do "proc" token-equals
        ctx token-index "macro" token-equals ||
        ctx token-index "const" token-equals ||
        ctx token-index "if" token-equals ||
        ctx token-index "elif" token-equals ||
        ctx token-index "else" token-equals ||
        ctx token-index "while" token-equals ||
        ctx token-index "do" token-equals ||
        ctx token-index "end" token-equals ||
        ctx token-index "let" token-equals ||
        ctx token-index "peek" token-equals ||
        ctx token-index "from" token-equals ||
        ctx token-index "import" token-equals ||
        ctx token-index "as" token-equals ||
        ctx token-index "extern" token-equals ||
        ctx token-index "record" token-equals ||
        ctx token-index "union" token-equals ||
        ctx token-index "case" token-equals ||
        ctx token-index "fn" token-equals ||
        ctx token-index "--" token-equals ||
    end
end

proc parse-c-abi-type-token ModuleContext int -- int do
    peek ctx token-index do require-word
        if ctx token-index "c-int" token-equals do
            type-int
        elif ctx token-index "c-bool" token-equals do
            type-bool
        elif ctx token-index "c-ptr" token-equals do
            type-ptr
        else
            "unknown C ABI type" fail
            0
        end
    end
end

proc c-identifier-suffix-valid ptr int int -- bool do
    let bytes length index do
        if index length >= do
            true
        elif bytes index byte-read is-c-identifier-byte do
            bytes length index 1 + c-identifier-suffix-valid
        else
            false
        end
    end
end

proc identifier-token ModuleContext int -- bool do
    peek ctx token-index do token-slice
        let bytes length do
            if length 0 == do
                false
            elif bytes 0 byte-read is-c-identifier-start ! do
                false
            else
                bytes length 1 c-identifier-suffix-valid
            end
        end
    end
end

proc c-keyword ModuleContext int -- bool do
    peek ctx token-index do "auto" token-equals
        ctx token-index "break" token-equals ||
        ctx token-index "case" token-equals ||
        ctx token-index "char" token-equals ||
        ctx token-index "const" token-equals ||
        ctx token-index "continue" token-equals ||
        ctx token-index "default" token-equals ||
        ctx token-index "do" token-equals ||
        ctx token-index "double" token-equals ||
        ctx token-index "else" token-equals ||
        ctx token-index "enum" token-equals ||
        ctx token-index "extern" token-equals ||
        ctx token-index "float" token-equals ||
        ctx token-index "for" token-equals ||
        ctx token-index "goto" token-equals ||
        ctx token-index "if" token-equals ||
        ctx token-index "inline" token-equals ||
        ctx token-index "int" token-equals ||
        ctx token-index "long" token-equals ||
        ctx token-index "register" token-equals ||
        ctx token-index "restrict" token-equals ||
        ctx token-index "return" token-equals ||
        ctx token-index "short" token-equals ||
        ctx token-index "signed" token-equals ||
        ctx token-index "sizeof" token-equals ||
        ctx token-index "static" token-equals ||
        ctx token-index "struct" token-equals ||
        ctx token-index "switch" token-equals ||
        ctx token-index "typedef" token-equals ||
        ctx token-index "union" token-equals ||
        ctx token-index "unsigned" token-equals ||
        ctx token-index "void" token-equals ||
        ctx token-index "volatile" token-equals ||
        ctx token-index "while" token-equals ||
        ctx token-index "_Alignas" token-equals ||
        ctx token-index "_Alignof" token-equals ||
        ctx token-index "_Atomic" token-equals ||
        ctx token-index "_Bool" token-equals ||
        ctx token-index "_Complex" token-equals ||
        ctx token-index "_Generic" token-equals ||
        ctx token-index "_Imaginary" token-equals ||
        ctx token-index "_Noreturn" token-equals ||
        ctx token-index "_Static_assert" token-equals ||
        ctx token-index "_Thread_local" token-equals ||
    end
end

proc frog-internal-symbol ModuleContext int -- bool do
    peek ctx token-index do token-slice
        let bytes length do
            if length 5 < do
                false
            else
                bytes 0 byte-read 102 ==
                bytes 1 byte-read 114 == &&
                bytes 2 byte-read 111 == &&
                bytes 3 byte-read 103 == &&
                bytes 4 byte-read 95 == &&
            end
        end
    end
end

proc reserved-c-symbol ModuleContext int -- bool do
    peek ctx token-index do c-keyword
        ctx token-index "main" token-equals ||
        ctx token-index "Cell" token-equals ||
        ctx token-index "FrogString" token-equals ||
        ctx token-index frog-internal-symbol ||
    end
end

proc valid-c-symbol ModuleContext int -- bool do
    peek ctx token-index do token-slice
        let bytes length do
            if length 0 == do
                false
            elif bytes 0 byte-read is-c-identifier-start ! do
                false
            elif ctx token-index reserved-c-symbol do
                false
            else
                bytes length 1 c-identifier-suffix-valid
            end
        end
    end
end

proc parse-type-token ModuleContext int -- int do
    peek ctx token-index do require-word
        if ctx token-index "int" token-equals do
            type-int
        elif ctx token-index "bool" token-equals do
            type-bool
        elif ctx token-index "ptr" token-equals do
            type-ptr
        elif ctx token-index "String" token-equals do
            type-string
        else
            if ctx token-index reserved-name do
                "unknown type in procedure signature" fail
                0
            else
                0 token-index - 1 -
            end
        end
    end
end

proc unresolved-type-token-index int -- int do 0 swap - 1 - end

proc proc-name-equals-token ModuleContext int int -- bool do
    let ctx proc-index token-index do
        ctx @ModuleContext.source
        ctx proc-index proc-name-start-at
        +
        ctx proc-index proc-name-length-at
        ctx token-index token-slice
        bytes-equal
    end
end

proc find-proc-from ModuleContext int int -- int do
    let ctx token-index proc-index do
        if proc-index ctx @ModuleContext.proc_count >= do
            0 1 -
        elif ctx proc-index token-index proc-name-equals-token do
            proc-index
        else
            ctx token-index proc-index 1 + find-proc-from
        end
    end
end

proc find-proc ModuleContext int -- int do
