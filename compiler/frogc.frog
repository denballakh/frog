        field @RecordFieldEntry.field_type let field-type do
            if setter do
                cc field-type type-expect
                if pointer-receiver do
                    cc record-entry field field-offset emit-record-pointer-field-write
                else
                    cc record-type type-push
                    cc record-entry field field-offset emit-record-value-field-write
                end
            else
                cc field-type type-push
                cc record-entry field field-offset pointer-receiver emit-record-field-read
            end
        end
