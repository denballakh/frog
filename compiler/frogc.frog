proc constant-evaluator-pop ConstantEvaluator* -- int int do
    let evaluator do
        if evaluator @ConstantEvaluator.count 0 <= do
            evaluator "constant expression stack underflow" constant-fail
            0 0
        else
            evaluator @ConstantEvaluator.count 1 -
            peek index do evaluator !ConstantEvaluator.count
                if
                    evaluator @ConstantEvaluator.format_operation_active
                    index evaluator @ConstantEvaluator.format_operation_minimum < &&
                do
                    index evaluator !ConstantEvaluator.format_operation_minimum
                end
                evaluator @ConstantEvaluator.values index constant-value-at @ConstantValue.value_type
                  evaluator @ConstantEvaluator.values index constant-value-at @ConstantValue.payload
