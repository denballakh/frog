            cc type-int type-push
            if cc @CompileContext.emitting do
                cc @CompileContext.type_count 1 - let index do
                    cc emit-indent cc index type-int emit-slot-as " = " emit
                    cc index type-string emit-slot-as ".len;" emit 10 putc
                end
            end
            true
        else
            false
        end
    end
end

proc compile-type-word CompileContext* int -- bool do
    let cc token-index do
        if cc @CompileContext.defining_module token-index token-is-pointer-type do
            cc @CompileContext.defining_module token-index parse-type-token
            let value-type do
                if value-type 0 < do
                    cc @CompileContext.scope_module value-type "unknown type literal" resolve-type-value
                else
                    value-type
                end
                0 swap -
                let literal-type do
                    if literal-type 0 < do 0 literal-type - else literal-type end
                    let resolved-type do cc OperationKind:type_literal resolved-type set-operation-type end
                    cc literal-type set-operation-payload
                    cc literal-type type-push
                    cc literal-type emit-push-integer
                end
                true
            end
        elif cc @CompileContext.defining_module token-index "int" token-equals do cc type-int compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "i8" token-equals do cc type-i8 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "i16" token-equals do cc type-i16 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "i32" token-equals do cc type-i32 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "i64" token-equals do cc type-i64 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "u8" token-equals do cc type-u8 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "u16" token-equals do cc type-u16 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "u32" token-equals do cc type-u32 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "u64" token-equals do cc type-u64 compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "bool" token-equals do cc type-bool compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "ptr" token-equals do cc type-ptr compile-primitive-type-literal
        elif cc @CompileContext.defining_module token-index "String" token-equals do cc type-string compile-primitive-type-literal
        else
            if cc token-index compile-record-type-word do
                true
            else
                if cc token-index compile-union-type-word do
                    true
                else
                    cc token-index compile-function-type-word
                end
            end
        end
    end
