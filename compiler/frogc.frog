// FrogLang compiler, written in FrogLang.
//
// The bootstrap compiler deliberately uses only the bootstrap-v1 language
// profile.  It reads one Frog source file from stdin and writes C to stdout.

const cell-bytes 8 end

const type-int 1 end
const type-bool 2 end
const type-ptr 3 end
const type-type 4 end
const type-string 5 end
const type-none 0 end
const type-nominal-base 1000 end
const type-function-base 1 32 << end

const max-int 1 62 << 1 62 << 1 - + end
const min-int 0 max-int - 1 - end

const token-int 1 end
const token-bool 2 end
const token-char 3 end
const token-string 4 end
const token-word 5 end

const token-kind-offset 0 end
const token-start-offset 8 end
const token-length-offset 16 end
const token-value-offset 24 end
const token-line-offset 32 end
const token-column-offset 40 end
const token-bytes 48 end

const proc-name-start-offset 0 end
const proc-name-length-offset 8 end
const proc-body-start-offset 16 end
const proc-body-end-offset 24 end
const proc-input-start-offset 32 end
const proc-input-count-offset 40 end
const proc-output-start-offset 48 end
const proc-output-count-offset 56 end
const proc-index-offset 64 end
const proc-global-id-offset 72 end
const proc-external-offset 80 end
const proc-c-symbol-token-offset 88 end
const proc-bytes 96 end

const program-root-module-offset 0 end
const program-module-head-offset 8 end
const program-module-tail-offset 16 end
const program-module-count-offset 24 end
const program-next-proc-id-offset 32 end
const program-token-count-offset 40 end
const program-strings-offset 48 end
const program-string-count-offset 56 end
const program-next-nominal-type-offset 72 end
const program-next-function-type-offset 80 end
const program-bytes 88 end

const string-bytes-offset 0 end
const string-length-offset 8 end
const string-hash-offset 16 end
const string-collision-offset 24 end
const string-bytes 32 end

const fnv-offset-basis 0x811c9dc5 end
const fnv-prime 0x01000193 end
const fnv-modulus 0x100000000 end

const macro-name-start-offset 0 end
const macro-name-length-offset 8 end
const macro-body-start-offset 16 end
const macro-body-end-offset 24 end
const macro-expanding-offset 32 end
const macro-bytes 40 end

const constant-name-start-offset 0 end
const constant-name-length-offset 8 end
const constant-body-start-offset 16 end
const constant-body-end-offset 24 end
const constant-state-offset 32 end
const constant-values-offset 40 end
const constant-value-count-offset 48 end
const constant-bytes 56 end

const constant-new 0 end
const constant-evaluating 1 end
const constant-evaluated 2 end

const constant-value-type-offset 0 end
const constant-value-payload-offset 8 end
const constant-value-bytes 16 end

const constant-evaluator-values-offset 0 end
const constant-evaluator-count-offset 8 end
const constant-evaluator-capacity-offset 16 end
const constant-evaluator-bytes 24 end

const record-name-start-offset 0 end
const record-name-length-offset 8 end
const record-field-start-offset 16 end
const record-field-count-offset 24 end
const record-type-offset 32 end
const record-bytes 40 end

const record-field-name-start-offset 0 end
const record-field-name-length-offset 8 end
const record-field-type-offset 16 end
const record-field-byte-offset-offset 24 end
const record-field-bytes 32 end

const union-name-start-offset 0 end
const union-name-length-offset 8 end
const union-case-start-offset 16 end
const union-case-count-offset 24 end
const union-type-offset 32 end
const union-bytes 40 end

const union-case-name-start-offset 0 end
const union-case-name-length-offset 8 end
const union-case-payload-type-offset 16 end
const union-case-tag-offset 24 end
const union-case-bytes 32 end

const union-payload-offset cell-bytes end
const union-storage-bytes cell-bytes 2 * end

const function-name-start-offset 0 end
const function-name-length-offset 8 end
const function-input-start-offset 16 end
const function-input-count-offset 24 end
const function-output-start-offset 32 end
const function-output-count-offset 40 end
const function-type-offset 48 end
const function-bytes 56 end

record ModuleContext
    source ptr
    source_length int
    tokens ptr
    token_count int
    procs ptr
    proc_count int
    types ptr
    type_count int
    lex_index int
    lex_line int
    lex_column int
    main_proc int
    macros ptr
    macro_count int
    program ptr
    module_id int
    next_module ModuleContext
    canonical_path ptr
    canonical_path_length int
    imports ptr
    import_count int
    scope ptr
    scope_count int
    load_state int
    resolve_state int
    is_root bool
    records ptr
    record_count int
    record_fields ptr
    record_field_count int
    unions ptr
    union_count int
    union_cases ptr
    union_case_count int
    functions ptr
    function_count int
    function_types ptr
    function_type_count int
    constants ptr
    constant_count int
end

record ImportEntry
    path_token int
    name_token int
    alias_token int
    target_module ModuleContext
    canonical_path ptr
    canonical_path_length int
end

record ScopeEntry
    name_module ModuleContext
    name_start int
    name_length int
    kind int
    definition_module ModuleContext
    definition_index int
end

const scope-procedure 1 end
const scope-macro 2 end
const scope-record 3 end
const scope-union 4 end
const scope-function 5 end
const scope-constant 6 end

const load-new 0 end
const load-loading 1 end
const load-loaded 2 end

const resolve-new 0 end
const resolve-resolving 1 end
const resolve-resolved 2 end

const max-source-bytes 4194304 end
const max-import-path-bytes 1024 end

proc field-read ptr int -- int do + @i64 end

proc field-write int ptr int -- do
    + !i64
end

proc pointer-field-read ptr int -- ptr do
    field-read ptr cast
end

proc pointer-field-write ptr ptr int -- do
    let value base offset do
        value int cast base offset field-write
    end
end

proc byte-read ptr int -- int do
    + @u8
end

proc byte-write int ptr int -- do
    + !u8
end

proc memory-copy ptr ptr int -- do
    let source destination count do
        0
        while dup count < do
            dup let index do
                source index byte-read
                destination index byte-write
            end
            1 +
        end
        drop
    end
end

proc emit-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + @u8 putc
            1 +
        end
        drop
    end
end

proc emit String -- do
    peek value do String.bytes value String.len emit-bytes
    end
end

proc emit-error-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + @u8 eputc
            1 +
        end
        drop
    end
end

proc emit-error String -- do
    peek value do String.bytes value String.len emit-error-bytes
    end
end

proc fail String -- do
    "frogc: " emit-error
    emit-error
    10 eputc
    1 exit
end

proc emit-unsigned int -- do
    let value do
        if value 10 >= do
            value 10 / emit-unsigned
        end
        value 10 % 48 + putc
    end
end

proc emit-integer int -- do
    let value do
        if value min-int == do
            "INT64_MIN" emit
        elif value 0 < do
            45 putc
            0 value - emit-unsigned
        else
            value emit-unsigned
        end
    end
end

proc is-space int -- bool do
    peek byte do 32 ==
        byte 9 == ||
        byte 10 == ||
        byte 13 == ||
    end
end

proc is-digit int -- bool do
    peek byte do 48 >= byte 57 <= &&
    end
end

proc is-ascii-letter int -- bool do
    peek byte do 65 >= byte 90 <= &&
        byte 97 >= byte 122 <= && ||
    end
end

proc is-c-identifier-start int -- bool do
    peek byte do is-ascii-letter byte 95 == ||
    end
end

proc is-c-identifier-byte int -- bool do
    peek byte do is-c-identifier-start byte is-digit ||
    end
end

proc digit-value int -- int do
    let byte do
        if byte is-digit do
            byte 48 -
        elif byte 65 >= byte 70 <= && do
            byte 65 - 10 +
        elif byte 97 >= byte 102 <= && do
            byte 97 - 10 +
        else
            0 1 -
        end
    end
end

proc is-hex-digit int -- bool do digit-value 0 >= end

proc hex-value int -- int do
    digit-value
    let value do
        if value 0 >= do
            value
        else
            "invalid hexadecimal digit" fail
            0
        end
    end
end

proc bytes-equal ptr int ptr int -- bool do
    let first first-length second second-length do
        if first-length second-length != do
            false
        else
            0 true
            while
                peek index equal do
                    index first-length < equal &&
                end
            do
                let index equal do
                    index 1 +
                    equal
                    first index byte-read second index byte-read == &&
                end
            end
            let index equal do equal end
        end
    end
end

proc bytes-equal-string ptr int String -- bool do
    peek bytes length value do String.bytes value String.len bytes-equal
    end
end

proc read-source -- ptr int do
    max-source-bytes alloc
    let source do
        0 getc
        while dup 0 >= do
            let length byte do
                if length max-source-bytes >= do
                    "source exceeds max-source-bytes" fail
                end
                byte source length byte-write
                length 1 +
                getc
            end
        end
        drop
        source swap
    end
end

proc @program-root-module ptr -- ModuleContext do program-root-module-offset pointer-field-read ModuleContext cast end
proc @program-module-head ptr -- ModuleContext do program-module-head-offset pointer-field-read ModuleContext cast end
proc @program-module-tail ptr -- ModuleContext do program-module-tail-offset pointer-field-read ModuleContext cast end
proc @program-module-count ptr -- int do program-module-count-offset field-read end
proc @program-next-proc-id ptr -- int do program-next-proc-id-offset field-read end
proc @program-token-count ptr -- int do program-token-count-offset field-read end
proc @program-strings ptr -- ptr do program-strings-offset pointer-field-read end
proc @program-string-count ptr -- int do program-string-count-offset field-read end
proc @program-next-nominal-type ptr -- int do program-next-nominal-type-offset field-read end
proc @program-next-function-type ptr -- int do program-next-function-type-offset field-read end

proc !program-root-module ModuleContext ptr -- do let value program do value ptr cast program program-root-module-offset pointer-field-write end end
proc !program-module-head ModuleContext ptr -- do let value program do value ptr cast program program-module-head-offset pointer-field-write end end
proc !program-module-tail ModuleContext ptr -- do let value program do value ptr cast program program-module-tail-offset pointer-field-write end end
proc !program-module-count int ptr -- do program-module-count-offset field-write end
proc !program-next-proc-id int ptr -- do program-next-proc-id-offset field-write end
proc !program-token-count int ptr -- do program-token-count-offset field-write end
proc !program-strings ptr ptr -- do program-strings-offset pointer-field-write end
proc !program-string-count int ptr -- do program-string-count-offset field-write end
proc !program-next-nominal-type int ptr -- do program-next-nominal-type-offset field-write end
proc !program-next-function-type int ptr -- do program-next-function-type-offset field-write end

proc string-address ptr int -- ptr do
    let program index do program @program-strings index string-bytes * + end
end

proc string-field ptr int int -- int do
    let program index offset do program index string-address offset field-read end
end
proc set-string-field int ptr int int -- do
    let value program index offset do value program index string-address offset field-write end
end

proc string-data-at ptr int -- ptr do
    peek program index do string-address string-bytes-offset pointer-field-read end
end
proc string-length-at ptr int -- int do string-length-offset string-field end
proc string-hash-at ptr int -- int do string-hash-offset string-field end
proc string-collision-at ptr int -- int do string-collision-offset string-field end

proc set-string-data ptr ptr int -- do
    peek data program index do string-address string-bytes-offset pointer-field-write end
end

proc program-allocate-proc-id ptr -- int do
    peek program do @program-next-proc-id
        peek proc-id do 1 + program !program-next-proc-id
            proc-id
        end
    end
end

proc program-allocate-nominal-type ptr -- int do
    peek program do @program-next-nominal-type
        peek nominal-type do 1 + program !program-next-nominal-type
            nominal-type
        end
    end
end

proc program-allocate-function-type ptr -- int do
    peek program do @program-next-function-type
        peek function-type do 1 + program !program-next-function-type
            function-type
        end
    end
end

proc program-add-module ptr ModuleContext -- do
    peek program module do !ModuleContext.program
        program @program-module-count module !ModuleContext.module_id
        0 ptr cast ModuleContext cast module !ModuleContext.next_module
        if program @program-module-count 0 == do
            module program !program-module-head
        else
            module program @program-module-tail !ModuleContext.next_module
        end
        module program !program-module-tail
        program @program-module-count 1 + program !program-module-count
    end
end

proc token-address ModuleContext int -- ptr do
    let ctx index do
        ctx @ModuleContext.tokens index token-bytes * +
    end
end

proc token-field ModuleContext int int -- int do
    let ctx index offset do
        ctx index token-address offset field-read
    end
end

proc set-token-field int ModuleContext int int -- do
    let value ctx index offset do
        value ctx index token-address offset field-write
    end
end

proc token-kind-at ModuleContext int -- int do token-kind-offset token-field end
proc token-start-at ModuleContext int -- int do token-start-offset token-field end
proc token-length-at ModuleContext int -- int do token-length-offset token-field end
proc token-value-at ModuleContext int -- int do token-value-offset token-field end
proc token-line-at ModuleContext int -- int do token-line-offset token-field end
proc token-column-at ModuleContext int -- int do token-column-offset token-field end

proc token-slice ModuleContext int -- ptr int do
    let ctx index do
        ctx @ModuleContext.source
        ctx index token-start-at +
        ctx index token-length-at
    end
end

proc token-equals ModuleContext int String -- bool do
    let ctx index value do
        ctx index token-slice value bytes-equal-string
    end
end

proc string-type-name ModuleContext int -- bool do
    peek ctx token-index do "String" token-equals
    end
end

proc add-token ModuleContext int int int int int int -- do
    let ctx kind start length value line column do
        ctx @ModuleContext.token_count
        let index do
            kind ctx index token-kind-offset set-token-field
            start ctx index token-start-offset set-token-field
            length ctx index token-length-offset set-token-field
            value ctx index token-value-offset set-token-field
            line ctx index token-line-offset set-token-field
            column ctx index token-column-offset set-token-field
            index 1 + ctx !ModuleContext.token_count
        end
    end
end

proc source-byte ModuleContext int -- int do
    let ctx index do
        ctx @ModuleContext.source index byte-read
    end
end

proc lex-advance ModuleContext -- do
    peek ctx do @ModuleContext.lex_index
        let index do
            ctx index source-byte
            let byte do
                index 1 + ctx !ModuleContext.lex_index
                if byte 10 == do
                    ctx @ModuleContext.lex_line 1 + ctx !ModuleContext.lex_line
                    1 ctx !ModuleContext.lex_column
                else
                    ctx @ModuleContext.lex_column 1 + ctx !ModuleContext.lex_column
                end
            end
        end
    end
end

proc all-digits ptr int int -- bool do
    let source start length do
        0 true
        while
            peek index valid do
                index length < valid &&
            end
        do
            let index valid do
                index 1 +
                valid source start index + byte-read is-digit &&
            end
        end
        let index valid do
            valid length 0 > &&
        end
    end
end

proc integer-literal-base ptr int int -- int do
    let source start length do
        if length 2 >= source start byte-read 48 == && do
            source start 1 + byte-read
            let prefix do
                if prefix 98 == do
                    2
                elif prefix 111 == do
                    8
                elif prefix 120 == do
                    16
                else
                    0
                end
            end
        else
            0
        end
    end
end

proc parse-integer ptr int int int -- int do
    let source start length base do
        if length 0 == do
            "invalid integer literal" fail
        end
        0 0
        while
            peek index value do index length <
            end
        do
            let index value do
                source start index + byte-read digit-value
                let digit do
                    if digit 0 < digit base >= || do
                        "invalid integer literal" fail
                    end
                    if
                        value max-int base / >
                        value max-int base / ==
                        digit max-int base % > && ||
                    do
                        "integer literal exceeds the signed 64-bit range" fail
                    end
                    index 1 +
                    value base * digit +
                end
            end
        end
        let index value do value end
    end
end

proc classify-word ptr int int -- int int do
    let source start length do
        if source start + length "true" bytes-equal-string do
            token-bool 1
        elif source start + length "false" bytes-equal-string do
            token-bool 0
        elif source start length all-digits do
            token-int source start length 10 parse-integer
        else
            source start length integer-literal-base
            let base do
                if base 0 > do
                    token-int source start 2 + length 2 - base parse-integer
                else
                    token-word 0
                end
            end
        end
    end
end

proc skip-comment ModuleContext -- do
    let ctx do
        while
            ctx @ModuleContext.lex_index ctx @ModuleContext.source_length <
            if dup do
                drop ctx ctx @ModuleContext.lex_index source-byte 10 !=
            end
        do
            ctx lex-advance
        end
    end
end

proc lex-string ModuleContext int int int -- do
    let ctx start line column do
        ctx lex-advance
        ctx @ModuleContext.lex_index
        let content-start do
            false
            while
                peek done do done !
                    ctx @ModuleContext.lex_index ctx @ModuleContext.source_length < &&
                end
            do
                let done do
                    ctx ctx @ModuleContext.lex_index source-byte
                    let byte do
                        if byte 34 == do
                            true
                        else
                            if byte 92 == do
                                ctx lex-advance
                                if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
                                    "unterminated string escape" fail
                                end
                            end
                            ctx lex-advance
                            false
                        end
                    end
                end
            end
            drop
            if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
                "unterminated string literal" fail
            end
            ctx @ModuleContext.lex_index content-start -
            let content-length do
                ctx token-string content-start content-length 0 line column add-token
            end
            ctx lex-advance
        end
    end
end

proc lex-character ModuleContext int int int -- do
    let ctx start line column do
        ctx lex-advance
        if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
            "unterminated character literal" fail
        end
        if ctx ctx @ModuleContext.lex_index source-byte 10 == do
            "unterminated character literal" fail
        end
        if ctx ctx @ModuleContext.lex_index source-byte 39 == do
            "invalid character literal" fail
        end
        ctx @ModuleContext.source ctx @ModuleContext.source_length ctx @ModuleContext.lex_index utf8-codepoint-at
        let value width do
            ctx width lex-advance-count
            if ctx @ModuleContext.lex_index ctx @ModuleContext.source_length >= do
                "unterminated character literal" fail
            end
            if ctx ctx @ModuleContext.lex_index source-byte 39 != do
                if ctx ctx @ModuleContext.lex_index source-byte 10 == do
                    "unterminated character literal" fail
                else
                    "invalid character literal" fail
                end
            end
            ctx lex-advance
            ctx token-char start width 2 + value line column add-token
        end
    end
end

proc lex-word ModuleContext int int int -- do
    let ctx start line column do
        while
            ctx @ModuleContext.lex_index ctx @ModuleContext.source_length <
            if dup do
                drop ctx ctx @ModuleContext.lex_index source-byte is-space !
            end
        do
            ctx lex-advance
        end
        ctx @ModuleContext.lex_index start -
        let length do
            if ctx @ModuleContext.source start + length "//" bytes-equal-string do
                ctx skip-comment
            else
                ctx @ModuleContext.source start length classify-word
                let kind value do
                    ctx kind start length value line column add-token
                end
            end
        end
    end
end

proc lex ModuleContext -- do
    let ctx do
        0 ctx !ModuleContext.token_count
        0 ctx !ModuleContext.lex_index
        1 ctx !ModuleContext.lex_line
        1 ctx !ModuleContext.lex_column

        while ctx @ModuleContext.lex_index ctx @ModuleContext.source_length < do
            ctx ctx @ModuleContext.lex_index source-byte
            let byte do
                if byte is-space do
                    ctx lex-advance
                else
                    ctx @ModuleContext.lex_index
                    ctx @ModuleContext.lex_line
                    ctx @ModuleContext.lex_column
                    let start line column do
                        if byte 34 == do
                            ctx start line column lex-string
                        else
                            if byte 39 == do
                                ctx start line column lex-character
                            else
                                ctx start line column lex-word
                            end
                        end
                    end
                end
            end
        end
    end
end

proc proc-address ModuleContext int -- ptr do
    let ctx index do
        ctx @ModuleContext.procs index proc-bytes * +
    end
end

proc proc-field ModuleContext int int -- int do
    let ctx index offset do
        ctx index proc-address offset field-read
    end
end

proc set-proc-field int ModuleContext int int -- do
    let value ctx index offset do
        value ctx index proc-address offset field-write
    end
end

proc proc-name-start-at ModuleContext int -- int do proc-name-start-offset proc-field end
proc proc-name-length-at ModuleContext int -- int do proc-name-length-offset proc-field end
proc proc-body-start-at ModuleContext int -- int do proc-body-start-offset proc-field end
proc proc-body-end-at ModuleContext int -- int do proc-body-end-offset proc-field end
proc proc-input-start-at ModuleContext int -- int do proc-input-start-offset proc-field end
proc proc-input-count-at ModuleContext int -- int do proc-input-count-offset proc-field end
proc proc-output-start-at ModuleContext int -- int do proc-output-start-offset proc-field end
proc proc-output-count-at ModuleContext int -- int do proc-output-count-offset proc-field end
proc proc-index-at ModuleContext int -- int do proc-index-offset proc-field end
proc proc-global-id-at ModuleContext int -- int do proc-global-id-offset proc-field end
proc proc-external-at ModuleContext int -- bool do proc-external-offset proc-field 0 != end
proc proc-c-symbol-token-at ModuleContext int -- int do proc-c-symbol-token-offset proc-field end

proc set-proc-external bool ModuleContext int -- do
    let value ctx index do
        if value do 1 else 0 end
        ctx index proc-external-offset set-proc-field
    end
end

proc macro-address ModuleContext int -- ptr do
    let ctx index do
        ctx @ModuleContext.macros index macro-bytes * +
    end
end

proc macro-field ModuleContext int int -- int do
    let ctx index offset do
        ctx index macro-address offset field-read
    end
end

proc set-macro-field int ModuleContext int int -- do
    let value ctx index offset do
        value ctx index macro-address offset field-write
    end
end

proc macro-name-start-at ModuleContext int -- int do macro-name-start-offset macro-field end
proc macro-name-length-at ModuleContext int -- int do macro-name-length-offset macro-field end
proc macro-body-start-at ModuleContext int -- int do macro-body-start-offset macro-field end
proc macro-body-end-at ModuleContext int -- int do macro-body-end-offset macro-field end
proc macro-expanding-at ModuleContext int -- bool do macro-expanding-offset macro-field 0 != end

proc set-macro-expanding bool ModuleContext int -- do
    let value ctx index do
        if value do 1 else 0 end
        ctx index macro-expanding-offset set-macro-field
    end
end

proc constant-address ModuleContext int -- ptr do
    let ctx index do
        ctx @ModuleContext.constants index constant-bytes * +
    end
end

proc constant-field ModuleContext int int -- int do
    let ctx index offset do
        ctx index constant-address offset field-read
    end
end

proc set-constant-field int ModuleContext int int -- do
    let value ctx index offset do
        value ctx index constant-address offset field-write
    end
end

proc constant-name-start-at ModuleContext int -- int do constant-name-start-offset constant-field end
proc constant-name-length-at ModuleContext int -- int do constant-name-length-offset constant-field end
proc constant-body-start-at ModuleContext int -- int do constant-body-start-offset constant-field end
proc constant-body-end-at ModuleContext int -- int do constant-body-end-offset constant-field end
proc constant-state-at ModuleContext int -- int do constant-state-offset constant-field end
proc constant-values-at ModuleContext int -- ptr do
    peek ctx index do constant-address constant-values-offset pointer-field-read end
end
proc constant-value-count-at ModuleContext int -- int do constant-value-count-offset constant-field end

proc set-constant-values ptr ModuleContext int -- do
    peek values ctx index do constant-address constant-values-offset pointer-field-write
    end
end

proc constant-value-address ptr int -- ptr do
    peek values index do constant-value-bytes * + end
end

proc constant-value-type-at ptr int -- int do
    peek values index do constant-value-address constant-value-type-offset field-read end
end

proc constant-value-payload-at ptr int -- int do
    peek values index do constant-value-address constant-value-payload-offset field-read end
end

proc set-constant-value int int ptr int -- do
    let type payload values index do
        type values index constant-value-address constant-value-type-offset field-write
        payload values index constant-value-address constant-value-payload-offset field-write
    end
