proc emit-inspect-program Program* bool bool -- do
    let program include-builtins include-lexemes do
        if program @Program.phase ProgramPhase.analyzed? ! do "internal program must be analyzed before inspection" fail end
        if include-lexemes do "frogc-inspect\t5\n" emit else "frogc-inspect\t4\n" emit end
        "fields\tmodule\tid\troot\tbuiltins\tpath\n" emit
        "fields\tprocedure\tmodule\tindex\tname\toperation_count\tbinding_local_count\tinstruction_count\texpansion_count\tblock_count\n" emit
        "fields\toperation\tprocedure_module\tprocedure_index\tindex\tsource_module\tstart_token\tend_token\tstart_byte\tend_byte\tline\tcolumn\tbefore_depth\tminimum_depth\tafter_depth\tinput_count\toutput_count\tkind\ttarget_module\ttarget_index\tsecondary_module\tsecondary_index\tlocal_id\tbinding_local_start\tbinding_local_count\tvalue_type\tintrinsic\tprivate_operation\tbefore_types\tafter_types\n" emit
        "fields\tbinding_local\tprocedure_module\tprocedure_index\tindex\tsource_module\tname_token\tname\tlocal_id\tvalue_type\n" emit
        "fields\tinstruction\tprocedure_module\tprocedure_index\tindex\tsource_module\tstart_token\tend_token\tstart_byte\tend_byte\tline\tcolumn\texpansion\tbefore_depth\tminimum_depth\tafter_depth\toperation\ttarget_module\ttarget_index\tsecondary_module\tsecondary_index\tlocal_id\tbinding_local_start\tbinding_local_count\tvalue_type\tsecondary_type\tpayload\tprivate_operation\tbefore_types\tafter_types\n" emit
        "fields\texpansion\tprocedure_module\tprocedure_index\tid\tparent\tinvocation_module\tinvocation_token\tmacro_module\tmacro_index\tinstruction_start\tinstruction_count\tbefore_depth\tminimum_depth\tafter_depth\tbefore_types\tafter_types\n" emit
        "fields\tblock\tprocedure_module\tprocedure_index\tindex\tsource_module\tstart_token\tinstruction_start\tinstruction_count\tterminator\tterminator_module\tterminator_token\tfirst_target\tsecond_target\tentry_types\texit_types\n" emit
        if include-lexemes do
            "fields\tlexeme\tmodule\tindex\tstart_byte\tlength\tkind\ttext\n" emit
            "fields\tregion\tmodule\tid\tparent\tkind\tstart_token\tend_token\tstart_byte\tend_byte\n" emit
        end
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            let module do
                "module\t" emit module @ModuleContext.module_id emit-unsigned 9 putc
                if module @ModuleContext.is_root do 1 else 0 end emit-unsigned 9 putc
                if module ptr cast int cast program @Program.builtins_module ptr cast int cast == do 1 else 0 end emit-unsigned 9 putc
                program module emit-inspect-module-path
                10 putc
                if
                    include-lexemes
                    include-builtins module ptr cast int cast program @Program.builtins_module ptr cast int cast != || &&
                do
                    module verify-module-lexemes
                    module verify-module-syntax-regions
                    module emit-inspect-lexemes
                    module emit-inspect-syntax-regions
                end
                if
                    include-builtins
                    module ptr cast int cast program @Program.builtins_module ptr cast int cast != ||
                do
                    0
                    while dup module @ModuleContext.proc_count < do
                        dup program module rot emit-inspect-procedure
                        1 +
                    end
                    drop
                end
                module @ModuleContext.next_module
            end
        end
        drop
    end
end

proc cursor-token-at-byte ModuleContext* int -- int do
