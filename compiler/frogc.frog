                        block @AnalyzedBlock.instruction_start analysis @ProcedureAnalysis.instruction_count > ||
                        block @AnalyzedBlock.instruction_count
                        analysis @ProcedureAnalysis.instruction_count block @AnalyzedBlock.instruction_start - > ||
