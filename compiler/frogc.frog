        elif semantic-class SemanticClass.constant? do
            module module index constant-at @ConstantEntry.name_token true
        elif semantic-class SemanticClass.record_type? do
            module module index record-type-at @RecordTypeEntry.name_token true
        elif semantic-class SemanticClass.record_field? do
            module module subindex record-field-at @RecordFieldEntry.name_token true
        elif semantic-class SemanticClass.union_type? do
            module module index union-type-at @UnionTypeEntry.name_token true
        elif semantic-class SemanticClass.union_case? do
            module module subindex union-case-at @UnionCaseEntry.name_token true
        elif semantic-class SemanticClass.function_type? do
            module module index function-type-at @FunctionTypeEntry.name_token true
        elif semantic-class SemanticClass.c_type? do
            module module index c-type-at @CTypeEntry.name_token true
        else
            module 0 1 - false
