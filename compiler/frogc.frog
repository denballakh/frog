                        ctx @ModuleContext.type_count ctx index procedure-at !ProcedureEntry.output_start
                        ctx next 1 + "end" scan-c-signature-types let end-token outputs do
                            if end-token ctx @ModuleContext.token_count >= do "expected end after C call" fail end
                            if ctx end-token "end" token-equals ! do "expected end after C call" fail end
                            if outputs 1 > do "C call may return at most one value" fail end
                            outputs ctx index procedure-at !ProcedureEntry.output_count
                            index 1 + ctx !ModuleContext.proc_count
                            end-token 1 +
                        end
                    end
                end
            end
        end
    end
end

proc scan-one-c-value ModuleContext* int -- int do
    let ctx token do
        token 1 + let name do
            ctx name allocate-proc let index do
                c-binding-value ctx index procedure-at !ProcedureEntry.c_binding
                if ctx name "main" token-equals do "main cannot be a C binding" fail end
                name 1 + let symbol do
                    if symbol ctx @ModuleContext.token_count >= do "expected C symbol" fail end
                    ctx symbol require-word
                    if ctx symbol valid-c-symbol ! do "invalid C symbol" fail end
                    symbol ctx index procedure-at !ProcedureEntry.c_symbol_token
                    symbol 1 + let separator do
                        if separator ctx @ModuleContext.token_count >= do "expected -- in C value signature" fail end
                        if ctx separator "--" token-equals ! do "expected -- in C value signature" fail end
                        0 ctx index procedure-at !ProcedureEntry.input_count
                        ctx @ModuleContext.type_count ctx index procedure-at !ProcedureEntry.input_start
                        ctx @ModuleContext.type_count ctx index procedure-at !ProcedureEntry.output_start
                        ctx separator 1 + "end" scan-c-signature-types let end-token outputs do
                            if end-token ctx @ModuleContext.token_count >= do "expected end after C value" fail end
                            if ctx end-token "end" token-equals ! do "expected end after C value" fail end
                            if outputs 1 != do "C value must return exactly one value" fail end
                            outputs ctx index procedure-at !ProcedureEntry.output_count
                            index 1 + ctx !ModuleContext.proc_count
                            end-token 1 +
                        end
                    end
                end
            end
        end
    end
end

proc import-at ModuleContext* int -- ImportEntry* do
    let ctx index do
        ctx @ModuleContext.imports index ImportEntry:sizeof * + ImportEntry* cast
    end
end

proc scope-at ModuleContext* int -- ScopeEntry* do
    let ctx index do
        ctx @ModuleContext.scope index ScopeEntry:sizeof * + ScopeEntry* cast
    end
end

proc token-contains-byte ModuleContext* int int -- bool do
    let ctx token byte do
        ctx token token-slice let bytes length do
            0 false
            while peek index found do
                index length < found ! &&
            end do
                let index found do
                    index 1 +
                    found bytes index byte-read byte == ||
                end
            end
            let index found do found end
        end
    end
end

proc require-import-name ModuleContext* int -- do
    peek ctx token do require-word
        if ctx token "*" token-equals do
            "wildcard imports are not supported" fail
        end
        if ctx token 44 token-contains-byte do
            "commas are not valid in import lists" fail
        end
        if
            ctx token reserved-name
            ctx token private-intrinsic-name ||
            ctx token "(" token-equals ||
            ctx token ")" token-equals ||
            ctx token "int" token-equals ||
            ctx token "bool" token-equals ||
            ctx token "ptr" token-equals ||
            ctx token string-type-name ||
        do
            "invalid imported name" fail
        end
    end
end

proc add-import ModuleContext* int int int ptr int -- do
    let ctx path-token name-token alias-token canonical canonical-length do
        ctx ctx @ModuleContext.import_count import-at
        let entry do
            path-token entry !ImportEntry.path_token
            name-token entry !ImportEntry.name_token
            alias-token entry !ImportEntry.alias_token
            0 ptr cast ModuleContext* cast entry !ImportEntry.target_module
            canonical entry !ImportEntry.canonical_path
            canonical-length entry !ImportEntry.canonical_path_length
            ctx @ModuleContext.import_count 1 + ctx !ModuleContext.import_count
        end
    end
end

proc scan-import-item ModuleContext* int ptr int int -- int do
    let ctx path-token canonical canonical-length token do
        if token ctx @ModuleContext.token_count >= do "expected imported name" fail end
        ctx token require-import-name
        token let name-token do
            token 1 + let next-token do
                if next-token ctx @ModuleContext.token_count >= do
                    ctx path-token name-token 0 1 - canonical canonical-length add-import
                    next-token
                elif ctx next-token "as" token-equals do
                    next-token 1 + let alias-token do
                        if alias-token ctx @ModuleContext.token_count >= do "expected import alias" fail end
                        ctx alias-token require-import-name
                        ctx path-token name-token alias-token canonical canonical-length add-import
                        alias-token 1 +
                    end
                else
                    ctx path-token name-token 0 1 - canonical canonical-length add-import
                    next-token
                end
            end
        end
    end
end

proc import-list-continues ModuleContext* int -- bool do
    let ctx token do
        if token ctx @ModuleContext.token_count >= do
            false
        else
            ctx token ")" token-equals !
        end
    end
end

proc scan-one-import ModuleContext* int -- int do
    let ctx token do
        token 1 + let path-token do
            if path-token ctx @ModuleContext.token_count >= do "expected import path string" fail end
            if ctx path-token token-at @TokenEntry.kind token-string != do "expected import path string" fail end
            path-token 1 + let import-token do
                if import-token ctx @ModuleContext.token_count >= do "expected import after import path" fail end
                if ctx import-token "import" token-equals ! do "expected import after import path" fail end
                ctx path-token decoded-import-path normalize-path let canonical canonical-length do
                    import-token 1 + let item-token do
                        if item-token ctx @ModuleContext.token_count >= do "expected imported name" fail end
                        if ctx item-token "(" token-equals do
                            item-token 1 + let next-token do
                                if next-token ctx @ModuleContext.token_count >= do "expected ) after import list" fail end
                                if ctx next-token ")" token-equals do "expected imported name" fail end
                                next-token
                                while dup ctx swap import-list-continues do
                                    let list-token do ctx path-token canonical canonical-length list-token scan-import-item end
                                end
                                let list-token do
                                    if list-token ctx @ModuleContext.token_count >= do "expected ) after import list" fail end
                                    if ctx list-token ")" token-equals ! do
                                        if ctx list-token 44 token-contains-byte do "commas are not valid in import lists" fail end
                                        "expected ) after import list" fail
                                    end
                                    list-token 1 +
                                end
                            end
                        else
                            ctx path-token canonical canonical-length item-token scan-import-item
                        end
                    end
                end
            end
        end
    end
end

proc token-starts-block ModuleContext* int -- bool do
    let ctx token do
        if ctx token token-at @TokenEntry.kind token-word != do
            false
        else
            ctx token "if" token-equals
            ctx token "while" token-equals ||
            ctx token "let" token-equals ||
            ctx token "peek" token-equals ||
        end
    end
end

proc scan-declarations ModuleContext* -- do
    let ctx do
        0 ctx !ModuleContext.proc_count
        0 ctx !ModuleContext.type_count
        0 ctx !ModuleContext.macro_count
        0 ctx !ModuleContext.constant_count
        0 ctx !ModuleContext.import_count
        0 ctx !ModuleContext.record_count
        0 ctx !ModuleContext.record_field_count
        0 ctx !ModuleContext.union_count
        0 ctx !ModuleContext.union_case_count
        0 ctx !ModuleContext.function_count
        0 ctx !ModuleContext.function_type_count
        0 ctx !ModuleContext.c_type_count
        0 ctx !ModuleContext.c_include_count
        0
        while dup ctx @ModuleContext.token_count < do
            let token-index do
                if
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "from" token-equals &&
                do
                    ctx token-index scan-one-import
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "import" token-equals &&
                do
                    "module aliases are not supported" fail
                    token-index 1 +
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "macro" token-equals &&
                do
                    ctx token-index scan-one-macro
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "const" token-equals &&
                do
                    ctx token-index scan-one-constant
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "proc" token-equals &&
                do
                    ctx token-index scan-one-proc
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "c-include" token-equals &&
                do
                    ctx token-index scan-one-c-include
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "c-type" token-equals &&
                do
                    ctx token-index scan-one-c-type
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "c-call" token-equals &&
                do
                    ctx token-index scan-one-c-call
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "c-value" token-equals &&
                do
                    ctx token-index scan-one-c-value
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "record" token-equals &&
                do
                    ctx token-index scan-one-record
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "union" token-equals &&
                do
                    ctx token-index scan-one-union
                elif
                    ctx token-index token-at @TokenEntry.kind token-word ==
                    ctx token-index "fn" token-equals &&
                do
                    ctx token-index scan-one-function
                else
                    if ctx @ModuleContext.is_root do
                        "only declarations and imports are allowed at top level" fail
                        token-index 1 +
                    elif ctx token-index token-starts-block do
                        ctx token-index 1 + scan-ignored-block-end
                    else
                        token-index 1 +
                    end
                end
            end
        end
        drop
        if ctx @ModuleContext.is_root do
            if ctx @ModuleContext.main_proc 0 < do
                "missing main procedure" fail
            end
        end
    end
end

const block-if 1 end
const block-while 2 end
const block-let 3 end

record BlockFrame
    kind int
    base_types ptr
    base_count int
    then_types ptr
    then_count int
    local_base int
    has_else bool
    has_do bool
    elif_parent bool
end

record LocalEntry
    name_start int
    name_length int
    value_type int
    id int
    module ModuleContext*
end

record StackSlotEntry
    depth int
    value_type int
end

record ResultTypeEntry
    types ptr
    count int
end

record RecordTypeEntry
    name_start int
    name_length int
    field_start int
    field_count int
    record_type int
end

record RecordFieldEntry
    name_start int
    name_length int
    field_type int
    byte_offset int
end

record UnionTypeEntry
    name_start int
    name_length int
    case_start int
    case_count int
    union_type int
end

record UnionCaseEntry
    name_start int
    name_length int
    payload_type int
    tag int
end

record FunctionTypeEntry
    name_start int
    name_length int
    input_start int
    input_count int
    output_start int
    output_count int
    function_type int
end

record Program
    root_module ModuleContext*
    module_head ModuleContext*
    module_tail ModuleContext*
    module_count int
    next_proc_id int
    token_count int
    strings ptr
    string_count int
    builtins_module ModuleContext*
    next_nominal_type int
    next_function_type int
    pointer_types ptr
    pointer_type_count int
    pointer_type_capacity int
    unresolved_pointer_types ptr
    unresolved_pointer_type_count int
    unresolved_pointer_type_capacity int
    result_types ptr
    result_type_count int
    result_type_capacity int
    debug bool
    standard_library_root ptr
    standard_library_root_length int
end

record CompileContext
    defining_module ModuleContext*
    procedure_index int
    type_stack ptr
    type_count int
    blocks ptr
    block_count int
    locals ptr
    local_count int
    next_local int
    indent int
    program Program*
    procedure_module ModuleContext*
    scope_module ModuleContext*
    emitting bool
    max_type_count int
    type_capacity int
    stack_slots ptr
    stack_slot_count int
    stack_slot_capacity int
    diagnostic_module ModuleContext*
    diagnostic_token int
    diagnostic_active bool
end

record TokenEntry
    kind int
    start int
    length int
    value int
    line int
    column int
end

record ProcedureEntry
    name_start int
    name_length int
    body_start int
    body_end int
    input_start int
    input_count int
    output_start int
    output_count int
    index int
    global_id int
    c_symbol_token int
    c_binding int
end

record StringPoolEntry
    data ptr
    length int
    hash int
    collision int
end

record MacroEntry
    name_start int
    name_length int
    body_start int
    body_end int
    expanding bool
end

record ConstantEntry
    name_start int
    name_length int
    body_start int
    body_end int
    state int
    values ptr
    value_count int
end

record ConstantValue
    value_type int
    payload int
end

proc emit-compile-word-error-prefix CompileContext* -- do
    let cc do
        "frogc: " emit-error
        if cc @CompileContext.diagnostic_active do
            cc @CompileContext.diagnostic_module cc @CompileContext.diagnostic_token token-slice emit-error-bytes
            ": " emit-error
        end
    end
end

proc fail-compile-word CompileContext* String -- do
    let cc message do
        cc emit-compile-word-error-prefix
        message emit-error
        10 eputc
        1 exit
    end
end

proc emit-error-type-module-prefix ModuleContext* -- do
    let module do
        if module @ModuleContext.canonical_path_length 0 > do
            module @ModuleContext.canonical_path module @ModuleContext.canonical_path_length
            emit-error-bytes
            ":" emit-error
        end
    end
end

proc emit-error-record-type-name ModuleContext* int int -- bool do
    let module value-type record-index do
        if record-index module @ModuleContext.record_count >= do
            false
        elif module record-index record-type-at @RecordTypeEntry.record_type value-type == do
            module emit-error-type-module-prefix
            module @ModuleContext.source module record-index record-type-at @RecordTypeEntry.name_start +
            module record-index record-type-at @RecordTypeEntry.name_length emit-error-bytes
            true
        else
            module value-type record-index 1 + emit-error-record-type-name
        end
    end
end

proc emit-error-union-type-name ModuleContext* int int -- bool do
    let module value-type union-index do
        if union-index module @ModuleContext.union_count >= do
            false
        elif module union-index union-type-at @UnionTypeEntry.union_type value-type == do
            module emit-error-type-module-prefix
            module @ModuleContext.source module union-index union-type-at @UnionTypeEntry.name_start +
            module union-index union-type-at @UnionTypeEntry.name_length emit-error-bytes
            true
        else
            module value-type union-index 1 + emit-error-union-type-name
        end
    end
end

proc emit-error-function-type-name ModuleContext* int int -- bool do
    let module value-type function-index do
        if function-index module @ModuleContext.function_count >= do
            false
        elif module function-index function-type-at @FunctionTypeEntry.function_type value-type == do
            module emit-error-type-module-prefix
            module @ModuleContext.source module function-index function-type-at @FunctionTypeEntry.name_start +
            module function-index function-type-at @FunctionTypeEntry.name_length emit-error-bytes
            true
        else
            module value-type function-index 1 + emit-error-function-type-name
        end
    end
end

proc emit-error-module-type-name ModuleContext* int -- bool do
    let module value-type do
        module value-type 0 emit-error-record-type-name
        let found do
            if found do
                true
            else
                module value-type 0 emit-error-union-type-name
                let found do
                    if found do true else module value-type 0 emit-error-function-type-name end
                end
            end
        end
    end
end

proc emit-error-nominal-type-name ModuleContext* int -- bool do
    let module value-type do
        if module ptr cast int cast 0 == do
            false
        else
            module value-type emit-error-module-type-name
            let found do
                if found do
                    true
                else
                    module @ModuleContext.next_module value-type emit-error-nominal-type-name
                end
            end
        end
    end
end

proc emit-error-type-name Program* int -- do
    let program value-type do
        if
            value-type 0 <
            value-type type-literal-base > value-type type-nominal-base < && ||
        do
            "type" emit-error
        elif value-type type-int == do
            "int" emit-error
        elif value-type type-bool == do
            "bool" emit-error
        elif value-type type-ptr == do
            "ptr" emit-error
        elif value-type type-type == do
            "type" emit-error
        elif value-type type-string == do
            "String" emit-error
        elif value-type type-i8 == do "i8" emit-error
        elif value-type type-i16 == do "i16" emit-error
        elif value-type type-i32 == do "i32" emit-error
        elif value-type type-i64 == do "i64" emit-error
        elif value-type type-u8 == do "u8" emit-error
        elif value-type type-u16 == do "u16" emit-error
        elif value-type type-u32 == do "u32" emit-error
        elif value-type type-u64 == do "u64" emit-error
        elif value-type type-none == do
            "none" emit-error
        elif value-type type-pointer-base >= do
            program program value-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type emit-error-type-name
            "*" emit-error
        else
            if program @Program.module_head value-type emit-error-nominal-type-name ! do
                "unknown" emit-error
            end
        end
    end
end

proc emit-error-type-array-items Program* ptr int int -- do
    let program values start count do
        0
        while dup count < do
            dup
            let index do
                if index 0 > do " " emit-error end
                program values start index + cell-bytes * field-read emit-error-type-name
            end
            1 +
        end
        drop
    end
end

proc emit-error-type-array Program* ptr int int -- do
    let program values start count do
        "[" emit-error
        program values start count emit-error-type-array-items
        "]" emit-error
    end
end

proc cc-debug-tracing CompileContext* -- bool do
    let cc do
        cc @CompileContext.program @Program.debug
        cc @CompileContext.emitting ! &&
        cc @CompileContext.procedure_module ptr cast int cast
        cc @CompileContext.program @Program.builtins_module ptr cast int cast != &&
    end
end

proc emit-debug-word-stack CompileContext* String -- do
    let cc phase do
        "frogc: debug: " emit-error
        cc @CompileContext.diagnostic_module cc @CompileContext.diagnostic_token token-slice emit-error-bytes
        ": " emit-error
        phase emit-error
        " " emit-error
        cc @CompileContext.program cc @CompileContext.type_stack 0 cc @CompileContext.type_count emit-error-type-array
        10 eputc
    end
end

proc cc-type-address CompileContext* int -- ptr do
    let cc index do
        cc @CompileContext.type_stack index cell-bytes * +
    end
end

proc stack-slot-at CompileContext* int -- StackSlotEntry* do
    let cc index do
        cc @CompileContext.stack_slots index StackSlotEntry:sizeof * + StackSlotEntry* cast
    end
end

proc find-stack-slot-from CompileContext* int int int -- int do
    let cc depth value-type index do
        if index cc @CompileContext.stack_slot_count >= do
            0 1 -
        elif
            cc index stack-slot-at @StackSlotEntry.depth depth ==
            cc index stack-slot-at @StackSlotEntry.value_type value-type == &&
        do
            index
        else
            cc depth value-type index 1 + find-stack-slot-from
        end
    end
end

proc find-stack-slot CompileContext* int int -- int do 0 find-stack-slot-from end

proc grow-stack-slots CompileContext* -- do
    let cc do
        cc @CompileContext.stack_slot_capacity 2 *
        let capacity do
            capacity StackSlotEntry:sizeof * alloc
            let entries do
                0
                while dup cc @CompileContext.stack_slot_count < do
                    dup let index do
                        cc index stack-slot-at @StackSlotEntry.depth entries index StackSlotEntry:sizeof * + StackSlotEntry* cast !StackSlotEntry.depth
                        cc index stack-slot-at @StackSlotEntry.value_type entries index StackSlotEntry:sizeof * + StackSlotEntry* cast !StackSlotEntry.value_type
                    end
                    1 +
                end
                drop
                entries cc !CompileContext.stack_slots
                capacity cc !CompileContext.stack_slot_capacity
            end
        end
    end
end

proc register-stack-slot CompileContext* int int -- do
    let cc depth value-type do
        cc depth value-type find-stack-slot
        let found do
            if found 0 < do
                if cc @CompileContext.emitting do
                    "internal unmeasured typed stack slot" fail
                end
                if cc @CompileContext.stack_slot_count cc @CompileContext.stack_slot_capacity == do cc grow-stack-slots end
                cc @CompileContext.stack_slot_count
                let index do
                    depth cc index stack-slot-at !StackSlotEntry.depth
                    value-type cc index stack-slot-at !StackSlotEntry.value_type
                    index 1 + cc !CompileContext.stack_slot_count
                end
            end
        end
    end
end

proc register-replaced-stack-slot CompileContext* int -- do
    let cc value-type do
        cc cc @CompileContext.type_count value-type register-stack-slot
    end
end

proc ensure-type-capacity CompileContext* -- do
    let cc do
        if cc @CompileContext.type_count cc @CompileContext.type_capacity == do
            if cc @CompileContext.type_capacity max-int cell-bytes 2 * / > do
                "internal compile-time type stack capacity overflow" fail
            end
            cc @CompileContext.type_capacity 2 *
            peek new-capacity do cell-bytes * alloc
                let new-stack do
                    cc @CompileContext.type_stack new-stack cc @CompileContext.type_count cell-bytes * memory-copy
                    new-stack cc !CompileContext.type_stack
                    new-capacity cc !CompileContext.type_capacity
                end
            end
        end
    end
end

proc type-push CompileContext* int -- do
    let cc value do
        if cc @CompileContext.emitting do
            if cc @CompileContext.type_count cc @CompileContext.max_type_count >= do
                "internal compile-time stack capacity exceeded" fail
            end
        end
        cc cc @CompileContext.type_count value register-stack-slot
        cc ensure-type-capacity
        value cc cc @CompileContext.type_count cc-type-address 0 field-write
        cc @CompileContext.type_count 1 + cc !CompileContext.type_count
        if cc @CompileContext.emitting ! do
            if cc @CompileContext.type_count cc @CompileContext.max_type_count > do
                cc @CompileContext.type_count cc !CompileContext.max_type_count
            end
        end
    end
end

proc type-pop CompileContext* -- int do
    let cc do
        if cc @CompileContext.type_count 0 <= do
            cc "compile-time stack underflow" fail-compile-word
        end
        cc @CompileContext.type_count 1 -
        peek index do cc !CompileContext.type_count
            cc index cc-type-address 0 field-read
        end
    end
end

proc type-expect CompileContext* int -- do
    let cc expected do
        if cc type-pop expected != do
            cc "compile-time stack type mismatch" fail-compile-word
        end
    end
end

proc type-at-depth CompileContext* int -- int do
    peek cc index do cc-type-address 0 field-read
    end
end

proc type-snapshot CompileContext* -- ptr int do
    peek cc do @CompileContext.type_count 1 + cell-bytes * alloc
        let snapshot do
            cc @CompileContext.type_stack snapshot cc @CompileContext.type_count cell-bytes * memory-copy
            snapshot cc @CompileContext.type_count
        end
    end
end

proc restore-type-snapshot CompileContext* ptr int -- do
    let cc snapshot count do
        snapshot cc @CompileContext.type_stack count cell-bytes * memory-copy
        count cc !CompileContext.type_count
    end
end

proc types-match-from CompileContext* ptr int int -- bool do
    let cc snapshot count index do
        if index count >= do
            true
        else
            if cc index type-at-depth snapshot index cell-bytes * field-read != do
                false
            else
                cc snapshot count index 1 + types-match-from
            end
        end
    end
end

proc types-match CompileContext* ptr int -- bool do
    let cc snapshot count do
        if cc @CompileContext.type_count count != do
            false
        else
            cc snapshot count 0 types-match-from
        end
    end
end

proc block-address CompileContext* int -- BlockFrame* do
    let cc index do
        cc @CompileContext.blocks index BlockFrame:sizeof * + BlockFrame* cast
    end
end

proc push-block CompileContext* int -- BlockFrame* do
    let cc kind do
        cc cc @CompileContext.block_count block-address
        let block do
            kind block !BlockFrame.kind
            cc type-snapshot
            let snapshot count do
                snapshot block !BlockFrame.base_types
                count block !BlockFrame.base_count
            end
            0 ptr cast block !BlockFrame.then_types
            0 block !BlockFrame.then_count
            cc @CompileContext.local_count block !BlockFrame.local_base
            false block !BlockFrame.has_else
            false block !BlockFrame.has_do
            false block !BlockFrame.elif_parent
            cc @CompileContext.block_count 1 + cc !CompileContext.block_count
            block
        end
    end
end

proc top-block CompileContext* -- BlockFrame* do
    let cc do
        if cc @CompileContext.block_count 0 <= do
            "control-flow block stack underflow" fail
        end
        cc cc @CompileContext.block_count 1 - block-address
    end
end

proc pop-block CompileContext* -- BlockFrame* do
    peek cc do top-block
        cc @CompileContext.block_count 1 - cc !CompileContext.block_count
    end
end

proc local-address CompileContext* int -- LocalEntry* do
    let cc index do
        cc @CompileContext.locals index LocalEntry:sizeof * + LocalEntry* cast
    end
end

proc add-local CompileContext* int int -- int do
    let cc name-token value-type do
        cc cc @CompileContext.local_count local-address
        let local do
            cc @CompileContext.defining_module name-token token-at @TokenEntry.start local !LocalEntry.name_start
            cc @CompileContext.defining_module name-token token-at @TokenEntry.length local !LocalEntry.name_length
            value-type local !LocalEntry.value_type
            cc @CompileContext.next_local local !LocalEntry.id
            cc @CompileContext.defining_module local !LocalEntry.module
            cc @CompileContext.local_count 1 + cc !CompileContext.local_count
            cc @CompileContext.next_local
            cc @CompileContext.next_local 1 + cc !CompileContext.next_local
        end
    end
end

proc local-name-equals CompileContext* LocalEntry* int -- bool do
    let cc local token-index do
        local @LocalEntry.module @ModuleContext.source
        local @LocalEntry.name_start +
        local @LocalEntry.name_length
        cc @CompileContext.defining_module token-index token-slice
        bytes-equal
    end
end

proc find-local-from CompileContext* int int -- int do
    let cc token-index local-index do
        if local-index 0 < do
            0 1 -
        else
            cc local-index local-address
            let local do
                if cc local token-index local-name-equals do
                    local-index
                else
                    cc token-index local-index 1 - find-local-from
                end
            end
        end
    end
end

proc find-local CompileContext* int -- int do
    peek cc token-index do cc @CompileContext.local_count 1 - find-local-from
    end
end

proc emit-indent CompileContext* -- do
    let cc do
        0
        while dup cc @CompileContext.indent < do
            "  " emit
            1 +
        end
        drop
    end
end

proc emit-line CompileContext* String -- do
    let cc code do
        if cc @CompileContext.emitting do
            cc emit-indent
            code emit
            10 putc
        end
    end
end

proc indent-more CompileContext* -- do
    peek cc do @CompileContext.indent 1 + cc !CompileContext.indent end
end

proc indent-less CompileContext* -- do
    let cc do
        if cc @CompileContext.indent 0 <= do
            "C emitter indentation underflow" fail
        end
        cc @CompileContext.indent 1 - cc !CompileContext.indent
    end
end

