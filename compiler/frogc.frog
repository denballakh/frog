                        cc indent-more
                        cc emit-indent "switch (function_id) {" emit 10 putc
                        cc indent-more
                        cc cc @CompileContext.program function-module function-index base emit-function-dispatch-cases
                        cc emit-indent "default: frog_runtime_fail();" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                    end
                end
            end
        end
    end
end

proc fail-function-reference-contract CompileContext* ModuleContext* int ModuleContext* int -- do
    let cc function-module function-index proc-module proc-index do
        64 byte-buffer-new
        let message do
            "function reference contract mismatch: expected " message byte-buffer-append-string
            cc @CompileContext.program function-module function-index message append-function-contract
            ", actual " message byte-buffer-append-string
            cc @CompileContext.program proc-module proc-index message append-proc-contract
            cc DiagnosticCode:type_error message finish-compile-diagnostic
