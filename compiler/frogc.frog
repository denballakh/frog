end

proc grow-analyzed-operations ProcedureAnalysis* -- do
    let analysis do
        if analysis @ProcedureAnalysis.operation_capacity max-int AnalyzedOperation:sizeof 2 * / > do
            "internal analyzed operation capacity overflow" fail
        end
        analysis @ProcedureAnalysis.operation_capacity 2 *
        let capacity do
            capacity AnalyzedOperation:sizeof * alloc
            let operations do
                analysis @ProcedureAnalysis.operations operations
                analysis @ProcedureAnalysis.operation_count AnalyzedOperation:sizeof * bytes-copy
                operations analysis !ProcedureAnalysis.operations
                capacity analysis !ProcedureAnalysis.operation_capacity
            end
        end
    end
end

proc ensure-operation-type-capacity ProcedureAnalysis* int -- do
    let analysis additional do
        if additional 0 < do "internal negative analyzed operation type count" fail end
        if analysis @ProcedureAnalysis.operation_type_count max-int additional - > do
            "internal analyzed operation type count overflow" fail
        end
        analysis @ProcedureAnalysis.operation_type_count additional +
        let required do
            while required analysis @ProcedureAnalysis.operation_type_capacity > do
                if analysis @ProcedureAnalysis.operation_type_capacity max-int cell-bytes 2 * / > do
                    "internal analyzed operation type capacity overflow" fail
                end
                analysis @ProcedureAnalysis.operation_type_capacity 2 *
                let capacity do
                    capacity cell-bytes * alloc
                    let operation-types do
                        analysis @ProcedureAnalysis.operation_types operation-types
                        analysis @ProcedureAnalysis.operation_type_count cell-bytes * bytes-copy
                        operation-types analysis !ProcedureAnalysis.operation_types
                        capacity analysis !ProcedureAnalysis.operation_type_capacity
                    end
                end
            end
        end
    end
end

proc append-operation-types ProcedureAnalysis* ptr int -- int do
    let analysis types count do
        analysis count ensure-operation-type-capacity
        analysis @ProcedureAnalysis.operation_type_count
        let start do
            types analysis @ProcedureAnalysis.operation_types start cell-bytes * + count cell-bytes * bytes-copy
            start count + analysis !ProcedureAnalysis.operation_type_count
            start
        end
    end
end

proc grow-typed-instructions ProcedureAnalysis* -- do
    let analysis do
        if analysis @ProcedureAnalysis.instruction_capacity max-int TypedInstruction:sizeof 2 * / > do
            "internal typed instruction capacity overflow" fail
        end
        analysis @ProcedureAnalysis.instruction_capacity 2 *
        let capacity do
            capacity TypedInstruction:sizeof * alloc
            let instructions do
                analysis @ProcedureAnalysis.instructions instructions
                analysis @ProcedureAnalysis.instruction_count TypedInstruction:sizeof * bytes-copy
                instructions analysis !ProcedureAnalysis.instructions
                capacity analysis !ProcedureAnalysis.instruction_capacity
            end
        end
    end
end

proc begin-typed-instruction CompileContext* int -- do
    let cc token-index do
        if cc @CompileContext.instruction_active do "internal nested typed instruction" fail end
        cc compile-context-analysis
        let analysis do
            if analysis @ProcedureAnalysis.instruction_count analysis @ProcedureAnalysis.instruction_capacity == do
                analysis grow-typed-instructions
            end
            analysis analysis @ProcedureAnalysis.instruction_count typed-instruction-at
            let instruction do
                cc @CompileContext.defining_module instruction !TypedInstruction.source_module
                token-index instruction !TypedInstruction.token_start
                0 1 - instruction !TypedInstruction.token_end
                cc @CompileContext.current_expansion_id instruction !TypedInstruction.expansion_id
                analysis cc @CompileContext.type_stack cc @CompileContext.type_count append-operation-types
                instruction !TypedInstruction.before_type_start
                cc @CompileContext.type_count instruction !TypedInstruction.before_type_count
                0 1 - instruction !TypedInstruction.after_type_start
                0 instruction !TypedInstruction.after_type_count
                cc @CompileContext.type_count instruction !TypedInstruction.minimum_type_count
                RuntimeOperation:none instruction !TypedInstruction.operation
                0 ptr cast ModuleContext* cast instruction !TypedInstruction.target_module
                0 1 - instruction !TypedInstruction.target_index
                0 ptr cast ModuleContext* cast instruction !TypedInstruction.secondary_module
                0 1 - instruction !TypedInstruction.secondary_index
                0 1 - instruction !TypedInstruction.local_id
                0 1 - instruction !TypedInstruction.binding_local_start
                0 instruction !TypedInstruction.binding_local_count
                type-none instruction !TypedInstruction.value_type
                type-none instruction !TypedInstruction.secondary_type
                0 instruction !TypedInstruction.payload
                PrivateOperation:none instruction !TypedInstruction.private_operation
                cc @CompileContext.type_count cc !CompileContext.instruction_minimum_type_count
                true cc !CompileContext.instruction_active
            end
        end
    end
end

proc active-typed-instruction CompileContext* -- TypedInstruction* do
    let cc do
        cc compile-context-analysis
        let analysis do analysis analysis @ProcedureAnalysis.instruction_count typed-instruction-at end
    end
