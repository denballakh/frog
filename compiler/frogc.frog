proc verify-procedure-cfg-reachability ProcedureAnalysis* -- do
    let analysis do
        analysis @ProcedureAnalysis.cfg_block_count
        let block-count do
            block-count alloc
            let reachable do
                0
                while dup block-count < do
                    dup let block-index do 0 reachable block-index byte-write end
                    1 +
                end
                drop

                block-count cell-bytes * alloc
                let pending do
                    1 reachable 0 byte-write
                    0 pending 0 field-write
