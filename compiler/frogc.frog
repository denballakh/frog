proc compile-inferred-record-field CompileContext* ptr int bool -- bool do
    let cc bytes length setter do
        if length 2 <= do
            cc "invalid inferred record field" fail-compile-word
            false
        else
            if cc @CompileContext.type_count 0 <= do
                cc "compile-time stack underflow" fail-compile-word
            end
            cc cc @CompileContext.type_count 1 - type-at-depth
            cc @CompileContext.program swap record-receiver-type
            let record-type pointer-receiver do
                cc @CompileContext.program @Program.module_head record-type 0 find-record-type-from
                let module record-index found do
                    if found ! do
                        cc "inferred field access requires a record" fail-compile-word
                        false
                    else
                        module record-index bytes 2 + length 2 - find-record-field
                        let field-index do
                            if field-index 0 < do cc "unknown record field" fail-compile-word end
                            module record-index record-type-at
                            module field-index record-field-at
                            let record-entry field do
                                cc record-entry field
                                field-index record-entry @RecordTypeEntry.field_start -
                                pointer-receiver setter compile-resolved-record-field
                            end
                            true
                        end
                    end
                end
            end
        end
    end
end

