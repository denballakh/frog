    end
end

proc validate-c-include-token ModuleContext* int -- do
    let ctx token do
        if ctx token token-at @TokenEntry.kind TokenKind:string != do ctx token "expected C include path string" fail-at end
        ctx token decoded-string-length
        let length do
            if length 0 == do ctx token "C include path must not be empty" fail-at end
            0
            while dup length < do
                dup let index do
                    if ctx token index decoded-string-byte valid-c-include-byte ! do ctx token "invalid C include path" fail-at end
                end
                1 +
            end
            drop
        end
    end
end

proc validate-c-type-spelling ModuleContext* int -- do
