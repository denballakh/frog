end

proc byte-in-range int int int -- bool do
    let value lower upper do value lower >= value upper <= && end
end

proc utf8-continuation-byte int -- bool do
    peek value do 128 191 byte-in-range end
end

proc utf8-sequence-width ptr int int -- int do
    let bytes length index do
        if index length >= do
            0
        else
            bytes index byte-read
            let first do
                if first 127 <= do
                    1
                elif first 194 223 byte-in-range do
                    if index 2 + length > do
                        0
                    elif bytes index 1 + byte-read utf8-continuation-byte do
                        2
                    else
                        0
                    end
                elif first 224 == do
                    if index 3 + length > do
                        0
                    elif
                        bytes index 1 + byte-read 160 191 byte-in-range
                        bytes index 2 + byte-read utf8-continuation-byte &&
                    do
                        3
                    else
                        0
                    end
                elif
                    first 225 236 byte-in-range
                    first 238 239 byte-in-range ||
                do
                    if index 3 + length > do
                        0
                    elif
                        bytes index 1 + byte-read utf8-continuation-byte
                        bytes index 2 + byte-read utf8-continuation-byte &&
                    do
                        3
                    else
                        0
                    end
                elif first 237 == do
                    if index 3 + length > do
                        0
                    elif
                        bytes index 1 + byte-read 128 159 byte-in-range
                        bytes index 2 + byte-read utf8-continuation-byte &&
                    do
                        3
                    else
                        0
                    end
                elif first 240 == do
                    if index 4 + length > do
                        0
                    elif
                        bytes index 1 + byte-read 144 191 byte-in-range
                        bytes index 2 + byte-read utf8-continuation-byte &&
                        bytes index 3 + byte-read utf8-continuation-byte &&
                    do
                        4
                    else
                        0
                    end
                elif first 241 243 byte-in-range do
                    if index 4 + length > do
                        0
                    elif
                        bytes index 1 + byte-read utf8-continuation-byte
                        bytes index 2 + byte-read utf8-continuation-byte &&
                        bytes index 3 + byte-read utf8-continuation-byte &&
                    do
                        4
                    else
                        0
                    end
                elif first 244 == do
                    if index 4 + length > do
                        0
                    elif
                        bytes index 1 + byte-read 128 143 byte-in-range
                        bytes index 2 + byte-read utf8-continuation-byte &&
                        bytes index 3 + byte-read utf8-continuation-byte &&
                    do
                        4
                    else
                        0
                    end
                else
                    0
                end
            end
        end
    end
