        if kind OperationKind.literal? do "literal" emit
        elif kind OperationKind.local? do "local" emit
        elif kind OperationKind.constant? do "constant" emit
        elif kind OperationKind.procedure_call? do "procedure_call" emit
        elif kind OperationKind.macro_call? do "macro_call" emit
        elif kind OperationKind.let_binding? do "let_binding" emit
        elif kind OperationKind.peek_binding? do "peek_binding" emit
        elif kind OperationKind.type_literal? do "type_literal" emit
        elif kind OperationKind.record_new? do "record_new" emit
        elif kind OperationKind.record_alloc? do "record_alloc" emit
        elif kind OperationKind.record_sizeof? do "record_sizeof" emit
        elif kind OperationKind.record_field_read? do "record_field_read" emit
        elif kind OperationKind.record_field_write? do "record_field_write" emit
        elif kind OperationKind.union_construct? do "union_construct" emit
        elif kind OperationKind.union_test? do "union_test" emit
        elif kind OperationKind.union_project? do "union_project" emit
        elif kind OperationKind.function_call? do "function_call" emit
        elif kind OperationKind.function_reference? do "function_reference" emit
        elif kind OperationKind.intrinsic? do "intrinsic" emit
        else "unresolved" emit end
    end
end

