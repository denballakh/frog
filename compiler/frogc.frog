proc record-receiver-is-pointer CompileContext* int -- bool do
    let cc record-type do
        if cc @CompileContext.type_count 0 <= do cc "compile-time stack underflow" fail-compile-word end
        cc cc @CompileContext.type_count 1 - type-at-depth
        let actual-type do
            if actual-type record-type == do false
            else
                cc @CompileContext.program record-type program-intern-pointer-type
                let pointer-type do
                    if actual-type pointer-type == do true
                    else cc pointer-type type-expect false end
                end
            end
        end
    end
end

proc compile-record-field CompileContext* ptr int int bool -- bool do
    let cc bytes length separator setter do
        if separator 1 <= separator 1 + length >= || do
            false
        else
            cc @CompileContext.scope_module bytes 1 + separator 1 - visible-record-definition
            let module record-index found do
                if found ! do
                    false
                else
                    separator 1 +
                    let field-start do
                        length field-start -
                        let field-length do
                            module record-index bytes field-start + field-length find-record-field
                            let field-index do
                                if field-index 0 < do
