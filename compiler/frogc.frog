proc create-constant-evaluator ModuleContext* int int -- ConstantEvaluator* do
    let module token constant-index do
        ConstantEvaluator:alloc
        let evaluator do
            module evaluator !ConstantEvaluator.module
            token evaluator !ConstantEvaluator.token
