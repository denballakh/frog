proc evaluate-constant-token ptr ModuleContext int -- do
    let evaluator module token-index do
        module token-index token-kind-at
        let kind do
            if kind token-int == kind token-char == || do
                evaluator type-int module token-index token-value-at constant-evaluator-push
            elif kind token-bool == do
                evaluator type-bool module token-index token-value-at constant-evaluator-push
            elif kind token-string == do
                evaluator type-string module token-index token-value-at constant-evaluator-push
            elif kind token-word == do
                evaluator module token-index evaluate-constant-word
            else
                "unknown token kind" fail
            end
        end
    end
end

