        if cc @cc-emitting do
            cc emit-indent
            cc emit-top-slot " = (Cell)(intptr_t)&" emit
            cc @cc-program string-index emit-string-symbol
            ";" emit 10 putc
        end
    end
end

proc emit-push-string ptr int -- do
    let cc token-index do
        cc cc @cc-defining-module token-index token-value-at emit-push-pooled-string
    end
end

proc emit-call-arguments-from ptr ModuleContext int int int -- do
    let cc ctx proc-index base input-index do
        if input-index ctx proc-index proc-input-count-at < do
            if input-index 0 != do ", " emit end
            cc base input-index + emit-slot
            cc ctx proc-index base input-index 1 + emit-call-arguments-from
        end
    end
end

proc emit-call-arguments ptr ModuleContext int int -- do
    peek cc ctx proc-index base do 0 emit-call-arguments-from end
end

proc emit-call-result-slots ptr int int -- do
    let cc base output-count do
        0
        while dup output-count < do
            dup
            let output-index do
                cc emit-indent
                cc base output-index + emit-slot " = frog_call_result.value_" emit
                output-index emit-unsigned ";" emit 10 putc
            end
            1 +
        end
        drop
    end
end

proc emit-procedure-invocation ptr ModuleContext int int -- do
    let cc module proc-index base do
        module proc-index proc-output-count-at
        let output-count do
            if output-count 0 == do
                cc emit-indent
                module proc-index emit-proc-name
                "(" emit cc module proc-index base emit-call-arguments ");" emit 10 putc
            elif output-count 1 == do
                cc emit-indent cc base emit-slot " = " emit
                module proc-index emit-proc-name
                "(" emit cc module proc-index base emit-call-arguments ");" emit 10 putc
            else
                cc emit-indent
                output-count emit-result-type-name " frog_call_result = " emit
                module proc-index emit-proc-name
                "(" emit cc module proc-index base emit-call-arguments ");" emit 10 putc
                cc base output-count emit-call-result-slots
            end
        end
    end
end

proc emit-call ptr ModuleContext int -- do
    let cc module proc-index do
        if cc @cc-emitting do
            module proc-index proc-output-count-at
            let output-count do
                cc @cc-type-count output-count -
                let base do
                    cc emit-indent "{" emit 10 putc
                    cc indent-more
                    cc module proc-index base emit-procedure-invocation
                    cc indent-less
                    cc emit-indent "}" emit 10 putc
                end
            end
        end
    end
end

proc emit-local-load ptr int -- do
    let cc local-id do
        if cc @cc-emitting do
            cc emit-indent
            cc emit-top-slot " = " emit local-id emit-local-name ";" emit 10 putc
        end
    end
end

proc compile-if ptr -- do
    block-if push-block drop
end

proc compile-while ptr -- do
    peek cc do block-while push-block drop
        cc "while (1) {" emit-line
        cc indent-more
    end
end

proc require-block-types ptr ptr -- do
    let cc block do
        block block-base-types-offset block-pointer-field
        block block-base-count-offset block-field
        cc rot rot types-match
        let matches do
            if matches ! do
                "control-flow stack shape mismatch" fail
            end
        end
    end
end

proc compile-do ptr -- do
    peek cc do top-block
        let block do
            if block block-has-do-offset block-field 0 != do
                "duplicate do in control-flow block" fail
            end
            if cc @cc-type-count block block-base-count-offset block-field <= do
                if block block-elif-parent-offset block-field 0 != do
                    "elif requires a condition before do" fail
                else
                    "if or while requires a condition before do" fail
                end
            end
            cc type-bool type-expect
            cc block require-block-types
            block block-kind-offset block-field
            let kind do
                if kind block-if == do
                    cc @cc-type-count
                    let condition-index do
                        if cc @cc-emitting do
                            cc emit-indent "if (" emit cc condition-index emit-slot " != 0) {" emit 10 putc
                        end
                    end
                    cc indent-more
                else
                    if kind block-while == do
                        cc @cc-type-count
                        let condition-index do
                            if cc @cc-emitting do
                                cc emit-indent "if (" emit cc condition-index emit-slot " == 0) break;" emit 10 putc
                            end
                        end
                    else
                        "do does not close an if or while condition" fail
                    end
                end
            end
            1 block block-has-do-offset set-block-field
        end
    end
end

proc compile-else ptr -- do
    peek cc do top-block
        let block do
            if block block-kind-offset block-field block-if != do
                "else outside if" fail
            end
            if block block-has-else-offset block-field 0 != do
                "duplicate else" fail
            end
            if block block-has-do-offset block-field 0 == do
                "else requires a preceding if arm and do" fail
            end
            cc type-snapshot
            let then-types then-count do
                then-types block block-then-types-offset set-block-pointer-field
                then-count block block-then-count-offset set-block-field
            end
            cc
            block block-base-types-offset block-pointer-field
            block block-base-count-offset block-field
            restore-type-snapshot
            1 block block-has-else-offset set-block-field
            cc indent-less
            cc "} else {" emit-line
            cc indent-more
        end
    end
end

proc compile-elif ptr -- do
    peek cc do top-block
        let block do
            if block block-kind-offset block-field block-if != do
                "elif outside if" fail
            end
            if block block-has-do-offset block-field 0 == do
                "elif requires a preceding if arm and do" fail
            end
            if block block-has-else-offset block-field 0 != do
                "elif after else" fail
            end
            cc compile-else
            cc block-if push-block
            let nested do
                1 nested block-elif-parent-offset set-block-field
            end
        end
    end
end

proc close-if-block ptr ptr -- do
    let cc block do
        if block block-has-do-offset block-field 0 == do
            "if requires do before end" fail
        end
        if block block-has-else-offset block-field 0 == do
            cc block require-block-types
        else
            block block-then-types-offset block-pointer-field
            block block-then-count-offset block-field
            let then-types then-count do
                if cc then-types then-count types-match ! do
                    "if branches leave different stack shapes" fail
                end
                cc then-types then-count restore-type-snapshot
            end
        end
        cc indent-less
        cc "}" emit-line
    end
end

proc close-while-block ptr ptr -- do
    let cc block do
        if block block-has-do-offset block-field 0 == do
            "while requires do before end" fail
        end
        cc block require-block-types
        cc indent-less
        cc "}" emit-line
    end
end

proc close-let-block ptr ptr -- do
    let cc block do
        block block-local-base-offset block-field cc !cc-local-count
        cc indent-less
        cc "}" emit-line
    end
end

proc close-end-chain ptr ptr -- do
    let cc block do
        block block-kind-offset block-field
        let kind do
            if kind block-if == do
                cc block close-if-block
            elif kind block-while == do
                cc block close-while-block
            elif kind block-let == do
                cc block close-let-block
            else
                "unknown block kind" fail
            end
        end
        if block block-elif-parent-offset block-field 0 != do
            cc pop-block
            let parent do
                cc parent close-end-chain
            end
        end
    end
end

proc compile-end ptr -- do
    peek cc do pop-block
        let block do
            cc block close-end-chain
        end
    end
end

proc find-binding-do ptr int String -- int do
    let cc token-index error-message do
        if token-index cc @cc-defining-module @ModuleContext.token_count >= do
            error-message fail
            token-index
        elif cc @cc-defining-module token-index "do" token-equals do
            token-index
        else
            cc @cc-defining-module token-index require-word
            cc token-index 1 + error-message find-binding-do
        end
    end
end

proc bind-let-names ptr int int -- do
    let cc first-token count do
        if count 0 > do
            first-token count 1 - +
            let name-token do
                if cc @cc-defining-module name-token string-type-name do
                    "String cannot be a local name" fail
                end
                cc type-pop
                let value-type do
                    cc name-token value-type add-local
                    let local-id do
                        if cc @cc-emitting do
                            cc emit-indent
                            "Cell " emit local-id emit-local-name " = " emit
                            cc cc @cc-type-count emit-slot ";" emit 10 putc
                            cc emit-indent
                            "(void)" emit local-id emit-local-name ";" emit 10 putc
                        end
                    end
                end
                cc first-token count 1 - bind-let-names
            end
        end
    end
end

proc begin-binding-block ptr int int -- do
    let cc first-token name-count do
        cc block-let push-block drop
        cc "{" emit-line
        cc indent-more
        cc first-token name-count bind-let-names
    end
end

proc restore-peek-names ptr int int -- do
    let cc first-token name-count do
        if name-count 0 > do
            cc first-token find-local
            let local-index do
                if local-index 0 < do
                    "internal peek binding not found" fail
                end
                cc first-token local-index compile-local-reference
                cc first-token 1 + name-count 1 - restore-peek-names
            end
        end
    end
end

proc compile-let ptr int -- int do
    peek cc let-token do 1 + "unterminated let binding" find-binding-do
        peek do-token do let-token 1 + -
            let name-count do
                if name-count 0 <= do
                    "let requires at least one name" fail
                end
                cc let-token 1 + name-count begin-binding-block
                do-token 1 +
            end
        end
    end
end

proc compile-peek ptr int -- int do
    peek cc peek-token do 1 + "unterminated peek binding" find-binding-do
        peek do-token do peek-token 1 + -
            let name-count do
                if name-count 0 <= do
                    "peek requires at least one name" fail
                end
                cc peek-token 1 + name-count begin-binding-block
                cc peek-token 1 + name-count restore-peek-names
                do-token 1 +
            end
        end
    end
end

proc compile-local-reference ptr int int -- do
    let cc token-index local-index do
        cc local-index local-address
        peek local do @LocalEntry.value_type cc swap type-push
            cc local @LocalEntry.id emit-local-load
        end
    end
end

proc compile-procedure-call ptr int ModuleContext int -- do
    let cc token-index module proc-index do
        cc module proc-index apply-proc-contract
        cc module proc-index emit-call
    end
end

proc first-index-of-byte-from ptr int int int -- int do
    let bytes length value index do
        if index length >= do
            0 1 -
        elif bytes index byte-read value == do
            index
        else
            bytes length value index 1 + first-index-of-byte-from
        end
    end
end

proc first-index-of-byte ptr int int -- int do 0 first-index-of-byte-from end

