                                end
                                module record-index record-type-at
                                let record-entry do
                                    module field-index record-field-at
                                    let field do
                                        if setter do OperationKind:record_field_write else OperationKind:record_field_read end
                                        let operation-kind do
                                            cc operation-kind module field-index set-operation-target
                                        end
                                        cc record-entry @RecordTypeEntry.record_type record-receiver-is-pointer
                                        let pointer-receiver do
                                            if cc @CompileContext.instruction_active do
                                                record-entry @RecordTypeEntry.record_type cc active-typed-instruction !TypedInstruction.value_type
                                                field @RecordFieldEntry.field_type cc active-typed-instruction !TypedInstruction.secondary_type
                                                module cc active-typed-instruction !TypedInstruction.secondary_module
                                                record-index cc active-typed-instruction !TypedInstruction.secondary_index
                                                if pointer-receiver do 1 else 0 end cc active-typed-instruction !TypedInstruction.payload
                                            end
                                            cc record-entry field
                                            field-index record-entry @RecordTypeEntry.field_start -
                                            pointer-receiver setter compile-resolved-record-field
                                        end
                                    true
                                end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc compile-record-word CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.defining_module token-index token-slice
        let bytes length do
            if length 2 >= bytes 0 byte-read 64 == && bytes 1 byte-read 46 == && do
                cc bytes length false compile-inferred-record-field
            elif length 2 >= bytes 0 byte-read 33 == && bytes 1 byte-read 46 == && do
                cc bytes length true compile-inferred-record-field
            else
                bytes length 58 first-index-of-byte
            let colon do
                if colon 0 >= do
                    cc bytes length colon compile-record-special
                else
                    if
                        length 0 >
                        if dup do
                            drop
                            bytes 0 byte-read 64 ==
                            bytes 0 byte-read 33 == ||
                        end
                    do
                        bytes length 46 first-index-of-byte
                        let dot do
                            if dot 0 >= do
                                cc bytes length dot bytes 0 byte-read 33 == compile-record-field
                            else
                                false
                            end
                        end
                    else
                        false
                    end
                end
            end
            end
        end
    end
end

proc emit-union-constructor CompileContext* int int int -- do
    let cc tag payload-type union-type do
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 -
            let result-index do
                cc emit-indent "{ " emit
                union-type emit-c-union-type-name " union_value = { 0 }; union_value.tag = " emit
                tag emit-unsigned ";" emit
                if payload-type type-none != do
                    " union_value.payload." emit tag emit-c-union-case-member-name " = " emit
                    cc result-index payload-type emit-slot-as ";" emit
                end
                " " emit cc result-index union-type emit-slot-as " = union_value; }" emit
                10 putc
            end
        end
    end
end

proc emit-union-predicate CompileContext* int int int -- do
    let cc union-type tag case-count do
        if cc @CompileContext.emitting do
            cc @CompileContext.type_count 1 -
            let value-index do
                cc emit-indent "{ " emit union-type emit-c-union-type-name " union_value = " emit
                cc value-index union-type emit-slot-as "; if (union_value.tag < 0 || union_value.tag >= " emit
                case-count emit-unsigned ") frog_runtime_fail(); " emit
                cc value-index type-bool emit-slot-as " = union_value.tag == " emit
                tag emit-unsigned "; }" emit 10 putc
            end
        end
    end
end

proc emit-union-projection CompileContext* int int int int -- do
    let cc union-type payload-type tag case-count do
        if cc @CompileContext.emitting do
            if payload-type type-none != do cc @CompileContext.type_count 1 - else cc @CompileContext.type_count end
            let value-index do
                cc emit-indent "{ " emit union-type emit-c-union-type-name " union_value = " emit
                cc value-index union-type emit-slot-as "; if (union_value.tag < 0 || union_value.tag >= " emit
                case-count emit-unsigned ") frog_runtime_fail(); if (union_value.tag != " emit
                tag emit-unsigned
                ") frog_runtime_fail();" emit
                if payload-type type-none != do
                    " " emit cc value-index payload-type emit-slot-as " = " emit
                    "union_value.payload." emit tag emit-c-union-case-member-name ";" emit
                end
                " }" emit
                10 putc
            end
        end
    end
end

proc compile-union-constructor CompileContext* ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @CompileContext.scope_module bytes separator visible-union-definition
            let module union-index found do
                if found ! do
                    false
                else
                    module union-index
                    bytes separator 1 + +
                    length separator 1 + -
                    find-union-case
                    let case-index do
                        if case-index 0 < do
                            cc "unknown union variant" fail-compile-word
                        end
                        module case-index union-case-at @UnionCaseEntry.payload_type
                        let payload-type do
                            cc OperationKind:union_construct module case-index set-operation-target
                            if cc @CompileContext.instruction_active do
                                module union-index union-type-at @UnionTypeEntry.union_type cc active-typed-instruction !TypedInstruction.value_type
                                payload-type cc active-typed-instruction !TypedInstruction.secondary_type
                                module cc active-typed-instruction !TypedInstruction.secondary_module
                                union-index cc active-typed-instruction !TypedInstruction.secondary_index
                                module case-index union-case-at @UnionCaseEntry.tag cc active-typed-instruction !TypedInstruction.payload
                            end
                            if payload-type type-none != do
                                cc payload-type type-expect
                            end
                            module union-index union-type-at @UnionTypeEntry.union_type cc swap type-push
                            cc
                            module case-index union-case-at @UnionCaseEntry.tag
                            payload-type
                            module union-index union-type-at @UnionTypeEntry.union_type
                            emit-union-constructor
                            true
                        end
                    end
                end
            end
        end
    end
end

proc compile-union-instance CompileContext* ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @CompileContext.scope_module bytes separator visible-union-definition
            let module union-index found do
                if found ! do
                    false
                else
                    separator 1 +
                    let case-start do
                        bytes length 1 - byte-read 63 ==
                        let predicate do
                            length case-start -
                            if predicate do 1 - end
                            let case-length do
                                if case-length 0 <= do
                                    cc "unknown union variant" fail-compile-word
                                end
                                module union-index bytes case-start + case-length find-union-case
                                let case-index do
                                    if case-index 0 < do
                                        cc "unknown union variant" fail-compile-word
                                    end
                                    module union-index union-type-at @UnionTypeEntry.union_type
                                    let union-type do
                                        if predicate do OperationKind:union_test else OperationKind:union_project end
                                        let operation-kind do
                                            cc operation-kind module case-index set-operation-target
                                        end
                                        if cc @CompileContext.instruction_active do
                                            union-type cc active-typed-instruction !TypedInstruction.value_type
                                            module case-index union-case-at @UnionCaseEntry.payload_type cc active-typed-instruction !TypedInstruction.secondary_type
                                            module cc active-typed-instruction !TypedInstruction.secondary_module
                                            union-index cc active-typed-instruction !TypedInstruction.secondary_index
                                            module case-index union-case-at @UnionCaseEntry.tag cc active-typed-instruction !TypedInstruction.payload
                                        end
                                        cc union-type type-expect
                                        if predicate do
                                            cc type-bool type-push
                                            cc
                                            union-type
                                            module case-index union-case-at @UnionCaseEntry.tag
                                            module union-index union-type-at @UnionTypeEntry.case_count
                                            emit-union-predicate
                                        else
                                            module case-index union-case-at @UnionCaseEntry.payload_type
                                            let payload-type do
                                                if payload-type type-none != do
                                                    cc payload-type type-push
                                                end
                                                cc
                                                union-type
                                                payload-type
                                                module case-index union-case-at @UnionCaseEntry.tag
                                                module union-index union-type-at @UnionTypeEntry.case_count
                                                emit-union-projection
                                            end
                                        end
                                        true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc compile-union-word CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.defining_module token-index token-slice
        peek bytes length do 58 first-index-of-byte
            let colon do
                if colon 0 >= do
                    cc bytes length colon compile-union-constructor
                else
                    bytes length 46 first-index-of-byte
                    let dot do
                        if dot 0 >= do
                            cc bytes length dot compile-union-instance
                        else
                            false
                        end
                    end
                end
            end
        end
    end
end

proc emit-function-dispatch-module CompileContext* ModuleContext* int ModuleContext* int -- do
    let cc function-module function-index proc-module base do
        0
        while dup proc-module @ModuleContext.proc_count < do
            dup
            let proc-index do
                if
                    function-module function-index proc-module proc-index
                    function-proc-contracts-equal
                do
                    cc emit-indent "case " emit
                    proc-module proc-index procedure-at @ProcedureEntry.global_id emit-unsigned
                    ": {" emit 10 putc
                    cc indent-more
                    cc proc-module proc-index base emit-procedure-invocation
                    cc emit-indent "break;" emit 10 putc
                    cc indent-less
                    cc emit-indent "}" emit 10 putc
                end
            end
            1 +
        end
        drop
    end
end

proc emit-function-dispatch-cases CompileContext* Program* ModuleContext* int int -- do
    let cc program function-module function-index base do
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            let proc-module do
                cc function-module function-index proc-module base emit-function-dispatch-module
                proc-module @ModuleContext.next_module
            end
        end
        drop
    end
end

proc emit-function-call CompileContext* ModuleContext* int -- do
    let cc function-module function-index do
        if cc @CompileContext.emitting do
            function-module function-index function-type-at @FunctionTypeEntry.output_count
            let output-count do
                cc @CompileContext.type_count output-count -
                let base do
                    function-module function-index function-type-at @FunctionTypeEntry.input_count
                    let input-count do
                        cc emit-indent "{ Cell function_id = " emit
                        cc base input-count +
                        function-module function-index function-type-at @FunctionTypeEntry.function_type
                        emit-slot-as ";" emit 10 putc
                        cc indent-more
                        cc emit-indent "switch (function_id) {" emit 10 putc
                        cc indent-more
                        cc cc @CompileContext.program function-module function-index base emit-function-dispatch-cases
                        cc emit-indent "default: frog_runtime_fail();" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                        cc indent-less
                        cc emit-indent "}" emit 10 putc
                    end
                end
            end
        end
    end
end

proc fail-function-reference-contract CompileContext* ModuleContext* int ModuleContext* int -- do
    let cc function-module function-index proc-module proc-index do
        cc emit-compile-word-error-prefix
        "function reference contract mismatch: expected " emit-error
        cc @CompileContext.program function-module function-index emit-error-function-contract
        ", actual " emit-error
        cc @CompileContext.program proc-module proc-index emit-error-proc-contract
        10 eputc
        1 exit
    end
end

proc compile-function-operation CompileContext* ptr int int -- bool do
    let cc bytes length separator do
        if separator 0 <= separator 1 + length >= || do
            false
        else
            cc @CompileContext.scope_module bytes separator visible-function-definition
            let function-module function-index found do
                if found ! do
                    false
                else
                    bytes separator 1 + +
                    length separator 1 + -
                    let operation operation-length do
                        if operation operation-length "call" bytes-equal-string do
                            cc OperationKind:function_call function-module function-index set-operation-target
                            cc function-module function-index apply-function-contract
                            cc function-module function-index emit-function-call
                            true
                        elif operation operation-length "ref" bytes-equal-string do
                            cc "expected function reference target" fail-compile-word
                            false
                        elif
                            operation-length 4 >=
                            if dup do
                                drop operation 4 "ref:" bytes-equal-string
                            end
                        do
                            if operation-length 4 == do
                                cc "expected function reference target" fail-compile-word
                            end
                            function-module function-index
                            cc @CompileContext.scope_module
                            operation 4 +
                            operation-length 4 -
                            visible-function-reference-matches
                            let proc-module proc-index count proc-found do
                                if count 1 > do
                                    cc "ambiguous function reference target" fail-compile-word
                                end
                                if count 0 == do
                                    cc @CompileContext.scope_module
                                    operation 4 +
                                    operation-length 4 -
                                    visible-procedure-definition
                                    let actual-module actual-index actual-found do
                                        if actual-found do
                                            cc function-module function-index actual-module actual-index
                                            fail-function-reference-contract
                                        else
                                            cc "function reference target not found" fail-compile-word
                                        end
                                    end
                                end
                                cc OperationKind:function_reference function-module function-index set-operation-target
                                cc proc-module proc-index set-operation-secondary-target
                                cc proc-module proc-index procedure-at @ProcedureEntry.global_id set-operation-payload
                                cc function-module function-index function-type-at @FunctionTypeEntry.function_type type-push
                                cc proc-module proc-index procedure-at @ProcedureEntry.global_id emit-push-integer
                                true
                            end
                        else
                            cc "unknown function operation" fail-compile-word
                            false
                        end
                    end
                end
            end
        end
    end
end

proc compile-function-word CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.defining_module token-index token-slice
        peek bytes length do 58 first-index-of-byte
            let colon do
                if colon 0 >= do
                    cc bytes length colon compile-function-operation
                else
                    false
                end
            end
        end
    end
end

proc compile-string-word CompileContext* int -- bool do
    let cc token-index do
        if cc @CompileContext.defining_module token-index "String.bytes" token-equals do
            cc IntrinsicOperation:string_bytes type-string PrivateOperation:none set-operation-intrinsic
            cc type-string type-expect
            cc type-ptr register-replaced-stack-slot
            cc type-ptr type-push
            if cc @CompileContext.emitting do
                cc @CompileContext.type_count 1 - let index do
                cc emit-indent cc index type-ptr emit-slot-as " = (void *)" emit
                cc index type-string emit-slot-as ".bytes;" emit 10 putc
                end
            end
            true
        elif cc @CompileContext.defining_module token-index "String.len" token-equals do
            cc IntrinsicOperation:string_len type-string PrivateOperation:none set-operation-intrinsic
            cc type-string type-expect
            cc type-int register-replaced-stack-slot
            cc type-int type-push
            if cc @CompileContext.emitting do
                cc @CompileContext.type_count 1 - let index do
                cc emit-indent cc index type-int emit-slot-as " = " emit
                cc index type-string emit-slot-as ".len;" emit 10 putc
                end
            end
