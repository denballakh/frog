proc require-block-types ptr ptr -- do
    let cc block do
        block block-base-types-offset block-pointer-field
        block block-base-count-offset block-field
        cc rot rot types-match
        let matches do
            if matches ! do
                "control-flow stack shape mismatch" fail
            end
        end
    end
end

proc compile-do ptr -- do
    let cc do
        cc top-block
        let block do
            if block block-has-do-offset block-field 0 != do
                "duplicate do in control-flow block" fail
            end
            if cc cc-type-count block block-base-count-offset block-field <= do
                if block block-elif-parent-offset block-field 0 != do
                    "elif requires a condition before do" fail
                else
                    "if or while requires a condition before do" fail
                end
            end
            cc type-bool type-expect
            cc block require-block-types
            block block-kind-offset block-field
            let kind do
                if kind block-if == do
                    cc "if (frog_pop() != 0) {" emit-line
                    cc indent-more
                else
                    if kind block-while == do
                        cc "if (frog_pop() == 0) break;" emit-line
                    else
                        "do does not close an if or while condition" fail
                    end
                end
            end
            1 block block-has-do-offset set-block-field
        end
    end
end

proc compile-else ptr -- do
    let cc do
        cc top-block
        let block do
            if block block-kind-offset block-field block-if != do
                "else outside if" fail
            end
            if block block-has-else-offset block-field 0 != do
                "duplicate else" fail
            end
            cc type-snapshot
            let then-types then-count do
                then-types block block-then-types-offset set-block-pointer-field
                then-count block block-then-count-offset set-block-field
            end
            cc
            block block-base-types-offset block-pointer-field
            block block-base-count-offset block-field
            restore-type-snapshot
            1 block block-has-else-offset set-block-field
            cc indent-less
            cc "} else {" emit-line
            cc indent-more
        end
    end
end

proc compile-elif ptr -- do
    let cc do
        cc top-block
        let block do
            if block block-kind-offset block-field block-if != do
                "elif outside if" fail
            end
            if block block-has-do-offset block-field 0 == do
                "elif requires a preceding if arm and do" fail
            end
            if block block-has-else-offset block-field 0 != do
                "elif after else" fail
            end
            cc compile-else
            cc block-if push-block
            let nested do
                1 nested block-elif-parent-offset set-block-field
            end
        end
    end
end

proc close-if-block ptr ptr -- do
    let cc block do
        if block block-has-else-offset block-field 0 == do
            cc block require-block-types
        else
            block block-then-types-offset block-pointer-field
            block block-then-count-offset block-field
            let then-types then-count do
                if cc then-types then-count types-match ! do
                    "if branches leave different stack shapes" fail
                end
                cc then-types then-count restore-type-snapshot
            end
        end
        cc indent-less
        cc "}" emit-line
    end
end

proc close-while-block ptr ptr -- do
    let cc block do
        cc block require-block-types
        cc indent-less
        cc "}" emit-line
    end
end

proc close-let-block ptr ptr -- do
    let cc block do
        block block-local-base-offset block-field cc set-cc-local-count
        cc indent-less
        cc "}" emit-line
    end
end

proc close-end-chain ptr ptr -- do
    let cc block do
        block block-kind-offset block-field
        let kind do
            if kind block-if == do
                cc block close-if-block
            elif kind block-while == do
                cc block close-while-block
            elif kind block-let == do
                cc block close-let-block
            else
                "unknown block kind" fail
            end
        end
        if block block-elif-parent-offset block-field 0 != do
            cc pop-block
            let parent do
                cc parent close-end-chain
            end
        end
    end
end

proc compile-end ptr -- do
    let cc do
        cc pop-block
        let block do
            cc block close-end-chain
        end
    end
end

proc find-let-do ptr int -- int do
    let cc token-index do
        if token-index cc cc-defining-module ctx-token-count >= do
            "unterminated let binding" fail
            token-index
        elif cc cc-defining-module token-index "do" token-equals do
            token-index
        else
            cc cc-defining-module token-index require-word
            cc token-index 1 + find-let-do
        end
    end
end

proc bind-let-names ptr int int -- do
    let cc first-token count do
        if count 0 > do
            first-token count 1 - +
            let name-token do
                cc type-pop
                let value-type do
                    cc name-token value-type add-local
                    let local-id do
                        cc emit-indent
                        "Cell " emit local-id emit-local-name
                        " = frog_pop();" emit 10 putc
                        cc emit-indent
                        "(void)" emit local-id emit-local-name ";" emit 10 putc
                    end
                end
                cc first-token count 1 - bind-let-names
            end
        end
    end
end

proc compile-let ptr int -- int do
    let cc let-token do
        cc let-token 1 + find-let-do
        let do-token do
            do-token let-token 1 + -
            let name-count do
                if name-count 0 <= do
                    "let requires at least one name" fail
                end
                cc block-let push-block drop
                cc "{" emit-line
                cc indent-more
                cc let-token 1 + name-count bind-let-names
                do-token 1 +
            end
        end
    end
end

proc compile-local-reference ptr int int -- do
    let cc token-index local-index do
        cc local-index local-address
        let local do
            local local-type-offset local-field cc swap type-push
            cc local local-id-offset local-field emit-local-load
        end
    end
end

proc compile-procedure-call ptr int ptr int -- do
    let cc token-index module proc-index do
        cc module proc-index apply-proc-contract
        cc module proc-index emit-call
    end
end

proc compile-type-word ptr int -- bool do
    let cc token-index do
        if cc cc-defining-module token-index "int" token-equals do
            cc type-literal-base type-int + type-push
            cc type-literal-base type-int + emit-push-integer
            true
        elif cc cc-defining-module token-index "bool" token-equals do
            cc type-literal-base type-bool + type-push
            cc type-literal-base type-bool + emit-push-integer
            true
        elif cc cc-defining-module token-index "ptr" token-equals do
            cc type-literal-base type-ptr + type-push
            cc type-literal-base type-ptr + emit-push-integer
            true
        else
            false
        end
    end
end

proc compile-macro ptr ptr int -- do
    let cc module macro-index do
        if module macro-index macro-expanding-at do
            "recursive macro expansion" fail
        end
        true module macro-index set-macro-expanding
        cc cc-defining-module
        cc cc-scope-module
        let previous-defining-module previous-scope-module do
            module cc set-cc-defining-module
            module cc set-cc-scope-module
            cc
            module macro-index macro-body-start-at
            module macro-index macro-body-end-at
            compile-body-range
            previous-defining-module cc set-cc-defining-module
            previous-scope-module cc set-cc-scope-module
        end
        false module macro-index set-macro-expanding
    end
end

proc compile-ordinary-word ptr int -- do
    let cc token-index do
        cc cc-scope-module cc cc-defining-module token-index find-scope-symbol
        let symbol-index do
            if symbol-index 0 >= do
                cc cc-scope-module symbol-index scope-kind-at scope-macro ==
            else
                false
            end
            let is-macro do
            if is-macro do
                cc
                cc cc-scope-module symbol-index scope-definition-module-at
                cc cc-scope-module symbol-index scope-definition-index-at
                compile-macro
            elif cc token-index compile-type-word do
            elif cc token-index compile-intrinsic do
            else
                cc token-index find-local
                let local-index do
                    if local-index 0 >= do
                        cc token-index local-index compile-local-reference
                    else
                        if symbol-index 0 < do
                            "unknown word" fail
                        end
                        if cc cc-scope-module symbol-index scope-kind-at scope-procedure != do
                            "unknown word" fail
                        end
                        cc
                        token-index
                        cc cc-scope-module symbol-index scope-definition-module-at
                        cc cc-scope-module symbol-index scope-definition-index-at
                        compile-procedure-call
                    end
                end
            end
            end
        end
    end
end

proc compile-word-token ptr int -- int do
    let cc token-index do
        if cc cc-defining-module token-index "if" token-equals do
            cc compile-if token-index 1 +
        elif cc cc-defining-module token-index "while" token-equals do
            cc compile-while token-index 1 +
        elif cc cc-defining-module token-index "do" token-equals do
            cc compile-do token-index 1 +
        elif cc cc-defining-module token-index "else" token-equals do
            cc compile-else token-index 1 +
        elif cc cc-defining-module token-index "elif" token-equals do
            cc compile-elif token-index 1 +
        elif cc cc-defining-module token-index "end" token-equals do
            cc compile-end token-index 1 +
        elif cc cc-defining-module token-index "let" token-equals do
            cc token-index compile-let
        else
            cc token-index compile-ordinary-word
            token-index 1 +
        end
    end
end

proc compile-token ptr int -- int do
    let cc token-index do
        cc cc-defining-module token-index token-kind-at
        let kind do
            if kind token-int == do
                cc type-int type-push
                cc cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-bool == do
                cc type-bool type-push
                cc cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-char == do
                cc type-int type-push
                cc cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-string == do
                cc type-ptr type-push
                cc type-int type-push
                cc token-index emit-push-string
                token-index 1 +
            elif kind token-word == do
                cc token-index compile-word-token
            else
                "unknown token kind" fail
                token-index 1 +
            end
        end
    end
end

proc initialize-proc-inputs ptr int -- do
    let cc input-index do
        if input-index cc cc-procedure-module cc cc-proc proc-input-count-at < do
            cc cc-procedure-module
            cc cc-procedure-module cc cc-proc proc-input-start-at
            input-index +
            type-at
            cc swap type-push
            cc input-index 1 + initialize-proc-inputs
        end
    end
end

proc outputs-match-from ptr int -- bool do
    let cc output-index do
        if output-index cc cc-type-count >= do
            true
        else
            cc output-index type-at-depth
            cc cc-procedure-module
            cc cc-procedure-module cc cc-proc proc-output-start-at
            output-index +
            type-at
            ==
            let matches do
                if matches do
                    cc output-index 1 + outputs-match-from
                else
                    false
                end
            end
        end
    end
end

proc require-proc-outputs ptr -- do
    let cc do
        if cc cc-type-count cc cc-procedure-module cc cc-proc proc-output-count-at != do
            "procedure output stack depth mismatch" fail
        end
        if cc 0 outputs-match-from ! do
            "procedure output stack type mismatch" fail
        end
    end
end

proc compile-body-range ptr int int -- do
    let cc token-index body-end do
        token-index
        while dup body-end < do
            cc swap compile-token
        end
        drop
    end
end

proc create-compile-context ptr ptr int -- ptr do
    let program ctx proc-index do
        cc-bytes alloc
        let cc do
            program cc set-cc-program
            ctx cc set-cc-procedure-module
            ctx cc set-cc-defining-module
            ctx cc set-cc-scope-module
            proc-index cc set-cc-proc
            program program-token-count 1 + cell-bytes * alloc cc set-cc-type-stack
            0 cc set-cc-type-count
            program program-token-count 1 + block-bytes * alloc cc set-cc-blocks
            0 cc set-cc-block-count
            program program-token-count 1 + local-bytes * alloc cc set-cc-locals
            0 cc set-cc-local-count
            0 cc set-cc-next-local
            0 cc set-cc-indent
            cc
        end
    end
end

proc compile-procedure ptr ptr int -- do
    let program ctx proc-index do
        program ctx proc-index create-compile-context
        let cc do
            cc 0 initialize-proc-inputs
            "void " emit
            ctx proc-index proc-global-id-at emit-proc-name
            "(void) {" emit 10 putc
            1 cc set-cc-indent
            cc
            ctx proc-index proc-body-start-at
            ctx proc-index proc-body-end-at
            compile-body-range
            if cc cc-block-count 0 != do
                "unclosed control-flow block" fail
            end
            if cc cc-local-count 0 != do
                "unclosed local scope" fail
            end
            cc require-proc-outputs
            "}" emit 10 putc
        end
    end
end

proc compile-module-procedures ptr ptr -- do
    let program ctx do
        0
        while dup ctx ctx-proc-count < do
            dup program ctx rot compile-procedure
            1 +
        end
        drop
    end
end

proc compile-all-procedures ptr -- do
    let program do
        program program-module-head
        while dup int cast 0 != do
            dup program swap compile-module-procedures
            ctx-next-module
        end
        drop
    end
end

proc emit-main-wrapper ptr -- do
    let program do
        program program-root-module
        let ctx do
        "int main(void) {\n  " emit
        ctx ctx ctx-main-proc proc-global-id-at emit-proc-name
        "();\n  if (frog_stack.count != 0) frog_runtime_fail();\n  free(frog_stack.values);\n  return 0;\n}\n" emit
        end
    end
end
// END BODY COMPILER


proc main -- do
    program-bytes alloc
    let program do
        0 ptr cast program set-program-root-module
        0 ptr cast program set-program-module-head
        0 ptr cast program set-program-module-tail
        0 program set-program-module-count
        0 program set-program-next-proc-id
        0 program set-program-token-count
        ctx-bytes alloc
        let ctx do
            0 ptr cast ctx set-ctx-canonical-path
            0 ctx set-ctx-canonical-path-length
            0 ptr cast ctx set-ctx-imports
            0 ctx set-ctx-import-count
            0 ptr cast ctx set-ctx-scope
            0 ctx set-ctx-scope-count
            load-loading ctx set-ctx-load-state
            resolve-new ctx set-ctx-resolve-state
            true ctx set-ctx-is-root
            program ctx program-add-module
            ctx program set-program-root-module
            read-source
            let source source-length do
            ctx source source-length initialize-module-source
            program ctx load-module-imports
            load-loaded ctx set-ctx-load-state
            program resolve-all-module-scopes

            program emit-c-emitter-support
            program compile-all-procedures
            program emit-main-wrapper
            end
        end
    end
end
