proc emit-c-record-forward-declarations-module ModuleContext* int -- do
    let module index do
        if index module @ModuleContext.record_count < do
            module index record-type-at @RecordTypeEntry.record_type
            let record-type do
                "typedef struct " emit record-type emit-c-record-type-name " " emit record-type emit-c-record-type-name ";\n" emit
            end
            module index 1 + emit-c-record-forward-declarations-module
        end
    end
end

proc emit-c-record-field-type Program* int -- do
    let program field-type do
        if field-type type-is-nominal do
            program @Program.module_head field-type 0 find-record-type-from
            let module record-index found do
                if found do
                    module record-index record-type-at @RecordTypeEntry.record_type emit-c-record-type-name
                else
                    program field-type emit-c-value-type
                end
            end
        elif field-type type-is-typed-pointer do
            program field-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type
            let pointee-type do
                if pointee-type type-is-nominal do
                    program @Program.module_head pointee-type 0 find-record-type-from
                    let module record-index found do
                        if found do
                            module record-index record-type-at @RecordTypeEntry.record_type emit-c-record-type-name " *" emit
                        else
                            program field-type emit-c-value-type
                        end
                    end
                else
                    program field-type emit-c-value-type
                end
            end
        else
            program field-type emit-c-value-type
        end
    end
end

proc emit-c-record-fields Program* ModuleContext* int int -- do
    let program module record-index field-offset do
        if field-offset module record-index record-type-at @RecordTypeEntry.field_count < do
            module module record-index record-type-at @RecordTypeEntry.field_start field-offset + record-field-at
            let field do
                "  " emit program field @RecordFieldEntry.field_type emit-c-record-field-type
                " " emit field-offset emit-c-record-field-name ";\n" emit
            end
            program module record-index field-offset 1 + emit-c-record-fields
        end
    end
end

proc emit-c-record-forward-declarations Program* -- do
    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup 0 emit-c-record-forward-declarations-module
            @ModuleContext.next_module
        end
        drop
    end
end

proc aggregate-c-emitted? ModuleContext* int bool -- bool do
    let module index is-record do
        if is-record do module index record-type-at @RecordTypeEntry.c_emitted
        else module index union-type-at @UnionTypeEntry.c_emitted end
    end
end

proc set-aggregate-c-emitted ModuleContext* int bool -- do
    let module index is-record do
        if is-record do true module index record-type-at !RecordTypeEntry.c_emitted
        else true module index union-type-at !UnionTypeEntry.c_emitted end
    end
end

proc emit-c-aggregate-dependencies Program* ModuleContext* int bool int -- do
    let program module index is-record offset do
        if offset module index is-record aggregate-member-count < do
            if is-record do
                module module index record-type-at @RecordTypeEntry.field_start offset + record-field-at @RecordFieldEntry.field_type
            else
                module module index union-type-at @UnionTypeEntry.case_start offset + union-case-at @UnionCaseEntry.payload_type
            end
            let value-type do
                if value-type type-is-nominal do
                    program value-type find-aggregate-type
                    let dependency-module dependency-index found dependency-record do
                        if found do program dependency-module dependency-index dependency-record emit-c-aggregate-definition end
                    end
                end
            end
            program module index is-record offset 1 + emit-c-aggregate-dependencies
        end
    end
end

proc union-has-payload-from ModuleContext* int int -- bool do
    let module union-index case-offset do
        if case-offset module union-index union-type-at @UnionTypeEntry.case_count >= do
            false
        else
            module
            module union-index union-type-at @UnionTypeEntry.case_start case-offset +
            union-case-at @UnionCaseEntry.payload_type
            type-none !=
            if dup do
            else
                drop module union-index case-offset 1 + union-has-payload-from
            end
        end
    end
end

proc union-has-payload ModuleContext* int -- bool do 0 union-has-payload-from end

proc emit-c-aggregate-definition Program* ModuleContext* int bool -- do
    let program module index is-record do
        if module index is-record aggregate-c-emitted? ! do
            module index is-record set-aggregate-c-emitted
            program module index is-record 0 emit-c-aggregate-dependencies
            if is-record do
                module index record-type-at @RecordTypeEntry.record_type
                let value-type do
                    "struct " emit value-type emit-c-record-type-name " {\n" emit
                    program module index 0 emit-c-record-fields
                    "};\n" emit
                end
            else
                module index union-type-at
                let union-entry do
                    union-entry @UnionTypeEntry.union_type
                    let value-type do
                        "struct " emit value-type emit-c-union-type-name " {\n  Cell tag;\n" emit
                        if module index union-has-payload do
                            "  union {\n" emit
                            program module index 0 emit-c-union-case-members
                            "  } payload;\n" emit
                        end
                        "};\n" emit
                    end
                end
            end
        end
    end
end

proc emit-c-module-aggregate-definitions Program* ModuleContext* int int -- do
    let program module record-index union-index do
        if record-index module @ModuleContext.record_count < do
            program module record-index true emit-c-aggregate-definition
            program module record-index 1 + union-index emit-c-module-aggregate-definitions
        elif union-index module @ModuleContext.union_count < do
            program module union-index false emit-c-aggregate-definition
            program module record-index union-index 1 + emit-c-module-aggregate-definitions
        end
    end
end

proc emit-c-aggregate-definitions Program* -- do
    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup program swap 0 0 emit-c-module-aggregate-definitions
            @ModuleContext.next_module
        end
        drop
    end
end

