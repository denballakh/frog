proc emit-inspect-type Program* int -- do
    let program value-type do
        if value-type 0 < do
            "type:" emit program 0 value-type - emit-inspect-type
        elif value-type type-literal-base > value-type type-nominal-base < && do
            "type:" emit program value-type type-literal-base - emit-inspect-type
        elif value-type type-int == do "int" emit
        elif value-type type-bool == do "bool" emit
        elif value-type type-ptr == do "ptr" emit
        elif value-type type-type == do "type" emit
        elif value-type type-string == do "String" emit
        elif value-type type-i8 == do "i8" emit
        elif value-type type-i16 == do "i16" emit
        elif value-type type-i32 == do "i32" emit
        elif value-type type-i64 == do "i64" emit
        elif value-type type-u8 == do "u8" emit
        elif value-type type-u16 == do "u16" emit
        elif value-type type-u32 == do "u32" emit
        elif value-type type-u64 == do "u64" emit
        elif value-type type-none == do "none" emit
        elif value-type type-is-typed-pointer do
            program program value-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type emit-inspect-type
            "*" emit
        elif value-type type-is-function do
            program @Program.module_head value-type 0 find-function-type-from
            let module index found do
                if found do
                    "function:" emit module @ModuleContext.module_id emit-unsigned ":" emit index emit-unsigned
                else "internal unknown inspected function type" fail end
            end
        elif value-type type-is-nominal do
            program @Program.module_head value-type 0 find-record-type-from
            let module index found do
                if found do
                    "record:" emit module @ModuleContext.module_id emit-unsigned ":" emit index emit-unsigned
                else
                    program @Program.module_head value-type 0 find-union-type-from
                    let union-module union-index union-found do
                        if union-found do
                            "union:" emit union-module @ModuleContext.module_id emit-unsigned ":" emit union-index emit-unsigned
                        else "internal unknown inspected nominal type" fail end
                    end
                end
            end
        else "internal unknown inspected type" fail end
    end
end

