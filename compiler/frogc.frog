end

proc external-inputs-equal ModuleContext int ModuleContext int -- bool do
    let first first-index second second-index do
        if first first-index proc-input-count-at second second-index proc-input-count-at != do
            false
        else
            0 true
            while
                peek input-index equal do
                    input-index first first-index proc-input-count-at < equal &&
                end
            do
                let input-index equal do
                    input-index 1 +
                    equal
                    first first first-index proc-input-start-at input-index + type-at
                    second second second-index proc-input-start-at input-index + type-at
                    == &&
                end
            end
            let input-index equal do equal end
        end
    end
end

proc external-outputs-equal ModuleContext int ModuleContext int -- bool do
    let first first-index second second-index do
        if first first-index proc-output-count-at second second-index proc-output-count-at != do
            false
        elif first first-index proc-output-count-at 0 == do
            true
        else
            first first first-index proc-output-start-at type-at
            second second second-index proc-output-start-at type-at
            ==
        end
    end
end

proc external-contracts-equal ModuleContext int ModuleContext int -- bool do
    peek first first-index second second-index do external-inputs-equal
        first first-index second second-index external-outputs-equal &&
    end
end

proc function-input-type-at ModuleContext int int -- int do
