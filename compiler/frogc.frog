proc verify-analyzed-branch ModuleContext* int ProcedureAnalysis* AnalyzedBlock* ptr int -- do
    let module procedure-index analysis block exit-types exit-count do
        if exit-count 0 <= do "internal analyzed branch is missing its condition" fail end
        if exit-types exit-count 1 - cell-bytes * + 0 field-read type-bool != do
            "internal analyzed branch condition is not bool" fail
        end
        module procedure-index analysis block @AnalyzedBlock.first_target verify-analyzed-target
          module procedure-index analysis block @AnalyzedBlock.second_target verify-analyzed-target
        let first-target second-target do
            if
                analysis first-target
                    analysis @ProcedureAnalysis.operation_types second-target @AnalyzedBlock.entry_type_start cell-bytes * +
                      second-target @AnalyzedBlock.entry_type_count
                block-entry-matches-types !
            do
                "internal analyzed branch target stack mismatch: " emit-error
                "procedure " emit-error
                module @ModuleContext.source module procedure-index procedure-at @ProcedureEntry.name_start +
                module procedure-index procedure-at @ProcedureEntry.name_length emit-error-bytes
                ", " emit-error
                block @AnalyzedBlock.terminator_module block @AnalyzedBlock.terminator_token token-slice emit-error-bytes
                " at token " emit-error block @AnalyzedBlock.terminator_token emit-integer-error
                ", first=" emit-error
                "block " emit-error block @AnalyzedBlock.first_target emit-integer-error " " emit-error
                analysis @ProcedureAnalysis.operation_types first-target @AnalyzedBlock.entry_type_start cell-bytes * +
                  first-target @AnalyzedBlock.entry_type_count
                let types count do
                    block @AnalyzedBlock.terminator_module @ModuleContext.program types 0 count emit-error-type-array
                end
                ", second=" emit-error
                "block " emit-error block @AnalyzedBlock.second_target emit-integer-error " " emit-error
                analysis @ProcedureAnalysis.operation_types second-target @AnalyzedBlock.entry_type_start cell-bytes * +
                  second-target @AnalyzedBlock.entry_type_count
