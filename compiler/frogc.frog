                                if proc-found ! do
                                    "function reference target not found" fail
                                end
                                if
                                    function-module function-index proc-module proc-index
                                    function-proc-contracts-equal
                                    !
                                do
                                    "function reference contract mismatch" fail
                                end
                                cc function-module function-index function-type-at type-push
                                cc proc-module proc-index proc-global-id-at emit-push-integer
                                true
                            end
                        else
                            "unknown function operation" fail
                            false
                        end
                    end
                end
            end
        end
    end
end

proc compile-function-word ptr int -- bool do
    let cc token-index do
        cc @cc-defining-module token-index token-slice
        let bytes length do
            bytes length 58 first-index-of-byte
            let colon do
                if colon 0 >= do
                    cc bytes length colon compile-function-operation
                else
                    false
                end
            end
        end
    end
end

proc compile-string-word ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "String.bytes" token-equals do
            cc type-string type-expect
            cc type-ptr type-push
            cc "{ const FrogString *value = (const FrogString *)(intptr_t)frog_pop(); frog_push((Cell)(intptr_t)value->bytes); }" emit-line
            true
        elif cc @cc-defining-module token-index "String.len" token-equals do
            cc type-string type-expect
            cc type-int type-push
            cc "{ const FrogString *value = (const FrogString *)(intptr_t)frog_pop(); frog_push(value->len); }" emit-line
            true
        else
            false
        end
    end
end

proc compile-type-word ptr int -- bool do
    let cc token-index do
        if cc @cc-defining-module token-index "int" token-equals do
            cc type-literal-base type-int + type-push
            cc type-literal-base type-int + emit-push-integer
            true
        elif cc @cc-defining-module token-index "bool" token-equals do
            cc type-literal-base type-bool + type-push
            cc type-literal-base type-bool + emit-push-integer
            true
        elif cc @cc-defining-module token-index "ptr" token-equals do
            cc type-literal-base type-ptr + type-push
            cc type-literal-base type-ptr + emit-push-integer
            true
        elif cc @cc-defining-module token-index "String" token-equals do
            cc type-literal-base type-string + type-push
            cc type-literal-base type-string + emit-push-integer
            true
        else
            if cc token-index compile-record-type-word do
                true
            else
                if cc token-index compile-union-type-word do
                    true
                else
                    cc token-index compile-function-type-word
                end
            end
        end
    end
end

proc compile-macro ptr ptr int -- do
    let cc module macro-index do
        if module macro-index macro-expanding-at do
            "recursive macro expansion" fail
        end
        true module macro-index set-macro-expanding
        cc @cc-defining-module
        cc @cc-scope-module
        let previous-defining-module previous-scope-module do
            module cc !cc-defining-module
            module cc !cc-scope-module
            cc
            module macro-index macro-body-start-at
            module macro-index macro-body-end-at
            compile-body-range
            previous-defining-module cc !cc-defining-module
            previous-scope-module cc !cc-scope-module
        end
        false module macro-index set-macro-expanding
    end
end

proc compile-ordinary-word ptr int -- do
    let cc token-index do
        cc @cc-scope-module cc @cc-defining-module token-index find-scope-symbol
        let symbol-index do
            cc token-index token-resolves-to-macro
            let is-macro do
            if is-macro do
                cc
                cc @cc-scope-module symbol-index scope-definition-module-at
                cc @cc-scope-module symbol-index scope-definition-index-at
                compile-macro
            elif cc token-index compile-type-word do
            elif cc token-index compile-string-word do
            elif cc token-index compile-record-word do
            elif cc token-index compile-union-word do
            elif cc token-index compile-function-word do
            elif cc token-index compile-intrinsic do
            else
                cc token-index find-local
                let local-index do
                    if local-index 0 >= do
                        cc token-index local-index compile-local-reference
                    else
                        if symbol-index 0 >= do
                            if cc @cc-scope-module symbol-index scope-kind-at scope-procedure != do
                                "unknown word" fail
                            end
                            cc
                            token-index
                            cc @cc-scope-module symbol-index scope-definition-module-at
                            cc @cc-scope-module symbol-index scope-definition-index-at
                            compile-procedure-call
                        else
                            if cc token-index compile-prelude-macro ! do
                                "unknown word" fail
                            end
                        end
                    end
                end
            end
            end
        end
    end
end

proc compile-word-token ptr int -- int do
    let cc token-index do
        if cc @cc-defining-module token-index "if" token-equals do
            cc compile-if token-index 1 +
        elif cc @cc-defining-module token-index "while" token-equals do
            cc compile-while token-index 1 +
        elif cc @cc-defining-module token-index "do" token-equals do
            cc compile-do token-index 1 +
        elif cc @cc-defining-module token-index "else" token-equals do
            cc compile-else token-index 1 +
        elif cc @cc-defining-module token-index "elif" token-equals do
            cc compile-elif token-index 1 +
        elif cc @cc-defining-module token-index "end" token-equals do
            cc compile-end token-index 1 +
        elif cc @cc-defining-module token-index "let" token-equals do
            cc token-index compile-let
        else
            cc token-index compile-ordinary-word
            token-index 1 +
        end
    end
end

proc compile-token ptr int -- int do
    let cc token-index do
        cc @cc-defining-module token-index token-kind-at
        let kind do
            if kind token-int == do
                cc type-int type-push
                cc @cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-bool == do
                cc type-bool type-push
                cc @cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-char == do
                cc type-int type-push
                cc @cc-defining-module token-index token-value-at cc swap emit-push-integer
                token-index 1 +
            elif kind token-string == do
                cc type-string type-push
                cc token-index emit-push-string
                token-index 1 +
            elif kind token-word == do
                cc token-index compile-word-token
            else
                "unknown token kind" fail
                token-index 1 +
            end
        end
    end
end

proc token-resolves-to-macro ptr int -- bool do
    let cc token-index do
        cc @cc-scope-module cc @cc-defining-module token-index find-scope-symbol
        let symbol-index do
            if symbol-index 0 >= do
                cc @cc-scope-module symbol-index scope-kind-at scope-macro ==
            else
                false
            end
        end
    end
end

proc try-compile-constant-add ptr int int -- bool do
    let cc token-index body-end do
        if token-index 2 + body-end >= do
            false
        elif
            cc @cc-defining-module token-index token-kind-at token-int ==
            cc @cc-defining-module token-index 1 + token-kind-at token-int == &&
            cc @cc-defining-module token-index 2 + token-kind-at token-word == &&
            cc @cc-defining-module token-index 2 + "+" token-equals &&
            cc token-index 2 + token-resolves-to-macro ! &&
        do
            cc @cc-defining-module token-index token-value-at
            cc @cc-defining-module token-index 1 + token-value-at
            let left right do
                if left max-int right - <= do
                    cc type-int type-push
                    cc left right + emit-push-integer
                    true
                else
                    false
                end
            end
        else
            false
        end
    end
end

proc initialize-proc-inputs ptr int -- do
    let cc input-index do
        if input-index cc @cc-procedure-module cc @cc-proc proc-input-count-at < do
            cc @cc-procedure-module
            cc @cc-procedure-module cc @cc-proc proc-input-start-at
            input-index +
            type-at
            cc swap type-push
            cc input-index 1 + initialize-proc-inputs
        end
    end
end

proc outputs-match-from ptr int -- bool do
    let cc output-index do
        if output-index cc @cc-type-count >= do
            true
        else
            cc output-index type-at-depth
            cc @cc-procedure-module
            cc @cc-procedure-module cc @cc-proc proc-output-start-at
            output-index +
            type-at
            ==
            let matches do
                if matches do
                    cc output-index 1 + outputs-match-from
                else
                    false
                end
            end
        end
    end
end

proc require-proc-outputs ptr -- do
    let cc do
        if cc @cc-type-count cc @cc-procedure-module cc @cc-proc proc-output-count-at != do
            "procedure output stack depth mismatch" fail
        end
        if cc 0 outputs-match-from ! do
            "procedure output stack type mismatch" fail
        end
    end
end

proc compile-body-range ptr int int -- do
    let cc token-index body-end do
        token-index
        while dup body-end < do
            let current-token do
                if cc current-token body-end try-compile-constant-add do
                    current-token 3 +
                else
                    cc current-token compile-token
                end
            end
        end
        drop
    end
end

proc create-compile-context ptr ptr int -- ptr do
    let program ctx proc-index do
        cc-bytes alloc
        let cc do
            program cc !cc-program
            ctx cc !cc-procedure-module
            ctx cc !cc-defining-module
            ctx cc !cc-scope-module
            proc-index cc !cc-proc
            program @program-token-count 1 + cell-bytes * alloc cc !cc-type-stack
            0 cc !cc-type-count
            program @program-token-count 1 + block-bytes * alloc cc !cc-blocks
            0 cc !cc-block-count
            program @program-token-count 1 + local-bytes * alloc cc !cc-locals
            0 cc !cc-local-count
            0 cc !cc-next-local
            0 cc !cc-indent
            cc
        end
    end
end

proc proc-input-type-at ptr int int -- int do
    let ctx proc-index input-index do
        ctx ctx proc-index proc-input-start-at input-index + type-at
    end
end

proc emit-ffi-argument-name int -- do
    "frog_ffi_arg_" emit emit-unsigned
end

proc emit-external-input-locals ptr int int -- do
    let ctx proc-index remaining do
        if remaining 0 > do
            remaining 1 -
            let input-index do
                "  Cell " emit input-index emit-ffi-argument-name " = frog_pop();\n" emit
                ctx proc-index input-index emit-external-input-locals
            end
        end
    end
end

proc emit-external-argument ptr int int -- do
    let ctx proc-index input-index do
        ctx proc-index input-index proc-input-type-at
        let input-type do
            if input-type type-int == do
                "(int)" emit input-index emit-ffi-argument-name
            elif input-type type-bool == do
                "(int)(" emit input-index emit-ffi-argument-name " != 0)" emit
            elif input-type type-ptr == do
                "(void *)(intptr_t)" emit input-index emit-ffi-argument-name
            else
                "internal unknown C ABI argument type" fail
            end
        end
    end
end

proc emit-external-arguments ptr int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index proc-input-count-at < do
            if input-index 0 != do ", " emit end
            ctx proc-index input-index emit-external-argument
            ctx proc-index input-index 1 + emit-external-arguments
        end
    end
end

proc emit-external-call-expression ptr int -- do
    let ctx proc-index do
        ctx proc-index emit-c-symbol "(" emit
        ctx proc-index 0 emit-external-arguments
        ")" emit
    end
end

proc compile-external-procedure ptr int -- do
    let ctx proc-index do
        "void " emit ctx proc-index proc-global-id-at emit-proc-name "(void) {\n" emit
        ctx proc-index ctx proc-index proc-input-count-at emit-external-input-locals
        if ctx proc-index proc-output-count-at 0 == do
            "  " emit ctx proc-index emit-external-call-expression ";\n" emit
        else
            ctx ctx proc-index proc-output-start-at type-at
            let output-type do
                if output-type type-int == do
                    "  frog_push((Cell)" emit
                    ctx proc-index emit-external-call-expression
                    ");\n" emit
                elif output-type type-bool == do
                    "  frog_push((Cell)(" emit
                    ctx proc-index emit-external-call-expression
                    " != 0));\n" emit
                elif output-type type-ptr == do
                    "  frog_push((Cell)(intptr_t)" emit
                    ctx proc-index emit-external-call-expression
                    ");\n" emit
                else
                    "internal unknown C ABI return type" fail
                end
            end
        end
        "}\n" emit
    end
end

proc compile-procedure ptr ptr int -- do
    let program ctx proc-index do
        if ctx proc-index proc-external-at do
            ctx proc-index compile-external-procedure
        else
            program ctx proc-index create-compile-context
            let cc do
                cc 0 initialize-proc-inputs
                "void " emit
                ctx proc-index proc-global-id-at emit-proc-name
                "(void) {" emit 10 putc
                1 cc !cc-indent
                cc
                ctx proc-index proc-body-start-at
                ctx proc-index proc-body-end-at
                compile-body-range
                if cc @cc-block-count 0 != do
                    "unclosed control-flow block" fail
                end
                if cc @cc-local-count 0 != do
                    "unclosed local scope" fail
                end
                cc require-proc-outputs
                "}" emit 10 putc
            end
        end
    end
end

proc compile-module-procedures ptr ptr -- do
    let program ctx do
        0
        while dup ctx @ctx-proc-count < do
            dup program ctx rot compile-procedure
            1 +
        end
        drop
    end
end

proc compile-all-procedures ptr -- do
    let program do
        program @program-module-head
        while dup int cast 0 != do
            dup program swap compile-module-procedures
            @ctx-next-module
        end
        drop
    end
end

proc emit-main-wrapper ptr -- do
    let program do
        program @program-root-module
        let ctx do
            "int main(int argc, char **argv) {\n  frog_argc = argc;\n  frog_argv = argv;\n" emit
            program emit-string-references
            "  " emit ctx ctx @ctx-main-proc proc-global-id-at emit-proc-name
            "();\n  if (frog_stack.count != 0) frog_runtime_fail();\n  free(frog_stack.values);\n  return 0;\n}\n" emit
        end
    end
end
// END BODY COMPILER


proc compile-source ptr int -- do
    let source source-length do
        program-bytes alloc
        let program do
            0 ptr cast program !program-root-module
            0 ptr cast program !program-module-head
            0 ptr cast program !program-module-tail
            0 program !program-module-count
            0 program !program-next-proc-id
            type-nominal-base program !program-next-nominal-type
            type-function-base program !program-next-function-type
            0 program !program-token-count
            0 ptr cast program !program-strings
            0 program !program-string-count
            0 ptr cast program !program-prelude-module
            ctx-bytes alloc
            let ctx do
                0 ptr cast ctx !ctx-canonical-path
                0 ctx !ctx-canonical-path-length
                0 ptr cast ctx !ctx-imports
                0 ctx !ctx-import-count
                0 ptr cast ctx !ctx-scope
                0 ctx !ctx-scope-count
                load-loading ctx !ctx-load-state
                resolve-new ctx !ctx-resolve-state
                true ctx !ctx-is-root
                program ctx program-add-module
                ctx program !program-root-module
                ctx source source-length initialize-module-source
                program ctx load-module-imports
                load-loaded ctx !ctx-load-state
                program initialize-prelude
                program initialize-string-pool
                program resolve-all-module-scopes
                program resolve-all-types
                program validate-external-declarations

                program emit-c-emitter-support
                program compile-all-procedures
                program emit-main-wrapper
            end
        end
    end
end

proc program-prelude-module-offset -- int do 64 end
proc @program-prelude-module ptr -- ptr do program-prelude-module-offset pointer-field-read end
proc !program-prelude-module ptr ptr -- do program-prelude-module-offset pointer-field-write end

proc initialize-prelude ptr -- do
    let program do
        ctx-bytes alloc
        let prelude do
            0 ptr cast prelude !ctx-canonical-path
            0 prelude !ctx-canonical-path-length
            0 ptr cast prelude !ctx-imports
            0 prelude !ctx-import-count
            0 ptr cast prelude !ctx-scope
            0 prelude !ctx-scope-count
            load-loading prelude !ctx-load-state
            resolve-new prelude !ctx-resolve-state
            false prelude !ctx-is-root
            program prelude program-add-module
            "macro dup let a do a a end end
macro dup2 let a b do a b a b end end
macro drop let a do end end
macro swap let a b do b a end end
macro swap2 let a b c d do c d a b end end
macro rot let a b c do b c a end end
"
            let source do
                prelude source String.bytes source String.len initialize-module-source
            end
            load-loaded prelude !ctx-load-state
            prelude program !program-prelude-module
        end
    end
end

proc compile-prelude-macro ptr int -- bool do
    let cc token-index do
        cc @cc-program @program-prelude-module
        let prelude do
            prelude cc @cc-defining-module token-index find-scope-symbol
            let symbol-index do
                if symbol-index 0 < do
                    false
                else
                    if prelude symbol-index scope-kind-at scope-macro != do
                        "internal prelude symbol is not a macro" fail
                    end
                    cc
                    prelude symbol-index scope-definition-module-at
                    prelude symbol-index scope-definition-index-at
                    compile-macro
                    true
                end
            end
        end
    end
end

extern cli-fork froglang_fork -- c-int end
extern cli-create-file froglang_create_file c-ptr -- c-int end
extern cli-dup2 froglang_dup2 c-int c-int -- c-int end
extern cli-close froglang_close c-int -- c-int end
