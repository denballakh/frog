    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup resolve-module-scope
            @ModuleContext.next_module
        end
        drop
    end
end

proc create-constant-evaluator ModuleContext* int -- ConstantEvaluator* do
    let module token do
    ConstantEvaluator:alloc
    let evaluator do
        module evaluator !ConstantEvaluator.module
        token evaluator !ConstantEvaluator.token
        8
        peek capacity do ConstantValue:sizeof * alloc evaluator !ConstantEvaluator.values
            0 evaluator !ConstantEvaluator.count
            capacity evaluator !ConstantEvaluator.capacity
            evaluator
        end
    end
    end
end

proc constant-fail ConstantEvaluator* String -- do
    let evaluator message do
        evaluator @ConstantEvaluator.module evaluator @ConstantEvaluator.token message fail-at
    end
