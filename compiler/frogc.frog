                    program visibility @LocalVisibility.binding_occurrence semantic-occurrence-at
                    let occurrence do
                        program later
                            occurrence @SemanticOccurrence.source_module @ModuleContext.source occurrence @SemanticOccurrence.start_byte +
                              occurrence @SemanticOccurrence.end_byte occurrence @SemanticOccurrence.start_byte -
                        visibility-name-equals-bytes
                    end
                    if dup do
                    else drop program state state-index visibility later-index 1 + visibility-is-shadowed-from end
                else
