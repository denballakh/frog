proc emit-c-runtime -- do
    "void frog_runtime_fail(void) {
  exit(1);
}

void frog_assert_fail(FrogString message) {
  (void)fwrite(message.bytes, 1, (size_t)message.len, stderr);
  (void)fputc(10, stderr);
  exit(1);
}

void* frog_alloc(Cell size) {
  if (size < 0 || (uint64_t)size > SIZE_MAX) frog_runtime_fail();
  void* value = malloc((size_t)size);
  if (value == NULL && size != 0) frog_runtime_fail();
  return value;
}

" emit
    "#define FROG_INTEGER_HELPERS(name, type) \\
typedef struct { type quotient; type remainder; } frog_divmod_##name##_result; \\
type frog_add_##name(type a, type b) { return (type)(a + b); } \\
type frog_sub_##name(type a, type b) { return (type)(a - b); } \\
type frog_mul_##name(type a, type b) { return (type)(a * b); } \\
type frog_div_##name(type a, type b) { if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } return (type)(a / b); } \\
type frog_mod_##name(type a, type b) { if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } return (type)(a % b); } \\
frog_divmod_##name##_result frog_divmod_##name(type a, type b) { if (b == 0) { fputs(\"frog: division by zero\\n\", stderr); exit(1); } return (frog_divmod_##name##_result){ (type)(a / b), (type)(a % b) }; } \\
type frog_or_##name(type a, type b) { return (type)(a | b); } \\
type frog_and_##name(type a, type b) { return (type)(a & b); } \\
type frog_xor_##name(type a, type b) { return (type)(a ^ b); } \\
type frog_not_##name(type a) { return (type)(~a); } \\
type frog_shl_##name(type a, uint32_t b) { return (type)(a << b); } \\
type frog_shr_##name(type a, uint32_t b) { return (type)(a >> b); } \\
bool frog_eq_##name(type a, type b) { return a == b; } \\
bool frog_ne_##name(type a, type b) { return a != b; } \\
bool frog_lt_##name(type a, type b) { return a < b; } \\
bool frog_gt_##name(type a, type b) { return a > b; } \\
bool frog_le_##name(type a, type b) { return a <= b; } \\
bool frog_ge_##name(type a, type b) { return a >= b; }

FROG_INTEGER_HELPERS(int, intptr_t)
FROG_INTEGER_HELPERS(i8, int8_t)
FROG_INTEGER_HELPERS(i16, int16_t)
FROG_INTEGER_HELPERS(i32, int32_t)
FROG_INTEGER_HELPERS(i64, int64_t)
FROG_INTEGER_HELPERS(u8, uint8_t)
FROG_INTEGER_HELPERS(u16, uint16_t)
FROG_INTEGER_HELPERS(u32, uint32_t)
FROG_INTEGER_HELPERS(u64, uint64_t)

#define FROG_MEMORY_HELPERS(name, type) \\
type frog_load_##name(const void *ptr) { type value; memcpy(&value, ptr, sizeof(value)); return value; } \\
void frog_store_##name(void *ptr, type value) { memcpy(ptr, &value, sizeof(value)); }

FROG_MEMORY_HELPERS(int, intptr_t)
FROG_MEMORY_HELPERS(bool, bool)
FROG_MEMORY_HELPERS(i8, int8_t)
FROG_MEMORY_HELPERS(i16, int16_t)
FROG_MEMORY_HELPERS(i32, int32_t)
FROG_MEMORY_HELPERS(i64, int64_t)
FROG_MEMORY_HELPERS(u8, uint8_t)
FROG_MEMORY_HELPERS(u16, uint16_t)
FROG_MEMORY_HELPERS(u32, uint32_t)
FROG_MEMORY_HELPERS(u64, uint64_t)
FROG_MEMORY_HELPERS(ptr, void *)

bool frog_and_bool(bool a, bool b) { return a && b; }
bool frog_or_bool(bool a, bool b) { return a || b; }
bool frog_not_bool(bool a) { return !a; }
void *frog_add_ptr(void *ptr, intptr_t offset) { return (void *)((unsigned char *)ptr + offset); }
void *frog_sub_ptr(void *ptr, intptr_t offset) { return (void *)((unsigned char *)ptr - offset); }
bool frog_eq_ptr(void *a, void *b) { return a == b; }
bool frog_ne_ptr(void *a, void *b) { return a != b; }

" emit
end

proc emit-c-string-byte int -- do
    let byte do
        if byte '"' == do
            "\\\"" emit
        elif byte 92 == do
            "\\\\" emit
        elif byte 10 == do
            "\\n" emit
        elif byte 13 == do
            "\\r" emit
        elif byte 9 == do
            "\\t" emit
        elif byte 63 == do
            "\\?" emit
        elif byte 32 >= byte 126 <= && do
            byte putc
        else
            92 putc
            byte 64 / 48 + putc
            byte 8 / 8 % 48 + putc
            byte 8 % 48 + putc
        end
    end
end

proc emit-c-string-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup
            let index do
                bytes index byte-read emit-c-string-byte
            end
            1 +
        end
        drop
    end
end

proc emit-string-symbol Program* int -- do
    let program string-index do
        "frog_string_" emit
        program string-index string-at @StringPoolEntry.hash emit-unsigned
        program string-index string-at @StringPoolEntry.collision
        let collision do
            if collision 0 > do
                "_" emit collision emit-unsigned
            end
        end
    end
end

proc emit-string-bytes-symbol Program* int -- do
    peek program string-index do emit-string-symbol
        "_bytes" emit
    end
end

proc emit-c-string-literal Program* int -- do
    let program string-index do
        "static char " emit program string-index emit-string-bytes-symbol
        "[] = \"" emit
        program string-index string-at @StringPoolEntry.data
          program string-index string-at @StringPoolEntry.length
        emit-c-string-bytes
        "\";\n" emit
        "static const FrogString " emit program string-index emit-string-symbol
        " = { " emit program string-index emit-string-bytes-symbol ", " emit
        program string-index string-at @StringPoolEntry.length emit-unsigned
        " };\n" emit
    end
end

proc emit-string-globals Program* -- do
    let program do
