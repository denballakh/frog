proc emit-c-type-map-named ModuleContext* int int int String -- do
    let module value-type name-start name-length kind do
        "/* Frog type " emit value-type emit-unsigned " = " emit kind emit " module " emit
        module @ModuleContext.module_id emit-unsigned " " emit
        module @ModuleContext.source name-start + name-length emit-proc-source-name
        " */\n" emit
    end
end

