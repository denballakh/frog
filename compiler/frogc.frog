proc intern-module-strings ptr ModuleContext -- do
    let program ctx do
        0
        while dup ctx @ModuleContext.token_count < do
            dup
            let token do
                if ctx token token-kind-at token-string == do
                    program ctx token intern-string-token
                end
            end
            1 +
        end
        drop
    end
end

proc initialize-string-pool ptr -- do
    peek program do @program-token-count 1 + string-bytes * alloc program !program-strings
        0 program !program-string-count
        program @program-module-head
        while dup ptr cast int cast 0 != do
            dup program swap intern-module-strings
            @ModuleContext.next_module
        end
        drop
    end
end

proc bytes-are-dot ptr int int -- bool do
    let bytes start length do
        if length 1 == do
            bytes start byte-read 46 ==
        else
            false
        end
    end
end

proc bytes-are-dot-dot ptr int int -- bool do
    let bytes start length do
        if length 2 == do
            bytes start byte-read 46 ==
            bytes start 1 + byte-read 46 == &&
        else
            false
        end
