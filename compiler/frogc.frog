            do
                if
                    module @ModuleContext.canonical_path program @Program.standard_library_root_length
                    program @Program.standard_library_root program @Program.standard_library_root_length bytes-equal
                    module @ModuleContext.canonical_path program @Program.standard_library_root_length byte-read 47 == &&
                do
                    module @ModuleContext.canonical_path program @Program.standard_library_root_length 1 + +
                    module @ModuleContext.canonical_path_length program @Program.standard_library_root_length 1 + -
                    emit-inspect-bytes
                else
                    module @ModuleContext.canonical_path module @ModuleContext.canonical_path_length emit-inspect-bytes
                end
            else
                module @ModuleContext.canonical_path module @ModuleContext.canonical_path_length emit-inspect-bytes
            end
        end
    end
