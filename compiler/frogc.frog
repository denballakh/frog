proc scan-declarations ptr -- do
    let ctx do
        0 ctx !ctx-proc-count
        0 ctx !ctx-type-count
        0 ctx !ctx-macro-count
        0 ctx !ctx-import-count
        0 ctx !ctx-record-count
        0 ctx !ctx-record-field-count
        0 ctx !ctx-union-count
        0 ctx !ctx-union-case-count
        0 ctx !ctx-function-count
        0 ctx !ctx-function-type-count
        0
        while dup ctx @ctx-token-count < do
