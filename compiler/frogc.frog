proc constant-qualified-nominal-word ModuleContext ModuleContext int -- bool do
    let scope module token-index do
        module token-index token-slice
        peek bytes length do 58 first-index-of-byte
            let colon do
                if colon 0 > colon 1 + length < && do
                    scope bytes colon true scope-prefix-is-nominal
                else
                    bytes length 46 first-index-of-byte
                    let dot do
                        if dot 0 > dot 1 + length < && do
                            if
                                bytes 0 byte-read 64 ==
                                bytes 0 byte-read 33 == ||
                            do
                                if dot 1 <= do
                                    false
                                else
                                    scope bytes 1 + dot 1 - scope-record scope-prefix-has-kind
                                end
                            else
                                scope bytes dot scope-union scope-prefix-has-kind
                            end
                        else
                            false
                        end
                    end
                end
            end
        end
    end
end

proc constant-higher-priority-word ModuleContext ModuleContext int -- bool do
