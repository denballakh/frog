                ctx name-token token-at @TokenEntry.start ctx constant-index constant-at !ConstantEntry.name_start
                ctx name-token token-at @TokenEntry.length ctx constant-index constant-at !ConstantEntry.name_length
                ConstantState:new ctx constant-index constant-at !ConstantEntry.state
                0 ptr cast ctx constant-index constant-at !ConstantEntry.values
                0 ctx constant-index constant-at !ConstantEntry.value_count
                ctx name-token 1 + scan-constant-body
                let next-token do
                    name-token 1 + ctx constant-index constant-at !ConstantEntry.body_start
                    next-token 1 - ctx constant-index constant-at !ConstantEntry.body_end
