    end
end

proc emit-c-value-type Program* int -- do
    let program value-type do
        if value-type type-int == do "intptr_t" emit
        elif value-type type-bool == do "bool" emit
        elif value-type type-ptr == do "void *" emit
        elif value-type type-i8 == do "int8_t" emit
        elif value-type type-i16 == do "int16_t" emit
        elif value-type type-i32 == do "int32_t" emit
        elif value-type type-i64 == do "int64_t" emit
        elif value-type type-u8 == do "uint8_t" emit
        elif value-type type-u16 == do "uint16_t" emit
        elif value-type type-u32 == do "uint32_t" emit
        elif value-type type-u64 == do "uint64_t" emit
        elif value-type type-string == do "FrogString" emit
        elif value-type type-is-typed-pointer do
            program program value-type type-pointer-base - pointer-type-at @PointerTypeEntry.pointee_type emit-c-value-type
            " *" emit
        elif value-type type-is-nominal do
            program @Program.module_head value-type 0 find-record-type-from
            let module record-index record-found do
                if record-found do
                    value-type emit-c-record-type-name
                else
                    program @Program.module_head value-type 0 find-union-type-from
                    let union-module union-index union-found do
                        if union-found do value-type emit-c-union-type-name else "Cell" emit end
                    end
                end
            end
        else
            "Cell" emit
        end
    end
end

