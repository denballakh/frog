                if kind CFGTerminatorKind.jump? do
                    if block @AnalyzedBlock.first_target 0 < do "internal unresolved analyzed jump" fail end
                    module procedure-index analysis block exit-types exit-count verify-analyzed-jump
                elif kind CFGTerminatorKind.branch? do module procedure-index analysis block exit-types exit-count verify-analyzed-branch
                elif kind CFGTerminatorKind.return? do module procedure-index block exit-types exit-count verify-analyzed-return
                else "internal unresolved analyzed block terminator" fail end
