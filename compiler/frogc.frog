proc compile-constant-values-from CompileContext* ModuleContext* int int -- do
    let cc module constant-index value-index do
        if value-index module constant-index constant-at @ConstantEntry.value_count < do
            module constant-index constant-at @ConstantEntry.values
            peek values do value-index constant-value-at @ConstantValue.value_type
                values value-index constant-value-at @ConstantValue.payload
                let value-type payload do
                    cc value-type type-push
                    if value-type type-is-integer value-type type-bool == || do
                        if value-type type-int == value-type type-bool == || do
                            cc payload emit-push-integer
                        else
                            if cc @CompileContext.emitting do
                                cc emit-indent cc emit-top-slot " = (" emit
                                cc @CompileContext.program value-type emit-c-value-type ")" emit
                                payload emit-integer ";" emit 10 putc
                            end
                        end
                    elif value-type type-string == do
                        cc payload emit-push-pooled-string
                    else
                        "internal unsupported constant value type" fail
                    end
                    cc module constant-index value-index 1 + compile-constant-values-from
                end
            end
        end
    end
end

proc compile-constant CompileContext* ModuleContext* int -- do
    peek cc module constant-index do 0 compile-constant-values-from
    end
end

proc compile-macro CompileContext* ModuleContext* int -- do
    let cc module macro-index do
        if module macro-index macro-at @MacroEntry.expanding do
            cc "recursive macro expansion" fail-compile-word
        end
        true module macro-index macro-at !MacroEntry.expanding
        cc @CompileContext.defining_module
        cc @CompileContext.scope_module
        let previous-defining-module previous-scope-module do
            module cc !CompileContext.defining_module
            module cc !CompileContext.scope_module
            cc
            module macro-index macro-at @MacroEntry.body_start
            module macro-index macro-at @MacroEntry.body_end
            compile-body-range
            previous-defining-module cc !CompileContext.defining_module
            previous-scope-module cc !CompileContext.scope_module
        end
        false module macro-index macro-at !MacroEntry.expanding
    end
end

proc compile-ordinary-word CompileContext* int -- do
    let cc token-index do
        if cc token-index cc-diagnostic-is-token do true cc !CompileContext.diagnostic_word end
        cc cc-debug-tracing
        cc token-index cc-diagnostic-is-token &&
        let trace do
            if trace do cc "before" emit-debug-word-stack end
            cc @CompileContext.scope_module cc @CompileContext.defining_module token-index find-scope-symbol
                let symbol-index do
                    cc token-index token-resolves-to-macro
                    let is-macro do
                    if is-macro do
                        cc @CompileContext.scope_module cc @CompileContext.defining_module token-index token-slice
                        visible-macro-definition
                        let macro-module macro-index found do
                            if found ! do "internal macro resolution failed" fail end
                            cc macro-module macro-index compile-macro
                        end
                    elif cc token-index compile-type-word do
                    elif cc token-index compile-string-word do
                    elif cc token-index compile-record-word do
                    elif cc token-index compile-union-word do
                    elif cc token-index compile-function-word do
                    elif cc token-index compile-private-intrinsic do
                    else
                        cc token-index find-local
                        let local-index do
                            if local-index 0 >= do
                                cc token-index local-index compile-local-reference
                            else
                                if symbol-index 0 >= do
                                    if cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.kind ScopeKind:constant == do
                                        cc
                                        cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_module
                                        cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_index
                                        compile-constant
                                    elif cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.kind ScopeKind:procedure != do
                                        cc token-index fail-unknown-word
                                    else
                                        cc @CompileContext.defining_module token-index token-slice
                                        let bytes length do
                                            cc cc @CompileContext.scope_module bytes length visible-procedure-matches
                                            let proc-module proc-index count found do
                                                if
                                                    cc @CompileContext.scope_module ptr cast int cast
                                                    cc @CompileContext.program @Program.builtins_module ptr cast int cast
                                                    ==
                                                do
                                                    0 ptr cast ModuleContext* cast 0 1 - 0 false
                                                else
                                                    cc
                                                    cc @CompileContext.scope_module
                                                    cc @CompileContext.program @Program.builtins_module
                                                    bytes length
                                                    visible-builtin-procedure-matches
                                                end
                                                let builtin-module builtin-index builtin-count builtin-found do
                                                    count builtin-count +
                                                    let total-count do
                                                        if total-count 1 == do
                                                            if count 1 == do
                                                                cc token-index proc-module proc-index compile-procedure-call
                                                            else
                                                                cc token-index builtin-module builtin-index compile-implicit-builtin-call
                                                            end
                                                        elif total-count 1 > do
                                                            cc fail-ambiguous-procedure-call
                                                        else
                                                            if cc token-index compile-generic-pointer-memory ! do
                                                                cc
                                                                token-index
                                                                cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_module
                                                                cc @CompileContext.scope_module symbol-index scope-at @ScopeEntry.definition_index
                                                                compile-procedure-call
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                else
                                    if cc token-index compile-builtins-word ! do
                                        if cc token-index compile-generic-pointer-memory ! do
                                            if cc token-index compile-memory-io-intrinsic ! do
                                                cc token-index fail-unknown-word
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    end
                end
            if trace do cc "after" emit-debug-word-stack end
        end
    end
end

proc compile-word-token CompileContext* int -- int do
    let cc token-index do
        if cc @CompileContext.defining_module token-index "if" token-equals do
            cc compile-if token-index 1 +
        elif cc @CompileContext.defining_module token-index "while" token-equals do
            cc compile-while token-index 1 +
        elif cc @CompileContext.defining_module token-index "do" token-equals do
            cc compile-do token-index 1 +
        elif cc @CompileContext.defining_module token-index "else" token-equals do
            cc compile-else token-index 1 +
        elif cc @CompileContext.defining_module token-index "elif" token-equals do
            cc compile-elif token-index 1 +
        elif cc @CompileContext.defining_module token-index "end" token-equals do
            cc compile-end token-index 1 +
        elif cc @CompileContext.defining_module token-index "let" token-equals do
            cc token-index compile-let
        elif cc @CompileContext.defining_module token-index "peek" token-equals do
            cc token-index compile-peek
        else
            cc token-index compile-ordinary-word
            token-index 1 +
        end
    end
end

proc compile-token-inner CompileContext* int -- int do
    let cc token-index do
        cc @CompileContext.defining_module token-index token-at @TokenEntry.kind
        let kind do
            if kind TokenKind:int == do
                cc type-int type-push
                cc @CompileContext.defining_module token-index token-at @TokenEntry.value cc swap emit-push-integer
                token-index 1 +
            elif kind TokenKind:bool == do
                cc type-bool type-push
                cc @CompileContext.defining_module token-index token-at @TokenEntry.value cc swap emit-push-integer
                token-index 1 +
            elif kind TokenKind:char == do
                cc type-int type-push
                cc @CompileContext.defining_module token-index token-at @TokenEntry.value cc swap emit-push-integer
                token-index 1 +
            elif kind TokenKind:string == do
                cc type-string type-push
                cc token-index emit-push-string
                token-index 1 +
            elif kind TokenKind:word == do
                cc token-index compile-word-token
            else
                cc "unknown token kind" fail-compile-word
                token-index 1 +
            end
        end
    end
end

proc compile-token CompileContext* int -- int do
    let cc token-index do
        cc @CompileContext.diagnostic_active
        let was-active do
            if was-active ! do
                cc @CompileContext.defining_module cc !CompileContext.diagnostic_module
                token-index cc !CompileContext.diagnostic_token
                true cc !CompileContext.diagnostic_active
                false cc !CompileContext.diagnostic_word
            end
            cc token-index compile-token-inner
            let next-token do
                if was-active ! do false cc !CompileContext.diagnostic_active end
                next-token
            end
        end
    end
end

proc token-resolves-to-macro CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.scope_module cc @CompileContext.defining_module token-index token-slice
        visible-macro-definition
        let module index found do found end
    end
end

proc try-compile-constant-add CompileContext* int int -- bool do
    let cc token-index body-end do
        if token-index 2 + body-end >= do
            false
        elif
            cc @CompileContext.defining_module token-index token-at @TokenEntry.kind TokenKind:int ==
            cc @CompileContext.defining_module token-index 1 + token-at @TokenEntry.kind TokenKind:int == &&
            cc @CompileContext.defining_module token-index 2 + token-at @TokenEntry.kind TokenKind:word == &&
            cc @CompileContext.defining_module token-index 2 + "+" token-equals &&
            cc token-index 2 + token-resolves-to-macro ! &&
            cc @CompileContext.scope_module cc @CompileContext.defining_module token-index 2 + type-int type-int word-resolves-to-builtin-2 &&
        do
            cc @CompileContext.defining_module token-index token-at @TokenEntry.value
            cc @CompileContext.defining_module token-index 1 + token-at @TokenEntry.value
            let left right do
                if right 0 > do
                    left max-int right - <=
                elif right 0 < do
                    left min-int right - >=
                else
                    true
                end
                let fits do
                    if fits do
                        if cc cc-debug-tracing do
                            cc @CompileContext.stack_slot_count
                            let previous-slot-count do
                                cc token-index compile-token drop
                                cc token-index 1 + compile-token drop
                                cc token-index 2 + compile-token drop
                                previous-slot-count cc !CompileContext.stack_slot_count
                                cc cc @CompileContext.type_count 1 - type-int register-stack-slot
                            end
                        else
                            cc type-int type-push
                            cc left right + emit-push-integer
                        end
                        true
                    else
                        false
                    end
                end
            end
        else
            false
        end
    end
end

proc initialize-proc-inputs CompileContext* int -- do
    let cc input-index do
        if input-index cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.input_count < do
            cc @CompileContext.procedure_module
            cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.input_start
            input-index +
            type-at
            cc swap type-push
            cc input-index 1 + initialize-proc-inputs
        end
    end
end

proc outputs-match-from CompileContext* int -- bool do
    let cc output-index do
        if output-index cc @CompileContext.type_count >= do
            true
        else
            cc output-index type-at-depth
            cc @CompileContext.procedure_module
            cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.output_start
            output-index +
            type-at
            ==
            let matches do
                if matches do
                    cc output-index 1 + outputs-match-from
                else
                    false
                end
            end
        end
    end
end

proc fail-proc-output-contract CompileContext* -- do
    let cc do
        cc emit-source-error-prefix
        cc @CompileContext.procedure_module @ModuleContext.source
        cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.name_start
        +
        cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.name_length
        emit-error-bytes
        ": " emit-error
        "procedure output contract mismatch: expected " emit-error
        cc @CompileContext.program cc @CompileContext.procedure_module cc @CompileContext.procedure_index emit-error-proc-outputs
        ", actual " emit-error
        cc @CompileContext.program cc @CompileContext.type_stack 0 cc @CompileContext.type_count emit-error-type-array
        10 eputc
        1 exit
    end
end

proc require-proc-outputs CompileContext* -- do
    let cc do
        if cc @CompileContext.type_count cc @CompileContext.procedure_module cc @CompileContext.procedure_index procedure-at @ProcedureEntry.output_count != do
            cc fail-proc-output-contract
        end
        if cc 0 outputs-match-from ! do
            cc fail-proc-output-contract
        end
    end
end

proc compile-body-range CompileContext* int int -- do
    let cc token-index body-end do
        token-index
        while dup body-end < do
            let current-token do
                if cc current-token body-end try-compile-constant-add do
                    current-token 3 +
                else
                    cc current-token compile-token
                end
            end
        end
        drop
    end
end

proc create-compile-context Program* ModuleContext* int -- CompileContext* do
    let program ctx proc-index do
        CompileContext:alloc
        let cc do
            program cc !CompileContext.program
            ctx cc !CompileContext.procedure_module
            ctx cc !CompileContext.defining_module
            ctx cc !CompileContext.scope_module
            proc-index cc !CompileContext.procedure_index
            program @Program.token_count 1 +
            peek type-capacity do cell-bytes * alloc cc !CompileContext.type_stack
                type-capacity cc !CompileContext.type_capacity
            end
            0 cc !CompileContext.type_count
            program @Program.token_count 1 + BlockFrame:sizeof * alloc cc !CompileContext.blocks
            0 cc !CompileContext.block_count
            program @Program.token_count 1 + LocalEntry:sizeof * alloc cc !CompileContext.locals
            0 cc !CompileContext.local_count
            0 cc !CompileContext.next_local
            0 cc !CompileContext.indent
            false cc !CompileContext.emitting
            0 cc !CompileContext.max_type_count
            16 StackSlotEntry:sizeof * alloc cc !CompileContext.stack_slots
            0 cc !CompileContext.stack_slot_count
            16 cc !CompileContext.stack_slot_capacity
            false cc !CompileContext.diagnostic_active
            false cc !CompileContext.diagnostic_word
            cc
        end
    end
end

proc emit-ffi-argument-name int -- do
    emit-proc-argument-name
end

proc emit-c-signature-type-name ModuleContext* int -- do
    let ctx type-index do
        ctx type-index c-signature-type-at let signature do
            signature @CSignatureType.definition_module signature @CSignatureType.definition_index emit-c-type-spelling
        end
    end
end

proc emit-c-binding-arguments ModuleContext* int int -- do
    let ctx proc-index input-index do
        if input-index ctx proc-index procedure-at @ProcedureEntry.input_count < do
            if input-index 0 != do ", " emit end
            ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + type-at
            let value-type do
                "(" emit ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + emit-c-signature-type-name
                if value-type type-is-integer do ")" emit input-index emit-ffi-argument-name
                elif value-type type-bool == do ")(" emit input-index emit-ffi-argument-name " != 0)" emit
                elif value-type type-ptr == value-type type-is-typed-pointer || do ")(uintptr_t)" emit input-index emit-ffi-argument-name
                else ")(intptr_t)" emit input-index emit-ffi-argument-name end
            end
            ctx proc-index input-index 1 + emit-c-binding-arguments
        end
    end
end

proc emit-c-binding-expression ModuleContext* int -- do
    peek ctx proc-index do emit-c-symbol
        if ctx proc-index procedure-at @ProcedureEntry.c_binding CBinding:call == do
            "(" emit ctx proc-index 0 emit-c-binding-arguments ")" emit
        end
    end
end

proc compile-c-binding-procedure ModuleContext* int -- do
    peek ctx proc-index do emit-proc-signature " {\n" emit
        if ctx proc-index procedure-at @ProcedureEntry.output_count 0 == do
            "  " emit ctx proc-index emit-c-binding-expression ";\n" emit
        else
            ctx ctx proc-index procedure-at @ProcedureEntry.output_start type-at let value-type do
                "  return " emit
                if value-type type-is-integer do
                    "(" emit ctx @ModuleContext.program value-type emit-c-value-type ")(" emit
                    ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit
                    ctx proc-index emit-c-binding-expression ");\n" emit
                elif value-type type-bool == do "(bool)((" emit ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit ctx proc-index emit-c-binding-expression ") != 0);\n" emit
                elif value-type type-ptr == value-type type-is-typed-pointer || do
                    "(" emit ctx @ModuleContext.program value-type emit-c-value-type ")(uintptr_t)(" emit
                    ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit
                    ctx proc-index emit-c-binding-expression ");\n" emit
                else "(Cell)(intptr_t)(" emit ctx ctx proc-index procedure-at @ProcedureEntry.output_start emit-c-signature-type-name ")(" emit ctx proc-index emit-c-binding-expression ");\n" emit end
            end
        end
        "}\n" emit
    end
end

proc validate-compiled-procedure CompileContext* -- do
    let cc do
        if cc @CompileContext.block_count 0 != do
            cc "unclosed control-flow block" fail-compile-word
        end
        if cc @CompileContext.local_count 0 != do
            cc "unclosed local scope" fail-compile-word
        end
        cc require-proc-outputs
    end
end

proc compile-procedure-body CompileContext* ModuleContext* int -- do
    let cc ctx proc-index do
        cc 0 initialize-proc-inputs
        cc
        ctx proc-index procedure-at @ProcedureEntry.body_start
        ctx proc-index procedure-at @ProcedureEntry.body_end
        compile-body-range
        ctx cc !CompileContext.diagnostic_module
        ctx proc-index procedure-at @ProcedureEntry.body_end cc !CompileContext.diagnostic_token
        true cc !CompileContext.diagnostic_active
        false cc !CompileContext.diagnostic_word
        cc validate-compiled-procedure
        false cc !CompileContext.diagnostic_active
    end
end

proc emit-proc-input-slots CompileContext* ModuleContext* int int -- do
    let cc ctx proc-index input-index do
        if input-index ctx proc-index procedure-at @ProcedureEntry.input_count < do
            cc emit-indent cc input-index
            ctx ctx proc-index procedure-at @ProcedureEntry.input_start input-index + type-at
            emit-slot-as " = frog_arg_" emit input-index emit-unsigned ";" emit 10 putc
            cc ctx proc-index input-index 1 + emit-proc-input-slots
        end
    end
end

proc emit-proc-slot-frame CompileContext* -- do
    let cc do 0
        while dup cc @CompileContext.stack_slot_count < do
            dup let index do cc index stack-slot-at let slot do
                cc emit-indent cc @CompileContext.program slot @StackSlotEntry.value_type emit-c-value-type
                " " emit cc slot @StackSlotEntry.depth slot @StackSlotEntry.value_type emit-slot-as ";" emit 10 putc
                cc emit-indent "(void)&" emit cc slot @StackSlotEntry.depth slot @StackSlotEntry.value_type emit-slot-as ";" emit 10 putc
            end end
            1 +
        end
        drop
    end
end

proc emit-proc-return-values CompileContext* int -- do
    let cc remaining do
        if remaining 0 > do
            remaining 1 -
            let output-index do
                cc emit-indent "frog_result.value_" emit output-index emit-unsigned " = " emit
                cc output-index cc output-index type-at-depth emit-slot-as ";" emit 10 putc
                cc output-index emit-proc-return-values
            end
        end
    end
end

proc emit-proc-return CompileContext* ModuleContext* int -- do
    let cc ctx proc-index do
        ctx proc-index procedure-at @ProcedureEntry.output_count
        let output-count do
            if output-count 1 == do
                cc emit-indent "return " emit cc 0
                ctx ctx proc-index procedure-at @ProcedureEntry.output_start type-at
                emit-slot-as ";" emit 10 putc
            elif output-count 1 > do
                cc emit-indent
                ctx @ModuleContext.types ctx proc-index procedure-at @ProcedureEntry.output_start cell-bytes * +
                output-count emit-result-type-name " frog_result;" emit 10 putc
                cc output-count emit-proc-return-values
                cc emit-indent "return frog_result;" emit 10 putc
            end
        end
    end
end

proc compile-procedure Program* ModuleContext* int -- do
    let program ctx proc-index do
        if ctx proc-index procedure-at @ProcedureEntry.c_binding CBinding:none == do
            program ctx proc-index create-compile-context
            peek measurement do ctx proc-index compile-procedure-body
                measurement @CompileContext.max_type_count
                let max-type-count do
                    program ctx proc-index create-compile-context
                    let cc do
                        true cc !CompileContext.emitting
                        max-type-count cc !CompileContext.max_type_count
                        measurement @CompileContext.stack_slots cc !CompileContext.stack_slots
                        measurement @CompileContext.stack_slot_count cc !CompileContext.stack_slot_count
                        measurement @CompileContext.stack_slot_capacity cc !CompileContext.stack_slot_capacity
                        ctx proc-index emit-proc-signature " {" emit 10 putc
                        1 cc !CompileContext.indent
                        cc emit-proc-slot-frame
                        cc ctx proc-index 0 emit-proc-input-slots
                        cc ctx proc-index compile-procedure-body
                        cc ctx proc-index emit-proc-return
                        "}" emit 10 putc
                    end
                end
            end
        end
    end
end

proc compile-c-bindings-module ModuleContext* -- do
    let ctx do
        0
        while dup ctx @ModuleContext.proc_count < do
            dup let proc-index do
                if ctx proc-index procedure-at @ProcedureEntry.c_binding CBinding:none != do
                    ctx proc-index compile-c-binding-procedure
                end
            end
            1 +
        end
        drop
    end
end

proc compile-all-c-bindings Program* -- do
    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup compile-c-bindings-module
            @ModuleContext.next_module
        end
        drop
    end
end

proc compile-module-procedures Program* ModuleContext* -- do
    let program ctx do
        0
        while dup ctx @ModuleContext.proc_count < do
            dup program ctx rot compile-procedure
            1 +
        end
        drop
    end
end

proc compile-all-procedures Program* -- do
    peek program do @Program.module_head
        while dup ptr cast int cast 0 != do
            dup program swap compile-module-procedures
            @ModuleContext.next_module
        end
        drop
    end
end

proc emit-main-wrapper Program* -- do
    peek program do @Program.root_module
        let ctx do
            "int main(int argc, char **argv) {\n  frog_argc = argc;\n  frog_argv = argv;\n" emit
            program emit-string-references
            "  " emit ctx ctx @ModuleContext.main_proc emit-proc-name
            "();\n  return 0;\n}\n" emit
        end
    end
end
// END BODY COMPILER


proc compile-source ptr int ptr int bool bool ptr int -- do
    let source source-length diagnostic-path diagnostic-path-length debug release standard-library-root standard-library-root-length do
        Program:alloc
        let program do
            0 ptr cast ModuleContext* cast program !Program.root_module
            0 ptr cast ModuleContext* cast program !Program.module_head
            0 ptr cast ModuleContext* cast program !Program.module_tail
            0 program !Program.module_count
            0 program !Program.next_proc_id
            type-nominal-base program !Program.next_nominal_type
            type-function-base program !Program.next_function_type
            16 PointerTypeEntry:sizeof * alloc program !Program.pointer_types
            0 program !Program.pointer_type_count
            16 program !Program.pointer_type_capacity
            16 UnresolvedPointerTypeEntry:sizeof * alloc program !Program.unresolved_pointer_types
            0 program !Program.unresolved_pointer_type_count
            16 program !Program.unresolved_pointer_type_capacity
            16 ResultTypeEntry:sizeof * alloc program !Program.result_types
            0 program !Program.result_type_count
            16 program !Program.result_type_capacity
            0 program !Program.token_count
            0 ptr cast program !Program.strings
            0 program !Program.string_count
            debug program !Program.debug
            release program !Program.release
            0 1 - program !Program.builtins_assert_proc
            standard-library-root program !Program.standard_library_root
            standard-library-root-length program !Program.standard_library_root_length
            0 ptr cast ModuleContext* cast program !Program.builtins_module
            ModuleContext:alloc
            let ctx do
                0 ptr cast ctx !ModuleContext.canonical_path
                0 ctx !ModuleContext.canonical_path_length
                diagnostic-path ctx !ModuleContext.diagnostic_path
                diagnostic-path-length ctx !ModuleContext.diagnostic_path_length
                0 ptr cast ctx !ModuleContext.imports
                0 ctx !ModuleContext.import_count
                0 ptr cast ctx !ModuleContext.scope
                0 ctx !ModuleContext.scope_count
                LoadState:loading ctx !ModuleContext.load_state
                ResolveState:new ctx !ModuleContext.resolve_state
                true ctx !ModuleContext.is_root
                program ctx program-add-module
                ctx program !Program.root_module
                ctx source source-length initialize-module-source
                program ctx load-module-imports
                LoadState:loaded ctx !ModuleContext.load_state
                program initialize-builtins
                program initialize-string-pool
                program resolve-all-module-scopes
                program find-builtins-assert-procedure program !Program.builtins_assert_proc
                program evaluate-all-constants
                program resolve-all-types

                program emit-c-emitter-support
                program compile-all-procedures
                program emit-main-wrapper
            end
        end
    end
end

proc find-builtins-assert-procedure Program* -- int do
    let program do
        program @Program.builtins_module
        let builtins do
            builtins "assert" String.bytes "assert" String.len 0 find-scope-symbol-from
            let symbol-index do
                if symbol-index 0 < do "missing builtin assert" fail end
                builtins symbol-index scope-at
                let symbol do
                    if
                        symbol @ScopeEntry.kind ScopeKind:procedure !=
                        symbol @ScopeEntry.definition_module ptr cast int cast builtins ptr cast int cast != ||
                        symbol @ScopeEntry.definition_module symbol @ScopeEntry.definition_index
                        type-bool type-string procedure-inputs-are-2 ! ||
                        symbol @ScopeEntry.definition_module symbol @ScopeEntry.definition_index
                        procedure-at @ProcedureEntry.output_count 0 != ||
                    do
                        "invalid builtin assert" fail
                    end
                    symbol @ScopeEntry.definition_index
                end
            end
        end
    end
end

proc compile-implicit-builtin-call CompileContext* int ModuleContext* int -- do
    let cc token-index module proc-index do
        if
            cc @CompileContext.program @Program.release
            module ptr cast int cast cc @CompileContext.program @Program.builtins_module ptr cast int cast == &&
            proc-index cc @CompileContext.program @Program.builtins_assert_proc == &&
        do
            cc module proc-index apply-proc-contract
        else
            cc token-index module proc-index compile-procedure-call
        end
    end
end

proc initialize-builtins Program* -- do
    let program do
        "stdlib/builtins.frog"
        let path do
            program @Program.root_module path String.bytes path String.len standard-library-import-path
            let bytes length do
                program @Program.root_module 0 bytes length normalize-path
            end
            let canonical canonical-length do
                program program @Program.root_module 0 canonical canonical-length load-module-path
                program !Program.builtins_module
            end
        end
    end
end

proc compile-builtins-word CompileContext* int -- bool do
    let cc token-index do
        cc @CompileContext.procedure_module ptr cast int cast
        cc @CompileContext.program @Program.builtins_module ptr cast int cast ==
        let compiling-builtins do
            if compiling-builtins do
                if cc @CompileContext.defining_module token-index "builtins-assert-fail" token-equals do
                    cc type-string type-expect
                    if cc @CompileContext.emitting do
                        cc @CompileContext.type_count
                        let value-index do
                            cc emit-indent
                            "{ FrogString value = " emit cc value-index type-string emit-slot-as
                            "; (void)fwrite(value.bytes, 1, (size_t)value.len, stderr); (void)fputc(10, stderr); exit(1); }" emit
                            10 putc
                        end
                    end
                    true
                else
                    false
                end
            else
                cc @CompileContext.program @Program.builtins_module
                let builtins do cc @CompileContext.defining_module token-index token-slice
                    let bytes length do
                        builtins bytes length visible-macro-definition
                        let macro-module macro-index macro-found do
                            if macro-found do
                                cc macro-module macro-index compile-macro
                                true
                            else
                                builtins bytes length 0 find-scope-symbol-from
                                let symbol-index do
                                    if symbol-index 0 < do
                                        false
                                    else
                                        builtins symbol-index scope-at
                                        let symbol do
                                            if symbol @ScopeEntry.kind ScopeKind:procedure != do
                                                false
                                            elif
                                                symbol @ScopeEntry.definition_module symbol @ScopeEntry.definition_index
                                                procedure-at @ProcedureEntry.c_binding CBinding:none !=
                                            do
                                                false
                                            else
                                                cc builtins bytes length visible-procedure-matches
                                                let proc-module proc-index count found do
                                                    if count 1 == do
                                                        cc token-index proc-module proc-index compile-implicit-builtin-call
                                                        true
                                                    elif count 1 > do
                                                        cc fail-ambiguous-procedure-call
                                                        true
                                                    else
                                                        if cc token-index compile-generic-pointer-memory do
                                                            true
                                                        else
                                                            cc token-index
                                                            symbol @ScopeEntry.definition_module
                                                            symbol @ScopeEntry.definition_index
                                                            compile-implicit-builtin-call
                                                            true
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc null-pointer -- ptr do 0 ptr cast end

proc cstring-length ptr -- int do
    let bytes do
        0
        while dup bytes swap + u8* cast @ int cast 0 != do
            1 +
        end
    end
end

proc cstring-equals ptr String -- bool do
    let cstring value do
        cstring cstring-length
        let cstring-byte-count do
            cstring cstring-byte-count value String.bytes value String.len bytes-equal
        end
    end
end

proc argv-at ptr int -- ptr do cell-bytes * + ptr* cast @ end

proc copy-cstring ptr int -- ptr do
    let bytes length do
        length 1 + alloc
        let result do
            bytes result length memory-copy
            0 result length byte-write
            result
        end
    end
end

proc last-index-of-byte ptr int int -- int do
    let bytes length value do
        0 0 1 -
        while
            peek index last-index do index length <
            end
        do
            let index last-index do
                index 1 +
                if bytes index byte-read value == do index else last-index end
            end
        end
        let index last-index do last-index end
    end
end

proc parent-path ptr -- ptr do
    peek path do cstring-length
        let length do
            path length 47 last-index-of-byte
            let slash do
                if slash 0 < do
                    "." String.bytes
                elif slash 0 == do
                    "/" String.bytes
                else
                    path slash copy-cstring
                end
            end
        end
    end
end

proc distribution-root-from-absolute-executable ptr -- ptr int do
    parent-path parent-path
    let root do root root cstring-length end
end

proc compiler-distribution-root ptr -- ptr int do
    let executable do
        executable cstring-length
        let executable-length do
            if executable-length max-import-path-bytes > do
                null-pointer 0
            else
                executable executable-length 47 last-index-of-byte
                let slash do
                    if slash 0 < do
                        null-pointer 0
                    elif executable 0 byte-read 47 == do
                        executable distribution-root-from-absolute-executable
                    else
                        max-import-path-bytes 1 + alloc
                        let cwd do
                            if cwd max-import-path-bytes 1 + get-current-directory ! do
                                null-pointer 0
                            else
                                cwd cstring-length
                                let cwd-length do
                                    cwd-length executable-length + 2 + alloc
                                    let absolute-executable do
                                        cwd absolute-executable cwd-length memory-copy
                                        absolute-executable cwd-length append-path-separator
                                        let executable-start do
                                            executable absolute-executable executable-start + executable-length memory-copy
                                            0 absolute-executable executable-start executable-length + byte-write
                                            absolute-executable distribution-root-from-absolute-executable
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc replace-path-suffix ptr String -- ptr do
    let path suffix do
        suffix String.len
        let suffix-length do
            path cstring-length
            let path-length do
                path path-length 47 last-index-of-byte 1 +
                path path-length 46 last-index-of-byte
                let base dot do
                    if dot base > do dot else path-length end
                    peek prefix-length do suffix-length + 1 + alloc
                        let result do
                            path result prefix-length memory-copy
                            suffix String.bytes result prefix-length + suffix-length memory-copy
                            0 result prefix-length suffix-length + byte-write
                            result
                        end
                    end
                end
            end
        end
    end
end

proc set-pointer-at ptr int ptr -- do
    let array index value do
        value array index cell-bytes * + ptr* cast !
    end
end

proc allocate-pointer-array int -- ptr do
    peek count do 1 + cell-bytes * alloc
        peek array do count null-pointer set-pointer-at
            array
        end
    end
end

proc cli-error String -- do
    let message do
        "frogc: " emit-error
        message emit-error
        10 eputc
    end
end

proc cli-error-path String ptr -- do
    let message path do
        "frogc: " emit-error
        message emit-error
        ": " emit-error
        path path cstring-length emit-error-bytes
        10 eputc
    end
end

proc cli-usage-error String -- do
    cli-error
    "Try `frogc --help`.\n" emit-error
    2 exit
end

proc cli-usage-error-value String ptr -- do
    let message value do
        "frogc: " emit-error
        message emit-error
        value value cstring-length emit-error-bytes
        10 eputc
        "Try `frogc --help`.\n" emit-error
        2 exit
    end
end

proc cli-usage -- do
    "Usage:
  frogc [--debug] [--release] < source.frog > source.c
  frogc [--debug] [--release] <command> [options]

Commands:
  run [-c CODE | FILE]       compile and run Frog source
  build [-o FILE] [-r] FILE  compile Frog source to a binary

Options:
  --debug    trace compile-time type stacks to standard error
  --release  omit implicit builtin assertion calls
" emit
end

proc read-source-path ptr -- ptr int do
    peek path do path cstring-length read-file
        let source source-length success do
            if success do
                source source-length
            else
                "unable to read source" path cli-error-path
                1 exit
                null-pointer 0
            end
        end
    end
end

proc wait-for-child int -- int do
    wait-child
    let status do
        if status 0 < do
            "unable to wait for child" cli-error
            1
        else
            status
        end
    end
end

proc compile-frog-source ptr int ptr int ptr ptr bool bool ptr int -- int do
    let source source-length diagnostic-path diagnostic-path-length directory output debug release standard-library-root standard-library-root-length do
        output create-file
        let output-fd do
            if output-fd 0 < do
                "unable to prepare compiler input or output" cli-error
                1
            else
                fork
                let child do
                    if child 0 < do
                        output-fd close drop
                        "unable to fork compiler" cli-error
                        1
                    elif child 0 == do
                        reset-child-signals
                        output-fd 1 dup2 0 <
                        directory chdir 0 != ||
                        let preparation-failed do
                            output-fd close drop
                            if preparation-failed do
                                "unable to prepare compiler child" cli-error
                                1 finish-child
                                1
                            else
                                source source-length diagnostic-path diagnostic-path-length debug release standard-library-root standard-library-root-length compile-source
                                0 finish-child
                                0
                            end
                        end
                    else
                        output-fd close drop
                        child wait-for-child
                    end
                end
            end
        end
    end
end

proc compile-c-source ptr ptr -- int do
    let source executable do
        13 allocate-pointer-array
        peek arguments do 0 "gcc" String.bytes set-pointer-at
            arguments 1 "-std=c11" String.bytes set-pointer-at
            arguments 2 "-pedantic" String.bytes set-pointer-at
            arguments 3 "-Wall" String.bytes set-pointer-at
            arguments 4 "-Wextra" String.bytes set-pointer-at
            arguments 5 "-Wconversion" String.bytes set-pointer-at
            arguments 6 "-Werror" String.bytes set-pointer-at
            arguments 7 "-O2" String.bytes set-pointer-at
            arguments 8 "-x" String.bytes set-pointer-at
            arguments 9 "c" String.bytes set-pointer-at
            arguments 10 source set-pointer-at
            arguments 11 "-o" String.bytes set-pointer-at
            arguments 12 executable set-pointer-at
            fork
            let child do
                if child 0 < do
                    "unable to fork gcc" cli-error
                    1
                elif child 0 == do
                    reset-child-signals
                    "gcc" String.bytes arguments execvp drop
                    "unable to run gcc" cli-error
                    127 finish-child
                    127
                else
                    child wait-for-child
                end
            end
        end
    end
end

proc run-executable ptr -- int do
    let executable do
        1 allocate-pointer-array
        peek arguments do 0 executable set-pointer-at
            fork
            let child do
                if child 0 < do
                    "unable to fork executable" cli-error
                    1
                elif child 0 == do
                    reset-child-signals
                    executable arguments execv drop
                    "unable to run " emit-error
                    executable executable cstring-length emit-error-bytes
                    10 eputc
                    127 finish-child
                    127
                else
                    child wait-for-child
                end
            end
        end
    end
end

proc run-source ptr int ptr int ptr bool bool ptr int -- int do
    let source source-length diagnostic-path diagnostic-path-length directory debug release standard-library-root standard-library-root-length do
        if "build" String.bytes ensure-directory 0 != do
            "unable to create build directory" cli-error
            1
        else
            source source-length diagnostic-path diagnostic-path-length directory "build/frog-run.c" String.bytes debug release
            standard-library-root standard-library-root-length
            compile-frog-source
            let compile-status do
                if compile-status 0 != do
                    compile-status
                else
                    "build/frog-run.c" String.bytes "build/frog-run.exe" String.bytes compile-c-source
                    let c-status do
                        if c-status 0 != do
                            c-status
                        else
                            "build/frog-run.exe" String.bytes run-executable
                        end
                    end
                end
            end
        end
    end
end

proc run-file ptr bool bool ptr int -- int do
    let path debug release standard-library-root standard-library-root-length do path read-source-path
        let source source-length do
            path parent-path
            let directory do
                source source-length path path cstring-length directory debug release standard-library-root standard-library-root-length run-source
            end
        end
    end
end

proc build-file ptr ptr bool bool bool ptr int -- int do
    let path requested-output should-run debug release standard-library-root standard-library-root-length do
        path ".c" replace-path-suffix
        let c-file do
            if requested-output int cast 0 == do
                path ".exe" replace-path-suffix
            else
                requested-output
            end
            let executable do
                path read-source-path
                let source source-length do
                    path parent-path
                    let directory do
                        source source-length path path cstring-length directory c-file debug release
                        standard-library-root standard-library-root-length compile-frog-source
                        let frog-status do
                            if frog-status 0 != do
                                frog-status
                            else
                                c-file executable compile-c-source
                                let c-status do
                                    if c-status 0 != do
                                        c-status
                                    elif should-run do
                                        executable run-executable
                                    else
                                        0
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

proc run-command ptr int int bool bool ptr int -- do
    let argv argc command-index debug release standard-library-root standard-library-root-length do
        command-index 1 +
        let argument-index do
            if argument-index argc >= do
                "run requires a source file or -c CODE" cli-usage-error
            end
            argv argument-index argv-at
            let argument do
                if
                    argc argument-index 1 + ==
                    argument "-h" cstring-equals argument "--help" cstring-equals || &&
                do
                    "Usage: frogc [--debug] [--release] run [-c CODE | FILE]\n" emit
                elif argument "-c" cstring-equals do
                    if argc argument-index 2 + != do
                        "run -c requires exactly one CODE argument" cli-usage-error
                    end
                    argv argument-index 1 + argv-at
                    peek code do
                        code cstring-length "<command>" String.bytes "<command>" String.len "." String.bytes debug release
                        standard-library-root standard-library-root-length run-source exit
                    end
                elif argument u8* cast @ int cast 45 == do
                    "unknown run option: " argument cli-usage-error-value
                elif argc argument-index 1 + != do
                    "run accepts exactly one source file" cli-usage-error
                else
                    argument debug release standard-library-root standard-library-root-length run-file exit
                end
            end
        end
    end
end

proc parse-build-options ptr int int ptr bool -- ptr ptr bool do
    let argv argc index output should-run do
        if index argc >= do
            "build requires exactly one source file" cli-usage-error
            null-pointer null-pointer false
        else
            argv index argv-at
            let argument do
                if argument u8* cast @ int cast 45 == do
                    if
                        argument "-h" cstring-equals
                        argument "--help" cstring-equals ||
                    do
                        "Usage: frogc [--debug] [--release] build [-o FILE] [-r] FILE\n" emit
                        0 exit
                        null-pointer null-pointer false
                    elif argument "-r" cstring-equals do
                        argv argc index 1 + output true parse-build-options
                    elif argument "-o" cstring-equals do
                        if index 1 + argc >= do
                            "build -o requires an output file" cli-usage-error
                        end
                        argv argc index 2 + argv index 1 + argv-at should-run parse-build-options
                    else
                        "unknown build option: " argument cli-usage-error-value
                        null-pointer null-pointer false
                    end
                else
                    if argc index - 1 != do
                        "build requires exactly one source file" cli-usage-error
                    end
                    argument output should-run
                end
            end
        end
    end
end

proc build-command ptr int int bool bool ptr int -- do
    let argv argc command-index debug release standard-library-root standard-library-root-length do
        argv argc command-index 1 + null-pointer false parse-build-options
        let source output should-run do
            source output should-run debug release standard-library-root standard-library-root-length build-file exit
        end
    end
end

proc parse-global-options ptr int int bool bool -- int bool bool do
    let argv argc index debug release do
        if index argc >= do
            index debug release
        else
            argv index argv-at
            let argument do
                if argument "--debug" cstring-equals do
                    argv argc index 1 + true release parse-global-options
                elif argument "--release" cstring-equals do
                    argv argc index 1 + debug true parse-global-options
                else
                    index debug release
                end
            end
        end
    end
end

proc main -- do
    args
    let argv argc do
        argv 0 argv-at compiler-distribution-root
        let standard-library-root standard-library-root-length do
            argv argc 1 false false parse-global-options
            let command-index debug release do
                if command-index argc >= do
                    read-source "<stdin>" String.bytes "<stdin>" String.len debug release standard-library-root standard-library-root-length compile-source
                else
                    argv command-index argv-at
                let command do
                    if
                        command "-h" cstring-equals
                        command "--help" cstring-equals ||
                    do
                        cli-usage
                    elif command "run" cstring-equals do
                        argv argc command-index debug release standard-library-root standard-library-root-length run-command
                    elif command "build" cstring-equals do
                        argv argc command-index debug release standard-library-root standard-library-root-length build-command
                    else
                        "unknown command: " command cli-usage-error-value
                    end
                end
                end
            end
        end
    end
end
