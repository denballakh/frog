proc token-value-at ptr int -- int do token-value-offset token-field end
proc token-line-at ptr int -- int do token-line-offset token-field end
proc token-column-at ptr int -- int do token-column-offset token-field end

proc token-slice ptr int -- ptr int do
    let ctx index do
        ctx @ctx-source
        ctx index token-start-at +
        ctx index token-length-at
    end
end

proc token-equals ptr int String -- bool do
    let ctx index value do
        ctx index token-slice value bytes-equal-string
    end
end

proc string-type-name ptr int -- bool do
    let ctx token-index do
        ctx token-index "String" token-equals
    end
end

proc add-token ptr int int int int int int -- do
    let ctx kind start length value line column do
        ctx @ctx-token-count
        let index do
            kind ctx index token-kind-offset set-token-field
            start ctx index token-start-offset set-token-field
            length ctx index token-length-offset set-token-field
            value ctx index token-value-offset set-token-field
            line ctx index token-line-offset set-token-field
            column ctx index token-column-offset set-token-field
            index 1 + ctx !ctx-token-count
        end
    end
end

proc source-byte ptr int -- int do
    let ctx index do
        ctx @ctx-source index byte-read
    end
end

proc lex-advance ptr -- do
    let ctx do
        ctx @ctx-lex-index
        let index do
            ctx index source-byte
            let byte do
                index 1 + ctx !ctx-lex-index
                if byte 10 == do
                    ctx @ctx-lex-line 1 + ctx !ctx-lex-line
                    1 ctx !ctx-lex-column
                else
                    ctx @ctx-lex-column 1 + ctx !ctx-lex-column
                end
            end
        end
    end
end

proc all-digits ptr int int -- bool do
    let source start length do
        0 true
        while
            let index valid do
                index valid
                index length < valid &&
            end
        do
            let index valid do
                index 1 +
                valid source start index + byte-read is-digit &&
            end
        end
        let index valid do
            valid length 0 > &&
        end
    end
end

proc integer-literal-base ptr int int -- int do
    let source start length do
        if length 2 >= source start byte-read 48 == && do
            source start 1 + byte-read
            let prefix do
                if prefix 98 == do
                    2
                elif prefix 111 == do
                    8
                elif prefix 120 == do
                    16
                else
                    0
                end
            end
        else
            0
        end
    end
end

proc parse-integer ptr int int int -- int do
    let source start length base do
        if length 0 == do
            "invalid integer literal" fail
        end
        0 0
        while
            let index value do
                index value index length <
            end
        do
            let index value do
                source start index + byte-read digit-value
                let digit do
                    if digit 0 < digit base >= || do
                        "invalid integer literal" fail
                    end
                    if
                        value max-int base / >
                        value max-int base / ==
                        digit max-int base % > && ||
                    do
                        "integer literal exceeds the signed 64-bit range" fail
                    end
                    index 1 +
                    value base * digit +
                end
            end
        end
        let index value do value end
    end
end

proc classify-word ptr int int -- int int do
    let source start length do
        if source start + length "true" bytes-equal-string do
            token-bool 1
        elif source start + length "false" bytes-equal-string do
            token-bool 0
        elif source start length all-digits do
            token-int source start length 10 parse-integer
        else
            source start length integer-literal-base
            let base do
                if base 0 > do
                    token-int source start 2 + length 2 - base parse-integer
                else
                    token-word 0
                end
            end
        end
    end
end

proc skip-comment ptr -- do
    let ctx do
        while
            ctx @ctx-lex-index ctx @ctx-source-length <
            if dup do
                drop ctx ctx @ctx-lex-index source-byte 10 !=
            end
        do
            ctx lex-advance
        end
    end
end

proc lex-string ptr int int int -- do
    let ctx start line column do
        ctx lex-advance
        ctx @ctx-lex-index
        let content-start do
            false
            while
                let done do
                    done done !
                    ctx @ctx-lex-index ctx @ctx-source-length < &&
                end
            do
                let done do
                    ctx ctx @ctx-lex-index source-byte
                    let byte do
                        if byte 34 == do
                            true
                        else
                            if byte 92 == do
                                ctx lex-advance
                                if ctx @ctx-lex-index ctx @ctx-source-length >= do
                                    "unterminated string escape" fail
                                end
                            end
                            ctx lex-advance
                            false
                        end
                    end
                end
            end
            drop
            if ctx @ctx-lex-index ctx @ctx-source-length >= do
                "unterminated string literal" fail
            end
            ctx @ctx-lex-index content-start -
            let content-length do
                ctx token-string content-start content-length 0 line column add-token
            end
            ctx lex-advance
        end
    end
end

proc lex-character ptr int int int -- do
    let ctx start line column do
        ctx lex-advance
        if ctx @ctx-lex-index ctx @ctx-source-length >= do
            "unterminated character literal" fail
        end
        if ctx ctx @ctx-lex-index source-byte 10 == do
            "unterminated character literal" fail
        end
        if ctx ctx @ctx-lex-index source-byte 39 == do
            "invalid character literal" fail
        end
        ctx @ctx-source ctx @ctx-source-length ctx @ctx-lex-index utf8-codepoint-at
        let value width do
            ctx width lex-advance-count
            if ctx @ctx-lex-index ctx @ctx-source-length >= do
                "unterminated character literal" fail
            end
            if ctx ctx @ctx-lex-index source-byte 39 != do
                if ctx ctx @ctx-lex-index source-byte 10 == do
                    "unterminated character literal" fail
                else
                    "invalid character literal" fail
                end
            end
            ctx lex-advance
            ctx token-char start width 2 + value line column add-token
        end
    end
end

proc lex-word ptr int int int -- do
    let ctx start line column do
        while
            ctx @ctx-lex-index ctx @ctx-source-length <
            if dup do
                drop ctx ctx @ctx-lex-index source-byte is-space !
            end
        do
            ctx lex-advance
        end
        ctx @ctx-lex-index start -
        let length do
            if ctx @ctx-source start + length "//" bytes-equal-string do
                ctx skip-comment
            else
                ctx @ctx-source start length classify-word
                let kind value do
                    ctx kind start length value line column add-token
                end
            end
        end
    end
end

proc lex ptr -- do
    let ctx do
        0 ctx !ctx-token-count
        0 ctx !ctx-lex-index
        1 ctx !ctx-lex-line
        1 ctx !ctx-lex-column

        while ctx @ctx-lex-index ctx @ctx-source-length < do
            ctx ctx @ctx-lex-index source-byte
            let byte do
                if byte is-space do
                    ctx lex-advance
                else
                    ctx @ctx-lex-index
                    ctx @ctx-lex-line
                    ctx @ctx-lex-column
                    let start line column do
                        if byte 34 == do
                            ctx start line column lex-string
                        else
                            if byte 39 == do
                                ctx start line column lex-character
                            else
                                ctx start line column lex-word
                            end
                        end
                    end
                end
            end
        end
    end
end

