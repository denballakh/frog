// BEGIN C EMITTER SUPPORT
proc raw-string-byte ModuleContext* int int -- int do
    let ctx token raw-index do
        ctx @ModuleContext.source
        ctx token token-at @TokenEntry.start
        raw-index +
        byte-read
    end
end

proc raw-string-length ModuleContext* int -- int do
    peek ctx token do token-at @TokenEntry.length end
end

proc raw-string-line ModuleContext* int int -- int do
    let ctx token finish do
        0 ctx token token-at @TokenEntry.line
        while peek index line do index finish < end do
            let index line do
                if ctx ctx token token-at @TokenEntry.start index + source-byte-is-newline do
                    index 1 + line 1 +
                else
                    index 1 + line
                end
            end
        end
        let index line do line end
    end
end

proc decoded-string-unit ModuleContext* int int -- int int do
    peek ctx token raw-index do raw-string-byte
        let byte do
            if byte 92 != do
                byte 1
            else
                raw-index 1 +
                let escape-index do
                    if escape-index ctx token raw-string-length >= do
                        ctx
                        ctx token token-at @TokenEntry.start raw-index +
                        1
                        ctx token raw-index raw-string-line
                        "unterminated string escape"
                        fail-span-at
                    end
                    ctx token escape-index raw-string-byte
                    let escaped do
                        if escaped 92 == do 92 2
                        elif escaped '"' == do '"' 2
                        elif escaped 110 == do 10 2
                        elif escaped 114 == do 13 2
                        elif escaped 116 == do 9 2
                        elif escaped 48 == do 0 2
                        elif escaped 120 == do
                            if escape-index 2 + ctx token raw-string-length >= do
                                ctx
                                ctx token token-at @TokenEntry.start raw-index +
                                ctx token raw-string-length raw-index -
                                ctx token raw-index raw-string-line
                                "incomplete hexadecimal string escape"
                                fail-span-at
                            end
                            ctx token escape-index 1 + raw-string-byte
                            ctx token escape-index 2 + raw-string-byte
                            let high low do
                                if high is-hex-digit low is-hex-digit && ! do
                                    ctx
                                    ctx token token-at @TokenEntry.start raw-index +
                                    4
                                    ctx token raw-index raw-string-line
                                    "invalid hexadecimal string escape"
                                    fail-span-at
                                end
                                high hex-value 16 * low hex-value + 4
                            end
                        else
                            ctx
                            ctx token token-at @TokenEntry.start raw-index +
                            2
                            ctx token raw-index raw-string-line
                            "invalid string escape"
                            fail-span-at
                            0 0
                        end
                    end
                end
            end
        end
    end
end

proc decoded-string-length ModuleContext* int -- int do
    let ctx token do
        0 0
        while
            peek raw-index count do
                raw-index ctx token raw-string-length <
            end
        do
            let raw-index count do
                ctx token raw-index decoded-string-unit
                let ignored width do
                    raw-index width + count 1 +
                end
            end
        end
        let raw-index count do count end
    end
end

proc decoded-string-byte-from ModuleContext* int int int -- int do
    let ctx token raw-index byte-index do
        if raw-index ctx token raw-string-length >= do
            "decoded string byte index out of bounds" fail
        end
        ctx token raw-index decoded-string-unit
        let value width do
            if byte-index 0 == do
                value
            else
                ctx token raw-index width + byte-index 1 - decoded-string-byte-from
            end
        end
    end
end

proc decoded-string-byte ModuleContext* int int -- int do
    let ctx token byte-index do
        ctx token 0 byte-index decoded-string-byte-from
    end
end

proc decode-string-copy-from ModuleContext* int int ptr int -- do
    let ctx token raw-index destination destination-index do
        if raw-index ctx token raw-string-length < do
            ctx token raw-index decoded-string-unit let value width do
                value destination destination-index byte-write
                ctx token raw-index width + destination destination-index 1 + decode-string-copy-from
            end
        end
    end
end

proc hash-string-bytes ptr int -- int do
    let bytes length do
        0 fnv-offset-basis
        while
            peek index hash do index length <
            end
        do
            let index hash do
                index 1 +
                hash bytes index byte-read ^ fnv-prime * fnv-modulus %
            end
        end
        let index hash do hash end
    end
end

proc pooled-string-matches Program* int ptr int int -- bool do
    let program string-index bytes length hash do
        if program string-index string-at @StringPoolEntry.hash hash != do
            false
        elif program string-index string-at @StringPoolEntry.length length != do
            false
        else
            program string-index string-at @StringPoolEntry.data
            program string-index string-at @StringPoolEntry.length
            bytes length bytes-equal
        end
    end
end

proc find-pooled-string Program* ptr int int -- int do
    let program bytes length hash do
        0 0 1 -
        while
            peek string-index found do
                string-index program @Program.string_count < found 0 < &&
            end
        do
            let string-index found do
                string-index 1 +
                if program string-index bytes length hash pooled-string-matches do
                    string-index
                else
                    found
                end
            end
        end
        let string-index found do found end
    end
end

proc count-string-hash Program* int -- int do
    let program hash do
        0 0
        while
            peek string-index count do string-index program @Program.string_count <
            end
        do
            let string-index count do
                string-index 1 +
                if program string-index string-at @StringPoolEntry.hash hash == do
                    count 1 +
                else
                    count
                end
            end
        end
        let string-index count do count end
    end
end

proc add-pooled-string Program* ptr int int int -- int do
    let program bytes length hash collision do
        program @Program.string_count
        let string-index do
            bytes program string-index string-at !StringPoolEntry.data
            length program string-index string-at !StringPoolEntry.length
            hash program string-index string-at !StringPoolEntry.hash
            collision program string-index string-at !StringPoolEntry.collision
            string-index 1 + program !Program.string_count
            string-index
        end
    end
end

proc intern-string-token Program* ModuleContext* int -- do
    let program ctx token do
        ctx token decoded-string-length
        peek length do alloc
            let bytes do
                ctx token 0 bytes 0 decode-string-copy-from
                bytes length hash-string-bytes
                let hash do
                    program bytes length hash find-pooled-string
                    let existing do
                        if existing 0 >= do
                            existing
                        else
                            program bytes length hash program hash count-string-hash add-pooled-string
                        end
                        ctx token token-at !TokenEntry.value
                    end
                end
            end
        end
    end
end

proc intern-module-strings Program* ModuleContext* -- do
    let program ctx do
        0
        while dup ctx @ModuleContext.token_count < do
            dup
            let token do
                if ctx token token-at @TokenEntry.kind TokenKind:string == do
                    program ctx token intern-string-token
                end
            end
            1 +
        end
        drop
    end
end

proc initialize-string-pool Program* -- do
    peek program do @Program.token_count 1 + StringPoolEntry:sizeof * alloc program !Program.strings
        0 program !Program.string_count
        program @Program.module_head
        while dup ptr cast int cast 0 != do
            dup program swap intern-module-strings
            @ModuleContext.next_module
        end
        drop
    end
end

proc bytes-are-dot ptr int int -- bool do
    let bytes start length do
        if length 1 == do
            bytes start byte-read 46 ==
        else
            false
        end
    end
end

proc bytes-are-dot-dot ptr int int -- bool do
    let bytes start length do
        if length 2 == do
            bytes start byte-read 46 ==
            bytes start 1 + byte-read 46 == &&
        else
            false
        end
    end
end

proc bytes-contain-byte ptr int int -- bool do
    let bytes length value do
        0 false
        while
            peek index found do
                index length < found ! &&
            end
        do
            let index found do
                index 1 +
                found bytes index byte-read value == ||
            end
        end
        let index found do found end
