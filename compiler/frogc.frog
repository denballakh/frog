proc valid-c-symbol ModuleContext* int -- bool do
    let ctx token-index do ctx token-index token-slice
        let bytes length do
            if length 0 == do
                false
            elif bytes 0 byte-read is-c-identifier-start ! do
                false
            elif ctx token-index reserved-c-symbol do
                false
            else
                bytes length 1 c-identifier-suffix-valid
            end
        end
    end
end

proc valid-c-include-byte int -- bool do
    let byte do
        byte 65 >= byte 90 <= &&
        byte 97 >= byte 122 <= && ||
        byte 48 >= byte 57 <= && ||
        byte 95 == || byte 46 == || byte 47 == || byte 43 == || byte 45 == ||
    end
end

proc validate-c-include-token ModuleContext* int -- do
    let ctx token do
        if ctx token token-at @TokenEntry.kind token-string != do "expected C include path string" fail end
        ctx token decoded-string-length
        let length do
            if length 0 == do "C include path must not be empty" fail end
            0
            while dup length < do
                dup let index do
                    if ctx token index decoded-string-byte valid-c-include-byte ! do "invalid C include path" fail end
                end
                1 +
            end
            drop
        end
    end
end

proc validate-c-type-spelling ModuleContext* int -- do
    let ctx token do
        if ctx token token-at @TokenEntry.kind token-string != do "expected C type string" fail end
        ctx token decoded-string-length let length do
            if length 0 == do "C type must not be empty" fail end
            0
            while dup length < do
                dup let index do
                    ctx token index decoded-string-byte let byte do
                        if byte 0 == byte 10 == || byte 13 == || do "invalid C type spelling" fail end
                    end
                end
                1 +
            end
            drop
        end
    end
end

proc parse-type-token ModuleContext* int -- int do
    peek ctx token-index do require-word
        ctx token-index type-token-pointer-depth
        let depth do
        if depth ctx token-index token-at @TokenEntry.length == do
            "malformed pointer type" fail
        end
        ctx token-index token-at @TokenEntry.length depth -
        let base-length do
        if ctx token-index base-length type-token-base-has-star do "malformed pointer type" fail end
        if ctx token-index base-length "int" token-type-prefix-equals do
            type-int
        elif ctx token-index base-length "i8" token-type-prefix-equals do type-i8
        elif ctx token-index base-length "i16" token-type-prefix-equals do type-i16
        elif ctx token-index base-length "i32" token-type-prefix-equals do type-i32
        elif ctx token-index base-length "i64" token-type-prefix-equals do type-i64
        elif ctx token-index base-length "u8" token-type-prefix-equals do type-u8
        elif ctx token-index base-length "u16" token-type-prefix-equals do type-u16
        elif ctx token-index base-length "u32" token-type-prefix-equals do type-u32
        elif ctx token-index base-length "u64" token-type-prefix-equals do type-u64
        elif ctx token-index base-length "bool" token-type-prefix-equals do
            type-bool
        elif ctx token-index base-length "ptr" token-type-prefix-equals do
            type-ptr
        elif ctx token-index base-length "String" token-type-prefix-equals do
            type-string
        else
            if depth 0 > do
                if base-length 0 == do
                    "malformed pointer type" fail
                    0
                else
                    ctx @ModuleContext.program ctx token-index depth program-add-unresolved-pointer-type
                end
            elif ctx token-index reserved-name do
                "unknown type in procedure signature" fail
                0
            else
                0 token-index - 1 -
            end
        end
        let value-type do
            if depth 0 > value-type 0 >= && do
                ctx @ModuleContext.program
                let program do program value-type depth intern-pointer-depth end
            else
                value-type
            end
        end
        end
        end
    end
end

