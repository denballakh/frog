proc reserved-c-symbol ModuleContext* int -- bool do
    let ctx token-index do ctx token-index c-keyword
        ctx token-index "main" token-equals ||
        ctx token-index "Cell" token-equals ||
        ctx token-index "FrogString" token-equals ||
        ctx token-index frog-internal-symbol ||
