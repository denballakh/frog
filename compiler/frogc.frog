proc field-read ptr int -- int do + @i64 end

proc field-write int ptr int -- do
    + !i64
end

proc pointer-field-read ptr int -- ptr do
    field-read ptr cast
end

proc pointer-field-write ptr ptr int -- do
    let value base offset do
        value int cast base offset field-write
    end
end

proc byte-read ptr int -- int do
    + @u8
end

proc byte-write int ptr int -- do
    + !u8
end

proc memory-copy ptr ptr int -- do
    let source destination count do
        0
        while dup count < do
            dup let index do
                source index byte-read
                destination index byte-write
            end
            1 +
        end
        drop
    end
end

proc emit-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + @u8 putc
            1 +
        end
        drop
    end
end

proc emit String -- do
    let value do
        value String.bytes value String.len emit-bytes
    end
end

proc emit-error-bytes ptr int -- do
    let bytes length do
        0
        while dup length < do
            dup bytes swap + @u8 eputc
            1 +
        end
        drop
    end
end

proc emit-error String -- do
    let value do
        value String.bytes value String.len emit-error-bytes
    end
end

proc fail String -- do
    "frogc: " emit-error
    emit-error
    10 eputc
    1 exit
end

proc emit-unsigned int -- do
    let value do
        if value 10 >= do
            value 10 / emit-unsigned
        end
        value 10 % 48 + putc
    end
end

proc emit-integer int -- do
    if dup 0 < do
        45 putc
        0 swap -
    end
    emit-unsigned
end

proc is-space int -- bool do
    let byte do
        byte 32 ==
        byte 9 == ||
        byte 10 == ||
        byte 13 == ||
    end
end

proc is-digit int -- bool do
    let byte do
        byte 48 >= byte 57 <= &&
    end
end

proc is-ascii-letter int -- bool do
    let byte do
        byte 65 >= byte 90 <= &&
        byte 97 >= byte 122 <= && ||
    end
end

proc is-c-identifier-start int -- bool do
    let byte do
        byte is-ascii-letter byte 95 == ||
    end
end

proc is-c-identifier-byte int -- bool do
    let byte do
        byte is-c-identifier-start byte is-digit ||
    end
end

proc digit-value int -- int do
    let byte do
        if byte is-digit do
            byte 48 -
        elif byte 65 >= byte 70 <= && do
            byte 65 - 10 +
        elif byte 97 >= byte 102 <= && do
            byte 97 - 10 +
        else
            0 1 -
        end
    end
end

proc is-hex-digit int -- bool do digit-value 0 >= end

proc hex-value int -- int do
    digit-value
    let value do
        if value 0 >= do
            value
        else
            "invalid hexadecimal digit" fail
            0
        end
    end
end

proc bytes-equal ptr int ptr int -- bool do
    let first first-length second second-length do
        if first-length second-length != do
            false
        else
            0 true
            while
                let index equal do
                    index equal
                    index first-length < equal &&
                end
            do
                let index equal do
                    index 1 +
                    equal
                    first index byte-read second index byte-read == &&
                end
            end
            let index equal do equal end
        end
    end
end

proc bytes-equal-string ptr int String -- bool do
    let bytes length value do
        bytes length value String.bytes value String.len bytes-equal
    end
end

proc read-source -- ptr int do
    max-source-bytes alloc
    let source do
        0 getc
        while dup 0 >= do
            let length byte do
                if length max-source-bytes >= do
                    "source exceeds max-source-bytes" fail
                end
                byte source length byte-write
                length 1 +
                getc
            end
        end
        drop
        source swap
    end
end

